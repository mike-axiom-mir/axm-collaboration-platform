{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.adaptive-grade/v1",
  "type": "object",
  "required": [
    "schema",
    "grade_id",
    "track_id",
    "class_id",
    "skill_id",
    "scenario_id",
    "score",
    "verdict",
    "passed",
    "checks",
    "dimensions",
    "authority",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "axm.mirror.adaptive-grade/v1"
    },
    "track_id": {
      "const": "adaptive_communication"
    },
    "verdict": {
      "enum": [
        "PASS",
        "HOLD",
        "REPAIR",
        "REJECT"
      ]
    },
    "authority": {
      "const": "NONE"
    }
  },
  "additionalProperties": true
}
