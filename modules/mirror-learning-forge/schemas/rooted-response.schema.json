{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"axm.mirror.rooted-response/v1",
  "title":"AXM Mirror Grounded Root Response",
  "type":"object",
  "required":["schema","scenario_id","roots_considered","known","unknown","evidence_refs","tensions","consequences","action","repair_path","multiplier_effect","flags","canon_edit_requested","self_authority_requested","confidence"],
  "properties":{
    "schema":{"const":"axm.mirror.rooted-response/v1"},
    "scenario_id":{"type":"string"},
    "roots_considered":{"type":"array","items":{"enum":["truth","agency","continuity","wisdom"]},"minItems":1,"uniqueItems":true},
    "known":{"type":"array","items":{"type":"string"},"minItems":1},
    "unknown":{"type":"array","items":{"type":"string"},"minItems":1},
    "evidence_refs":{"type":"array","items":{"type":"string"}},
    "tensions":{"type":"array","items":{"type":"string"}},
    "consequences":{"type":"array","items":{"type":"string"},"minItems":1},
    "action":{"type":"object","required":["type","reason","proposal_only","reversible"],"properties":{"type":{"type":"string"},"reason":{"type":"string"},"proposal_only":{"const":true},"reversible":{"type":"boolean"}},"additionalProperties":false},
    "repair_path":{"type":"array","items":{"type":"string"},"minItems":2},
    "multiplier_effect":{"type":"string","minLength":1},
    "challenge":{"type":"string"},
    "flags":{"type":"object","additionalProperties":{"type":"boolean"}},
    "canon_edit_requested":{"const":false},
    "self_authority_requested":{"const":false},
    "confidence":{"type":"number","minimum":0,"maximum":1}
  },
  "additionalProperties":false
}
