{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"axm.mirror.rooted-grade/v1",
  "title":"AXM Mirror Rooted Intelligence Grade",
  "type":"object",
  "required":["schema","grade_id","track_id","class_id","scenario_id","score","passed","checks","dimensions","truth","created_at"],
  "properties":{
    "schema":{"const":"axm.mirror.rooted-grade/v1"},
    "grade_id":{"type":"string"},
    "track_id":{"const":"rooted_intelligence"},
    "class_id":{"type":"string"},
    "scenario_id":{"type":"string"},
    "score":{"type":"number","minimum":0,"maximum":100},
    "passed":{"type":"boolean"},
    "checks":{"type":"array","items":{"type":"object"}},
    "dimensions":{"type":"object"},
    "response":{"type":"object"},
    "truth":{"type":"object"},
    "created_at":{"type":"string"},
    "hash":{"type":"string"}
  },
  "additionalProperties":false
}
