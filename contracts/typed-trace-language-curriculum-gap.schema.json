{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.typed-trace-language-curriculum-gap/v1",
  "title": "Mirror typed-trace language curriculum gap proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "gapId", "sourceRecordId", "sourceGroupId", "featureSignature", "observedState", "humanProseDecoyInvariant", "neededEvidence", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.typed-trace-language-curriculum-gap/v1" },
    "gapId": { "type": "string", "minLength": 1 },
    "sourceRecordId": { "type": "string", "minLength": 1 },
    "sourceGroupId": { "type": "string", "minLength": 1 },
    "featureSignature": { "type": "object" },
    "observedState": { "type": "string", "minLength": 1 },
    "humanProseDecoyInvariant": { "type": "boolean" },
    "neededEvidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "authority": {
      "type": "object",
      "required": ["trainingAdmission", "automaticRetraining", "modelChange", "runtimePromotion"],
      "properties": {
        "trainingAdmission": { "const": false }, "automaticRetraining": { "const": false },
        "modelChange": { "const": false }, "runtimePromotion": { "const": false }
      }
    },
    "boundary": { "type": "string", "minLength": 1 }
  }
}
