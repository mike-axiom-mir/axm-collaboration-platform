{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.foundation-capability-native-artifact-inventory-declaration/v1",
  "title": "Mirror declaration-bound native capability artifact inventory contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "inventoryDeclarationId", "inventoryDeclarationDigest", "source", "search", "preservation", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.foundation-capability-native-artifact-inventory-declaration/v1" },
    "inventoryDeclarationId": { "type": "string", "pattern": "^foundation-capability-native-artifact-inventory-[a-f0-9]{24}$" },
    "inventoryDeclarationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "capabilityDeclarationDigest", "nativeOutputKind"],
      "properties": {
        "capabilityId": { "type": "string", "minLength": 1 },
        "capabilityDeclarationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "nativeOutputKind": { "type": "string", "minLength": 1 }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "fileRule", "maximumDepth", "maximumFiles", "maximumFileBytes", "requiredRootSchema"],
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "availability", "artifactClass"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "availability": { "enum": ["REQUIRED", "OPTIONAL"] },
              "artifactClass": { "enum": ["PRIVATE_PERMISSIONED_DATASET", "PRIVATE_EVIDENCE_STATE"] }
            }
          }
        },
        "fileRule": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "name"],
              "properties": {
                "kind": { "const": "EXACT_BASENAME" },
                "name": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "prefix", "hexLength", "suffix"],
              "properties": {
                "kind": { "const": "CONTENT_ADDRESSED_JSON_BASENAME" },
                "prefix": { "type": "string", "minLength": 1 },
                "hexLength": { "type": "integer", "minimum": 8, "maximum": 64 },
                "suffix": { "const": ".json" }
              }
            }
          ]
        },
        "maximumDepth": { "type": "integer", "minimum": 0, "maximum": 3 },
        "maximumFiles": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "maximumFileBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "requiredRootSchema": { "type": "string", "minLength": 1 }
      }
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentExposure", "permissionState", "evidenceEligibility", "selectionState"],
      "properties": {
        "contentExposure": { "const": "HASH_AND_MACHINE_CLASSIFICATION_ONLY" },
        "permissionState": { "const": "NOT_EVALUATED" },
        "evidenceEligibility": { "const": "UNASSESSED" },
        "selectionState": { "const": "ALL_MATCHES_UNSELECTED" }
      }
    },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "boundary": { "type": "string", "minLength": 1 }
  }
}
