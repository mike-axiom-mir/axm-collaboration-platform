{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.provider-declaration-research-executor-review-response.schema.json",
  "title": "AXM Mirror sealed provider declaration research executor review response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "responseDigest", "organId", "sourceResearchExamBatch", "request", "reviewProvenance", "state", "recipe", "admission", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.provider-declaration-research-executor-review-response/v1" },
    "responseDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "organId": { "const": "axm.mirror.organ/provider-declaration-research-executor-human-review-bridge-v1" },
    "sourceResearchExamBatch": { "type": "object" },
    "request": { "type": "object" },
    "reviewProvenance": { "type": "object" },
    "state": { "enum": ["REVIEWED_EXECUTOR_RECIPE_SEALED_NOT_BUILT", "HOLD_RECORDED_WITH_NO_EXECUTOR"] },
    "recipe": { "$ref": "reviewed-provider-declaration-research-executor-recipe.schema.json" },
    "admission": { "$ref": "provider-declaration-research-executor-recipe-admission.schema.json" },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "boundary": { "type": "string" }
  }
}
