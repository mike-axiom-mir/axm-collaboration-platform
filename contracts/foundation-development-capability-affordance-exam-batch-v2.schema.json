{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.foundation-development-capability-affordance-exam-batch/v2",
  "title": "Mirror Foundation capability affordance-exam planning batch with output-adapter holds",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batchId", "batchDigest", "organ", "source", "requests", "holds", "summary", "state", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.foundation-development-capability-affordance-exam-batch/v2" },
    "batchId": { "type": "string", "pattern": "^foundation-capability-affordance-exams-[a-f0-9]{24}$" },
    "batchDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "organ": { "type": "object" },
    "source": { "type": "object" },
    "requests": { "type": "array" },
    "holds": { "type": "array" },
    "summary": { "type": "object" },
    "state": { "enum": ["INDEPENDENT_AFFORDANCE_EXAM_REQUESTS_PROPOSED", "HOLD_PARTIAL_DECLARED_COMPATIBILITY_REQUIRES_OUTPUT_ADAPTER", "HOLD_NO_DECLARED_COMPATIBILITY_WITNESSES", "NO_EVIDENCE_HANDS_TO_EXAMINE"] },
    "authority": { "type": "object" },
    "boundary": { "type": "string", "minLength": 1 }
  }
}
