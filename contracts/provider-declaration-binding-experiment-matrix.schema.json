{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.provider-declaration-binding-experiment-matrix.schema.json",
  "title": "AXM Mirror provider declaration binding experiment matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrixId", "matrixDigest", "schema", "cellId", "sourceEvidenceSurvey", "sourceArchitectureSurvey", "sourceResearchExam", "requirementId", "demandedProviderSelectors", "candidateSources", "validationWitnesses", "hypothesesRepresented", "unresolvedFallback", "experimentFrames", "selectedFrameId", "selectionState", "providerIdentityInferred", "outerRequirementBound", "permissionsInferred", "implementationSelected", "sourceExecuted", "architectureSelected", "architectureEvaluated", "providerCandidateBuilt", "providerDeclarationWritten", "state", "authority", "boundary"],
  "properties": {
    "matrixId": { "type": "string", "pattern": "^provider-binding-experiment-matrix-[a-f0-9]{20}$" },
    "matrixDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "schema": { "const": "axm.mirror.provider-declaration-binding-experiment-matrix/v1" },
    "cellId": { "const": "axm.mirror.cell/provider-binding-experiment-frame-v1" },
    "sourceEvidenceSurvey": { "type": "object" },
    "sourceArchitectureSurvey": { "type": "object" },
    "sourceResearchExam": { "type": "object" },
    "requirementId": { "type": "string", "minLength": 1 },
    "demandedProviderSelectors": { "type": "array", "minItems": 1, "uniqueItems": true },
    "candidateSources": { "type": "array" },
    "validationWitnesses": { "type": "array" },
    "hypothesesRepresented": { "type": "array", "maxItems": 3 },
    "unresolvedFallback": { "type": ["object", "null"] },
    "experimentFrames": { "type": "array", "maxItems": 384 },
    "selectedFrameId": { "const": null },
    "selectionState": { "const": "NO_EXPERIMENT_FRAME_SELECTED" },
    "providerIdentityInferred": { "const": false },
    "outerRequirementBound": { "const": false },
    "permissionsInferred": { "const": false },
    "implementationSelected": { "const": false },
    "sourceExecuted": { "const": false },
    "architectureSelected": { "const": false },
    "architectureEvaluated": { "const": false },
    "providerCandidateBuilt": { "const": false },
    "providerDeclarationWritten": { "const": false },
    "state": { "enum": ["PROPOSED_BALANCED_PROVIDER_BINDING_EXPERIMENT_MATRIX_NOT_SELECTED", "NO_ELIGIBLE_IMPLEMENTATION_EXPERIMENT_INPUT_PRESERVE_UNRESOLVED"] },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "boundary": { "type": "string", "minLength": 1 }
  }
}
