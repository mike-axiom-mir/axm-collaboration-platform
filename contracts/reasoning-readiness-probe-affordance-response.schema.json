{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.reasoning-readiness-probe-affordance-response.schema.json",
  "title": "AXM Mirror readiness probe affordance response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "responseDigest", "organId", "sourceBatchId", "request", "state", "reason", "reviewPackets", "holds", "humanReviewCreated", "recipesSealed", "candidatesBuilt", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.reasoning-readiness-probe-affordance-response/v1" },
    "responseDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "organId": { "const": "axm.mirror.organ/reasoning-readiness-probe-affordance-planner-v1" },
    "sourceBatchId": { "type": "string" },
    "request": { "type": "object" },
    "state": { "type": "string" },
    "reason": { "type": "string" },
    "reviewPackets": { "type": "array" },
    "holds": { "type": "array" },
    "humanReviewCreated": { "const": false },
    "recipesSealed": { "const": false },
    "candidatesBuilt": { "const": false },
    "authority": { "type": "object" },
    "boundary": { "type": "string" }
  }
}
