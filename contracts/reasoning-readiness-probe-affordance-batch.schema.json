{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.reasoning-readiness-probe-affordance-batch.schema.json",
  "title": "AXM Mirror readiness probe declaration affordance batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batchId", "batchDigest", "inputsDigest", "createdAt", "organ", "affordanceContract", "sourceLineage", "sourceHandBatch", "sourceHandoffGraph", "serviceInventoryDigest", "results", "summary", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.reasoning-readiness-probe-affordance-batch/v1" },
    "batchId": { "type": "string", "pattern": "^reasoning-readiness-probe-affordances-[a-f0-9]{20}$" },
    "batchDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputsDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "null" },
    "organ": { "type": "object" },
    "affordanceContract": { "type": "object" },
    "sourceLineage": { "type": "array" },
    "sourceHandBatch": { "type": "object" },
    "sourceHandoffGraph": { "type": "object" },
    "serviceInventoryDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "results": { "type": "array", "maxItems": 128 },
    "summary": { "type": "object" },
    "authority": { "type": "object" },
    "boundary": { "type": "string" }
  }
}
