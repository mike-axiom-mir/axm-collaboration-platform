{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.reasoning-provider-declaration-binding-experiment-batch.schema.json",
  "title": "AXM Mirror provider declaration binding experiment planner batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batchId", "batchDigest", "inputsDigest", "createdAt", "organ", "cell", "plannerContract", "sourceLineage", "sourceImplementationEvidenceBatch", "results", "summary", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.reasoning-provider-declaration-binding-experiment-batch/v1" },
    "batchId": { "type": "string", "pattern": "^reasoning-provider-declaration-binding-experiments-[a-f0-9]{20}$" },
    "batchDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputsDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "null" },
    "organ": { "type": "object" },
    "cell": { "type": "object" },
    "plannerContract": { "type": "object" },
    "sourceLineage": { "type": "array", "minItems": 1 },
    "sourceImplementationEvidenceBatch": { "type": "object" },
    "results": { "type": "array", "maxItems": 128 },
    "summary": { "type": "object" },
    "authority": { "type": "object" },
    "boundary": { "type": "string", "minLength": 1 }
  }
}
