{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.foundation-public-source-inventory/v1",
  "title": "Mirror bounded public Foundation source inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "digest", "cell", "identity", "rules", "files", "summary", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.foundation-public-source-inventory/v1" },
    "digest": { "$ref": "#/$defs/digest" },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "learnedWeights", "discoveryAuthority", "executionAuthority"],
      "properties": {
        "id": { "const": "axm.mirror.foundation-public-source-inventory-cell/v1" },
        "learnedWeights": { "const": false }, "discoveryAuthority": { "const": false }, "executionAuthority": { "const": false }
      }
    },
    "identity": { "const": "axm.machine.mirror/seed-0" },
    "rules": {
      "type": "object", "additionalProperties": false,
      "required": ["discoveryRoots", "requiredAnchors", "sourceExtensions", "excludedSegments", "excludedPairs", "limits"],
      "properties": {
        "discoveryRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/rootRule" } },
        "requiredAnchors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "sourceExtensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" } },
        "excludedSegments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "excludedPairs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["maxFiles", "maxFileBytes", "maxTotalBytes", "maxDepth"],
          "properties": {
            "maxFiles": { "$ref": "#/$defs/positive" }, "maxFileBytes": { "$ref": "#/$defs/positive" },
            "maxTotalBytes": { "$ref": "#/$defs/positive" }, "maxDepth": { "$ref": "#/$defs/positive" }
          }
        }
      }
    },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
        "properties": { "path": { "$ref": "#/$defs/path" }, "bytes": { "$ref": "#/$defs/count" }, "sha256": { "$ref": "#/$defs/digest" } }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "totalBytes", "rootsObserved", "optionalRootsAbsent", "excludedDirectories", "excludedExtensions", "excludedHiddenEntries"],
      "properties": {
        "files": { "$ref": "#/$defs/count" }, "totalBytes": { "$ref": "#/$defs/count" },
        "rootsObserved": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "optionalRootsAbsent": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "excludedDirectories": { "$ref": "#/$defs/count" }, "excludedExtensions": { "$ref": "#/$defs/count" }, "excludedHiddenEntries": { "$ref": "#/$defs/count" }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceExecution", "capabilityClaim", "permissionGrant", "trainingAdmission", "runtimePromotion", "canonChange", "worldAction"],
      "properties": {
        "sourceExecution": { "const": false }, "capabilityClaim": { "const": false }, "permissionGrant": { "const": false },
        "trainingAdmission": { "const": false }, "runtimePromotion": { "const": false }, "canonChange": { "const": false }, "worldAction": { "const": false }
      }
    },
    "boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "rootRule": {
      "type": "object", "additionalProperties": false, "required": ["path", "required"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "required": { "type": "boolean" } }
    }
  }
}
