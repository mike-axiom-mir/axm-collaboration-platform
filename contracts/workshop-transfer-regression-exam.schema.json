{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/contracts/workshop-transfer-regression-exam.schema.json",
  "title": "AXM Mirror Workshop Transfer Regression Exam",
  "type": "object",
  "required": [
    "schema",
    "examId",
    "examDigest",
    "organ",
    "regressionBinding",
    "settledAudit",
    "sourceLineage",
    "expectedResultAuthorship",
    "result",
    "state",
    "evidenceDisposition",
    "authority",
    "boundary"
  ],
  "properties": {
    "schema": { "const": "axm.mirror.workshop-transfer-regression-exam/v1" },
    "examId": { "type": "string", "pattern": "^workshop-transfer-regression-exam-[a-f0-9]{24}$" },
    "examDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "organ": { "type": "object" },
    "regressionBinding": { "type": "object" },
    "settledAudit": { "type": "object" },
    "sourceLineage": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "expectedResultAuthorship": { "type": "object" },
    "result": { "$ref": "workshop-transfer-regression-exam-result.schema.json" },
    "state": { "type": "string" },
    "evidenceDisposition": { "type": "string" },
    "authority": { "type": "object" },
    "boundary": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
