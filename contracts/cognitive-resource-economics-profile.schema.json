{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.cognitive-resource-economics-profile/v1",
  "title": "Mirror sealed cognitive-resource economics profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profileId", "profileDigest", "organ", "source", "scope", "components", "permission", "assessment", "state", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.cognitive-resource-economics-profile/v1" },
    "profileId": { "type": "string", "pattern": "^cognitive-resource-economics-profile-[a-f0-9]{24}$" },
    "profileDigest": { "$ref": "cognitive-resource-economics-profile-draft.schema.json#/$defs/digest" },
    "organ": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "learnedWeights", "automaticPriceRefresh", "automaticSelection"],
      "properties": {
        "id": { "const": "axm.mirror.cognitive-resource-economics-cell/v1" },
        "learnedWeights": { "const": false },
        "automaticPriceRefresh": { "const": false },
        "automaticSelection": { "const": false }
      }
    },
    "source": { "$ref": "cognitive-resource-economics-profile-draft.schema.json#/$defs/source" },
    "scope": { "$ref": "cognitive-resource-economics-profile-draft.schema.json#/$defs/scope" },
    "components": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "cognitive-resource-economics-profile-draft.schema.json#/$defs/component" } },
    "permission": { "$ref": "cognitive-resource-economics-profile-draft.schema.json#/$defs/permission" },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimateEligible", "issues", "rateEvidenceClass", "externalFreshnessCertified", "nonlinearBillingSupported", "universalTokenComputeConversion"],
      "properties": {
        "estimateEligible": { "type": "boolean" },
        "issues": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,119}$" } },
        "rateEvidenceClass": { "enum": ["DIRECT_SOURCE_DECLARATION_NOT_CERTIFIED", "DECLARED_SOURCE_NOT_CERTIFIED"] },
        "externalFreshnessCertified": { "const": false },
        "nonlinearBillingSupported": { "const": false },
        "universalTokenComputeConversion": { "const": false }
      }
    },
    "state": { "enum": ["READY_LINEAR_PROFILE_DERIVATION_NOT_CALIBRATED_COST", "HOLD_INCOMPLETE_ECONOMICS_PROFILE"] },
    "authority": { "$ref": "#/$defs/authority" },
    "boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["billedCostClaim", "measuredCostClaim", "calibratedCostClaim", "costOptimization", "modelSelection", "hardwareSelection", "budgetAllocation", "permissionGrant", "trainingAdmission", "runtimePromotion", "canonChange", "worldAction"],
      "properties": {
        "billedCostClaim": { "const": false },
        "measuredCostClaim": { "const": false },
        "calibratedCostClaim": { "const": false },
        "costOptimization": { "const": false },
        "modelSelection": { "const": false },
        "hardwareSelection": { "const": false },
        "budgetAllocation": { "const": false },
        "permissionGrant": { "const": false },
        "trainingAdmission": { "const": false },
        "runtimePromotion": { "const": false },
        "canonChange": { "const": false },
        "worldAction": { "const": false }
      }
    }
  }
}
