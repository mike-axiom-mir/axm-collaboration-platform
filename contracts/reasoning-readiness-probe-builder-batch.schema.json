{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.reasoning-readiness-probe-builder-batch/v1",
  "title": "AXM Mirror reviewed disposable readiness probe candidate batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batchId", "batchDigest", "inputsDigest", "createdAt", "organ", "cell", "generationContract", "sourceLineage", "sourceHandBatch", "results", "summary", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.reasoning-readiness-probe-builder-batch/v1" },
    "batchId": { "type": "string", "pattern": "^reasoning-readiness-probe-candidates-[a-f0-9]{20}$" },
    "batchDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputsDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "null" },
    "organ": { "type": "object" },
    "cell": { "type": "object" },
    "generationContract": { "type": "object" },
    "sourceLineage": { "type": "array" },
    "sourceHandBatch": { "type": "object" },
    "results": { "type": "array", "maxItems": 32 },
    "summary": { "type": "object" },
    "authority": { "type": "object" },
    "boundary": { "type": "string" }
  }
}
