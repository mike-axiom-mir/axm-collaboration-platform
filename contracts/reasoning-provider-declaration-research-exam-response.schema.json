{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.reasoning-provider-declaration-research-exam-response.schema.json",
  "title": "AXM Mirror provider declaration research exam response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "responseDigest", "organId", "sourceBatchId", "request", "state", "reason", "examRequests", "holds", "architectureSelected", "examExecutorBuilt", "fixtureFilesGenerated", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.reasoning-provider-declaration-research-exam-response/v1" },
    "responseDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "organId": { "const": "axm.mirror.organ/provider-declaration-research-exam-planner-v1" },
    "sourceBatchId": { "type": "string" },
    "request": { "type": "object" },
    "state": { "type": "string" },
    "reason": { "type": "string" },
    "examRequests": { "type": "array" },
    "holds": { "type": "array" },
    "architectureSelected": { "const": false },
    "examExecutorBuilt": { "const": false },
    "fixtureFilesGenerated": { "const": 0 },
    "authority": { "type": "object" },
    "boundary": { "type": "string" }
  }
}
