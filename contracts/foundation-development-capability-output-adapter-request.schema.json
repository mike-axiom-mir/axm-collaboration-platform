{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.foundation-development-capability-output-adapter-request/v1",
  "title": "Mirror modular output-adapter request for a partial declared-capability witness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapterRequestId", "adapterRequestDigest", "source", "adapterContract", "requiredIndependentArtifacts", "result", "state", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.foundation-development-capability-output-adapter-request/v1" },
    "adapterRequestId": { "type": "string", "pattern": "^foundation-capability-output-adapter-[a-f0-9]{24}$" },
    "adapterRequestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": { "type": "object" },
    "adapterContract": { "type": "object" },
    "requiredIndependentArtifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "result": { "type": "object" },
    "state": { "const": "MODULAR_OUTPUT_ADAPTER_REQUESTED_NOT_BUILT_OR_SELECTED" },
    "authority": { "type": "object" },
    "boundary": { "type": "string", "minLength": 1 }
  }
}
