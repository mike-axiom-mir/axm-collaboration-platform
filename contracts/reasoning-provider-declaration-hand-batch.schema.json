{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.reasoning-provider-declaration-hand-batch.schema.json",
  "title": "AXM Mirror provider declaration hand batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batchId", "batchDigest", "inputsDigest", "createdAt", "organ", "cell", "implementationContract", "sourceLineage", "sourceAffordanceBatch", "results", "summary", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.reasoning-provider-declaration-hand-batch/v1" },
    "batchId": { "type": "string", "pattern": "^reasoning-provider-declaration-hands-[a-f0-9]{20}$" },
    "batchDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputsDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "null" },
    "organ": { "type": "object" },
    "cell": { "type": "object" },
    "implementationContract": { "type": "object" },
    "sourceLineage": { "type": "array" },
    "sourceAffordanceBatch": { "type": "object" },
    "results": { "type": "array", "maxItems": 128 },
    "summary": { "type": "object" },
    "authority": { "type": "object" },
    "boundary": { "type": "string" }
  }
}

