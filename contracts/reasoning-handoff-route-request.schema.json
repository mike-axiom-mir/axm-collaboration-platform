{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.reasoning-handoff-route-request.schema.json",
  "title": "AXM Mirror typed handoff route request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceModuleId", "targetModuleId"],
  "properties": {
    "schema": { "const": "axm.mirror.reasoning-handoff-route-request/v1" },
    "sourceModuleId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "targetModuleId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "maximumDepth": { "type": "integer", "minimum": 1, "maximum": 2 }
  }
}
