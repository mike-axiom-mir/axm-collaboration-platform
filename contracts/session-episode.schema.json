{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.session-episode/v1",
  "title": "Reviewable Mirror session episode",
  "type": "object",
  "required": ["schema", "episodeId", "groupId", "source", "goal", "observations", "candidates", "decision", "outcome", "verification", "digest", "review"],
  "properties": {
    "schema": { "const": "axm.mirror.session-episode/v1" },
    "episodeId": { "type": "string", "maxLength": 120 },
    "groupId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source": {
      "type": "object",
      "required": ["provider", "model", "usePermission", "permissionBasis", "capturedBy"],
      "properties": {
        "provider": { "type": "string", "maxLength": 120 },
        "model": { "type": "string", "maxLength": 200 },
        "sessionRef": { "type": ["string", "null"], "maxLength": 500 },
        "usePermission": { "const": "allowed" },
        "permissionBasis": { "type": "string", "maxLength": 1000 },
        "capturedBy": { "type": "string", "maxLength": 120 }
      },
      "additionalProperties": false
    },
    "goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "observations": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "maxLength": 2000 } },
    "evidenceRefs": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 1000 } },
    "candidates": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "maxLength": 2000 } },
    "decision": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "outcome": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "verification": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "maxLength": 2000 } },
    "repairs": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 2000 } },
    "limitations": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 2000 } },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "review": { "type": "object" }
  },
  "additionalProperties": false
}
