{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.reasoning-provider-declaration-research-exam-batch.schema.json",
  "title": "AXM Mirror provider declaration research exam batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batchId", "batchDigest", "inputsDigest", "createdAt", "organ", "sourceLineage", "implementationContract", "sourceProviderDeclarationHandBatch", "results", "summary", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.reasoning-provider-declaration-research-exam-batch/v1" },
    "batchId": { "type": "string", "pattern": "^reasoning-provider-declaration-research-exams-[a-f0-9]{20}$" },
    "batchDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputsDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "null" },
    "organ": { "type": "object" },
    "sourceLineage": { "type": "array" },
    "implementationContract": { "type": "object" },
    "sourceProviderDeclarationHandBatch": { "type": "object" },
    "results": { "type": "array", "maxItems": 128 },
    "summary": { "type": "object" },
    "authority": { "type": "object", "properties": { "privateEvidenceTraceWrite": { "const": true } }, "additionalProperties": { "const": false } },
    "boundary": { "type": "string", "minLength": 1 }
  }
}
