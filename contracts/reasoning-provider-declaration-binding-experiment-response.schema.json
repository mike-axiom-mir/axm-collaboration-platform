{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.reasoning-provider-declaration-binding-experiment-response.schema.json",
  "title": "AXM Mirror provider declaration binding experiment response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "responseDigest", "organId", "sourceBatchId", "request", "state", "reason", "matrices", "holds", "selectedFrameId", "providerIdentityInferred", "outerRequirementBound", "permissionsInferred", "implementationSelected", "sourceExecuted", "architectureSelected", "architectureEvaluated", "providerCandidateBuilt", "providerDeclarationWritten", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.reasoning-provider-declaration-binding-experiment-response/v1" },
    "responseDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "organId": { "const": "axm.mirror.organ/provider-declaration-binding-experiment-planner-v1" },
    "sourceBatchId": { "type": "string" },
    "request": { "type": "object" },
    "state": { "type": "string" },
    "reason": { "type": "string" },
    "matrices": { "type": "array" },
    "holds": { "type": "array" },
    "selectedFrameId": { "const": null },
    "providerIdentityInferred": { "const": false },
    "outerRequirementBound": { "const": false },
    "permissionsInferred": { "const": false },
    "implementationSelected": { "const": false },
    "sourceExecuted": { "const": false },
    "architectureSelected": { "const": false },
    "architectureEvaluated": { "const": false },
    "providerCandidateBuilt": { "const": false },
    "providerDeclarationWritten": { "const": false },
    "authority": { "type": "object" },
    "boundary": { "type": "string", "minLength": 1 }
  }
}
