{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.foundation-development-capability-declaration/v2",
  "title": "Mirror declared existing capability with native output-kind lineage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capabilityId", "declarationDigest", "implementation", "supportedHandFamilies", "inputKinds", "outputKinds", "capabilityTokens", "operatingMode", "authority", "boundary"],
  "properties": {
    "schema": { "const": "axm.mirror.foundation-development-capability-declaration/v2" },
    "capabilityId": { "type": "string", "pattern": "^axm\\.mirror\\.declared-capability/[a-z0-9-]+/v1$" },
    "declarationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "implementation": {
      "type": "object",
      "required": ["organId", "sourceFiles"],
      "properties": {
        "organId": { "type": "string", "minLength": 1 },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "supportedHandFamilies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "inputKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "outputKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "capabilityTokens": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "operatingMode": { "enum": ["EXPLICIT_MANUAL_INTAKE_AND_EVALUATION", "AUTOMATIC_EXISTING_EPISODE_INTAKE"] },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "boundary": { "type": "string", "minLength": 1 }
  }
}
