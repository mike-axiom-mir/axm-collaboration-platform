{
  "schema": "axm.creation-rung-contract/v1",
  "id": "axm-open-ended-creation-incubator",
  "version": "0.1.0",
  "status": "EXPERIMENTAL-DESIGN-PROOF",
  "purpose": "Preserve safe novelty and useful branching before reducing creations to winners.",
  "loop": [
    "observe-tension-need-or-curiosity",
    "open-or-generate-niche",
    "originate-plural-candidate-forms",
    "instantiate-in-disposable-workshop-sandbox",
    "characterize-before-scoring",
    "test-hard-constraints",
    "measure-novelty-and-plural-value-dimensions",
    "preserve-revise-archive-or-discard-with-receipt",
    "propose-representation-extension-through-strict-review"
  ],
  "inputs": [
    "axm.world.observation/v1",
    "axm.workshop.capability-catalog/v1",
    "axm.creation.niche/v1",
    "human-or-machine-curiosity/v1"
  ],
  "outputs": [
    "axm.creation.form/v1",
    "axm.creation.characterization/v1",
    "axm.creation.archive/v1",
    "axm.creation.language-extension-proposal/v1"
  ],
  "selection": {
    "kind": "quality-diversity-not-single-winner",
    "hardConstraintsFirst": true,
    "dimensionsRemainSeparate": [
      "novelty",
      "coherence",
      "usefulness",
      "play-value",
      "resource-cost",
      "repairability"
    ],
    "preserveUnknownPotential": true,
    "changingNiches": true,
    "candidateMayNotAuthorItsOwnHeldOutExam": true
  },
  "automaticWrites": [
    "browser-local:disposable-creation-incubator",
    "browser-local:novelty-and-diversity-archive"
  ],
  "requiresReview": [
    "canonical-world-promotion",
    "workshop-module-promotion",
    "creation-language-extension",
    "new-tool-authority",
    "external-or-physical-effect"
  ],
  "refuses": [
    "single-scalar-is-truth",
    "winner-takes-all-archive-erasure",
    "candidate-self-certification",
    "silent-canonical-rewrite",
    "claim-of-open-endedness-before-longitudinal-evidence",
    "claim-of-creation-from-nothing"
  ]
}
