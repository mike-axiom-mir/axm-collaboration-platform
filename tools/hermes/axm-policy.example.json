{
  "schema": "axm.hermes-policy/v1",
  "posture": "research",
  "consent": {
    "enabled": false,
    "reason": "off by default"
  },
  "mode": {
    "hub_sandbox": true,
    "external_mode": false
  },
  "provider_egress": {
    "mode": "local_only",
    "allowed_secret_env": [],
    "note": "Credential/environment guard only; this is not network namespace isolation."
  },
  "research_tools": [
    "web_search",
    "web_extract",
    "read_file",
    "search_files",
    "vision_analyze",
    "skills_list",
    "skill_view",
    "session_search",
    "clarify"
  ],
  "allowed_tools": [],
  "limits": {
    "max_tool_calls_per_session": 15,
    "max_files_read_per_session": 20,
    "max_files_written_per_session": 5
  },
  "paths": {
    "read_roots": [
      "../..",
      "runtime/workspace"
    ],
    "write_roots": [
      "runtime/workspace",
      "queue",
      "outbox",
      "run-reports"
    ]
  },
  "capabilities": {
    "allow_terminal": false,
    "allow_execute_code": false,
    "allow_computer_use": false,
    "allow_delegation": false,
    "allow_scheduling": false,
    "allow_messaging": false,
    "allow_memory_mutation": false,
    "allow_skill_mutation": false,
    "allow_browser_interaction": false,
    "allow_external_account_actions": false,
    "allow_home_automation": false,
    "allow_project_changes": false,
    "allow_coordination_mutation": false,
    "allow_generation": false
  },
  "blocked_tools": [],
  "receipts": {
    "enabled": true,
    "redact_arguments": true,
    "redact_results": true,
    "record_provider_metadata": true,
    "record_session_outcome_metadata": true
  },
  "repair": {
    "backup_before_managed_config_change": true,
    "retain_config_backups": 5
  },
  "canon": {
    "hermes_memory_is_canon": false,
    "hermes_skills_are_canon": false,
    "outputs_are_candidates_only": true
  }
}
