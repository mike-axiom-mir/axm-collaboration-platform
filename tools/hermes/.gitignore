# AXM Hermes local/runtime state. Public source contains examples and contracts only.
runtime/
external/
hermes-source.local.json
hermes-settings.local.json
.hermes-consent.json

# Local execution evidence/proposals generated by the runner.
queue/*.json
outbox/*.md
logs/*
run-reports/*

# Preserve placeholder files if the directories later use them.
!queue/.gitkeep
!outbox/.gitkeep
!logs/.gitkeep
!run-reports/.gitkeep
