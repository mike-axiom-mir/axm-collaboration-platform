{
  "schema": "axm.module-contract/v1",
  "id": "aetherfx",
  "version": "v1.3.0-axm.1",
  "provides": [
    "visual-fx.catalog.modular",
    "visual-fx.recipe.guide-and-edit",
    "visual-fx.recipe.raw-validation",
    "visual-fx.recipe.normalization-review",
    "visual-fx.recipe.compile",
    "visual-fx.resolved-intent",
    "visual-fx.target-support-report",
    "visual-fx.package.integrity-review",
    "visual-fx.package.transactional-import",
    "visual-fx.snapshot.complete",
    "visual-fx.repair.bounded",
    "visual-fx.performance-estimate",
    "visual-fx.accessibility-protection",
    "visual-fx.web-render",
    "visual-fx.static-svg-approximation",
    "visual-fx.adapter-handoff",
    "visual-fx.portable-runtime",
    "visual-fx.local-cli"
  ],
  "consumes": [
    "axm.visual-recipe/1",
    "axm.visual-module/1",
    "axm.visual-module-package/1",
    "axm.visual-recipe-package/1",
    "browser-local-storage",
    "browser-file-import:explicit",
    "filesystem:explicit-cli-input-and-output-only",
    "python:standard-library-static-svg-optional"
  ],
  "permissions": [
    "storage",
    "files",
    "export",
    "clipboard-write"
  ],
  "handoffs": {
    "emits": [
      "axm.resolved-visual-intent/1",
      "axm.adapter-support-report/1",
      "axm.runtime-snapshot/1",
      "axm.recipe-inspection/1",
      "text/html",
      "text/css",
      "image/svg+xml",
      "application/json"
    ],
    "accepts": [
      "axm.visual-recipe/1",
      "axm.visual-module/1",
      "axm.visual-module-package/1",
      "axm.visual-recipe-package/1",
      "human:appearance-review",
      "human:sharing-rights-review",
      "target-adapter:explicit"
    ]
  },
  "lifecycle": {
    "state_owner": "mixed",
    "reload": "resume",
    "disconnect": "not-applicable",
    "cleanup": "explicit"
  },
  "boundaries": {
    "writes": [
      "browser-local-storage:recipe-custom-modules-and-snapshots",
      "browser-download:explicit-export-only",
      "system-clipboard:explicit-copy-only",
      "filesystem:explicit-cli-output-only"
    ],
    "refuses": [
      "network-access",
      "package-supplied-executable-code",
      "automatic-host-apply",
      "automatic-existing-visual-owner-rewrite",
      "automatic-visual-approval",
      "silent-normalization",
      "partial-package-import",
      "silent-unsupported-adapter-operation",
      "native-engine-parity-claim",
      "medical-photosensitivity-certification",
      "public-licence-inference",
      "automatic-canon",
      "canon-change"
    ]
  }
}
