{
  "schema": "axm.game-adapter-map/1",
  "engine": "generic",
  "mappings": {
    "light.neon-edge-glow": {
      "intent": "emissive-edge",
      "targets": [
        "ui.material.emission",
        "sprite.outline"
      ],
      "quality": {
        "low": "sprite.outline",
        "high": "ui.material.emission"
      }
    },
    "light.soft-bloom-halo": {
      "intent": "bloom",
      "targets": [
        "postprocess.bloom",
        "ui.halo-sprite"
      ]
    },
    "atmosphere.ambient-field": {
      "intent": "ambient-particles",
      "targets": [
        "particle-system",
        "pooled-sprites"
      ]
    },
    "motion.hover-lift": {
      "intent": "selection-elevation",
      "targets": [
        "ui.transform",
        "ui.animation"
      ]
    }
  },
  "rule": "Adapter must report fallback or approximation rather than silently dropping an operation."
}
