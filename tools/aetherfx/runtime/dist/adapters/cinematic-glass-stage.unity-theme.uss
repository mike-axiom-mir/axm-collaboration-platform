/* AXM AetherFX Unity UI Toolkit starter approximation.
   Visual operations still require an explicit native material/animation adapter. */
:root{--axm-accent:#54ffd2;--axm-accent-2:#63a7ff;--axm-bg:#03100f;}
.axm-surface{background-color:#03100f;border-color:#54ffd2;border-width:1px;border-radius:18px;}
