{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/module-package.schema.json",
  "title": "AXM Visual Module Package",
  "type": "object",
  "required": [
    "schema",
    "packageId",
    "name",
    "version",
    "entryModuleId",
    "modules",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "axm.visual-module-package/1"
    },
    "packageId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "entryModuleId": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "visual-module.schema.json"
      }
    },
    "compatibility": {
      "type": "object"
    },
    "sharing": {
      "type": "object"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$defs": {
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    }
  },
  "additionalProperties": true
}
