{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm://contracts/translation-request/v1",
  "title": "AXM Translation Request",
  "type": "object",
  "required": [
    "request_id",
    "operation",
    "source",
    "target",
    "authority"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "target": {
      "type": "object"
    },
    "authority": {
      "type": "object"
    },
    "constraints": {
      "type": "object"
    },
    "declared_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
