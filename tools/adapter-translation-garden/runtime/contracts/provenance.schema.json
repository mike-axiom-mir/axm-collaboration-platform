{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm://contracts/provenance/v1",
  "type": "object",
  "required": [
    "schema",
    "source_ids",
    "classification",
    "consent_scopes",
    "lineage",
    "released"
  ],
  "properties": {
    "schema": {
      "const": "axm.translation.provenance/v1"
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "secret"
      ]
    },
    "released": {
      "const": false
    }
  },
  "additionalProperties": true
}
