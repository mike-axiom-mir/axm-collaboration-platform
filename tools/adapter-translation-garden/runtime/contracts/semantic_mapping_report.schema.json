  "$id": "axm://contracts/semantic-mapping-report/v1",
  "title": "AXM Semantic Mapping Report",
  "type": "object",
  "required": [
    "schema",
    "ok",
    "mapped",
    "unresolved",
    "loss"
  ],
  "properties": {
    "schema": {
      "const": "axm.translation.semantic-mapping-report/v1"
    },
    "ok": {
      "type": "boolean"
    },
    "mapped": {
      "type": "object"
    },
    "unresolved": {
