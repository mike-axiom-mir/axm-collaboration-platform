{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm://contracts/semantic-value/v1",
  "title": "AXM Semantic Value",
  "type": "object",
  "required": [
    "schema",
    "state"
  ],
  "properties": {
    "schema": {
      "const": "axm.translation.semantic-value/v1"
    },
    "state": {
      "enum": [
        "value",
        "null",
        "missing",
        "defaulted",
        "unknown",
        "unsupported",
        "redacted",
        "empty"
      ]
    },
    "value": {},
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "array"
    }
  }
}
