{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm://contracts/verification-report/v1",
  "title": "AXM Verification Report",
  "type": "object",
  "required": [
    "schema",
    "verdict",
    "results"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "UNPROVEN"
      ]
    },
    "results": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    }
  }
}
