{
  "schema": "axm.module-contract/v1",
  "id": "geographic-market-map",
  "version": "v0.1-polished-review",
  "provides": [
    "geographic-price-normalization",
    "source-bounded-popularity-ranking",
    "diagnostic-market-quality-review",
    "visible-rule-pattern-candidates",
    "human-invalidated-watchlist",
    "market-evidence-export"
  ],
  "consumes": [
    "gate:axm",
    "storage:axm",
    "user-file:csv-json"
  ],
  "permissions": [
    "storage",
    "gate",
    "export"
  ],
  "handoffs": {
    "emits": [
      "axm.geographic-market-evidence/0.2",
      "axm.geographic-market-report/0.2",
      "axm.market-watchlist/0.1"
    ],
    "accepts": [
      "text/csv:axm-market-observation-schema",
      "application/json:axm-geographic-market-evidence"
    ]
  },
  "boundaries": {
    "writes": [
      "browser-local:geographic-market-map",
      "user-download:explicit"
    ],
    "refuses": [
      "auto-buy-or-sell",
      "trade-execution",
      "missing-market-estimation",
      "silent-currency-conversion",
      "source-free-ranking",
      "demo-data-as-real-evidence",
      "quality-score-as-truth",
      "pattern-candidate-as-forecast",
      "watch-entry-without-invalidation",
      "self-promotion-to-working-or-canon",
      "silent-evidence-overwrite"
    ]
  }
}
