{
  "schema": "axm.git-pr-scope-policy/v1",
  "id": "deterministic-pr-checkpoint-v0.1",
  "baseRef": "origin/main",
  "remoteName": "origin",
  "allowedRemoteHosts": ["github.com"],
  "allowedBranchPrefixes": ["codex/"],
  "refusedBranches": ["main", "master"],
  "allowedPrefixes": [
    "shared/deterministic-pr-checkpoint/",
    "tools/deterministic-pr-checkpoint/"
  ],
  "allowedExactPaths": [],
  "requiredPrefixes": [
    "shared/deterministic-pr-checkpoint/",
    "tools/deterministic-pr-checkpoint/"
  ],
  "requiredPaths": [
    "shared/deterministic-pr-checkpoint/checkpoint-core.js",
    "tools/deterministic-pr-checkpoint/manifest.json",
    "tools/deterministic-pr-checkpoint/module.contract.json",
    "tools/deterministic-pr-checkpoint/pr-checkpoint-cli.cmd",
    "tools/deterministic-pr-checkpoint/pr-checkpoint-cli.js",
    "tools/deterministic-pr-checkpoint/selftest.js"
  ],
  "forbiddenPrefixes": ["state/", "logs/"],
  "forbiddenExactPaths": [
    "bridge/bridge-token.txt",
    "bridge/bridge.log",
    "logs/workshop.log"
  ],
  "requiredEvidenceClaims": [
    "focused-selftest",
    "workshop-regression"
  ],
  "allowDeletions": false,
  "allowRenames": false,
  "allowCopies": false,
  "scanSecrets": true,
  "maxFiles": 40,
  "maxChangedBytes": 1048576,
  "maxCommits": 10
}
