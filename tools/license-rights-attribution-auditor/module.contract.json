{
  "schema": "axm.module-contract/v1",
  "id": "license-rights-attribution-auditor",
  "version": "v0.1",
  "status": "EXPERIMENTAL",
  "provides": [
    "bounded-local-proof",
    "visible-limit-inspection",
    "typed-foundation-artifact",
    "independent-evidence-verification"
  ],
  "consumes": [
    "human-direction",
    "bounded-local-fixture",
    "human-review"
  ],
  "permissions": [
    "export"
  ],
  "lifecycle": {
    "state_owner": "browser",
    "reload": "reset",
    "disconnect": "graceful-degrade",
    "cleanup": "automatic"
  },
  "handoffs": {
    "emits": [
      "axm.rights-attribution-audit/v1",
      "axm.p34-release-verification/v1"
    ],
    "accepts": [
      "human:explicit-export",
      "human:review"
    ]
  },
  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [
      "user-download:candidate-receipt-json"
    ],
    "refuses": [
      "automatic-apply",
      "automatic-publish",
      "automatic-git-push",
      "automatic-library-promotion",
      "human-or-legal-approval-by-metric",
      "undeclared-external-runtime-dependency"
    ]
  }
}
