{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.deterministic-receipt/0.2",
  "title": "AXM External Deterministic Receipt v0.2",
  "description": "Hash-bound runner evidence. HMAC proves key possession and payload integrity, not the truth of the measurement.",
  "type": "object",
  "required": [
    "schema_version",
    "challenge_id",
    "submission_id",
    "packet_hash",
    "rubric_hash",
    "submission_content_hash",
    "artifact_set_hash",
    "runner_id",
    "issued_at",
    "results",
    "metadata",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "axm.deterministic-receipt/0.2"
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "packet_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rubric_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "submission_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_set_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runner_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "issued_at": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "result_id",
          "status"
        ],
        "properties": {
          "result_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "ERROR",
              "SKIP"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object"
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "hmac-sha256"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
