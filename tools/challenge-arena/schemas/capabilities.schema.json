      "properties": {
        "automatic_merge": {
          "const": false
        },
        "automatic_human_decision": {
          "const": false
        },
        "candidate_execution_default": {
          "const": false
        },
        "execution_flag_is_a_security_sandbox": {
          "const": false
        },
        "blind_review_guarantees_perfect_anonymity": {
          "const": false
        },
        "hmac_receipt_proves_measurement_truth": {
          "const": false
        },
        "sealed_input_proves_semantic_correctness": {
          "const": false
        },
        "candidate_content_is_reviewer_instruction": {
          "const": false
        },
        "review_safety_signal_is_automatic_penalty": {
          "const": false
        },
        "bounded_execution_is_a_security_sandbox": {
          "const": false
        },
        "seat_failure_is_automatic_candidate_penalty": {
          "const": false
        },
        "budget_overrun_is_automatic_candidate_penalty": {
          "const": false
        }
