{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.challenge-bundle-verification/0.4",
  "title": "AXM Standalone Evidence Bundle Verification v0.4",
  "description": "A no-extraction verification report for an AXM challenge evidence ZIP.",
  "type": "object",
  "required": [
    "schema_version",
    "path",
    "exists",
    "valid",
    "extracted",
    "errors",
    "warnings",
    "limits",
    "authority_boundary",
    "bundle_bytes",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "axm.challenge-bundle-verification/0.4"
    },
    "path": {
      "type": "string"
    },
    "exists": {
      "type": "boolean"
    },
    "valid": {
      "type": "boolean"
    },
    "extracted": {
      "const": false
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_entries",
        "max_entry_bytes",
        "max_total_uncompressed_bytes",
        "max_compression_ratio",
        "max_metadata_json_bytes"
      ],
      "properties": {
        "max_entries": {
          "type": "integer",
          "minimum": 1
        },
        "max_entry_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_uncompressed_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_compression_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_metadata_json_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "authority_boundary": {
      "type": "string",
      "minLength": 1
    },
    "bundle_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "bundle_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_uncompressed_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "challenge_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "challenge_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "arena_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "bundle_manifest_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "integrity_report_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "challenge_tree_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "verified_challenge_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "event_head": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_state_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "origin_integrity_valid": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
