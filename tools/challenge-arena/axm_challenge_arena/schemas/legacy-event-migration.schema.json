{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.challenge-legacy-event-migration/0.4",
  "title": "AXM Resumable Legacy Event Migration Marker v0.4",
  "description": "Binds an exact JSONL event projection while canonical event files are being created. It authorizes resumption only, never event invention or rewriting.",
  "type": "object",
  "required": [
    "schema_version",
    "challenge_id",
    "projection_sha256",
    "event_count",
    "event_hashes",
    "created_at",
    "authority_note"
  ],
  "properties": {
    "schema_version": {
      "const": "axm.challenge-legacy-event-migration/0.4"
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "projection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_count": {
      "type": "integer",
      "minimum": 1
    },
    "event_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "authority_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
