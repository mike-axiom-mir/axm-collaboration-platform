{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-recipe/v1",
  "title": "AXM Code Recipe",
  "type": "object",
  "required": ["id", "title", "snippet", "description", "primaryLanguage", "tags", "sourceUrl", "popularityIndicator", "popularityScope", "rankingBasis", "familyKey", "familyKeySource", "reviewState", "holdReasons"],
  "properties": {
    "id": {"type": "string", "pattern": "^recipe-[a-f0-9]{16}$"},
    "rank": {"type": ["integer", "null"], "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "snippet": {"type": "string", "minLength": 1, "maxLength": 4000},
    "description": {"type": "string", "minLength": 1, "maxLength": 600},
    "primaryLanguage": {"type": "string", "minLength": 1, "maxLength": 80},
    "domain": {"type": ["string", "null"], "maxLength": 80},
    "tags": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 60}, "uniqueItems": true},
    "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "popularityIndicator": {"type": "string", "minLength": 1, "maxLength": 240},
    "popularityScope": {"enum": ["snippet", "repository", "ecosystem", "source", "not-measured", "unknown"]},
    "rankingBasis": {"enum": ["DECLARED_POPULARITY_CONTEXT", "EDITORIAL_NOT_POPULARITY_MEASURED"]},
    "familyKey": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$", "maxLength": 120},
    "familyKeySource": {"enum": ["DECLARED", "DERIVED_TITLE", "DERIVED_CATEGORY_TITLE"]},
    "reviewState": {"enum": ["SOURCE_REVIEW_REQUIRED", "STRUCTURE_HOLD", "STRUCTURE_VALIDATED"]},
    "holdReasons": {"type": "array", "maxItems": 20, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}, "uniqueItems": true},
    "sourceId": {"type": ["string", "null"], "maxLength": 120},
    "categoryRank": {"type": ["integer", "null"], "minimum": 1},
    "notesSafety": {"type": ["string", "null"], "maxLength": 1200},
    "difficulty": {"type": ["string", "null"], "maxLength": 80},
    "platform": {"type": ["string", "null"], "maxLength": 160},
    "versionBasis": {"type": ["string", "null"], "maxLength": 240},
    "researchDate": {"type": ["string", "null"], "maxLength": 40},
    "verification": {"type": ["string", "null"], "maxLength": 600}
  },
  "additionalProperties": false
}
