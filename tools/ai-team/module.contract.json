{
  "schema": "axm.module-contract/v1",
  "id": "ai-team",
  "version": "v1.5",
  "provides": [
    "multi-model-collaboration-room",
    "agent-task-and-handoff-views",
    "agent-identity-and-memory-controls",
    "prompt-workshop",
    "model-evaluation-view",
    "reasoning-proposal-view",
    "collaboration-attention-inbox",
    "connector-status-and-control-dashboard",
    "shell-guardian-dashboard"
    ,"agent-tool-and-skill-forge-view"
    ,"versioned-prompt-comparison-handoff"
    ,"local-dataset-label-ledger"
    ,"training-run-evidence-ledger"
    ,"opt-in-identity-exploration-garden"
    ,"evidenced-creative-proposal-discussion"
    ,"shared-specialist-mask-library"
    ,"attributed-specialist-checkout"
    ,"ai-native-specialist-package"
    ,"capability-bridge-skill-plan"
    ,"specialist-specific-result-schema"
    ,"recommendation-only-specialist-router"
  ],
  "consumes": [
    "service:agent-command-center",
    "service:ai-task-talk",
    "service:model-lab",
    "service:reasoning-shell",
    "service:prompt-vault",
    "service:duo-test",
    "service:discovery-role-packs",
    "service:agent-tool-forge",
    "service:shell-guardian",
    "workshop:presence-notices",
    "workshop:connector-status"
  ],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.collaboration-review/v1", "axm.model-comparison-review/v1", "axm.exploration-proposal/v1", "axm.specialist-result/v1"],
    "accepts": ["axm.collaboration-notice/v1", "axm.ai-team-prompt/v1", "axm.specialist-checkout/v1", "hub:init", "hub:settings:value"]
  },
  "boundaries": {
    "writes": ["browser-local:ai-team-workspace", "browser-local:dataset-and-training-ledger", "local-service:exploration-garden", "local-service:specialist-checkouts", "workshop:notice-acknowledgement", "bridge:local-agent-pause"],
    "refuses": ["automatic-specialist-checkout", "automatic-skill-activation", "automatic-agent-start-from-recommendation", "hidden-screen-capture", "capability-bridge-as-permission-bypass", "specialist-as-identity-replacement", "specialist-permission-escalation", "specialist-as-independent-review", "silent-notice-approval", "automatic-wisdom-promotion", "automatic-exploration-installation", "connector-memory-merging", "automatic-guardian-reset", "connector-credential-access", "unbounded-agent-autonomy"]
  }
}
