{
  "schema": "axm.module-contract/v1",
  "id": "learning-lab",
  "version": "v0.1",
  "provides": [
    "categorized-local-academy-catalog",
    "validated-data-driven-academy-source-registry",
    "generic-module-contract-to-human-lesson-adapter",
    "validated-data-driven-academy-learning-paths",
    "non-enrolling-next-lesson-guidance",
    "revision-aware-current-and-historical-path-progress",
    "deterministic-organ-data-to-human-lesson",
    "source-boundary-provenance-preserving-curriculum",
    "semantic-lesson-fingerprint-and-immutable-editions",
    "compiler-recipe-and-generated-steps-bound-editions",
    "strict-privacy-safe-single-lesson-inheritance",
    "preview-first-human-admission-for-inherited-lessons",
    "explicit-attributed-academy-start-and-resume",
    "learner-visible-evidence-recap-and-targeted-repair",
    "single-guided-learning-workspace",
    "portable-learning-project",
    "attributed-human-ai-machine-learners",
    "interactive-lessons-and-flashcards",
    "evidence-bearing-assessments",
    "deterministic-simulation-labs",
    "time-limited-network-blocked-code-practice",
    "local-virtual-classroom",
    "private-or-shared-lab-notebook",
    "draft-course-authoring",
    "explicit-ai-learning-forge-door"
  ],
  "consumes": [
    "service:shared-engines/project-v1",
    "service:shared-engines/collaboration-v1",
    "service:shared-engines/evidence-v1",
    "workspace:project-room",
    "workspace:knowledge-canvas",
    "workspace:game-forge",
    "workspace:ai-team",
    "child:mirror-learning-shell",
    "service:mirror-learning-forge"
  ],
  "permissions": ["storage", "export", "shared-engines"],
  "handoffs": {
    "emits": ["axm.academy.source-lesson/v1", "axm.academy.inheritance-packet/v1", "axm.learning-lab.project/v1", "axm.learning-lab.assessment/v1", "axm.learning-lab.simulation-result/v1", "axm.learning-lab.code-run/v1", "axm.ai-learning.session-proposal/v1"],
    "accepts": ["hub:init", "hub:settings:value", "user-file:axm.learning-lab.project/v1", "user-file:axm.academy.inheritance-packet/v1", "axm.ai-learning.curriculum/v1"]
  },
  "integratedChildren": [
    { "id": "mirror-learning-shell", "role": "machine-native-school-door", "separation": ["identity", "memory", "learner-state", "promotion", "authority"] }
  ],
  "adapterSlots": [
    "academy:local-source-inspector",
    "classroom:networked-presence",
    "assessment:external-question-bank",
    "lab:domain-simulation-adapter",
    "code:language-runtime-adapter",
    "school:additional-attributed-learner-adapter"
  ],
  "boundaries": {
    "writes": ["browser-local:axm.learning-lab.project.v1", "user-download:explicit", "learner-private:only-through-child-school-contract"],
    "refuses": [
      "automatic-enrollment",
      "forced-study",
      "unattributed-learner",
      "identity-or-memory-merge",
      "authority-from-grade",
      "source-free-lesson-claims",
      "automatic-source-quality-promotion",
      "automatic-academy-lesson-publication",
      "silent-installed-lesson-rewrite",
      "silent-compiler-recipe-or-generated-step-rewrite",
      "learner-or-session-state-in-lesson-inheritance",
      "trusted-imported-progress-or-authority",
      "automatic-consent-resume-from-project-import",
      "imported-code-run-as-sandbox-proof",
      "automatic-enrollment-from-lesson-inheritance",
      "lesson-inheritance-without-human-review",
      "automatic-enrollment-from-learning-path",
      "mandatory-curriculum-order",
      "mastery-or-authority-from-path-progress",
      "silent-current-completion-from-historical-edition",
      "automatic-wisdom-or-canon-promotion",
      "hidden-chain-of-thought-capture",
      "completion-without-visible-step-evidence",
      "destructive-repair-overwrite-of-prior-attempts",
      "unsandboxed-user-code",
      "external-network-from-code-sandbox",
      "automatic-publication",
      "pretend-networked-classroom",
      "pretend-domain-simulation"
    ]
  },
  "lifecycle": {"state_owner": "browser", "reload": "resume", "disconnect": "graceful-degrade", "cleanup": "explicit"}
}
