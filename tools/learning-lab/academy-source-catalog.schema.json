{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.academy.source-catalog.schema.json",
  "title": "AXM Academy Source Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "sources"],
  "properties": {
    "schema": { "const": "axm.academy.source-catalog/v1" },
    "version": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "adapter", "organ", "title", "level", "path", "summary", "boundary", "tool"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
        "category": { "enum": ["visual-language", "organ-building", "living-systems", "evidence-stewardship"] },
        "adapter": { "enum": ["preskins", "molds", "aetherglass", "planet", "lineage", "module-contract"] },
        "organ": { "type": "string", "minLength": 2, "maxLength": 120 },
        "title": { "type": "string", "minLength": 3, "maxLength": 140 },
        "level": { "type": "string", "minLength": 3, "maxLength": 40 },
        "path": { "type": "string", "pattern": "^(?:\\.\\.?/)+(?:shared|worlds|tools|learning-lab|design-lineage-lab)[^:?#[\\]\\\\]*\\.json$", "maxLength": 260 },
        "summary": { "type": "string", "minLength": 40, "maxLength": 500 },
        "boundary": { "type": "string", "minLength": 40, "maxLength": 600 },
        "tool": { "type": "string", "pattern": "^\\.\\.?/", "maxLength": 260 }
      }
    }
  }
}
