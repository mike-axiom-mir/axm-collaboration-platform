      "automatic-asset-promotion",
      "automatic-canonization",
      "technical-pass-as-human-approval",
      "browser-transport-as-physical-audibility-proof",
      "implicit-output-device-identification",
      "unallowlisted-source-mutation",
      "network-listen-beyond-loopback",
      "filesystem-write-through-host-bridge"
    ]
  },
  "known_gaps": [
    { "id": "EVIDENCE-PHYSICAL-AUDIBILITY-001", "type": "EVIDENCE", "status": "HUMAN_REQUIRED" },
    { "id": "EVIDENCE-OUTPUT-DEVICE-001", "type": "EVIDENCE", "status": "UNKNOWN" },
    { "id": "EVIDENCE-AUDIO-ACCESSIBILITY-001", "type": "EVIDENCE", "status": "UNKNOWN" },
    { "id": "EVIDENCE-AUDIO-AESTHETIC-001", "type": "EVIDENCE", "status": "HUMAN_REQUIRED" }
  ],
  "authority": { "installed": false, "promoted": false, "canonical": false }
}
