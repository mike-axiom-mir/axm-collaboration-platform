{
  "schema": "axm.module-contract/v1",
  "id": "asset-audio-sensory-workbench",
  "version": "0.1.0",
  "provides": [
    "asset.audio.waveform.inspect",
    "asset.audio.playback.user-gesture",
    "asset.audio.edit.host-bridged",
    "asset.listener-state.digest",
    "asset.audio-review.receipt.nonpromoting"
  ],
  "consumes": [
    "axm.asset-hand-result/v1",
    "axm.deterministic-audio-recipe/v1",
    "axm.deterministic-audio-analysis/v1",
    "axm.deterministic-audio-verification/v1"
  ],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.asset-audio-sensory-machine-patch/v1", "axm.asset-human-audio-sensory-review-receipt/v1"],
    "accepts": ["axm.asset-hand-result/v1", "axm.deterministic-audio-recipe/v1"]
  },
  "lifecycle": {
    "state_owner": "browser",
    "reload": "reset",
    "disconnect": "graceful-degrade",
