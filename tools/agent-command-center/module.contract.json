      "browser-local:axm-identity-registry",
      "browser-local:legacy-identity-migration-marker"
    ],
    "refuses": [
      "hidden-identity-switch",
      "cross-identity-private-memory-merge",
      "shared-wisdom-without-explicit-choice",
      "automatic-wisdom-promotion",
      "connector-or-model-lock-bypass",
      "cloud-or-local-connector-fallback",
      "mirror-ask-through-generic-connector",
      "keel-ask-through-generic-connector",
      "keel-axiom-mir-identity-conflation",
      "hidden-connector-token-access",
      "automatic-agent-run",
      "permission-expansion",
      "promotion-authority",
      "canon-authority"
    ]
  }
}
