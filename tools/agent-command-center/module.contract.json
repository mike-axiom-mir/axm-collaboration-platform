{
  "schema": "axm.module-contract/v1",
  "id": "agent-command-center",
  "version": "v0.5",
  "provides": [
    "supervised-identity-registry",
    "connector-and-model-bound-identity-routing",
    "identity-separated-private-wisdom",
    "explicit-shared-wisdom",
    "optional-default-identity-selection",
    "local-connector-readiness-view",
    "consent-aware-identity-task-routing",
    "external-codex-workspace-manager-identity"
  ],
  "consumes": [
    "service:local-model-bridge",
    "service:mirror-native-status",
    "service:chatgpt-connector-status",
    "identity:keel",
    "identity:nova",
    "identity:axiom-mir",
    "identity:gemini-local",
    "identity:mirror",
    "workshop:storage-wisdom-identity-gate-foundation"
  ],
  "permissions": [],
  "handoffs": {
    "emits": [
      "plain-text:identity-grounded-context",
      "browser-local:evidence-backed-identity-wisdom-entry"
    ],
    "accepts": [
      "hub:init",
      "plain-text:attributed-task",
      "browser-local:legacy-identity-wisdom"
    ]
  },
  "lifecycle": {
    "state_owner": "browser",
    "reload": "resume",
    "disconnect": "graceful-degrade",
    "cleanup": "explicit"
  },
  "boundaries": {
