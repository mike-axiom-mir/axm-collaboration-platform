{
  "schema": "axm.module-contract/v1",
  "id": "human-control-binding-observatory",
  "version": "v0.1",
  "provides": [
    "graph-hash-bound-source-reading",
    "entry-human-control-text-pattern-inventory",
    "static-selector-inline-and-native-binding-evidence",
    "name-hidden-disabled-and-duplicate-id-observations",
    "single-module-question-only-control-review-request"
  ],
  "consumes": ["filesystem/workshop-root", "axm.entry-resource-graph/v1"],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.human-control-binding-map/v1", "axm.human-control-binding-review-request/v1"],
    "accepts": ["filesystem/workshop-root", "axm.entry-resource-graph/v1"]
  },
  "boundaries": {
    "writes": ["explicit-user-selected-output-only"],
    "refuses": [
      "complete-html-parsing",
      "complete-javascript-parsing",
      "browser-loading",
      "dom-construction",
      "control-clicking",
      "runtime-interaction-proof",
      "accessibility-adequacy-proof",
      "route-behavior-proof",
      "visual-quality-approval",
      "automatic-binding",
      "automatic-element-removal",
      "permission-grant",
      "source-mutation",
      "filesystem-symlink-following",
      "installer-staging",
      "installation",
      "promotion",
      "canon-change"
    ]
  },
  "lifecycle": {
    "state_owner": "none",
    "reload": "reset",
    "disconnect": "not-applicable",
    "cleanup": "not-applicable"
  }
}
