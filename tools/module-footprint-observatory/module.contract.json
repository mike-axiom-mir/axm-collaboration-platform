{
  "schema": "axm.module-contract/v1",
  "id": "module-footprint-observatory",
  "version": "v0.2",
  "provides": [
    "per-module-active-file-count",
    "per-module-active-byte-count",
    "largest-observed-module-file",
    "per-module-extension-footprint",
    "excluded-directory-and-symlink-evidence",
    "freshness-bound-footprint-observation",
    "multi-root-storage-pressure-observation",
    "same-size-sha256-exact-duplicate-observation",
    "protected-by-default-operational-retention-classification",
    "directory-fanout-observation",
    "cluster-rounded-allocation-estimate",
    "separately-timed-storage-snapshot-delta"
  ],
  "consumes": [
    "filesystem/workshop-root",
    "filesystem/mirror-root"
  ],
  "permissions": [],
  "handoffs": {
    "emits": [
      "axm.module-footprint-map/v1",
      "axm.storage-pressure-map/v1"
    ],
    "accepts": [
      "filesystem/workshop-root",
      "filesystem/mirror-root"
    ]
  },
  "boundaries": {
    "writes": [
      "explicit-user-selected-output-only"
    ],
    "refuses": [
      "symlink-following",
      "quality-from-size",
      "complexity-from-size",
      "performance-from-size",
      "readiness-from-size",
      "size-budget-enforcement",
      "semantic-importance-from-path",
      "duplicate-disposability-inference",
      "deletion-target-selection",
      "file-deletion",
      "hardlinking",
      "unreviewed-retention-action",
      "compression",
      "packaging",
      "source-mutation",
      "installer-staging",
      "installation",
      "permission-change",
      "promotion",
      "canon-change"
    ]
  },
  "lifecycle": {
    "state_owner": "none",
    "reload": "reset",
    "disconnect": "not-applicable",
    "cleanup": "not-applicable"
  }
}
