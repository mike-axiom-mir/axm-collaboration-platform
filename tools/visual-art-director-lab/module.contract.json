{
  "schema": "axm.module-contract/v1",
  "id": "visual-art-director-lab",
  "version": "v0.1",
  "status": "EXPERIMENTAL",
  "provides": [
    "bounded-local-scenario",
    "visible-outcome-inspection",
    "typed-experience-artifact",
    "independent-evidence-verification"
  ],
  "consumes": [
    "human-direction",
    "bounded-local-fixture",
    "human-review"
  ],
  "permissions": [
    "export"
  ],
  "lifecycle": {
    "state_owner": "browser",
    "reload": "reset",
    "disconnect": "graceful-degrade",
    "cleanup": "automatic"
  },
  "handoffs": {
    "emits": [
      "axm.visual-direction-review/v1",
      "axm.p2-experience-verification/v1"
    ],
    "accepts": [
      "human:explicit-export",
      "human:review"
    ]
  },
  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [
      "user-download:candidate-receipt-json"
    ],
    "refuses": [
      "automatic-library-promotion",
      "automatic-apply",
      "durable-world-state-ownership",
      "human-approval-by-metric",
      "undeclared-external-runtime-dependency",
      "raw-private-session-retention"
    ]
  }
}
