{
  "schema": "axm.module-contract/v1",
  "id": "runtime-channel-observatory",
  "version": "v0.1",
  "provides": [
    "graph-hash-bound-source-reading",
    "runtime-channel-text-pattern-inventory",
    "literal-and-same-file-constant-channel-name-resolution",
    "static-channel-pairing-and-review-seams",
    "single-channel-question-only-review-request"
  ],
  "consumes": ["filesystem/workshop-root", "axm.entry-resource-graph/v1"],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.runtime-channel-map/v1", "axm.runtime-channel-review-request/v1"],
    "accepts": ["filesystem/workshop-root", "axm.entry-resource-graph/v1"]
  },
  "boundaries": {
    "writes": ["explicit-user-selected-output-only"],
    "refuses": [
      "complete-javascript-parsing",
      "browser-loading",
      "script-execution",
      "channel-opening",
      "socket-opening",
      "event-stream-opening",
      "message-sending",
      "event-dispatch",
      "delivery-proof",
      "payload-reading",
      "protocol-compatibility-proof",
      "automatic-protocol-change",
      "permission-grant",
      "source-mutation",
      "filesystem-symlink-following",
      "installer-staging",
      "installation",
      "promotion",
      "canon-change"
    ]
  },
  "lifecycle": {
    "state_owner": "none",
    "reload": "reset",
    "disconnect": "not-applicable",
    "cleanup": "not-applicable"
  }
}
