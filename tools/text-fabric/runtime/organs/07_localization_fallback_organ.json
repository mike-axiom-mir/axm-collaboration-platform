{
  "id": "axm.text.organ.localization_fallback_organ",
  "version": "0.1.0",
  "status": "WORKING",
  "purpose": "Protects shaping, fallback fonts, expansion, direction, and script coverage.",
  "capabilities": [
    "fallback chain",
    "RTL/LTR",
    "pseudo-localization",
    "missing glyph warning",
    "expansion reserve"
  ],
  "inputs": [
    "text_request",
    "role_tokens",
    "recipe",
    "platform_profile"
  ],
  "outputs": [
    "resolved_text_plan",
    "decision_trace",
    "warnings"
  ],
  "replaceable": true,
  "rollback_safe": true
}
