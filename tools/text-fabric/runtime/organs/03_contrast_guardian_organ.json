  "status": "WORKING",
  "purpose": "Measures contrast and adds protective layers when the background is unsafe or dynamic.",
  "capabilities": [
    "WCAG contrast math",
    "large/normal thresholds",
    "scrim recommendation",
    "outline fallback"
