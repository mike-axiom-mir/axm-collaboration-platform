{
  "id": "axm.text.organ.qa_regression_organ",
  "version": "0.1.0",
  "status": "WORKING",
  "purpose": "Defines stress tests for scale, backgrounds, localization, and screenshot drift.",
  "capabilities": [
    "small screen",
    "TV distance",
    "200 percent scale",
    "worst background",
    "RTL",
    "long strings"
  ],
  "inputs": [
    "text_request",
    "role_tokens",
    "recipe",
    "platform_profile"
  ],
  "outputs": [
    "resolved_text_plan",
    "decision_trace",
    "warnings"
  ],
  "replaceable": true,
  "rollback_safe": true
}
