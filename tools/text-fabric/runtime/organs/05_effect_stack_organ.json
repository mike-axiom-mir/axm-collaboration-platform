{
  "id": "axm.text.organ.effect_stack_organ",
  "version": "0.1.0",
  "status": "WORKING",
  "purpose": "Builds effects in ordered layers so decoration never destroys the glyph core.",
  "capabilities": [
    "fill",
    "inner highlight",
    "outline",
    "near shadow",
    "far shadow",
    "glow",
    "texture"
  ],
  "inputs": [
    "text_request",
    "role_tokens",
    "recipe",
    "platform_profile"
  ],
  "outputs": [
    "resolved_text_plan",
    "decision_trace",
    "warnings"
  ],
  "replaceable": true,
  "rollback_safe": true
}
