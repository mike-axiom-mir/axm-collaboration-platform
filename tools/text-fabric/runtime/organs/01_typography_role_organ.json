{
  "id": "axm.text.organ.typography_role_organ",
  "version": "0.1.0",
  "status": "WORKING",
  "purpose": "Assigns semantic roles and stable hierarchy tokens instead of one-off text styling.",
  "capabilities": [
    "role lookup",
    "size range",
    "weight",
    "line height",
    "tracking",
    "measure"
  ],
  "inputs": [
    "text_request",
    "role_tokens",
    "recipe",
    "platform_profile"
  ],
  "outputs": [
    "resolved_text_plan",
    "decision_trace",
    "warnings"
  ],
  "replaceable": true,
  "rollback_safe": true
}
