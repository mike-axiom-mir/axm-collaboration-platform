{
  "id": "axm.text.organ.platform_adapter_router_organ",
  "version": "0.1.0",
  "status": "WORKING",
  "purpose": "Maps one resolved text plan into platform-specific implementation hints.",
  "capabilities": [
    "web CSS",
    "Unity TMP",
    "Unreal Slate/UMG",
    "Godot Label",
    "native mobile",
    "desktop"
  ],
  "inputs": [
    "text_request",
    "role_tokens",
    "recipe",
    "platform_profile"
  ],
  "outputs": [
    "resolved_text_plan",
    "decision_trace",
    "warnings"
  ],
  "replaceable": true,
  "rollback_safe": true
}
