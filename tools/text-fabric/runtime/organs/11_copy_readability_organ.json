{
  "id": "axm.text.organ.copy_readability_organ",
  "version": "0.1.0",
  "status": "WORKING",
  "purpose": "Checks casing, length, density, labels, and concise action wording.",
  "capabilities": [
    "line length",
    "all-caps warning",
    "label length",
    "sentence density",
    "verb-first actions"
  ],
  "inputs": [
    "text_request",
    "role_tokens",
    "recipe",
    "platform_profile"
  ],
  "outputs": [
    "resolved_text_plan",
    "decision_trace",
    "warnings"
  ],
  "replaceable": true,
  "rollback_safe": true
}
