{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/font_audit.schema.json",
  "title": "AXM Font Audit",
  "type": "object",
  "required": [
    "font",
    "coverage_ratio",
    "complete",
    "missing",
    "warnings"
  ],
  "properties": {
    "font": {
      "type": "object"
    },
    "coverage_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "complete": {
      "type": "boolean"
    },
    "missing": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
