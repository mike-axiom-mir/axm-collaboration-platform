{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/layout_audit.schema.json",
  "title": "AXM Layout Audit",
  "type": "object",
  "required": [
    "status",
    "role",
    "platform",
    "scenarios",
    "warnings"
  ],
  "properties": {
    "status": {
      "enum": [
        "pass",
        "warning",
        "critical"
      ]
    },
    "role": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "scenarios": {
      "type": "object"
    },
    "warnings": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
