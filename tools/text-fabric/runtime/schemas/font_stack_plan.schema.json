{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/font_stack_plan.schema.json",
  "title": "AXM Font Stack Plan",
  "type": "object",
  "required": [
    "id",
    "version",
    "complete",
    "font_stack",
    "missing"
  ],
  "properties": {
    "id": {
      "const": "axm.text.font_stack_plan"
    },
    "version": {
      "type": "string"
    },
    "complete": {
      "type": "boolean"
    },
    "font_stack": {
      "type": "array"
    },
    "missing": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
