{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/font_registry.schema.json",
  "title": "AXM Font Registry",
  "type": "object",
  "required": [
    "id",
    "version",
    "font_count",
    "fonts",
    "errors"
  ],
  "properties": {
    "id": {
      "const": "axm.text.font_registry"
    },
    "version": {
      "type": "string"
    },
    "font_count": {
      "type": "integer",
      "minimum": 0
    },
    "fonts": {
      "type": "array"
    },
    "errors": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
