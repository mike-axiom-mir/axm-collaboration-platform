{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AXM Portable Static Asset Manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "target_id",
    "svg",
    "sha256",
    "font_policy"
  ],
  "properties": {
    "id": {
      "const": "axm.text.portable_asset"
    },
    "version": {
      "type": "string"
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "svg": {
      "type": "string",
      "pattern": "\\.svg$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "font_policy": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
