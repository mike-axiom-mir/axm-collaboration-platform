{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AXM Text Compiled Library Manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "preset_count",
    "presets",
    "files"
  ],
  "properties": {
    "id": {
      "const": "axm.text.compiled_library"
    },
    "version": {
      "type": "string"
    },
    "preset_count": {
      "type": "integer",
      "minimum": 1
    },
    "presets": {
      "type": "array"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
