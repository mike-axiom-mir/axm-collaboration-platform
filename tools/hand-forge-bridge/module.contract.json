{
  "schema": "axm.module-contract/v1",
  "id": "hand-forge-bridge",
  "version": "v0.1",
  "provides": [
    "capability.adapt.hand-specification-to-forge/v1",
    "hand-specification-forge-draft-mapping",
    "verification-plan-source-binding",
    "forge-package-provenance-enrichment",
    "hand-package-explicit-review-export"
  ],
  "consumes": [
    "axm.missing-hand-specification/v1",
    "axm.hand-verification-plan/v1",
    "agent-tool-forge:forge-core/v0.2",
    "agent-tool-forge:zip-store"
  ],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.hand-forge-bridge-result/v1", "axm.forge-draft/v1", "axm.forge-package/v1", "axm.hand-forge-bridge-receipt/v1", "application/zip"],
    "accepts": ["axm.missing-hand-specification/v1", "axm.hand-verification-plan/v1", "application/json"]
  },
  "boundaries": {
    "writes": ["browser:explicit-json-download", "browser:explicit-zip-download"],
    "refuses": [
      "unbound-specification-and-plan",
      "foundation-source-implicit-copy",
      "automatic-install",
      "source-overwrite",
      "generated-code-execution",
      "automatic-permission-grant",
      "automatic-apply",
      "automatic-promotion",
      "automatic-release",
      "automatic-canon",
      "network-access",
      "persistent-storage"
    ]
  },
  "lifecycle": {
    "state_owner": "browser",
    "reload": "reset",
    "disconnect": "not-applicable",
    "cleanup": "automatic"
  }
}
