{
  "schema": "axm.module-contract/v1",
  "id": "technical-glasses",
  "version": "v0.2",
  "provides": [
    "live-machine-readable-technical-ground-truth",
    "task-focused-ai-briefing",
    "source-fingerprint-and-freshness",
    "module-contract-and-readiness-summary",
    "prioritized-open-technical-seams",
    "shared-human-machine-technical-hud",
    "offline-live-compiler"
  ],
  "consumes": [
    "workshop:tool-manifests",
    "workshop:module-contracts",
    "axm.tools-index/v1",
    "axm.workshop-readiness-view/v1",
    "axm.tool-selftest-results/v1",
    "workshop:capability-index",
    "workshop:live-readiness",
    "workshop:body-pulse-state",
    "workshop:source-metadata",
    "workshop:test-declarations"
  ],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.technical-glasses/v1", "text/plain/ai-technical-briefing"],
    "accepts": ["plain-text/task-focus", "axm.technical-focus/v1", "hub:init", "hub:settings:value"]
  },
  "lifecycle": {
    "state_owner": "service",
    "reload": "resume",
    "disconnect": "graceful-degrade",
    "cleanup": "automatic"
  },
  "boundaries": {
    "writes": ["state/technical-glasses/latest.json:derived-portability-snapshot"],
    "refuses": [
      "chat-memory-as-technical-authority",
      "readme-as-technical-authority",
      "guessing-missing-state",
      "hidden-reasoning-capture",
      "automatic-repair",
      "automatic-module-open",
      "permission-change",
      "canon-or-wisdom-promotion",
      "review-readiness-as-approval",
      "review-readiness-as-promotion",
      "structural-scan-as-runtime-proof",
      "stale-readiness-as-current",
      "stale-snapshot-as-current-truth"
    ]
  }
}
