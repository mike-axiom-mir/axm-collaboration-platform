{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.disposable-candidate-repair-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sessionId", "baseIterationId", "baseIterationDigest", "findings", "changes", "authority", "planDigest"],
  "properties": {
    "schema": {"const": "axm.disposable-candidate-repair-plan/v1"},
    "sessionId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "baseIterationId": {"type": "string", "pattern": "^iteration-[0-9]{3}$"},
    "baseIterationDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "findings": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,79}$"}},
    "changes": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "expectedSha256", "replacementEncoding", "replacementContent", "replacementSha256", "byteLength"],
        "properties": {
          "path": {"enum": ["README.md", "game-forge-project.json", "game.config.json", "game.js", "index.html", "styles.css", "test-plan.json"]},
          "expectedSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "replacementEncoding": {"const": "base64"},
          "replacementContent": {"type": "string", "minLength": 1},
          "replacementSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "byteLength": {"type": "integer", "minimum": 1, "maximum": 262144}
        }
      }
    },
    "authority": {"const": "NONE"},
    "planDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
