{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "axm.workshop-contract-repair-draft-receipt/v1",
  "title": "AXM Workshop Contract Repair Draft Receipt v1",
  "type": "object",
  "additionalProperties": false,
