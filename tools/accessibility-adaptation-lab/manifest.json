{
  "schema": "axm.tool-manifest/v1",
  "kind": "product",
  "id": "accessibility-adaptation-lab",
  "name": "AXM Accessibility Adaptation Lab",
  "version": "v0.1",
  "status": "TEST",
  "entry": "index.html",
  "contract": "module.contract.json",
  "type": "local-module",
  "hubApiVersion": "1.0",
  "category": "ACCESSIBILITY",
  "layer": "experience",
  "audience": "human-machine",
  "risk": "MEDIUM",
  "tags": ["accessibility", "adaptive-interface", "keyboard", "vision", "cognitive", "media", "local-first"],
  "uses": ["filesystem-read", "storage", "browser-dom"],
  "permissions": ["storage"],
  "actions": [
    "browse one hundred curated accessibility packets",
    "rank packets against explicit user goals",
    "preview six local display preferences",
    "prepare a non-canonical adaptation plan"
  ],
  "accepts": ["axm.accessibility-adaptation-request/v1", "application/json"],
  "produces": ["axm.accessibility-adaptation-catalog/v1", "axm.accessibility-adaptation-plan/v1"],
  "readiness": ["local-browser", "reviewed-disabled-packets"],
  "summary": "A searchable 100-packet accessibility catalog with explicit goal planning and a tool-local adaptive-interface preview.",
  "notes": "No diagnosis, global apply, production, compatibility, accessibility-effect, or conformance authority."
}
