{
  "schema": "axm.module-contract/v1",
  "id": "publish-library",
  "version": "v1.0",
  "provides": [
    "single-publish-library-workspace",
    "shared-asset-library-view",
    "asset-pack-and-template-view",
    "versioned-artifact-inbox",
    "reviewed-release-ledger",
    "verified-workshop-packaging-view",
    "launcher-distribution-proposal-view"
  ],
  "consumes": [
    "service:asset-vault",
    "service:asset-pack-lab",
    "service:workshop-packager",
    "service:launcher-card-installer"
  ],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.release-manifest/v1"],
    "accepts": ["axm.publish-artifact/v1", "hub:init", "hub:settings:value"]
  },
  "boundaries": {
    "writes": [
      "browser-local:artifact-inbox",
      "browser-local:release-ledger",
      "user-download:explicit-release-manifest"
    ],
    "refuses": [
      "automatic-artifact-approval",
      "pretend-format-conversion",
      "automatic-release-evidence-acceptance",
      "public-package-after-secret-scan-failure",
      "automatic-launcher-installation",
      "marketplace-publication"
    ]
  }
}
