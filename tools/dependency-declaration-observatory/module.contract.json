{
  "schema": "axm.module-contract/v1",
  "id": "dependency-declaration-observatory",
  "version": "v0.2",
  "provides": [
    "exact-module-dependency-topology",
    "declared-cycle-observation",
    "single-cycle-human-review-packet",
    "explicit-target-top-level-module-presence-observation",
    "generic-dependency-token-inventory",
    "freshness-bound-dependency-observation"
  ],
  "consumes": [
    "filesystem/workshop-root"
  ],
  "permissions": [],
  "handoffs": {
    "emits": [
      "axm.dependency-declaration-map/v1",
      "axm.dependency-cycle-review-packet/v1"
    ],
    "accepts": [
      "filesystem/workshop-root"
    ]
  },
  "boundaries": {
    "writes": [
      "explicit-user-selected-output-only"
    ],
    "refuses": [
      "capability-token-semantic-inference",
      "dependency-version-resolution",
      "activation-order-selection",
      "cycle-defect-inference",
      "edge-removal-recommendation",
      "readiness-proof",
      "provider-substitution",
      "network-download",
      "dependency-installation",
      "declaration-repair",
      "source-mutation",
      "filesystem-symlink-following",
      "installer-staging",
      "permission-change",
      "promotion",
      "canon-change"
    ]
  },
  "lifecycle": {
    "state_owner": "none",
    "reload": "reset",
    "disconnect": "not-applicable",
    "cleanup": "not-applicable"
  }
}
