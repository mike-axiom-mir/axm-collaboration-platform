{
  "schema": "axm.module-contract/v1",
  "id": "film-motion-studio",
  "version": "v1.0",
  "provides": [
    "single-film-and-motion-workspace",
    "frame-accurate-non-destructive-edit-document",
    "layered-2d-cutout-stop-motion-scenes",
    "editable-procedural-motion-keyframes",
    "clip-effects-color-grade-and-current-frame-proof",
    "storyboards-and-shot-plan",
    "dailies-comments-questions-and-approvals",
    "manual-and-evidence-bearing-imported-tracking",
    "explicit-camera-on-set-preview",
    "portable-project-and-edl-export",
    "review-gated-publish-handoff"
  ],
  "consumes": ["service:asset-vault", "service:publish-library", "service:studio", "service:audio-studio", "service:shared-engines/project-v1", "service:shared-engines/timeline-v1", "service:shared-engines/scene-v1", "service:shared-engines/collaboration-v1"],
  "permissions": ["storage", "export", "files", "gate", "asset-vault", "shared-engines", "camera"],
  "handoffs": {
    "emits": ["axm.film-motion.project/v1", "axm.film.edl/v1", "axm.publish-artifact/v1", "axm.film.frame-proof/v1"],
    "accepts": ["hub:init", "hub:settings:value", "session-local:media-files", "axm.motion-capture.points/v1"]
  },
  "boundaries": {
    "writes": ["browser-local:axm.film-motion.project.v1", "browser-local:axm.publish-library.ledger.v1:unreviewed-artifact", "user-download:explicit"],
    "refuses": [
      "automatic-publish-approval",
      "automatic-rights-clearance",
      "pretend-session-media-persistence",
      "pretend-final-video-encoding",
      "pretend-camera-tracking-without-solver-evidence",
      "silent-camera-or-microphone-access",
      "automatic-review-approval",
      "unverified-motion-capture-import",
      "destructive-source-media-editing"
    ]
  }
}
