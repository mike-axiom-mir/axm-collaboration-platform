  "boundaries": {
    "writes": ["browser-local:ai-task-talk"],
    "refuses": ["automatic-done", "automatic-wisdom-promotion", "cloud-fallback", "hidden-prompt", "unbounded-loop", "silent-restart"]
  }
}
