{
  "schema": "axm.module-contract/v1",
  "id": "ai-task-talk",
  "version": "v0.1",
  "provides": ["local-ai-task-queue", "time-wake-dispatch", "budgeted-ai-conversation"],
  "consumes": ["identity:nova", "identity:gemini-local", "bridge:local"],
  "permissions": ["storage", "ai", "bridge", "identity", "gate"],
