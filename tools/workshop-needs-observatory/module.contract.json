      "auto-promotion",
      "silent-need-closure",
      "fuzzy-capability-claim",
      "unknown-category-coercion",
      "readiness-as-approval",
      "readiness-as-promotion",
      "stale-readiness-as-current",
      "declared-capability-as-runtime-proof"
    ]
  },
  "lifecycle": {
    "state_owner": "service",
    "reload": "resume",
    "disconnect": "graceful-degrade",
    "cleanup": "explicit"
  }
}
