{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.storage-fault-injector",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.virtual-storage-fault.receipt/v1"
  ],
  "consumes": [
    "virtual-store",
    "bounded-storage-fault"
  ],
  "permissions": [],
