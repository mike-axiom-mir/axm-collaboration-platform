{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.differential-comparator",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.differential-comparison.report/v1"
  ],
  "consumes": [
    "reference-output",
    "candidate-output",
    "comparison-policy"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_0_VERIFY_ONLY",
    "automaticMutation": false,
    "explicitCallerRequired": true
  },
  "overlap": {
    "decision": "ADAPTER_BETWEEN_EXISTING",
    "targets": [
      "tools/qa-lab",
      "tools/repairbuddy",
      "shared/visual-proof"
    ],
    "reason": "Adds explainable structured differences without declaring the reference automatically correct."
  },
  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "verification-as-permission",
      "selftest-as-runtime-proof",
      "automatic-repair",
      "automatic-promotion",
      "automatic-canon",
      "hidden-evidence-omission"
    ]
  }
}
