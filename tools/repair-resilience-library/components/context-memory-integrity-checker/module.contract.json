{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.context-memory-integrity-checker",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.context-memory-integrity.report/v1"
  ],
  "consumes": [
    "context-records",
    "required-context-contract",
    "scope-policy"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_2_SHADOW_RESTORATION",
    "automaticMutation": false,
    "explicitCallerRequired": true
