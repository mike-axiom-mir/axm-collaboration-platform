{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.heartbeat-lease-monitor",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.heartbeat-lease.status/v1"
  ],
  "consumes": [
    "axm.platform-heartbeat.beat/v1"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_0_OBSERVE_ONLY",
