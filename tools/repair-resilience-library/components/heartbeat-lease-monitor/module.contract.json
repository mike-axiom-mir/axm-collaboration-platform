  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "automatic-repair",
      "automatic-restart",
      "automatic-promotion",
      "automatic-canon",
      "permission-grant",
      "network-access",
      "runtime-proof-claim",
      "mutation-of-existing-axm-organs"
    ]
  }
}
