{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.replay-verifier",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.replay-verification.report/v1"
  ],
  "consumes": [
    "initial-state",
    "recorded-operations",
    "replay-adapter",
    "expected-outcome"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_0_VERIFY_ONLY",
    "automaticMutation": false,
    "explicitCallerRequired": true
  },
  "overlap": {
    "decision": "ADAPTER_BETWEEN_EXISTING",
    "targets": [
      "tools/repairbuddy",
      "tools/recovery-center",
      "shared/evidence-retention"
    ],
    "reason": "Adds deterministic replay evidence but never replays against canonical state by default."
  },
  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "verification-as-permission",
      "selftest-as-runtime-proof",
      "automatic-repair",
      "automatic-promotion",
      "automatic-canon",
      "hidden-evidence-omission"
    ]
  }
}
