{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.candidate-patch-generator",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.patch-candidate-set/v1"
  ],
  "consumes": [
    "repair-input",
    "matched-patch-templates"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_2_SHADOW_REPAIR",
    "automaticMutation": false,
    "explicitCallerRequired": true
  },
  "overlap": {
    "decision": "EXTEND_EXISTING",
    "targets": [
      "tools/repairbuddy"
    ],
    "reason": "Produces bounded shadow candidates only; RepairBuddy and human gates retain review and replay authority."
  },
  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "automatic-patch-application",
      "automatic-source-rewrite",
      "automatic-install",
      "automatic-dependency-change",
      "automatic-promotion",
      "automatic-canon",
      "verification-from-original-tests-only",
      "runtime-proof-claim"
    ]
  }
}
