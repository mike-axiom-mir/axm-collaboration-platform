{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.ai-regression-harness",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.ai-regression.report/v1"
  ],
  "consumes": [
    "fixed-scenarios",
    "baseline-adapter",
    "candidate-adapter",
    "behavior-comparator"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_0_VERIFY_ONLY",
    "automaticMutation": false,
    "explicitCallerRequired": true
  },
  "overlap": {
    "decision": "ADAPTER_BETWEEN_EXISTING",
    "targets": [
      "tools/ai-team",
      "tools/qa-lab",
      "shared/evidence-retention"
    ],
    "reason": "Runs caller-supplied deterministic adapters on fixed scenarios; it does not contact a provider or select a new model automatically."
  },
  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "automatic-pattern-reuse",
      "automatic-memory-write",
      "provider-execution",
      "active-repair-orchestration",
      "permission-grant",
      "automatic-promotion",
      "automatic-release",
      "automatic-canon",
      "diagnosis-from-similarity-alone",
      "root-cause-invention"
    ]
  }
}
