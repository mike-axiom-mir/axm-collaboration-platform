  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "automatic-pattern-reuse",
      "automatic-memory-write",
      "provider-execution",
      "active-repair-orchestration",
      "permission-grant",
      "automatic-promotion",
      "automatic-release",
      "automatic-canon",
      "diagnosis-from-similarity-alone",
      "root-cause-invention"
    ]
  }
}
