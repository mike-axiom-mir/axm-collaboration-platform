{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.known-problem-matcher",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.known-problem.match-report/v1"
  ],
  "consumes": [
    "failure-signature-registry",
    "new-failure-evidence"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_0_OBSERVE_ONLY",
    "automaticMutation": false,
    "explicitCallerRequired": true
