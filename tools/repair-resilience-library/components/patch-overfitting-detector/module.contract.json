{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.patch-overfitting-detector",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.patch-overfitting-assessment/v1"
  ],
  "consumes": [
    "training-results",
    "holdout-results",
    "property-results",
    "differential-results"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_2_SHADOW_REPAIR",
    "automaticMutation": false,
    "explicitCallerRequired": true
  },
  "overlap": {
    "decision": "ADAPTER_BETWEEN_EXISTING",
    "targets": [
      "tools/repairbuddy",
      "tools/qa-lab"
    ],
    "reason": "Adds explicit holdout/property/differential skepticism before any patch can be treated as verified."
  },
  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "automatic-patch-application",
      "automatic-source-rewrite",
      "automatic-install",
      "automatic-dependency-change",
      "automatic-promotion",
      "automatic-canon",
      "verification-from-original-tests-only",
      "runtime-proof-claim"
    ]
  }
}
