{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.compensation-registry",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.compensation-plan/v1"
  ],
  "consumes": [
    "forward-actions",
    "compensation-definitions"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_3_HUMAN_GATED_PLAN",
    "automaticMutation": false,
    "explicitCallerRequired": true
  },
  "overlap": {
    "decision": "ADAPTER_BETWEEN_EXISTING",
    "targets": [
      "tools/recovery-center",
      "shared/module-evolution-ledger"
    ],
    "reason": "Stores explicit compensators with applicability and builds reverse-order plans without executing them automatically."
  },
  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "automatic-restore",
      "automatic-rollback",
      "silent-data-loss",
      "automatic-promotion",
      "automatic-canon",
      "permission-grant",
      "runtime-proof-claim"
    ]
  }
}
