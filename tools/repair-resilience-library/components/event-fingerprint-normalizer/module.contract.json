{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.event-fingerprint-normalizer",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.failure-fingerprint/v1"
  ],
  "consumes": [
    "logs",
    "errors"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_0_OBSERVE_ONLY",
