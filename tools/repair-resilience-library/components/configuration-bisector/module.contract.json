  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "root-cause-certainty",
      "canonical-state-mutation",
      "automatic-repair",
      "automatic-promotion",
      "automatic-canon",
      "permission-grant",
      "runtime-proof-claim"
    ]
  }
}
