{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.configuration-bisector",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.configuration-bisection/v1"
  ],
  "consumes": [
    "ordered-config-history",
    "bounded-test"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_2_SHADOW_EXPERIMENT",
    "automaticMutation": false
  },
  "overlap": {
