{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.diagnostic-experiment-runner",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.diagnostic-experiment.receipt/v1"
  ],
  "consumes": [
    "hypothesis",
    "shadow-fixture",
    "experiment-function"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_2_SHADOW_EXPERIMENT",
    "automaticMutation": false
  },
  "overlap": {
    "decision": "ADAPTER_BETWEEN_EXISTING",
    "targets": [
      "tools/repairbuddy",
      "tools/diagnostics-operations-center"
    ],
    "reason": "Runs bounded experiments on cloned fixtures; active or canonical state is never passed through."
  },
  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "root-cause-certainty",
      "canonical-state-mutation",
      "automatic-repair",
      "automatic-promotion",
      "automatic-canon",
      "permission-grant",
      "runtime-proof-claim"
    ]
  }
}
