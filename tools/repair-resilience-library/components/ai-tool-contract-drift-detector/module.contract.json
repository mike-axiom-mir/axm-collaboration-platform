{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.ai-tool-contract-drift-detector",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.ai-tool-contract-drift.report/v1"
  ],
  "consumes": [
    "declared-tool-contract",
    "observed-tool-surface"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_0_OBSERVE_ONLY",
    "automaticMutation": false,
    "explicitCallerRequired": true
  },
  "overlap": {
    "decision": "ADAPTER_BETWEEN_EXISTING",
    "targets": [
      "tools/ai-team",
      "shared/technical-glasses",
      "tools/schema-identity-observatory"
    ],
    "reason": "Compares declared and observed surfaces without calling providers or silently updating contracts."
  },
  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "automatic-pattern-reuse",
      "automatic-memory-write",
      "provider-execution",
      "active-repair-orchestration",
      "permission-grant",
      "automatic-promotion",
      "automatic-release",
      "automatic-canon",
      "diagnosis-from-similarity-alone",
      "root-cause-invention"
    ]
  }
}
