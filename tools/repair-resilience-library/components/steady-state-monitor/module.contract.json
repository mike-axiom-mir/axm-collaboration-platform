{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.steady-state-monitor",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.steady-state.evaluation/v1"
  ],
  "consumes": [
    "axm.steady-state.contract/v1",
    "metric-samples"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_0_OBSERVE_ONLY",
    "automaticMutation": false
  },
  "overlap": {
    "decision": "ADAPTER_BETWEEN_EXISTING",
    "targets": [
      "tools/diagnostics-operations-center",
      "tools/body-pulse",
      "shared/heartbeat"
    ],
    "reason": "Defines steady state before Heartbeat or Diagnostics interprets deviation."
  },
  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "automatic-repair",
      "automatic-restart",
      "automatic-promotion",
      "automatic-canon",
      "permission-grant",
      "network-access",
      "runtime-proof-claim",
      "mutation-of-existing-axm-organs"
    ]
  }
}
