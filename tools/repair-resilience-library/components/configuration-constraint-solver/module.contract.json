{
  "schema": "axm.module-contract/v1",
  "id": "axm.repair.configuration-constraint-solver",
  "version": "0.1.0",
  "status": "EXPERIMENTAL",
  "provides": [
    "axm.configuration-repair-candidates/v1"
  ],
  "consumes": [
    "configuration",
    "option-domains",
    "declared-constraints"
  ],
  "permissions": [],
  "authority": {
    "tier": "TIER_2_SHADOW_REPAIR",
    "automaticMutation": false,
    "explicitCallerRequired": true
  },
  "overlap": {
    "decision": "ADAPTER_BETWEEN_EXISTING",
    "targets": [
      "tools/repairbuddy",
      "tools/module-contract-workbench",
      "shared/technical-glasses"
    ],
    "reason": "Creates explainable minimal configuration candidates instead of blind rewrites."
  },
  "boundaries": {
    "automaticWrites": [],
    "explicitWrites": [],
    "refuses": [
      "automatic-patch-application",
      "automatic-source-rewrite",
      "automatic-install",
      "automatic-dependency-change",
      "automatic-promotion",
      "automatic-canon",
      "verification-from-original-tests-only",
      "runtime-proof-claim"
    ]
  }
}
