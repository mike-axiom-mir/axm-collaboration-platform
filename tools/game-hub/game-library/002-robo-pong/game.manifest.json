{
  "slot": "002",
  "game_id": "002-robo-pong",
  "name": "AXM Pong: Duet",
  "status": "WORKING TEST",
  "description": "A dark-glass 1-2 player Pong story with solo AI support, two-player co-op, three arenas, and local 1v1 multiplayer.",
  "version": "2.0.0-neon-duet",
  "min_players": 1,
  "max_players": 2,
  "play_modes": [
    {
      "id": "story_coop",
      "label": "Story / Co-op · 1-2 players",
      "description": "One player receives an AI wingmate; two ready seats defend the core together across three light-driven arenas.",
      "party_rule": "party-a-only"
    },
    {
      "id": "duet_versus",
      "label": "Duet Versus · 1v1",
      "description": "Two ready seats meet in a first-to-seven local multiplayer duel.",
      "party_rule": "party-a-only"
    }
  ],
  "allowed_seat_types": ["human", "adapter", "ai"],
  "launch": {
