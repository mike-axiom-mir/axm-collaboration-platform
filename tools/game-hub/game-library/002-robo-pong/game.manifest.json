    "port": 8792,
    "start_command": "managed-by-game-hub",
    "local_only_default": true
  },
  "join": {"supports_qr": true, "supports_lan_link": true, "supports_room_code": true, "room_code": "AXM1"},
  "controls": {"phone_controller": true, "keyboard": true, "mouse": true, "touch": true, "shared_screen": true},
  "session": {"passes_seat_map": true, "returns_result_summary": true, "drop_in_out_later": false},
  "rules": {"no_hidden_players": true, "host_launch_required": true, "game_does_not_override_hub_seats": true},
  "verification": {
