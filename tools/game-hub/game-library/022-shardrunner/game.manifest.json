      "state_authority": "server",
      "host_reload_recovery": "game-hub-active-launch",
      "shared_screen_occupies_seat": false,
      "disconnect_recovery": "pending",
      "blocking_overlay_escape": "pending",
      "physical_phone_qa": "pending",
      "adapter_state_interface": "not-applicable"
    }
  },
  "package": {
    "source_status": "local-3d-prototype",
    "installed": false,
    "promoted": false,
    "required_paths": [
      "game.manifest.json",
      "runtime/server.cjs",
      "runtime/index.html",
      "runtime/shardrunner-core.cjs",
      "runtime/vendor/three.module.js",
      "tests/package-selftest.js"
    ]
  }
