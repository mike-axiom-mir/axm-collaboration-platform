{
  "schema": "axm.pulse-choir-2030-requirements/v1",
  "objective": "Evolve Pulse Choir into a future-facing room game with adaptive cooperation, visible human agency, resilient surfaces, and evidence-backed quality.",
  "requirements": [
    {"id":"evolving-rounds","required":true,"capabilities":["game.setlist.deterministic","game.setlist.server-authoritative","game.show-memory.server-authoritative"]},
    {"id":"adaptive-conductor","required":true,"capabilities":["game.conductor.receipt-adaptive","game.conductor.transparent","state.conductor.schema-migration","ui.conductor.cross-surface","input.ai.idle-noop","test.conductor","visual.conductor.journey"]},
    {"id":"human-steering","required":true,"capabilities":["game.room-signal.human-authority","game.room-signal.deterministic-resolution","state.room-signal.round-bound","ui.room-signal.cross-surface","test.room-signal","visual.room-signal.journey"]},
    {"id":"human-agency","required":true,"capabilities":["game.human-agency.gated"]},
    {"id":"surface-parity","required":true,"capabilities":["ui.shared-screen.setlist","ui.controller.setlist","ui.show-memory.cross-surface","ui.recovery.cross-surface"]},
    {"id":"resilient-session","required":true,"capabilities":["state.checkpoint.atomic","state.session.restore","input.sequence.restart-safe"]},
    {"id":"managed-handback","required":true,"capabilities":["game.handback.authoritative","transport.hub-result.callback","state.handback.clean-relaunch","ui.shared-screen.handback"]},
    {"id":"verification","required":true,"capabilities":["test.setlist.rules","test.setlist.http","test.show-memory.replay","test.recovery.fresh-process","test.hub-handback","visual.setlist.journey","visual.show-memory.replay","visual.recovery.managed-restart","visual.handback-control"]},
    {"id":"human-delight","required":false,"capabilities":["judgment.human.game-night"]},
    {"id":"physical-controller-proof","required":false,"capabilities":["visual.physical-phone"]},
    {"id":"hub-home-navigation-proof","required":false,"capabilities":["visual.hub-home-navigation"]},
    {"id":"production-networking","required":false,"capabilities":["network.production-scale"]}
  ]
}
