{
  "slot": "010",
  "game_id": "010-example-game",
  "name": "Example Game",
  "status": "RAW / REVIEW / ACCEPT FOR TEST / WORKING / KNOWN FAIL / RETIRED",
  "description": "Short public description.",
  "version": "0.1.0",
  "min_players": 1,
  "max_players": 8,
  "allowed_seat_types": [
    "human",
    "adapter",
    "ai",
    "spectator"
  ],
  "launch": {
    "server_entry": "runtime/server.js",
    "client_entry": "/games/010/",
    "controller_path": "/controller/?room=AXM1&player={player}&seat={seat_id}",
    "port": 8800,
    "start_command": "managed-by-game-hub",
    "local_only_default": true
  },
  "join": {
    "supports_qr": true,
    "supports_lan_link": true,
    "supports_room_code_later": true
  },
  "controls": {
    "profile_id": "axm-top-down-twin-stick-v1",
    "intent_protocol": "axm-semantic-input-v1",
    "adapter_observation": "axm-seat-screen-semantics-v1",
    "phone_controller": true,
    "keyboard": true,
    "mouse": false,
    "touch": true
  },
  "session": {
    "passes_seat_map": true,
    "returns_result_summary": true,
    "drop_in_out_later": true
  },
  "post_match": {
    "bondfire": false,
    "mode": "off / optional-button / default-for-this-game",
    "route": null,
    "auto_promote_wisdom": false
  },
  "rules": {
    "no_hidden_players": true,
    "human_and_adapter_same_input_gate": true,
    "adapter_observation_is_seat_visible_only": true,
    "host_launch_required": true,
    "game_does_not_override_hub_seats": true
  },
  "verification": {
    "game_night": {
      "schema": "axm.game-night-seams/v1",
      "controller_delivery": "dedicated-path",
      "controller_evidence": ["client/controller/index.html"],
      "state_authority": "server",
      "host_reload_recovery": "game-hub-active-launch",
      "shared_screen_occupies_seat": false,
      "disconnect_recovery": "pending",
      "blocking_overlay_escape": "pending",
      "physical_phone_qa": "pending",
      "adapter_state_interface": "pending",
      "adapter_state_evidence": ["docs/AI_NATIVE_SEAT_CONTRACT.md"]
    }
  },
  "package": {
    "source_status": "new-package-template",
    "required_paths": [
      "README_FIRST.md",
      "KNOWN_LIMITS.md",
      "runtime/server.js",
      "client/index.html",
      "client/controller/index.html",
      "docs/AI_NATIVE_SEAT_CONTRACT.md"
    ]
  }
}
