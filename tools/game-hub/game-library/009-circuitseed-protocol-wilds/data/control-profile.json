    "return": "return",
    "build": "build",
    "interact": "interact"
  },
  "labels": {
    "left": "MOVE",
    "scan": "SCAN",
    "connect": "CONNECT",
    "deploy": "DEPLOY",
    "assist": "ASSIST",
    "recover": "RECOVER",
    "return": "RETURN",
    "build": "BUILD / SELL",
    "interact": "ACT"
  },
  "intent": {
    "vectorPairs": [{ "x": "moveX", "y": "moveY" }],
