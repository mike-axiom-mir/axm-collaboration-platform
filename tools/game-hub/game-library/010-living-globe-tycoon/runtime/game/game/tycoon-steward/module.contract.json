{
  "schema": "axm.module-contract/v1",
  "id": "tycoon-steward",
  "version": "v0.1",
  "provides": [
    "deterministic-steward-simulation",
    "broad-zone-direction",
    "transactional-resource-allocation",
    "traceable-emergence",
    "typed-deposit-and-product-supply-chain",
    "supply-aware-candidate-selection",
    "explicit-captured-emergence-patterns",
    "preserve-or-evolve-goal-layers",
    "presentation-only-palace-feedback",
    "trade-ready-surplus-without-auto-export",
    "append-only-turn-receipts",
    "headless-steward-api",
    "disconnected-globe-proposal-contract"
  ],
  "consumes": [
    "user-action:explicit-steward-decision",
    "user-file:validated-json-state",
    "browser-local-read:axm.tycoon-steward.v0.1.emergence-memory-v1",
    "browser-local-read:axm.tycoon-steward.v0.1"
  ],
  "permissions": [
    "storage",
    "export"
  ],
  "handoffs": {
    "emits": [
      "axm.tycoon-steward.export/v0.1",
      "axm.tycoon-steward.receipt-export/v0.1",
      "axm.tycoon-steward.city-patch-proposal/v0.1",
      "axm.tycoon-steward.emergent-content/v0.1",
      "axm.tycoon-steward.emergence-memory/v0.1"
    ],
    "accepts": [
      "axm.tycoon-steward.export/v0.1",
      "axm.tycoon-steward.decision/v0.1",
      "axm.tycoon-steward.globe-event/v0.1:explicit-host-call-only"
    ]
  },
  "boundaries": {
    "writes": [
      "browser-local:axm.tycoon-steward.v0.1.palace-polish-v1:explicit-user-action",
      "user-download:explicit"
    ],
    "refuses": [
      "auto-turn-on-open",
      "timer-driven-state-change",
      "manual-individual-building-placement",
      "manual-default-road-placement",
      "unseeded-simulation-randomness",
      "double-spend-or-negative-inventory",
      "silent-import-repair-or-migration",
      "silent-state-overwrite",
      "unscored-novelty-affecting-vitals",
      "automatic-emergence-capture",
      "captured-pattern-as-cloned-buildings-or-inventory",
      "captured-goal-bypass-of-zone-labor-material-allocation-or-money-gates",
      "proposal-as-accepted-change",
      "living-globe-import-or-state-ownership",
      "live-globe-mutation",
      "self-installation",
      "self-promotion",
      "self-canonization",
      "runtime-network-dependency"
    ]
  }
}
