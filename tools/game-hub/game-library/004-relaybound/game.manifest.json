{
  "slot": "004",
  "game_id": "004-relaybound",
  "name": "Relaybound",
  "status": "VERTICAL SLICE",
  "description": "A human-and-AI co-op action adventure where every upgrade forces the upgrader into the opposite role and hands the improved role to their partner.",
  "version": "0.1.0-role-relay",
  "min_players": 2,
  "max_players": 2,
  "allowed_seat_types": ["human", "adapter", "ai"],
  "launch": {
    "server_entry": "runtime/relaybound-server.cjs",
    "client_entry": "/games/004/?player=p1",
    "spectator_client_entry": "/games/004/?player=screen",
    "ready_path": "/state",
    "port": 8794,
    "start_command": "managed-by-game-hub",
    "local_only_default": true
  },
  "join": {"supports_qr": true, "supports_lan_link": true, "supports_room_code": true, "room_code": "AXM1"},
  "controls": {"phone_controller": true, "keyboard": true, "mouse": false, "touch": true},
  "session": {"passes_seat_map": true, "returns_result_summary": true, "drop_in_out_later": false},
  "post_match": {"bondfire": true, "mode": "default-for-this-game", "route": "/games/004/debrief", "auto_promote_wisdom": false},
  "rules": {
    "no_hidden_players": true,
    "host_launch_required": true,
    "game_does_not_override_hub_seats": true,
    "intended_pair": "one-human-one-ai",
    "upgrade_forces_opposite_role": true
  },
  "verification": {
    "game_night": {
      "schema": "axm.game-night-seams/v1",
      "controller_delivery": "shared-runtime",
      "controller_evidence": ["runtime/relaybound-client.html"],
      "state_authority": "server",
      "host_reload_recovery": "game-hub-active-launch",
      "shared_screen_occupies_seat": false,
      "disconnect_recovery": "pending",
      "blocking_overlay_escape": "pending",
      "physical_phone_qa": "pending",
      "adapter_state_interface": "pending"
    }
  },
  "package": {
    "source_status": "cc0-asset-vertical-slice",
    "required_paths": [
      "README.md",
      "ASSET_LICENSES.md",
      "runtime/relaybound-server.cjs",
      "runtime/relaybound-client.html",
      "runtime/relaybound-debrief.html",
      "runtime/assets/characters/Warrior.gltf",
      "runtime/assets/characters/Wizard.gltf"
    ]
  }
}
