{
  "slot": "007",
  "game_id": "007-casino-alpha",
  "name": "Casino Alpha: Ten-Slot Free Play",
  "status": "TEST-WORKING",
  "description": "A local authoritative ten-slot free-play and 1v1-4v4 casino tycoon alpha powered by one 50K Draw Spine, immutable style books, and a reactive robot theater.",
  "version": "0.3.3-alpha",
  "min_players": 1,
  "max_players": 8,
  "play_modes": [
    {
      "id": "backroom_story",
      "label": "Free Play - solo / co-op",
      "description": "Ready one to four seats from Party A (seats 1-4). All ten slot cabinets are immediately open with no quests or searches.",
      "party_rule": "party-a-only"
    },
    {
      "id": "house_war",
      "label": "House War - multiplayer",
      "description": "Ready equal teams in Party A and Party B for 1v1 through 4v4.",
      "party_rule": "balanced-parties"
    }
  ],
  "allowed_seat_types": ["human", "adapter", "ai"],
  "uses": ["game-hub-seats", "party-routing", "local-authority", "axm-50k-draw-spine", "ten-immutable-style-books"],
  "launch": {
    "server_entry": "alpha/runtime/casino-server.cjs",
    "client_entry": "/games/007/?role=host&play=1",
    "spectator_client_entry": "/games/007/?role=host",
    "ready_path": "/state",
    "port": 8797,
    "start_command": "managed-by-game-hub",
    "local_only_default": true
  },
  "join": {
    "supports_qr": true,
    "supports_lan_link": true,
    "supports_room_code": true
  },
  "controls": {
    "phone_controller": true,
    "keyboard": true,
    "mouse": true,
    "touch": true
  },
  "session": {
    "passes_seat_map": true,
    "returns_result_summary": true,
    "drop_in_out_later": true,
    "party_a_seats": [1, 2, 3, 4],
    "party_b_seats": [5, 6, 7, 8]
  },
  "rules": {
    "no_hidden_players": true,
    "host_launch_required": true,
    "game_does_not_override_hub_seats": true,
    "server_authoritative_money": true,
    "immutable_slot_outcomes": true,
    "outside_network_required": false
  },
  "verification": {
    "game_night": {
      "schema": "axm.game-night-seams/v1",
      "controller_delivery": "runtime-issued",
      "runtime_metadata_endpoint": "/api/host/bootstrap",
      "controller_evidence": ["alpha/client/index.html", "alpha/tests/game-hub-integration-selftest.js"],
      "state_authority": "server",
      "host_reload_recovery": "game-hub-active-launch",
      "shared_screen_occupies_seat": false,
      "disconnect_recovery": "pending",
      "blocking_overlay_escape": "not-applicable",
      "physical_phone_qa": "pending",
      "adapter_state_interface": "pending"
    }
  },
  "package": {
    "source_status": "alpha-implemented-browser-and-physical-phone-qa-required",
    "required_paths": [
      "README.md",
      "README_FIRST.md",
      "ALPHA_GAMEPLAY_ROUTE.md",
      "BUILD_REPORT.md",
      "CODEX_LOCAL_LAYER_DROP.md",
      "integration/PR14_INTAKE.md",
      "alpha/README.md",
      "alpha/runtime/casino-server.cjs",
      "alpha/runtime/casino-core.js",
      "alpha/runtime/game-hub-adapter.js",
      "alpha/client/index.html",
      "alpha/client/app.js",
      "alpha/client/styles.css",
      "alpha/tests/core-selftest.js",
      "alpha/tests/server-selftest.js",
      "alpha/tests/game-hub-integration-selftest.js",
      "alpha/tests/run-all.js",
      "alpha/tests/package-selftest.js",
      "slots/slot-catalog.js",
      "slots/slot-catalog-selftest.js",
      "slots/axm-draw-spine.js",
      "slots/axm-draw-spine-selftest.js",
      "slots/lux-5/lux5-model.js",
      "slots/lux-5/lux5-rng.js",
      "slots/lux-5/lux5-outcome-book.js",
      "slots/lux-5/lux5-math-selftest.js",
      "slots/lux-5/lux5-book-selftest.js"
    ]
  }
}
