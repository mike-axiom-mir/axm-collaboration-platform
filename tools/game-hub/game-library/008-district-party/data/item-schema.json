{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm-district-party://schemas/item-v0.1.1.json",
  "title": "AXM District Party inventory item",
  "description": "Generic inventory item instance. This schema defines slots and safe extension seams without defining an equipment catalogue.",
  "type": "object",
  "required": ["id", "displayName", "equipSlot"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "equipSlot": {
      "enum": ["melee", "ranged", "ammo", "shoes", "body", "hat"]
    },
    "ammoType": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,47}$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "abilities": {
      "description": "Future equipment abilities. The host remains responsible for validating and applying each known ability definition.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object"
      }
    },
    "statModifiers": {
      "description": "Finite numeric modifiers interpreted by a future authoritative stat system.",
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "number"
      }
    },
    "metadata": {
      "description": "Non-authoritative descriptive extension data. Gameplay effects must not be inferred from metadata.",
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "equipSlot": {
            "const": "ranged"
          }
        },
        "required": ["equipSlot"]
      },
      "then": {
        "required": ["ammoType"]
      }
    },
    {
      "if": {
        "properties": {
          "equipSlot": {
            "const": "ammo"
          }
        },
        "required": ["equipSlot"]
      },
      "then": {
        "required": ["ammoType", "quantity"]
      }
    }
  ],
  "additionalProperties": false
}
