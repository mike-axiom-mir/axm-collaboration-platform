{
  "slot": "008",
  "game_id": "008-district-party",
  "name": "AXM District Party",
  "status": "PUBLIC TEST",
  "description": "A substantial 1–8 player local shared-screen city game: co-op adventures, asymmetric district battles, vehicles, missions, inventory and equal human/AI control routes.",
  "version": "0.4.0-authored-city-alpha-public-test",
  "min_players": 1,
