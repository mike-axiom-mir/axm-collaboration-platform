    "adapter_observation": "axm-seat-screen-semantics-v1",
    "phone_controller": true,
    "keyboard": true,
    "mouse": false,
    "touch": true,
    "shared_screen": true
  },
  "session": {
    "passes_seat_map": true,
    "returns_result_summary": true,
    "drop_in_out_later": false,
    "parties": {
      "party_a": [1, 2, 3, 4],
      "party_b": [5, 6, 7, 8]
