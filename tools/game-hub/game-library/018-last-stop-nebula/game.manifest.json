  "status": "VERIFIED LOCAL BETA - HUMAN BALANCE DATA PENDING",
  "description": "A cinematic 3D pressure-management game where a nearly retired alien must rebuild a leaking petrol station inside a newly crowded nebula, capture guaranteed growth, and escape before 1,000 bad reviews revoke the license.",
  "version": "0.25.0-beta",
  "min_players": 1,
