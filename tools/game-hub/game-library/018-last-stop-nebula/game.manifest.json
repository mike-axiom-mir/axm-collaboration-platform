    "host_launch_required": true,
    "game_does_not_override_hub_seats": true,
    "runtime_internet_required": false,
    "simulation_authority": "browser-local",
    "save_authority": "browser-localStorage",
    "launch_session_authority": "managed-local-server",
    "growth_model": "guaranteed-escalating-demand",
    "loss_condition": "1000-bad-reviews",
    "win_condition": "survive-selected-retirement-timer",
    "score_basis": "cash-plus-assets-plus-review-bonus-minus-debt-times-contract",
    "balance_guidance": "contract-specific-local-field-estimate-never-auto-applied",
    "offscreen_simulation": false
