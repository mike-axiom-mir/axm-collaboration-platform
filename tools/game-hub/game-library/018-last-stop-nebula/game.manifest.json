    "mouse": true,
    "gamepad": false,
    "touch": true,
    "shared_screen": false,
    "bindings": ["1/2/3 serve lanes or event choices", "U upgrades", "C camera", "M sound", "Escape pause"]
  },
  "session": {
    "passes_seat_map": true,
    "returns_result_summary": false,
    "target_minutes": 9,
    "available_contract_minutes": [6, 9, 12],
    "persistent_local_save": true,
