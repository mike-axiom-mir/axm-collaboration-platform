{
  "schema": "axm.external-collaborator-seat/v1",
  "adapter_id": "example-adapter",
  "display_name": "Example Adapter",
  "status": "RAW / REVIEW / ACCEPT FOR TEST / WORKING / KNOWN FAIL / RETIRED",
  "seat_type": "adapter",
  "allowed_seats": [
    "seat_1",
    "seat_2",
    "seat_3",
    "seat_4",
    "seat_5",
    "seat_6",
    "seat_7",
    "seat_8"
  ],
  "connector": {
    "type": "simple-bot / hermes-local / lm-studio / chatgpt / claude / custom",
    "requires_consent": true,
    "visible_to_players": true
  },
  "execution": {
    "mode": "external-hub-connected",
    "built_in_host_ai": false,
    "owns_separate_player_seat": true
  },
  "interface": {
    "input_protocol": "axm-semantic-input-v1",
    "observation_protocol": "axm-seat-screen-semantics-v1",
    "observation_scope": "seat-visible-only",
    "same_authority_gate_as_human": true,
    "rendered_screen_required": false,
    "structured_state_required": true,
    "omniscient_world_state_allowed": false,
    "private_other_player_state_allowed": false
  },
  "continuity": {
    "seat_token_bound": true,
    "reconnectable": true,
    "action_sequence_monotonic": true,
    "result_receipt_required": true
  },
  "limits": {
    "can_chat": false,
    "can_control_player": true,
    "can_start_game": false,
    "can_change_seat": false,
    "can_access_private_logs": false
  },
  "rules": {
    "no_hidden_adapter": true,
    "host_must_assign_seat": true,
    "adapter_name_visible_in_lobby": true,
    "human_override_allowed": true,
    "adapter_is_not_relabelled_host_ai": true
  }
}
