{
  "schema": "axm.module-contract/v1",
  "id": "deterministic-pr-publisher",
  "version": "v0.1",
  "provides": [
    "git-pr.checkpoint-bound-publish-plan",
    "git-pr.public-safe-review-material-gate",
    "git-pr.clean-feature-branch-push",
    "git-pr.github-draft-create-or-update",
    "git-pr.sender-receiver-transport-receipt",
    "git-pr.platform-merge-handoff",
    "git-pr.merge-authority-refusal"
  ],
  "consumes": [
    "git-pr.read-only-local-checkpoint",
    "git-pr.deterministic-review-packet",
    "filesystem:explicit-clean-publish-lane-worktree",
    "local-git-runtime",
    "host-authenticated-github-cli-session"
  ],
  "permissions": [
    "network",
    "export"
  ],
  "handoffs": {
    "emits": [
      "axm.git-pr-publish-plan/v1",
      "axm.git-pr-publish-receipt/v1",
      "github/draft-pull-request",
      "platform-axiom-mir/independent-merge-review"
    ],
    "accepts": [
      "axm.git-pr-checkpoint/v1",
      "axm.git-pr-checkpoint-verification/v1",
      "axm.git-pr-review-packet/v1",
      "filesystem/explicit-clean-publish-lane-worktree"
    ]
  },
  "lifecycle": {
    "state_owner": "mixed",
    "reload": "resume",
    "disconnect": "graceful-degrade",
    "cleanup": "explicit"
  },
  "boundaries": {
    "writes": [
      "exact-current-feature-branch-to-approved-github-remote",
      "one-draft-pull-request-title-and-body",
      "explicit-create-new-receipt-outside-repository",
      "owned-ephemeral-body-file"
    ],
    "refuses": [
      "live-workshop-worktree",
      "dirty-worktree",
      "detached-head",
      "main-or-master-branch",
      "branch-outside-codex-or-agent-prefix",
      "checkpoint-or-review-packet-tamper",
      "checkpoint-hold",
      "remote-main-drift",
      "remote-branch-non-fast-forward",
      "force-push",
      "git-stage-or-commit",
      "branch-creation-or-deletion",
      "credential-storage-or-output",
      "private-or-machine-local-review-material",
      "multiple-open-pull-requests-for-one-branch",
      "non-draft-existing-pull-request",
      "pull-request-ready-transition",
      "pull-request-close",
      "automatic-merge",
      "promotion",
      "roots-change",
      "canon-change"
    ]
  }
}
