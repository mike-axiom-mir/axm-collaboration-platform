{
  "schema": "axm.module-contract/v1",
  "id": "graft",
  "version": "v0.1",
  "provides": [
    "structured-integration-idea-normalization",
    "workshop-state-fingerprinted-graft-plan",
    "state-aware-integration-conflict-detection",
    "protected-spine-refusal",
    "stale-plan-detection",
    "check-before-and-after-integration-plan",
    "explicit-json-plan-export"
  ],
  "consumes": [
    "hub:runtime-workshop-state",
    "hub:route-core",
    "hub:graft-core",
    "browser:blob-download"
  ],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.graft/v1", "application/json:axm.graft/v1"],
    "accepts": ["hub:init", "browser-form:structured-graft-idea"]
  },
  "lifecycle": {
    "state_owner": "browser",
    "reload": "reset",
    "disconnect": "graceful-degrade",
    "cleanup": "automatic"
  },
  "boundaries": {
    "writes": ["user-download:explicit-graft-plan"],
    "refuses": [
      "automatic-workshop-mutation",
      "executable-diff-generation",
      "protected-spine-touch",
      "blocked-plan-install",
      "stale-plan-as-current",
      "automatic-permission-grant",
      "automatic-status-promotion",
      "intent-quality-or-safety-certification",
      "runtime-execution-claim",
      "canon-authority"
    ]
  }
}
