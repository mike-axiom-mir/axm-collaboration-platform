{
  "schema": "axm.module-contract/v1",
  "id": "mirror-learning-shell",
  "version": "v0.3-action-lessons",
  "status": "TEST",
  "provides": [
    "mirror-observable-learning-view",
    "mirror-identity-bundle-view",
    "mirror-native-seam-review-view",
    "private-challenger-training-view",
    "portable-ai-native-curriculum-catalog",
    "attributed-opt-in-model-study-door"
  ],
  "consumes": [
    "service:mirror-native-learning-shell",
    "identity:attributed-connected-learner",
    "service:mirror-learning-forge",
    "service:reasoning-shell",
    "workshop:identity-wisdom-profile-skills"
  ],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.mirror.learning-shell-session/v1"],
    "accepts": ["hub:init", "hub:settings:value", "axm.ai-learning.session-proposal/v1"]
  },
  "lifecycle": {
    "state_owner": "service",
    "reload": "resume",
    "disconnect": "graceful-degrade",
    "cleanup": "explicit"
  },
  "boundaries": {
    "writes": ["mirror-service:explicit-action-feed-preference", "learner-private:attributed-session-artifacts", "learner-private:approved-practice-lessons", "learner-private:challenger-training-runs"],
    "refuses": ["automatic-action-feed-opt-in", "raw-prompt-or-output-lesson-intake", "cross-identity-memory-merge", "unattributed-study", "forced-enrollment", "workshop-action-execution", "external-network", "runtime-promotion", "canon-promotion", "identity-mutation", "permission-expansion", "tool-authority", "hidden-chain-of-thought-capture", "fake-hermes-runtime"]
  }
}
