{
  "schema": "axm.module-contract/v1",
  "id": "diagnostics-operations-center",
  "version": "v0.2",
  "provides": [
    "isolated-diagnostic-probes",
    "partial-health-snapshot-on-probe-failure",
    "explicit-probe-state-and-coverage",
    "available-log-source-catalog",
    "bounded-redacted-log-envelope",
    "diagnostic-log-content-digest",
    "persistent-diagnostic-export-lineage",
    "responsive-human-machine-operations-view"
  ],
  "consumes": [
    "service:runtime",
    "service:evidence-retention",
    "service:machine-host",
    "service:review-inbox",
    "service:recovery",
    "service:search",
    "service:assets",
    "service:permissions",
    "service:secret-metadata",
    "service:device-handoff"
  ],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.diagnostics-snapshot/v2", "axm.diagnostics-log-source-catalog/v1", "axm.diagnostics-log-envelope/v1", "axm.diagnostics-export-receipt/v1", "axm.diagnostics-export-lineage/v1"],
    "accepts": ["service-health-metadata", "allowlisted-evidence-source", "explicit local report export intent"]
  },
  "boundaries": {
    "writes": ["exports/diagnostics/explicit-report-and-receipt", "state/diagnostics/export-lineage.json"],
    "refuses": [
      "automatic-repair",
      "automatic-restart",
      "automatic-export",
      "arbitrary-execution",
      "arbitrary-log-path",
      "unbounded-log-read",
      "raw-log-return",
      "redaction-as-secret-free-certification",
      "one-probe-failure-as-whole-dashboard-failure",
      "health-as-certification",
      "diagnostic-evidence-as-promotion-approval"
    ]
  },
  "lifecycle": {
    "state_owner": "service",
    "reload": "resume",
    "disconnect": "graceful-degrade",
    "cleanup": "explicit"
  }
}
