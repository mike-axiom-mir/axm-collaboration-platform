{
  "schema": "axm.module-contract/v1",
  "id": "diagnostics-operations-center",
  "version": "v0.3",
  "provides": [
    "isolated-diagnostic-probes",
    "partial-health-snapshot-on-probe-failure",
    "explicit-probe-state-and-coverage",
    "available-log-source-catalog",
    "bounded-redacted-log-envelope",
    "diagnostic-log-content-digest",
    "persistent-diagnostic-export-lineage",
    "responsive-human-machine-operations-view",
    "windows-offline-evidence-validation",
    "windows-runtime-manifest-validation",
    "windows-offline-proof-gate",
    "digest-only-windows-gate-receipt"
  ],
  "consumes": [
    "service:runtime",
    "service:evidence-retention",
    "service:machine-host",
    "service:review-inbox",
    "service:recovery",
    "service:search",
    "service:assets",
    "service:permissions",
    "service:secret-metadata",
    "service:device-handoff",
    "reviewed:windows-network-evidence",
    "reviewed:windows-runtime-verification",
    "reviewed:windows-candidate-receipt",
    "reviewed:windows-lifecycle-receipt"
  ],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.diagnostics-snapshot/v2", "axm.diagnostics-log-source-catalog/v1", "axm.diagnostics-log-envelope/v1", "axm.diagnostics-export-receipt/v1", "axm.diagnostics-export-lineage/v1", "axm.windows-offline-readiness/v1", "axm.windows-offline-assessment-preview/v1", "axm.windows-offline-assessment-receipt/v1", "axm.deploy.windows-offline-gate.v1"],
    "accepts": ["service-health-metadata", "allowlisted-evidence-source", "reviewed Windows offline gate packet", "explicit Windows gate record intent", "explicit local report export intent"]
  },
  "boundaries": {
    "writes": ["exports/diagnostics/explicit-report-and-receipt", "state/diagnostics/export-lineage.json", "state/diagnostics/windows-offline-assessments.json"],
    "refuses": [
      "automatic-repair",
      "automatic-restart",
      "automatic-export",
      "arbitrary-execution",
      "arbitrary-log-path",
      "unbounded-log-read",
      "raw-log-return",
      "redaction-as-secret-free-certification",
      "one-probe-failure-as-whole-dashboard-failure",
      "health-as-certification",
      "diagnostic-evidence-as-promotion-approval",
      "network-adapter-mutation",
      "runtime-installation",
      "offline-proof-from-point-in-time-snapshot",
      "offline-proof-without-runtime-byte-verification",
      "public-support-grant",
      "automatic-publication"
    ]
  },
  "lifecycle": {
    "state_owner": "service",
    "reload": "resume",
    "disconnect": "graceful-degrade",
    "cleanup": "explicit"
  }
}
