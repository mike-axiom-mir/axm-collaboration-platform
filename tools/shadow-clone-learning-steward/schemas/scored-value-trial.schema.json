{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.shadow-clone.scored-value-trial/v1",
  "title": "AXM Shadow Clone Scored Value Trial",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trialId", "asOf", "rubric", "cases"],
  "properties": {
    "schema": { "const": "axm.shadow-clone.scored-value-trial/v1" },
    "trialId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,119}$" },
    "asOf": { "type": "string", "format": "date-time" },
    "rubric": { "type": "object" },
    "cases": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "object" } }
  }
}

