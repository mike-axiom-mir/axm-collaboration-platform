{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.shadow-clone.candidate-review-intake-request/v1",
  "title": "AXM Shadow Clone Candidate Review Intake Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requestId", "asOf", "lessonKey", "candidateDigest", "reviewPacketDigest", "prospectivePlanDigest", "assignmentRequestId", "reviewReceipt", "authorization"],
  "properties": {
    "schema": { "const": "axm.shadow-clone.candidate-review-intake-request/v1" },
    "requestId": { "$ref": "#/$defs/id" },
    "asOf": { "type": "string", "format": "date-time" },
    "lessonKey": { "$ref": "#/$defs/id" },
    "candidateDigest": { "$ref": "#/$defs/digest" },
    "reviewPacketDigest": { "$ref": "#/$defs/digest" },
    "prospectivePlanDigest": { "$ref": "#/$defs/digest" },
    "assignmentRequestId": { "$ref": "#/$defs/id" },
    "reviewReceipt": { "type": "object" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostAuthenticatedReviewReceipt", "authenticatedMikeIdentityDigest", "authorizationReceiptDigest", "automaticDecision"],
      "properties": {
        "hostAuthenticatedReviewReceipt": { "const": true },
        "authenticatedMikeIdentityDigest": { "$ref": "#/$defs/digest" },
        "authorizationReceiptDigest": { "$ref": "#/$defs/digest" },
        "automaticDecision": { "const": false }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,119}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
