{
  "schema": "axm.modern-asset-forge.phase0-requirements/v1",
  "requirements": [
    { "id": "MF-R00-PRESERVE-PS2", "required": true, "capabilities": ["preserve.ps2"] },
    { "id": "MF-R01-SCHEMAS", "required": true, "capabilities": ["contract.manifest", "contract.receipt", "contract.asset-id"] },
    { "id": "MF-R02-SOURCE-DELIVERY-SPLIT", "required": true, "capabilities": ["separate.source.delivery"] },
    { "id": "MF-R03-BLENDER-EXPORT", "required": true, "capabilities": ["author.blend", "export.blender.glb"] },
    { "id": "MF-R04-GLTF-VALIDATION", "required": true, "capabilities": ["inspect.glb.local", "validate.gltf.khronos"] },
    { "id": "MF-R05-MESHOPT", "required": true, "capabilities": ["optimize.gltf.transform", "compress.meshopt"] },
    { "id": "MF-R06-KTX2", "required": true, "capabilities": ["encode.ktx2.basis", "validate.ktx2.independent", "integrate.ktx2.gltf"] },
    { "id": "MF-R07-WEBGL2-RUNTIME", "required": true, "capabilities": ["render.webgl2.gltf", "render.webgl2.ktx2", "render.webgl2.meshopt", "observe.browser.smoke"] },
    { "id": "MF-R08-LOCAL-ONLY", "required": true, "capabilities": ["enforce.no-network"] },
    { "id": "MF-R09-WORKLOAD-MODE", "required": true, "capabilities": ["govern.workload.mode"] },
    { "id": "MF-R10-OBSERVABILITY", "required": false, "capabilities": ["measure.asset.metrics", "measure.system.performance"] }
  ]
}
