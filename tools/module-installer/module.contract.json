  "boundaries": {
    "writes": ["state/module-installer", "backups/module-installer", "tools/approved-module-id"],
    "refuses": ["path-traversal", "symbolic-link-install", "unselected-file-return", "changed-context-return", "stale-build-on-base", "ambiguous-multiple-module-return", "unreviewed-install", "digest-drift", "rollback-current-digest-drift", "historical-selftest-receipt-as-current-proof", "arbitrary-root-write", "silent-overwrite", "install-without-backup", "unbounded-backup-retention", "network-download", "review-approval-as-install-authority", "structural-readiness-as-install-approval", "automatic-install", "automatic-rollback", "automatic-promotion"]
  },
  "lifecycle": {
    "state_owner": "service",
    "reload": "resume",
    "disconnect": "graceful-degrade",
    "cleanup": "explicit"
  }
}
