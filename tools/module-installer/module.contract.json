{
  "schema": "axm.module-contract/v1",
  "id": "module-installer",
  "version": "v0.3",
  "provides": ["module-bundle-intake", "returned-build-on-zip-intake", "exact-export-base-binding", "path-and-size-validation", "read-only-install-governance-lineage", "exact-digest-review-gate", "atomic-module-install", "single-generation-update-backup", "post-install-selftest-lineage", "current-digest-scoped-selftest-lineage", "rollback-current-digest-guard", "module-rollback"],
  "consumes": ["axm.workshop-package-return/v1", "axm.workshop-package/v1", "axm.module-bundle/v1", "service:review-inbox", "service:backup", "service:gate", "service:machine-host"],
  "permissions": ["module.install"],
  "handoffs": {
    "emits": ["axm.review-item/v1", "axm.module-install-governance-view/v1", "axm.module-install-receipt/v1", "axm.module-install-backup/v1", "axm.module-post-install-verification/v1"],
