{
  "schema": "axm.module-contract/v1", "id": "module-installer", "version": "v0.1",
  "provides": ["module-bundle-intake", "path-and-size-validation", "exact-digest-review-gate", "atomic-module-install", "versioned-update-backup", "module-rollback"],
  "consumes": ["axm.module-bundle/v1", "service:review-inbox", "service:backup", "service:gate"], "permissions": ["module.install"],
  "handoffs": {"emits": ["axm.review-item/v1", "axm.module-install-receipt/v1", "axm.module-install-backup/v1"], "accepts": ["axm.module-bundle/v1", "axm.review-vote/v1"]},
  "boundaries": {"writes": ["state/module-installer", "backups/module-installer", "tools/approved-module-id"], "refuses": ["path-traversal", "symbolic-link-install", "unreviewed-install", "digest-drift", "arbitrary-root-write", "silent-overwrite", "install-without-backup", "network-download"]},
  "lifecycle": {"state_owner": "service", "reload": "resume", "disconnect": "graceful-degrade", "cleanup": "explicit"}
}

