{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/enrichment-catalog.schema.json",
  "title": "AXM Human Capability Atlas Enrichment Catalog",
  "type": "object",
  "required": [
    "catalog_version",
    "module_registry",
    "global_truth",
    "source_files",
    "source_seal_hash",
    "modules",
    "issues",
    "catalog_hash",
    "summary"
  ],
  "properties": {
    "catalog_version": {
      "const": "0.2.0"
    },
    "repository_root_at_generation": {
      "type": "string"
    },
    "module_registry": {
      "type": "object"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "source_seal_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "modules": {
      "type": "object"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "catalog_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "summary": {
      "type": "object"
    },
    "global_truth": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
