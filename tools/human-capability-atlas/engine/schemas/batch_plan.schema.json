{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/batch-plan.schema.json",
  "title": "AXM Capability Production Batch Plan",
  "type": "object",
  "required": [
    "plan_version",
    "module_id",
    "module_version",
    "implementation_fingerprint",
    "shared_contract_version",
    "capability_record_export_format_version",
    "batch_size",
    "record_count",
    "batches",
    "generated_at",
    "source_at_generation",
    "summary",
    "plan_hash",
    "plan_semantic_hash",
    "upstream_ingestion"
  ],
  "properties": {
    "plan_version": {
      "const": "0.2.0"
    },
    "module_id": {
      "const": "axm.module.human_capability_atlas"
    },
    "module_version": {
      "type": "string",
      "minLength": 1
    },
    "implementation_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shared_contract_version": {
      "const": "0.1.0"
    },
    "capability_record_export_format_version": {
      "const": "0.1.0"
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "upstream_ingestion": {
      "type": "object",
      "required": [
        "ingestion_report_present",
        "ingestion_report_sha256",
        "preflight_status",
        "public_intake_in_progress",
        "ingest_in_progress",
        "source_seal_hash",
        "normalized_inventory_present",
        "normalized_inventory_hash",
        "normalized_inventory_semantic_hash",
        "normalized_inventory_valid",
        "summary",
        "public_intake_preflight"
      ],
      "properties": {
        "ingestion_report_present": {
          "type": "boolean"
        },
        "ingestion_report_sha256": {
          "type": "string"
        },
        "preflight_status": {
          "enum": [
            "READY",
            "TEST_HOLD_REVIEW",
            "UNSEALED_SCOPE",
            "UNVERIFIED_SCOPE"
          ]
        },
        "source_seal_hash": {
          "type": "string"
        },
        "enrichment_catalog_hash": {
          "type": "string"
        },
        "enrichment_source_seal_hash": {
          "type": "string"
        },
        "ingestion_module_version": {
          "type": "string"
        },
        "public_intake_preflight": {
          "type": "object",
          "required": [
            "present",
            "status",
            "preflight_hash",
            "preflight_semantic_hash",
            "file_sha256",
            "verification_valid",
            "repository_snapshot_hash",
            "discovery_bundle_hash"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "status": {
              "type": "string"
            },
            "preflight_hash": {
              "type": "string"
            },
            "file_sha256": {
              "type": "string"
            },
            "verification_valid": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "repository_snapshot_hash": {
              "type": "string"
            },
            "discovery_bundle_hash": {
              "type": "string"
            },
            "preflight_semantic_hash": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "summary": {
          "type": "object"
        },
        "normalized_inventory_present": {
          "type": "boolean"
        },
        "normalized_inventory_hash": {
          "type": "string"
        },
        "normalized_inventory_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "normalized_inventory_semantic_hash": {
          "type": "string"
        },
        "ingest_in_progress": {
          "type": "boolean"
        },
        "public_intake_in_progress": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "batch_id",
          "records",
          "record_count",
          "batch_hash"
        ],
        "properties": {
          "batch_id": {
            "type": "string",
            "pattern": "^batch_[0-9]{4}$"
          },
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "record_key",
                "capability_id",
                "capability_revision",
                "source_hash",
                "source_pointer",
                "source_line",
                "normalized_source_semantic_sha256",
                "normalized_filename"
              ],
              "properties": {
                "record_key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{20}$"
                },
                "capability_id": {
                  "type": "string",
                  "minLength": 1
                },
                "capability_revision": {
                  "type": "string",
                  "minLength": 1
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_pointer": {
                  "type": "string"
                },
                "source_line": {
                  "type": "string"
                },
                "normalized_source_semantic_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "normalized_filename": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "record_count": {
            "type": "integer",
            "minimum": 1
          },
          "batch_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "source_at_generation": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "required": [
        "record_count",
        "batch_count",
        "batch_size",
        "last_batch_size"
      ],
      "properties": {
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "batch_count": {
          "type": "integer",
          "minimum": 1
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "last_batch_size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_semantic_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
