{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/normalized-inventory.schema.json",
  "title": "AXM Normalized Capability Inventory",
  "type": "object",
  "required": [
    "inventory_version",
    "intake_root_at_generation",
    "generated_at",
    "records",
    "summary",
    "inventory_semantic_hash",
    "inventory_hash"
  ],
  "properties": {
    "inventory_version": {
      "const": "0.1.0"
    },
    "intake_root_at_generation": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relative_path",
          "bytes",
          "file_sha256",
          "record_key",
          "capability_id",
          "capability_revision",
          "source_hash",
          "source_pointer",
          "source_line",
          "normalized_source_semantic_sha256"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "record_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{20}$"
          },
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "capability_revision": {
            "type": "string",
            "minLength": 1
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_pointer": {
            "type": "string"
          },
          "source_line": {
            "type": "string"
          },
          "normalized_source_semantic_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "record_count",
        "total_bytes"
      ],
      "properties": {
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "inventory_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inventory_semantic_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
