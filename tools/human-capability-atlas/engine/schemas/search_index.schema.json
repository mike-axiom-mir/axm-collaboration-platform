{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/search-index.schema.json",
  "title": "AXM Deterministic Capability Search Index",
  "type": "object",
  "required": ["module", "module_version", "shared_contract_version", "operation", "generated_at", "summary", "field_weights", "records", "postings", "facets", "integrity_notes"],
  "properties": {
    "module": {"const": "AXM Human Capability Atlas"},
    "module_version": {"type": "string"},
    "shared_contract_version": {"const": "0.1.0"},
    "operation": {"const": "deterministic_capability_search_index"},
    "generated_at": {"type": "string"},
    "summary": {"type": "object"},
    "field_weights": {"type": "object"},
    "records": {"type": "object"},
    "postings": {"type": "object"},
    "facets": {"type": "object"},
    "integrity_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
