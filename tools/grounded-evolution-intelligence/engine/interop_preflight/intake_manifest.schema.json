{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/gei/three-module-intake-manifest/v1",
  "title": "AXM Three-Module Intake Manifest",
  "type": "object",
  "properties": {
    "schema": {"const": "axm.three-module-intake-manifest/v1"},
    "module_id": {"type":"string","pattern":"^axm:module:[a-z0-9][a-z0-9._-]{2,127}$"},
    "package_name": {"type":"string","minLength":1},
    "package_version": {"type":"string","minLength":1},
    "shared_contract_version": {"type":"string","minLength":1},
    "artifact_hash": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "source_kind": {"enum":["REAL_PACKAGE","REFERENCE_ONLY"]},
    "exports": {
      "type":"object",
      "properties": {
        "capability_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "interface_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "evidence_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true}
      },
      "required":["capability_ids","interface_ids","evidence_ids"],"additionalProperties":false
    },
    "references": {
      "type":"object",
      "properties": {
        "capability_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "interface_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "module_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true}
      },
      "required":["capability_ids","interface_ids","module_ids"],"additionalProperties":false
    },
    "record_inventory": {
      "type":"array",
      "items": {
        "type":"object",
        "properties": {
          "record_id":{"type":"string","minLength":1},
          "kind":{"type":"string","minLength":1},
          "digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}
        },
        "required":["record_id","kind","digest"],"additionalProperties":false
      }
    },
    "authority": {
      "type":"object",
      "properties": {
        "execution_authority":{"const":false},
        "canon_authority":{"const":false},
        "silent_overwrite_authority":{"const":false}
      },
      "required":["execution_authority","canon_authority","silent_overwrite_authority"],"additionalProperties":false
    }
  },
  "required":["schema","module_id","package_name","package_version","shared_contract_version","artifact_hash","source_kind","exports","references","record_inventory","authority"],
  "additionalProperties":false
}
