{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/gei/v0.1.0/interface_intelligence_reference.schema.json",
  "title": "Human Interface Intelligence Reference",
  "type": "object",
  "properties": {
    "interface_record_id": {
      "type": "string",
      "pattern": "^axm:(module|capability|interface|evidence|edge|need|research|direction|intervention|decision|event|packet):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "source_module_id": {
      "type": "string",
      "pattern": "^axm:(module|capability|interface|evidence|edge|need|research|direction|intervention|decision|event|packet):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^axm:(module|capability|interface|evidence|edge|need|research|direction|intervention|decision|event|packet):[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "interface_pattern": {
      "type": "string",
      "minLength": 1
    },
    "target_humans": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "environment_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "available_resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "suitability_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unsuitable_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "beginner_layer": {
      "type": [
        "string",
        "null"
      ]
    },
    "interaction_modes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^axm:(module|capability|interface|evidence|edge|need|research|direction|intervention|decision|event|packet):[a-z0-9][a-z0-9._-]{2,127}$"
      },
      "uniqueItems": true
    },
    "truth_state": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "DECLARED",
        "TESTED",
        "REPRODUCED",
        "INFERRED",
        "HYPOTHESIS",
        "CONFLICTED",
        "OBSOLETE",
        "UNKNOWN"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_record_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "interface_record_id",
    "contract_version",
    "source_module_id",
    "capability_id",
    "interface_pattern",
    "target_humans",
    "environment_constraints",
    "available_resources",
    "suitability_reasons",
    "unsuitable_conditions",
    "beginner_layer",
    "interaction_modes",
    "evidence_references",
    "truth_state",
    "confidence",
    "source_record_version"
  ],
  "additionalProperties": false
}
