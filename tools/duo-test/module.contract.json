{
  "schema": "axm.module-contract/v1",
  "id": "duo-test",
  "version": "v3",
  "provides": [
    "supervised-two-local-identity-view",
    "independent-visible-prompt-comparison",
    "attributed-visible-answer-review-relay",
    "session-only-attributed-transcript"
  ],
  "consumes": [
    "workshop:foundation-runtime",
    "registry:connector-and-model-bound-identities",
    "identity:nova",
    "identity:gemini-local",
    "loopback:http://127.0.0.1:8787/local-models",
    "human:explicit-visible-prompt"
  ],
  "permissions": [],
  "handoffs": {
    "emits": [
      "browser-visible:attributed-session-transcript",
      "plain-text:attributed-nova-answer-review-request"
    ],
    "accepts": [
      "human:explicit-visible-prompt",
      "loopback:local-model-list",
      "identity-registry:bound-model-response"
    ]
  },
  "lifecycle": {
    "state_owner": "none",
    "reload": "reset",
    "disconnect": "graceful-degrade",
    "cleanup": "automatic"
  },
  "boundaries": {
    "reads": [
      "loopback:http://127.0.0.1:8787/local-models",
      "identity-registry:bound-context-per-request"
    ],
    "writes": [],
    "refuses": [
      "cross-identity-private-memory-transfer",
      "direct-identity-memory-read-or-write",
      "identity-route-bypass",
      "connector-or-model-lock-bypass",
      "cloud-or-remote-model-fallback",
      "hidden-prompt-or-relay-content",
      "automatic-wisdom-promotion",
      "automatic-background-dispatch",
      "unbounded-model-loop",
      "transcript-as-verification-evidence",
      "direct-workshop-source-write",
      "external-network-access-outside-loopback-model-discovery",
      "manifest-status-change",
      "automatic-workshop-status-promotion",
      "canon-authority"
    ]
  }
}
