{
  "schema": "axm.module-contract/v1",
  "id": "holodeck-screen-deck",
  "version": "v0.1",
  "provides": [
    "holodeck.world.validate/v1",
    "holodeck.world.compile/v1",
    "holodeck.intent.dispatch/v1",
    "holodeck.sensor.observe/v1",
    "holodeck.state.snapshot/v1",
    "holodeck.adapter.screen/v1",
    "holodeck.experience.echo-atrium/v1"
  ],
  "consumes": [
    "axm.holodeck-world/v1",
    "axm.holodeck-render-adapter/v1",
    "local-human-input",
    "local-webgl",
    "shared-three-r160"
  ],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.holodeck-deck-plan/v1", "axm.holodeck-intent-receipt/v1", "axm.holodeck-sensor-frame/v1", "axm.holodeck-state-snapshot/v1"],
    "accepts": ["axm.holodeck-world/v1", "axm.holodeck-intent/v1", "axm.holodeck-state-snapshot/v1"]
  },
  "boundaries": {
    "writes": ["browser-local:axm.holodeck.snapshot.v1:explicit-only"],
    "refuses": [
      "automatic-world-save",
      "automatic-world-restore",
      "automatic-world-promotion",
      "actor-kind-as-extra-permission",
      "render-coordinate-as-canonical-state",
      "structured-proximity-as-camera-vision",
      "vr-or-ar-implementation-claim",
      "hologram-hardware-claim",
      "physical-world-manipulation-claim",
      "scientific-reality-simulation-claim",
      "runtime-network-dependency"
    ]
  },
  "lifecycle": {
    "state_owner": "browser",
    "reload": "reset",
    "disconnect": "graceful-degrade",
    "cleanup": "explicit"
  }
}
