{
  "schema": "axm.module-contract/v1",
  "id": "host-assumption-observatory",
  "version": "v0.2",
  "provides": [
    "declared-host-assumption-inventory",
    "filesystem-browser-network-and-runtime-syntax-separation",
    "operating-system-path-and-environment-variable-syntax-observation",
    "unprobed-assumption-state",
    "freshness-bound-host-assumption-observation",
    "single-module-environment-probe-request"
  ],
  "consumes": [
    "filesystem/workshop-root"
  ],
  "permissions": [],
  "handoffs": {
    "emits": [
      "axm.host-assumption-map/v1",
      "axm.environment-probe-request/v1"
    ],
    "accepts": [
      "filesystem/workshop-root"
    ]
  },
  "boundaries": {
    "writes": [
      "explicit-user-selected-output-only"
    ],
    "refuses": [
      "source-prose-inference",
      "undeclared-assumption-inference",
      "actual-host-probing",
      "probe-request-execution",
      "secret-or-environment-value-capture",
      "compatibility-proof",
      "readiness-proof",
      "tool-availability-proof",
      "path-existence-proof",
      "network-reachability-proof",
      "permission-grant",
      "dependency-installation",
      "path-rewrite",
      "source-mutation",
      "filesystem-symlink-following",
      "installer-staging",
      "installation",
      "promotion",
      "canon-change"
    ]
  },
  "lifecycle": {
    "state_owner": "none",
    "reload": "reset",
    "disconnect": "not-applicable",
    "cleanup": "not-applicable"
  }
}
