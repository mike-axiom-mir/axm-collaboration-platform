{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.modular-growth-seed/v1",
  "title": "AXM Modular Growth Seed",
  "type": "object",
  "required": [
    "schema",
    "version",
    "seedId",
    "title",
    "goal",
    "maturity",
    "truth",
    "provenance",
    "growthBudget",
    "modules",
    "growthProtocol",
    "intake",
    "integrity"
  ],
  "properties": {
    "schema": { "const": "axm.modular-growth-seed/v1" },
    "version": { "const": "1.0.0" },
    "seedId": { "type": "string", "pattern": "^seed-[a-z0-9-]+-[a-f0-9]{8}$" },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "maturity": { "const": "SEED" },
    "truth": {
      "type": "object",
      "required": ["installedCapability", "executedEvidence", "automaticGrowth", "automaticIntake", "automaticPromotion"],
      "properties": {
        "installedCapability": { "const": false },
        "executedEvidence": { "const": false },
        "automaticGrowth": { "const": false },
        "automaticIntake": { "const": false },
        "automaticPromotion": { "const": false }
      }
    },
    "growthBudget": {
      "type": "object",
      "required": ["suggestedHumanInitiatedRuns", "maximumChildCandidatesPerSeedPerRun", "maximumCandidatesPerRun", "automaticRun"],
      "properties": {
        "suggestedHumanInitiatedRuns": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maximumChildCandidatesPerSeedPerRun": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maximumCandidatesPerRun": { "type": "integer", "minimum": 1, "maximum": 48 },
        "automaticRun": { "const": false }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "evidenceStatus", "authority", "lane", "purpose", "contract", "work", "disconfirmingTests"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
          "status": { "const": "SEED" },
          "evidenceStatus": { "const": "UNTESTED" },
          "authority": { "const": "NONE" },
          "lane": { "enum": ["core", "interface", "evidence", "safety", "exchange", "evolution"] }
        }
      }
    },
    "intake": {
      "type": "object",
      "required": ["target", "humanReviewRequired", "installAuthority", "promotionAuthority"],
      "properties": {
        "target": { "const": "modular-intake-gate" },
        "humanReviewRequired": { "const": true },
        "installAuthority": { "const": false },
        "promotionAuthority": { "const": false }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "semanticDigest", "excludes"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "semanticDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
