      "automatic-promotion",
      "automatic-publication",
      "seed-as-runtime-proof",
      "untested-claim-as-capability",
      "identity-replacement-during-growth",
      "unbounded-growth-multiplier",
      "private-path-export",
      "network-access"
    ]
  },
  "lifecycle": {
    "state_owner": "browser",
    "reload": "resume",
    "disconnect": "not-applicable",
    "cleanup": "explicit"
  }
}
