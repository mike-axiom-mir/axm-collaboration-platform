{
  "schema": "axm.module-contract/v1",
  "id": "pbr-material-baker",
  "version": "v0.1",
  "status": "EXPERIMENTAL",
  "provides": [
    "seeded-local-pbr-material-baking",
    "non-flat-albedo-normal-height-signal",
    "open-gl-tangent-space-normal-map",
    "independently-decodable-packed-orm",
    "emissive-map-output",
    "six-game-material-families",
    "local-cpu-reference-render",
    "exact-map-pixel-digest-receipts"
  ],
  "consumes": ["axm.pbr-material-recipe/v1", "human-material-direction", "human-visual-approval"],
  "permissions": ["export"],
  "lifecycle": {"state_owner":"browser","reload":"reset","disconnect":"graceful-degrade","cleanup":"automatic"},
