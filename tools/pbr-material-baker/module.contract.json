    "refuses": [
      "automatic-library-promotion",
      "automatic-candidate-retention",
      "visual-quality-approval-by-statistics",
      "flat-map-labelled-as-baked-signal",
      "undeclared-normal-map-convention",
      "undeclared-channel-packing",
      "ps3-quality-claim-from-map-presence",
      "runtime-external-network-dependency"
    ]
  }
}
