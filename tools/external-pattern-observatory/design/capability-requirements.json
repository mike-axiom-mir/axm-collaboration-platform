{
  "requirements": [
    {
      "id": "compile-inert-review-cards",
      "required": true,
      "capabilities": [
        "strict-deterministic-canonical-json",
        "runtime:sha256",
        "external-pattern.card.compile/v1"
      ]
    },
    {
      "id": "compare-and-preserve-disagreement",
      "required": true,
      "capabilities": [
        "external-pattern.snapshot.diff/v1",
        "external-pattern.assertion.resolve/v1"
      ]
    },
    {
      "id": "review-without-authority",
      "required": true,
      "capabilities": [
        "external-pattern.review.observe/v1"
      ]
    },
    {
      "id": "verify-current-upstream-license",
      "required": false,
      "capabilities": [
        "external-source.license.verify-pinned/v1"
      ]
    },
    {
      "id": "validate-draft-execution-profile-schema",
      "required": false,
      "capabilities": [
        "json-schema.draft-2020-12.validate/v1"
      ]
    }
  ]
}
