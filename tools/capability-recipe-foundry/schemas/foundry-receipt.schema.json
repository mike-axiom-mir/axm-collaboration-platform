{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.capability-recipe-foundry-receipt/v1",
  "title": "AXM capability recipe Foundry receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "intentRef", "planRef", "packetRef", "output", "truth", "authority", "receiptDigest"],
  "properties": {
    "schema": { "const": "axm.capability-recipe-foundry-receipt/v1" },
    "version": { "const": "1.1.0" },
    "status": { "const": "INACTIVE_REVIEW_PACKET_COMPLETE" },
    "intentRef": { "type": "object" },
    "planRef": { "type": "object" },
    "packetRef": { "type": "object" },
    "output": { "type": "object", "additionalProperties": false, "required": ["recipeId", "builderId", "capabilityKind", "fileCount", "totalBytes"], "properties": { "recipeId": { "type": "string" }, "builderId": { "type": "string" }, "capabilityKind": { "enum": ["HAND", "SKILL"] }, "fileCount": { "const": 8 }, "totalBytes": { "type": "integer", "minimum": 1, "maximum": 524288 } } },
    "truth": { "type": "object" },
    "authority": { "type": "object" },
    "receiptDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
