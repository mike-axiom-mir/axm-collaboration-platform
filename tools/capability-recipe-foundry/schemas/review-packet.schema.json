{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.capability-recipe-review-packet/v1",
  "title": "AXM capability recipe review packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "id", "status", "intentRef", "target", "source", "proposalRef", "files", "totalBytes", "truth", "authority", "packetDigest"],
  "properties": {
    "schema": { "const": "axm.capability-recipe-review-packet/v1" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "status": { "const": "EXPERIMENTAL_REVIEW_PACKET" },
    "intentRef": { "type": "object" },
    "target": { "type": "object" },
    "source": { "type": "object" },
    "proposalRef": { "type": "object" },
    "files": { "type": "array", "minItems": 1, "maxItems": 12 },
    "totalBytes": { "type": "integer", "minimum": 1, "maximum": 524288 },
    "truth": { "type": "object" },
    "authority": { "type": "object" },
    "packetDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
