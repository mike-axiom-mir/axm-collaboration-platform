{
  "schema": "axm.module-contract/v1",
  "id": "protocol-version-observatory",
  "version": "v0.1",
  "provides": [
    "exact-protocol-token-role-inventory",
    "axm-slash-version-family-map",
    "multi-version-declaration-observation",
    "future-protocol-declaration-observation",
    "freshness-bound-protocol-version-surface"
  ],
  "consumes": [
    "filesystem/workshop-root"
  ],
  "permissions": [],
  "handoffs": {
    "emits": [
      "axm.protocol-version-surface/v1"
    ],
    "accepts": [
      "filesystem/workshop-root"
    ]
  },
  "boundaries": {
    "writes": [
      "explicit-user-selected-output-only"
    ],
    "refuses": [
      "non-axm-version-syntax-guessing",
      "protocol-validation",
      "compatibility-inference",
      "preferred-version-selection",
      "migration-generation",
      "adapter-generation",
      "declaration-rewrite",
      "source-mutation",
      "filesystem-symlink-following",
      "network-access",
      "installer-staging",
      "module-installation",
      "permission-change",
      "promotion",
      "canon-change"
    ]
  },
  "lifecycle": {
    "state_owner": "none",
    "reload": "reset",
    "disconnect": "not-applicable",
    "cleanup": "not-applicable"
  }
}
