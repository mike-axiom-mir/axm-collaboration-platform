{
  "requirements": [
    {
      "id": "author-bounded-game",
      "required": true,
      "capabilities": [
        "game.brief.typed",
        "game.candidate.generate.deterministic",
        "game.project.game-forge-compatible"
      ]
    },
    {
      "id": "build-inside-repaired-sandbox",
      "required": true,
      "capabilities": [
        "sandbox.source-output-evidence.disjoint",
        "sandbox.candidate.build.allowlisted",
        "sandbox.network.default-deny",
        "sandbox.host-authority.not-inherited",
        "sandbox.resource.bytes-enforced"
      ]
    },
    {
      "id": "grow-without-installing",
      "required": true,
      "capabilities": [
        "sandbox.candidate.repair.immutable-iterations",
        "sandbox.lesson.candidate.privacy-safe"
      ]
    },
    {
      "id": "prove-one-playable-game",
      "required": true,
      "capabilities": [
        "game.runtime.browser",
        "visual.capture.live",
        "game.play.journey",
        "game.accessibility.keyboard"
      ]
    },
    {
      "id": "show-before-installation",
      "required": true,
      "capabilities": [
        "game.install.review-packet",
        "game.install.human-gate"
      ]
    },
    {
      "id": "future-persistent-game",
      "required": false,
      "capabilities": [
        "game.persistence.restart"
      ]
    }
  ]
}

