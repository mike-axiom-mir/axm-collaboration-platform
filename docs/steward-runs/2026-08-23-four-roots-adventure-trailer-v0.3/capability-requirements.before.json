{
  "requirements": [
    {
      "id": "derive-truthful-game-trailer-plan",
      "required": true,
      "capabilities": [
        "game.content.exact-byte-source",
        "game.trailer.plan.deterministic",
        "game.trailer.claims.evidence-bound",
        "game.trailer.root-order.preserved"
      ]
    },
    {
      "id": "render-real-native-video",
      "required": true,
      "capabilities": [
        "game.trailer.rgba-frame-renderer",
        "video.native-vips-runtime.observed",
        "video.native-mp4-motion-jpeg",
        "video.native-webm-vp8",
        "video.sparse-sequence.bounded"
      ]
    },
    {
      "id": "explain-and-market-without-inflation",
      "required": true,
      "capabilities": [
        "game.trailer.controls.explained",
        "game.trailer.proven-counts.advertised",
        "game.trailer.caption-companion",
        "game.trailer.limitations.visible"
      ]
    },
    {
      "id": "prove-the-media-output",
      "required": true,
      "capabilities": [
        "video.container.structure.verify",
        "video.first-middle-last.decode",
        "video.browser.playback.observe",
        "video.duration-and-frame-count.verify"
      ]
    },
    {
      "id": "preserve-human-publication-authority",
      "required": true,
      "capabilities": [
        "video.output.test-only",
        "video.publish.separate-human-gate",
        "video.public-rights.hold",
        "video.canon.self-change.denied"
      ]
    }
  ]
}
