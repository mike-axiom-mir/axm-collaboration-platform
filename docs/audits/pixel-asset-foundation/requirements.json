{
  "requirements": [
    {
      "id": "bounded-png-raster-foundation",
      "required": true,
      "capabilities": [
        "asset.raster.source.preserve-exact",
        "asset.raster.recipe.apply",
        "asset.raster.crop",
        "asset.raster.trim-alpha",
        "asset.raster.resize-nearest",
        "asset.raster.pad-anchor",
        "asset.raster.alpha-threshold",
        "asset.raster.palette-map",
        "asset.sprite.grid-slice",
        "asset.sprite.grid-pack"
      ]
    },
    {
      "id": "lineage-and-reproduction",
      "required": true,
      "capabilities": [
        "asset.recipe.persist",
        "asset.provenance.parent-child",
        "asset.integrity.sha256",
        "asset.validation.pixel-repeat",
        "asset.export.png-json"
      ]
    },
    {
      "id": "research-v0-multi-format-import",
      "required": false,
      "capabilities": ["asset.import.jpeg", "asset.import.webp"]
    },
    {
      "id": "research-v0-live-pixel-preview",
      "required": false,
      "capabilities": ["visual.preview.integer-zoom", "visual.preview.game-context"]
    },
    {
      "id": "research-v0-downstream-adapter",
      "required": false,
      "capabilities": ["asset.export.tiled-or-godot"]
    },
    {
      "id": "later-semantic-and-generative-assist",
      "required": false,
      "capabilities": [
        "asset.semantic.mask-proposal",
        "asset.pixel.structured-abstraction",
        "asset.pixel.generative-variant"
      ]
    },
    {
      "id": "pixel-animation-workflow-profiles",
      "required": true,
      "capabilities": [
        "asset.pixel.profile.8bit",
        "asset.pixel.profile.16bit",
        "asset.animation.frame-metadata",
        "asset.animation.timing-validation",
        "asset.animation.integer-preview.encode"
      ]
    },
    {
      "id": "game-video-modular-bridges",
      "required": true,
      "capabilities": [
        "asset.animation.apng-variable-timing",
        "asset.animation.game-spine-adapter",
        "asset.animation.video-sequence",
        "asset.animation.author-provenance",
        "asset.factory.hand-registration"
      ]
    }
  ]
}
