# Dependencies and local caches
/node_modules/
/.cache/
/.tmp/

# Local runtime state; exported artifacts are reviewed before separate release
/state/
/saves/
/logs/
/backups/
/exports/
/runtime/
/sessions/
/cache/
/tmp/
/projects/
# Intake staging is private by default. Exact reviewed, public-safe runtime
# dependencies are deliberately versioned; sibling intakes remain private.
/intakes/*
!/intakes/ai-team-collaboration-runs-01-101-v1/
!/intakes/ai-team-collaboration-runs-01-101-v1/**
!/intakes/universal-object-fabric-v0.7.0-2026-07-28/
