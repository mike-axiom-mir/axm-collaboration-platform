/distributions/
/AXM_START_REPORT.txt

# Imported working packs and archive-review lanes are local intake material.
/_archive_review_*/
/AXM_*_WORKING*/
/AXM_*_PACK_*/
/AXM_AETHERGLASS_VISUAL_ENGINE_*/
/AXM_VISUAL_HANDSHAKE_*/

# Derived evidence/build caches; production game runtime folders remain tracked.
**/rollback/
**/__pycache__/
**/.pytest_cache/
**/coverage/

# Local credentials, tokens, and machine overrides
.env
.env.*
bridge/bridge-token.txt
bridge/bridge.log
**/*.local.json
**/*.local.txt

