{
  "schema": "axm.mirror.training-policy/v1",
  "automaticTraining": false,
  "automaticCanonPromotion": false,
  "requiredUsePermission": "allowed",
  "acceptedMaterial": [
    "task statements",
    "declared evidence references",
    "reviewable decisions",
    "explicit alternatives",
    "verifier results",
    "corrections",
    "observed outcomes",
    "structured Mirror traces"
  ],
  "refusedMaterial": [
    "private hidden chain-of-thought",
    "internal scratchpads",
    "secrets or credentials",
    "content whose training rights are unknown or forbidden",
    "unattributed outputs",
    "claims promoted only by fluent wording"
  ],
  "promotionGate": "explicit-human-review-plus-evidence",
  "truth": "Candidate artifacts are a future compression corpus, not proof that a model has learned them."
}
