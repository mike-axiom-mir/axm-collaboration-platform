{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/universal-object-manifest-v0.5.schema.json",
  "title": "AXM Universal Object Manifest v0.5",
  "type": "object",
  "required": ["schema_version", "object_identity", "asset_id", "asset_version", "contract_version", "source_binding", "contracts", "industry_outputs", "validation_status"],
  "properties": {
    "schema_version": {"const": "0.5"},
    "object_identity": {"type": "string", "minLength": 8},
    "asset_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{1,95}$"},
    "asset_version": {"type": "string"},
    "contract_version": {"type": "string"},
    "source_binding": {"type": "string"},
    "contracts": {
      "type": "object",
      "required": ["source", "materials", "assembly", "constraints"],
      "additionalProperties": {"type": "string"}
    },
    "industry_outputs": {
      "type": "object",
      "required": ["game", "runtime_capsule", "visual_skin", "simulation", "robotics", "urdf_concept", "architecture", "cinematic", "manufacturing", "openusd_preview", "diagram"],
      "additionalProperties": {"type": "string"}
    },
    "validation_status": {"enum": ["PASS", "WARN", "FAIL"]},
    "generated_utc": {"type": "string"},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
