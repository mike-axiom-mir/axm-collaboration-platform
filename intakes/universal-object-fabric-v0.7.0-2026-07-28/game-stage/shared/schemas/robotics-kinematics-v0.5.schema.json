{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/robotics-kinematics-v0.5.schema.json",
  "title": "AXM Robotics Kinematics Concept v0.5",
  "type": "object",
  "required": ["schema_version", "asset_id", "asset_version", "coordinate_contract", "root_link", "links", "joints", "authority", "scope_limit"],
  "properties": {
    "schema_version": {"const": "0.5"},
    "asset_id": {"type": "string"},
    "asset_version": {"type": "string"},
    "coordinate_contract": {
      "type": "object",
      "required": ["linear_unit", "angle_unit", "up", "forward"],
      "properties": {
        "linear_unit": {"const": "meter"},
        "angle_unit": {"const": "radian"},
        "up": {"const": "+Y"},
        "forward": {"const": "+Z"}
      },
      "additionalProperties": true
    },
    "root_link": {"type": ["string", "null"]},
    "links": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["link_id", "member_nodes"]}},
    "joints": {"type": "array", "items": {"type": "object", "required": ["joint_id", "type", "parent_link", "child_link", "axis", "pivot_m"]}},
    "authority": {
      "type": "object",
      "required": ["automatic_physical_control", "actuator_mapping", "controller_mapping", "emergency_stop", "human_engineering_review_required"],
      "properties": {
        "automatic_physical_control": {"const": false},
        "human_engineering_review_required": {"const": true}
      },
      "additionalProperties": true
    },
    "scope_limit": {"type": "string", "minLength": 20}
  },
  "additionalProperties": true
}
