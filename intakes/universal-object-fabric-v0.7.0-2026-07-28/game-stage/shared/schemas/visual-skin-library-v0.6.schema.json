{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/visual-skin-library-v0.6.schema.json",
  "title": "AXM Visual Skin Library v0.6",
  "type": "object",
  "required": ["schema_version", "library_id", "version", "status", "profiles", "truth_boundary"],
  "properties": {
    "schema_version": {"const": "0.6"},
    "library_id": {"const": "AXM-VISUAL-SKIN-LIBRARY"},
    "version": {"type": "string"},
    "status": {"type": "string"},
    "purpose": {"type": "string"},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["profile_id", "name", "status", "portable_pbr", "renderer_hints", "layer_slots", "external_capabilities"],
        "properties": {
          "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
          "name": {"type": "string", "minLength": 2},
          "status": {"type": "string"},
          "portable_pbr": {
            "type": "object",
            "required": [
              "base_color_multiplier",
              "opacity_multiplier",
              "metallic_multiplier",
              "metallic_offset",
              "roughness_multiplier",
              "roughness_offset",
              "emissive_multiplier",
              "transmission_floor",
              "ior_override",
              "depth_write",
              "double_sided"
            ],
            "properties": {
              "base_color_multiplier": {
                "type": "array",
                "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "opacity_multiplier": {"type": "number", "minimum": 0, "maximum": 1},
              "metallic_multiplier": {"type": "number", "minimum": 0, "maximum": 4},
              "metallic_offset": {"type": "number", "minimum": -1, "maximum": 1},
              "roughness_multiplier": {"type": "number", "minimum": 0, "maximum": 4},
              "roughness_offset": {"type": "number", "minimum": -1, "maximum": 1},
              "emissive_multiplier": {"type": "number", "minimum": 0, "maximum": 8},
              "transmission_floor": {"type": "number", "minimum": 0, "maximum": 1},
              "ior_override": {"type": ["number", "null"], "minimum": 1, "maximum": 3},
              "depth_write": {"enum": ["AUTO", "ON", "OFF"]},
              "double_sided": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "renderer_hints": {"type": "object"},
          "layer_slots": {"type": "array", "items": {"type": "object"}},
          "external_capabilities": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      }
    },
    "truth_boundary": {"type": "string", "minLength": 40}
  },
  "additionalProperties": false
}
