{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/visual-skin-binding-v0.6.schema.json",
  "title": "AXM Visual Skin Binding v0.6",
  "type": "object",
  "required": [
    "schema_version",
    "asset_id",
    "asset_version",
    "skin_library",
    "requested_variants",
    "fallback_variant",
    "variants",
    "effect_sockets",
    "state_routing",
    "truth_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "0.6"},
    "asset_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{1,95}$"},
    "asset_version": {"type": "string"},
    "skin_library": {
      "type": "object",
      "required": ["library_id", "version", "sha256"],
      "properties": {
        "library_id": {"const": "AXM-VISUAL-SKIN-LIBRARY"},
        "version": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "source_material_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requested_variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "available_library_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "fallback_variant": {"type": "string"},
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "profile_id",
          "name",
          "status",
          "portable_fallback",
          "renderer_hints",
          "layer_slots",
          "external_capabilities"
        ],
        "properties": {
          "profile_id": {"type": "string"},
          "name": {"type": "string"},
          "status": {"type": "string"},
          "portable_fallback": {
            "type": "object",
            "required": ["node_count", "nodes"],
            "properties": {
              "node_count": {"type": "integer", "minimum": 0},
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["node", "material_profile", "semantic_role", "appearance"],
                  "properties": {
                    "node": {"type": "string"},
                    "material_profile": {"type": "string"},
                    "semantic_role": {"type": "string"},
                    "appearance": {"type": "object"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "renderer_hints": {"type": "object"},
          "layer_slots": {"type": "array", "items": {"type": "object"}},
          "external_capabilities": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      }
    },
    "effect_sockets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "state_routing": {
      "type": "object",
      "required": ["mode", "bindings", "unmapped_states"],
      "properties": {
        "mode": {"const": "EXPLICIT-ONLY"},
        "bindings": {"type": "object"},
        "unmapped_states": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "truth_boundaries": {
      "type": "object",
      "required": [
        "geometry_modified",
        "physical_material_truth_modified",
        "simulation_modified",
        "manufacturing_authority",
        "renderer_claim"
      ],
      "properties": {
        "geometry_modified": {"const": false},
        "physical_material_truth_modified": {"const": false},
        "simulation_modified": {"const": false},
        "manufacturing_authority": {"const": false},
        "renderer_claim": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
