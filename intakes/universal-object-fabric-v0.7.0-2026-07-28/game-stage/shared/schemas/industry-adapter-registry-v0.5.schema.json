{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/industry-adapter-registry-v0.5.schema.json",
  "title": "AXM Industry Adapter Registry v0.5",
  "type": "object",
  "required": ["schema_version", "registry_id", "status", "adapters", "merge_rule"],
  "properties": {
    "schema_version": {"const": "0.5"},
    "registry_id": {"const": "AXM-INDUSTRY-ADAPTER-REGISTRY"},
    "status": {"type": "string"},
    "adapters": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["adapter_id", "domain", "status", "authority_limit"],
        "properties": {
          "adapter_id": {"type": "string"},
          "domain": {"type": "string"},
          "status": {"type": "string"},
          "authority_limit": {"type": "string", "minLength": 12}
        },
        "additionalProperties": true
      }
    },
    "merge_rule": {"type": "string", "minLength": 20}
  },
  "additionalProperties": true
}
