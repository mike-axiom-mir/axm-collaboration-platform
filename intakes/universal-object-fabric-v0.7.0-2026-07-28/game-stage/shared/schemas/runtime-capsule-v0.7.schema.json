{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/runtime-capsule-v0.7.schema.json",
  "title": "AXM Runtime Capsule v0.7",
  "type": "object",
  "required": [
    "schema_version",
    "capsule_version",
    "capsule_id",
    "asset",
    "source_binding",
    "coordinate_contract",
    "bounds_m",
    "lods",
    "collision",
    "sockets",
    "contracts",
    "states",
    "fallback_2d",
    "authority_limits",
    "generated_utc"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "vec3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "matrix4": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 16,
      "maxItems": 16
    }
  },
  "properties": {
    "schema_version": {"const": "0.7"},
    "capsule_version": {
      "type": "string",
      "pattern": "^0\\.7\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "capsule_id": {"type": "string", "minLength": 16},
    "asset": {
      "type": "object",
      "required": ["asset_id", "asset_version", "name", "family"],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]{1,95}$"
        },
        "asset_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "name": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source_binding": {
      "type": "object",
      "required": [
        "object_contract_sha256",
        "runtime_manifest",
        "source_glb",
        "binding_rule"
      ],
      "properties": {
        "object_contract_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_manifest": {
          "type": "object",
          "required": ["portable_path", "full_package_path", "sha256"],
          "properties": {
            "portable_path": {"$ref": "#/$defs/path"},
            "full_package_path": {"$ref": "#/$defs/path"},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "source_glb": {
          "type": "object",
          "required": ["portable_path", "full_package_path", "sha256"],
          "properties": {
            "portable_path": {"$ref": "#/$defs/path"},
            "full_package_path": {"$ref": "#/$defs/path"},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "binding_rule": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "coordinate_contract": {
      "type": "object",
      "required": ["linear_unit", "up", "forward", "import_scale"],
      "properties": {
        "linear_unit": {"const": "meter"},
        "up": {"const": "+Y"},
        "forward": {"const": "+Z"},
        "import_scale": {"const": 1.0}
      },
      "additionalProperties": false
    },
    "bounds_m": {
      "type": "object",
      "required": [
        "minimum_m",
        "maximum_m",
        "extents_m",
        "center_m",
        "footprint_xz_m",
        "height_m"
      ],
      "properties": {
        "minimum_m": {"$ref": "#/$defs/vec3"},
        "maximum_m": {"$ref": "#/$defs/vec3"},
        "extents_m": {"$ref": "#/$defs/vec3"},
        "center_m": {"$ref": "#/$defs/vec3"},
        "footprint_xz_m": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 2,
          "maxItems": 2
        },
        "height_m": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "lods": {
      "type": "object",
      "required": ["policy", "records", "selection_rule"],
      "properties": {
        "policy": {"type": "object"},
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["lod", "file", "faces", "bytes", "sha256"],
            "properties": {
              "lod": {"type": "integer", "minimum": 0},
              "file": {"$ref": "#/$defs/path"},
              "faces": {"type": "integer", "minimum": 0},
              "bytes": {"type": "integer", "minimum": 0},
              "sha256": {"$ref": "#/$defs/sha256"}
            },
            "additionalProperties": false
          }
        },
        "selection_rule": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "collision": {
      "type": "object",
      "required": [
        "status",
        "file",
        "file_sha256",
        "manifest",
        "manifest_sha256",
        "manifest_schema_version",
        "policy",
        "prefer_engine_primitives_when_available",
        "colliders",
        "runtime_rule"
      ],
      "properties": {
        "status": {"const": "DATA-CONTRACT"},
        "file": {"$ref": "#/$defs/path"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "manifest": {"$ref": "#/$defs/path"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_schema_version": {"type": "string", "minLength": 1},
        "policy": {"type": "string", "minLength": 1},
        "prefer_engine_primitives_when_available": {"type": "boolean"},
        "colliders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node", "shape", "policy", "game_unit"],
            "properties": {
              "node": {"type": "string", "minLength": 1},
              "source_component": {"type": "string"},
              "base_component": {"type": "string"},
              "shape": {"type": "string", "minLength": 1},
              "policy": {"type": "string", "minLength": 1},
              "game_unit": {"const": "meter"},
              "note": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "runtime_rule": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "sockets": {
      "type": "object",
      "required": [
        "file",
        "file_sha256",
        "manifest_schema_version",
        "records",
        "lookup_rule"
      ],
      "properties": {
        "file": {"$ref": "#/$defs/path"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_schema_version": {"type": "string", "minLength": 1},
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "purpose",
              "source_position_mm",
              "source_rotation_deg",
              "game_position_m",
              "game_matrix_column_major"
            ],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "purpose": {"type": "string"},
              "source_position_mm": {"$ref": "#/$defs/vec3"},
              "source_rotation_deg": {"$ref": "#/$defs/vec3"},
              "game_position_m": {"$ref": "#/$defs/vec3"},
              "game_matrix_column_major": {"$ref": "#/$defs/matrix4"}
            },
            "additionalProperties": true
          }
        },
        "lookup_rule": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "required": ["assembly", "materials"],
      "properties": {
        "assembly": {
          "type": "object",
          "required": ["path", "content_sha256", "validation_status"],
          "properties": {
            "path": {"$ref": "#/$defs/path"},
            "content_sha256": {"$ref": "#/$defs/sha256"},
            "validation_status": {"enum": ["PASS", "WARN", "UNKNOWN"]}
          },
          "additionalProperties": false
        },
        "materials": {
          "type": "object",
          "required": ["path", "content_sha256", "calibration_required"],
          "properties": {
            "path": {"$ref": "#/$defs/path"},
            "content_sha256": {"$ref": "#/$defs/sha256"},
            "calibration_required": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "states": {
      "type": "object",
      "required": [
        "default",
        "named",
        "interaction",
        "execution_status",
        "runtime_rule"
      ],
      "properties": {
        "default": {"type": "string", "minLength": 1},
        "named": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "interaction": {"type": "object"},
        "execution_status": {"const": "DECLARED-ONLY"},
        "runtime_rule": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "fallback_2d": {"type": "object"},
    "authority_limits": {
      "type": "object",
      "required": [
        "status",
        "automatic_engine_physics",
        "automatic_game_project_write",
        "gameplay_balance_authority",
        "physical_control_authority",
        "manufacturing_authority",
        "receiving_game_integration_claimed",
        "rule"
      ],
      "properties": {
        "status": {
          "const": "GAME-DATA-WORKING / RECEIVING-ENGINE-INTEGRATION-UNCLAIMED"
        },
        "automatic_engine_physics": {"const": false},
        "automatic_game_project_write": {"const": false},
        "gameplay_balance_authority": {"const": false},
        "physical_control_authority": {"const": false},
        "manufacturing_authority": {"const": false},
        "receiving_game_integration_claimed": {"const": false},
        "rule": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "generated_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "additionalProperties": false
}
