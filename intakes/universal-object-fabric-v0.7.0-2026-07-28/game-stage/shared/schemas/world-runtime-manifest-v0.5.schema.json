{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/world-runtime-manifest-v0.5.schema.json",
  "title": "AXM World Runtime Manifest v0.5",
  "type": "object",
  "required": ["schema_version", "world_id", "version", "game_glb", "linear_unit", "up", "forward", "instance_count", "unique_asset_count", "geometry_count", "triangle_count", "instances", "validation"],
  "properties": {
    "schema_version": {"const": "0.5"},
    "world_id": {"type": "string"},
    "version": {"type": "string"},
    "game_glb": {"type": "string"},
    "linear_unit": {"const": "meter"},
    "up": {"const": "+Y"},
    "forward": {"const": "+Z"},
    "instance_count": {"type": "integer", "minimum": 1},
    "unique_asset_count": {"type": "integer", "minimum": 1},
    "geometry_count": {"type": "integer", "minimum": 1},
    "triangle_count": {"type": "integer", "minimum": 1},
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "asset_id", "asset_version", "position_m", "source_runtime_manifest", "universal_object_manifest", "source_runtime_sha256", "source_glb_sha256"],
        "additionalProperties": true
      }
    },
    "validation": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["PASS", "WARN", "FAIL"]}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
