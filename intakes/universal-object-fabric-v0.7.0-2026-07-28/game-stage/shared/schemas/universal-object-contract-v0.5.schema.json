{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/universal-object-contract-v0.5.schema.json",
  "title": "AXM Universal Object Contract v0.5",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "source",
    "identity",
    "classification",
    "material_bindings",
    "node_material_bindings",
    "simulation",
    "assembly",
    "game",
    "architecture",
    "cinematic",
    "constraints",
    "manufacturing"
  ],
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "members",
        "pivot_m"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pivot_m": {
          "$ref": "#/$defs/vec3"
        },
        "allow_empty": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "joint": {
      "type": "object",
      "required": [
        "id",
        "type",
        "parent_group",
        "child_group",
        "axis",
        "pivot_m",
        "limits",
        "default",
        "drive"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "fixed",
            "revolute",
            "prismatic",
            "continuous"
          ]
        },
        "parent_group": {
          "type": "string"
        },
        "child_group": {
          "type": "string"
        },
        "axis": {
          "$ref": "#/$defs/vec3"
        },
        "pivot_m": {
          "$ref": "#/$defs/vec3"
        },
        "limits": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "degree",
                "radian",
                "meter"
              ]
            }
          },
          "additionalProperties": false
        },
        "default": {
          "type": "number"
        },
        "drive": {
          "type": "object"
        },
        "clearance_mm": {
          "type": "number",
          "minimum": 0
        },
        "human_confirmation_required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.5"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "source": {
      "type": "object",
      "required": [
        "asset_id",
        "asset_version"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]{1,95}$"
        },
        "asset_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "family",
        "lineage"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "lineage": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": [
        "industries",
        "human_meaning_required"
      ],
      "properties": {
        "industries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "human_meaning_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "material_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "node_material_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pattern",
          "profile_id"
        ],
        "properties": {
          "pattern": {
            "type": "string"
          },
          "profile_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "simulation": {
      "type": "object",
      "required": [
        "body_type",
        "game_mass_kg",
        "gravity",
        "friction_profile"
      ],
      "properties": {
        "body_type": {
          "enum": [
            "static",
            "dynamic",
            "kinematic"
          ]
        },
        "game_mass_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "gravity": {
          "type": "boolean"
        },
        "friction_profile": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "assembly": {
      "type": "object",
      "required": [
        "root_group",
        "groups",
        "joints"
      ],
      "properties": {
        "root_group": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "joints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/joint"
          }
        }
      },
      "additionalProperties": false
    },
    "game": {
      "type": "object",
      "required": [
        "interaction",
        "state_machine"
      ],
      "properties": {
        "interaction": {
          "type": "object"
        },
        "state_machine": {
          "type": "object",
          "required": [
            "states",
            "initial"
          ],
          "properties": {
            "states": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "initial": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "required": [
        "placement_class",
        "orientation",
        "clearance_zones",
        "connectors",
        "grid_snap_m"
      ],
      "properties": {
        "placement_class": {
          "type": "string"
        },
        "orientation": {
          "type": "object",
          "required": [
            "up",
            "forward"
          ],
          "properties": {
            "up": {
              "type": "string"
            },
            "forward": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "clearance_zones": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "connectors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "grid_snap_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "navigation": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "cinematic": {
      "type": "object",
      "required": [
        "hero_camera",
        "turntable",
        "lighting_roles",
        "effect_sockets",
        "material_variants"
      ],
      "properties": {
        "hero_camera": {
          "type": "object"
        },
        "turntable": {
          "type": "object"
        },
        "lighting_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effect_sockets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "material_variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "allowed_detached_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "manufacturing": {
      "type": "object",
      "required": [
        "status",
        "process_candidates",
        "material_candidates",
        "assembly_notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "pattern": "^(HOLD|TEST-HOLD|WORKING)"
        },
        "process_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "material_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assembly_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
