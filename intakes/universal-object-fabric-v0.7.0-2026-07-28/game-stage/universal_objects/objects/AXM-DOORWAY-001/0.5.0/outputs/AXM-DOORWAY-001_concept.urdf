<?xml version="1.0" encoding="utf-8"?>
<robot name="axm_doorway_001">
  <!--AXM UOF v0.5 concept only: no actuators, controllers, calibrated inertia, or physical-control authority.-->
  <link name="root">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="door_panel">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <joint name="door_lift" type="prismatic">
    <parent link="root" />
    <child link="door_panel" />
    <origin xyz="0 1.12 -0.08" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="2.15" effort="0" velocity="0" />
  </joint>
</robot>
