#usda 1.0
(
    defaultPrim = "AXM_DOORWAY_001"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "AXM_DOORWAY_001"
{
    custom string axmAssetId = "AXM-DOORWAY-001"
    custom string axmAssetVersion = "0.4.0"
    custom string axmUniversalContract = "0.5.0"
    custom string axmSourceGlb = "AXM-DOORWAY-001.glb"

    def Xform "AssemblyGroups"
    {
        def Xform "root"
        {
            custom string axmMembersJson = "[\"foot__l00\", \"foot__l01\", \"column__l00\", \"column__l01\", \"top_beam\", \"energy_strip__l00\", \"energy_strip__l01\", \"header_core\"]"
            custom double3 axmPivotM = (0.0, 0.0, 0.0)
        }
        def Xform "door_panel"
        {
            custom string axmMembersJson = "[\"door\"]"
            custom double3 axmPivotM = (0.0, 1.12, -0.08)
        }
    }

    def Xform "Joints"
    {
        def Xform "door_lift"
        {
            custom string axmJointType = "prismatic"
            custom string axmParentGroup = "root"
            custom string axmChildGroup = "door_panel"
            custom double3 axmAxis = (0.0, 1.0, 0.0)
            custom double3 axmPivotM = (0.0, 1.12, -0.08)
        }
    }
}

# Preview interchange only. Geometry remains in the referenced GLB;
# physics schemas are intentionally not claimed without usdchecker validation.
