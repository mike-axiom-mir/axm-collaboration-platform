#usda 1.0
(
    defaultPrim = "AXM_BARRIER_001"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "AXM_BARRIER_001"
{
    custom string axmAssetId = "AXM-BARRIER-001"
    custom string axmAssetVersion = "0.4.0"
    custom string axmUniversalContract = "0.5.0"
    custom string axmSourceGlb = "AXM-BARRIER-001.glb"

    def Xform "AssemblyGroups"
    {
        def Xform "root"
        {
            custom string axmMembersJson = "[\"foot__l00\", \"foot__l01\", \"post__l00\", \"post__l01\", \"light__l00\", \"light__l01\"]"
            custom double3 axmPivotM = (-0.7, 0.0, 0.0)
        }
        def Xform "arm"
        {
            custom string axmMembersJson = "[\"beam\", \"beam_insert\"]"
            custom double3 axmPivotM = (-0.7, 0.78, 0.0)
        }
    }

    def Xform "Joints"
    {
        def Xform "arm_lift"
        {
            custom string axmJointType = "revolute"
            custom string axmParentGroup = "root"
            custom string axmChildGroup = "arm"
            custom double3 axmAxis = (0.0, 0.0, 1.0)
            custom double3 axmPivotM = (-0.7, 0.78, 0.0)
        }
    }
}

# Preview interchange only. Geometry remains in the referenced GLB;
# physics schemas are intentionally not claimed without usdchecker validation.
