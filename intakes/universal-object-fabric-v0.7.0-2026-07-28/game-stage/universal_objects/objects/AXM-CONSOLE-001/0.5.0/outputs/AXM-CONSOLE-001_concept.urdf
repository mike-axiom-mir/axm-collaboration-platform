<?xml version="1.0" encoding="utf-8"?>
<robot name="axm_console_001">
  <!--AXM UOF v0.5 concept only: no actuators, controllers, calibrated inertia, or physical-control authority.-->
  <link name="root">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="button">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <joint name="button_press" type="prismatic">
    <parent link="root" />
    <child link="button" />
    <origin xyz="0 0.98 0.43" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.025" upper="0" effort="0" velocity="0" />
  </joint>
</robot>
