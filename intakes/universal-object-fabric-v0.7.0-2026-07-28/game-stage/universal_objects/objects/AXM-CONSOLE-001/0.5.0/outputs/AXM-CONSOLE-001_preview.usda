#usda 1.0
(
    defaultPrim = "AXM_CONSOLE_001"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "AXM_CONSOLE_001"
{
    custom string axmAssetId = "AXM-CONSOLE-001"
    custom string axmAssetVersion = "0.4.0"
    custom string axmUniversalContract = "0.5.0"
    custom string axmSourceGlb = "AXM-CONSOLE-001.glb"

    def Xform "AssemblyGroups"
    {
        def Xform "root"
        {
            custom string axmMembersJson = "[\"base\", \"pedestal\", \"panel\", \"screen\"]"
            custom double3 axmPivotM = (0.0, 0.0, 0.0)
        }
        def Xform "button"
        {
            custom string axmMembersJson = "[\"button__l00\", \"button__l01\", \"button__l02\", \"button__l03\"]"
            custom double3 axmPivotM = (0.0, 0.98, 0.43)
        }
    }

    def Xform "Joints"
    {
        def Xform "button_press"
        {
            custom string axmJointType = "prismatic"
            custom string axmParentGroup = "root"
            custom string axmChildGroup = "button"
            custom double3 axmAxis = (0.0, 0.0, 1.0)
            custom double3 axmPivotM = (0.0, 0.98, 0.43)
        }
    }
}

# Preview interchange only. Geometry remains in the referenced GLB;
# physics schemas are intentionally not claimed without usdchecker validation.
