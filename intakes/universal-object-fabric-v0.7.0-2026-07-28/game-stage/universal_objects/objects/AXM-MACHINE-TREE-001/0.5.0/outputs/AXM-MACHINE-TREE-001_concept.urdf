<?xml version="1.0" encoding="utf-8"?>
<robot name="axm_machine_tree_001">
  <!--AXM UOF v0.5 concept only: no actuators, controllers, calibrated inertia, or physical-control authority.-->
  <link name="root">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="heart">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <joint name="heart_spin" type="continuous">
    <parent link="root" />
    <child link="heart" />
    <origin xyz="0 1.82 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
</robot>
