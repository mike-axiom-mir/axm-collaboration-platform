#usda 1.0
(
    defaultPrim = "AXM_PICKUP_GEM_001"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "AXM_PICKUP_GEM_001"
{
    custom string axmAssetId = "AXM-PICKUP-GEM-001"
    custom string axmAssetVersion = "0.4.0"
    custom string axmUniversalContract = "0.5.0"
    custom string axmSourceGlb = "AXM-PICKUP-GEM-001.glb"

    def Xform "AssemblyGroups"
    {
        def Xform "root"
        {
            custom string axmMembersJson = "[\"base\"]"
            custom double3 axmPivotM = (0.0, 0.0, 0.0)
        }
        def Xform "gem"
        {
            custom string axmMembersJson = "[\"gem\"]"
            custom double3 axmPivotM = (0.0, 0.32, 0.0)
        }
        def Xform "lower_orbit"
        {
            custom string axmMembersJson = "[\"lower_orbit\"]"
            custom double3 axmPivotM = (0.0, 0.23, 0.0)
        }
        def Xform "upper_orbit"
        {
            custom string axmMembersJson = "[\"upper_orbit\"]"
            custom double3 axmPivotM = (0.0, 0.42, 0.0)
        }
    }

    def Xform "Joints"
    {
        def Xform "gem_spin"
        {
            custom string axmJointType = "continuous"
            custom string axmParentGroup = "root"
            custom string axmChildGroup = "gem"
            custom double3 axmAxis = (0.0, 1.0, 0.0)
            custom double3 axmPivotM = (0.0, 0.32, 0.0)
        }
        def Xform "lower_orbit_spin"
        {
            custom string axmJointType = "continuous"
            custom string axmParentGroup = "root"
            custom string axmChildGroup = "lower_orbit"
            custom double3 axmAxis = (0.0, 1.0, 0.0)
            custom double3 axmPivotM = (0.0, 0.23, 0.0)
        }
        def Xform "upper_orbit_spin"
        {
            custom string axmJointType = "continuous"
            custom string axmParentGroup = "root"
            custom string axmChildGroup = "upper_orbit"
            custom double3 axmAxis = (0.0, 1.0, 0.0)
            custom double3 axmPivotM = (0.0, 0.42, 0.0)
        }
    }
}

# Preview interchange only. Geometry remains in the referenced GLB;
# physics schemas are intentionally not claimed without usdchecker validation.
