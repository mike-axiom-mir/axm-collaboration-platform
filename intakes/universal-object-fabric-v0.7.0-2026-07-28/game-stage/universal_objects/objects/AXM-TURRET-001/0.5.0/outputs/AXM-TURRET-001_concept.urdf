<?xml version="1.0" encoding="utf-8"?>
<robot name="axm_turret_001">
  <!--AXM UOF v0.5 concept only: no actuators, controllers, calibrated inertia, or physical-control authority.-->
  <link name="root">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="yaw_body">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="pitch_head">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <joint name="yaw" type="continuous">
    <parent link="root" />
    <child link="yaw_body" />
    <origin xyz="0 0.245 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <joint name="pitch" type="revolute">
    <parent link="yaw_body" />
    <child link="pitch_head" />
    <origin xyz="0 0.735 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-0.261799388" upper="1.13446401" effort="0" velocity="0" />
  </joint>
</robot>
