    custom string axmSourceGlb = "AXM-VEHICLE-CHASSIS-001.glb"

    def Xform "AssemblyGroups"
    {
        def Xform "root"
        {
            custom string axmMembersJson = "[\"chassis\", \"cabin\", \"cargo\", \"front_core\"]"
            custom double3 axmPivotM = (0.0, 0.62, 0.0)
        }
        def Xform "wheel_0"
        {
            custom string axmMembersJson = "[\"wheel__g00\", \"hub__g00\"]"
