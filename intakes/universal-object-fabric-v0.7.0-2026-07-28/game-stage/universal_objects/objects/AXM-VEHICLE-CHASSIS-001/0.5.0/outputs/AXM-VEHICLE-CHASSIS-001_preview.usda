            custom double3 axmPivotM = (-0.97, 0.43, 1.05)
        }
        def Xform "wheel_1_spin"
        {
            custom string axmJointType = "continuous"
            custom string axmParentGroup = "root"
            custom string axmChildGroup = "wheel_1"
            custom double3 axmAxis = (1.0, 0.0, 0.0)
            custom double3 axmPivotM = (0.97, 0.43, 1.05)
        }
        def Xform "wheel_2_spin"
        {
            custom string axmJointType = "continuous"
            custom string axmParentGroup = "root"
            custom string axmChildGroup = "wheel_2"
            custom double3 axmAxis = (1.0, 0.0, 0.0)
            custom double3 axmPivotM = (-0.97, 0.43, -1.05)
        }
        def Xform "wheel_3_spin"
        {
            custom string axmJointType = "continuous"
            custom string axmParentGroup = "root"
            custom string axmChildGroup = "wheel_3"
            custom double3 axmAxis = (1.0, 0.0, 0.0)
