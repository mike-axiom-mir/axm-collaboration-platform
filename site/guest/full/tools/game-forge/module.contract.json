{
  "schema": "axm.module-contract/v1",
  "id": "game-forge",
  "version": "v1.3",
  "provides": [
    "modular-game-project-workspace",
    "2d-and-3d-world-documents",
    "semantic-level-editor",
    "event-graph-editor",
    "gameplay-system-records",
    "npc-behavior-tree-editor",
    "studio-hud-route",
    "multiplayer-controller-playtest-route",
    "test-replay-and-mod-ledger"
    ,"instant-playable-map-preview"
    ,"verified-package-candidate-builder"
    ,"shared-physics-2d-lab"
    ,"fixed-step-body-force-and-contact-prototypes"
    ,"physics-diagnostics-and-checksums"
    ,"explicit-game-physics-project-snapshots"
    ,"contact-lifecycle-and-collision-filtering"
    ,"bounded-physics-replay-traces"
    ,"contact-aware-sleep-and-explicit-wake"
    ,"searchable-500-pattern-game-production-atlas"
    ,"balanced-20-domain-game-capability-plans"
    ,"explicit-game-capability-plan-project-handoff"
  ],
  "consumes": [
    "service:game-hub",
    "service:sandbox",
    "service:studio",
    "game.manifest.json",
    "axm.game-asset/v1",
    "service:axm-physics-2d",
    "service:game-capability-atlas",
    "axm.game-capability-plan/v1"
  ],
  "permissions": [],
  "handoffs": {
    "emits": ["axm.game-forge-project/v1", "axm.game-mod-manifest/v1", "axm.game-physics-config/v1"],
    "accepts": ["axm.game-asset/v1", "axm.game-capability-plan/v1", "hub:init", "hub:settings:value"]
  },
  "boundaries": {
    "writes": ["browser-local:game-forge-projects", "user-download:explicit-project-or-mod-json", "exports:game-forge-candidates"],
    "refuses": [
      "pretend-3d-runtime-execution",
      "silent-game-package-write",
      "hidden-player-or-ai-seat",
      "automatic-test-pass",
      "automatic-mod-installation",
      "separate-engine-module-per-game"
      ,"automatic-candidate-installation"
      ,"automatic-physics-scene-execution"
      ,"scientific-validation-claim"
      ,"general-3d-physics-claim"
      ,"cross-engine-bitwise-determinism-claim"
      ,"claim-game-knowledge-is-executable-runtime-behavior"
      ,"automatic-capability-plan-attachment"
    ]
  },
  "lifecycle": {"state_owner": "browser", "reload": "resume", "disconnect": "graceful-degrade", "cleanup": "explicit"}
}
