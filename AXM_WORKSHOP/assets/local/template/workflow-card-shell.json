{
  "format": "axm-template-shell",
  "v": 1,
  "id": "workflow-card-shell",
  "name": "Workflow Card Shell",
  "family": "command-card",
  "layer": "shell",
  "status": "design-seed",
  "output": {
    "size": "1000x1414",
    "format": "png-or-html-export",
    "target": "Visual workflow cards"
  },
  "stableShell": [
    "title area locked",
    "status label area locked",
    "main instruction area locked",
    "steps area locked",
    "footer/signature area locked",
    "safe margins locked"
  ],
  "flexibleSlots": [
    { "id": "title", "type": "text", "required": true },
    { "id": "subtitle", "type": "text", "required": false },
    { "id": "mainInstruction", "type": "text", "required": true },
    { "id": "steps", "type": "list", "required": false },
    { "id": "icon", "type": "image", "required": false },
    { "id": "accent", "type": "color", "required": false },
    { "id": "footer", "type": "text", "required": false }
  ],
  "protectedOutput": [
    "main instruction stays readable",
    "footer/signature does not drift",
    "status label remains honest",
    "export size does not change without version bump"
  ],
  "principle": "Stable shell. Flexible slots. Protected output."
}
