{
  "schema": "axm.module-contract/v1",
  "id": "axm-native-web-engine-experimental",
  "version": "v0.4.0-experimental.1",
  "status": "EXPERIMENTAL",
  "installed": false,
  "promoted": false,
  "provides": [
    "axm.web.source-record/v1",
    "axm.web.token-stream/v1",
    "axm.web.document-tree/v1",
    "axm.web.page-model/v1",
    "axm.web.structure-index/v1",
    "axm.web.headless-result/v1",
    "axm.web.structure-layout/v1",
    "axm.web.display-list/v1",
    "axm.web.modification-ledger/v1",
    "axm.web.artifact-receipt/v1",
    "axm.web.local-browser-bundle/v1",
    "axm.web.local-browser-session/v1",
    "axm.web.local-browser-session-verification/v1",
    "axm.web.local-browser-host-receipt/v1",
    "offline-html-tokenize-subset",
    "offline-document-tree-subset",
    "offline-semantic-page-model",
    "shared-semantic-structure-index",
    "compact-headless-outline",
    "semantic-html-document-map",
    "headless-shared-core-cli",
    "offline-axm-structure-view",
    "inert-svg-and-html-snapshots",
    "explicit-local-page-bundle",
    "deterministic-headless-browser-session",
    "bounded-local-navigation-history-and-reload",
    "read-only-local-session-verification",
    "trusted-loopback-human-browser-shell"
  ],
  "consumes": [
    "caller-supplied-local-utf8-bytes",
    "caller-explicitly-allowed-local-file-set",
    "caller-supplied-local-browser-session-json",
    "node-runtime-sha256"
  ],
  "permissions": [
    "local-files:caller-explicit-list-read-only",
    "local-files:caller-selected-session-json-read-only",
    "loopback:ephemeral-127.0.0.1-shell-host"
  ],
  "handoffs": {
    "emits": [
      "axm.web.source-record/v1",
      "axm.web.token-stream/v1",
      "axm.web.document-tree/v1",
      "axm.web.page-model/v1",
      "axm.web.structure-index/v1",
      "axm.web.headless-result/v1",
      "axm.web.structure-layout/v1",
      "axm.web.display-list/v1",
      "axm.web.modification-ledger/v1",
      "axm.web.artifact-receipt/v1",
      "axm.web.local-browser-bundle/v1",
      "axm.web.local-browser-session/v1",
      "axm.web.local-browser-session-verification/v1",
      "axm.web.local-browser-host-receipt/v1"
    ],
    "accepts": [
      "local-file:utf8",
      "stdin:utf8",
      "explicit-local-file-set:utf8",
      "local-browser-session-json:utf8"
    ]
  },
  "boundaries": {
    "writes": [
      "stdout:explicit-cli-json-output",
      "stdout:read-only-session-verification-receipt",
      "caller-selected-file:render-svg-or-browser-snapshot-only",
      "process-memory:bounded-local-session-state",
      "127.0.0.1:ephemeral-trusted-shell-http"
    ],
    "refuses": [
      "external-network-fetch",
      "unlisted-local-file-navigation",
      "search-provider-query",
      "page-javascript-or-wasm-execution",
      "site-css-cascade-or-site-rendering-claim",
      "arbitrary-site-navigation-or-browser-conformance-claim",
      "session-verification-as-source-truth-or-trust-proof",
      "session-verification-triggered-mutation-install-promotion-or-canon",
      "implicit-output-overwrite",
      "symbolic-link-output-write",
      "provider-key-access",
      "workshop-state-access",
      "implicit-local-machine-authority",
      "foundation-registry-hub-or-workshop-server-mutation",
      "installation",
      "promotion",
      "canon-change"
    ]
  },
  "lifecycle": {
    "state_owner": "local-browser-session-process-memory",
    "reload": "exact-reparse-of-explicit-local-file-set-with-digest-receipts",
    "verification": "read-only-serialized-session-integrity-and-structural-consistency-check",
    "disconnect": "explicit-shell-host-shutdown-or-process-exit",
    "cleanup": "listener-and-session-discarded; caller owns explicit artifact outputs"
  }
}
