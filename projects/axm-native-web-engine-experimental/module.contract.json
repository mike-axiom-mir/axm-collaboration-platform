{
  "schema": "axm.module-contract/v1",
  "id": "axm-native-web-engine-experimental",
  "version": "v0.2.0-experimental.1",
  "status": "EXPERIMENTAL",
  "installed": false,
  "promoted": false,
  "provides": [
    "axm.web.source-record/v1",
    "axm.web.token-stream/v1",
    "axm.web.document-tree/v1",
    "axm.web.page-model/v1",
    "axm.web.headless-result/v1",
    "axm.web.structure-layout/v1",
    "axm.web.display-list/v1",
    "axm.web.modification-ledger/v1",
    "axm.web.artifact-receipt/v1",
    "offline-html-tokenize-subset",
    "offline-document-tree-subset",
    "offline-semantic-page-model",
    "headless-shared-core-cli",
    "offline-axm-structure-view",
    "inert-svg-and-html-snapshots"
  ],
  "consumes": [
    "caller-supplied-local-utf8-bytes",
    "node-runtime-sha256"
  ],
  "permissions": [],
  "handoffs": {
    "emits": [
      "axm.web.source-record/v1",
      "axm.web.token-stream/v1",
      "axm.web.document-tree/v1",
      "axm.web.page-model/v1",
      "axm.web.headless-result/v1",
      "axm.web.structure-layout/v1",
      "axm.web.display-list/v1",
      "axm.web.modification-ledger/v1",
      "axm.web.artifact-receipt/v1"
    ],
    "accepts": ["local-file:utf8", "stdin:utf8"]
  },
  "boundaries": {
    "writes": [
      "stdout:explicit-cli-json-output",
      "caller-selected-file:render-svg-or-browser-snapshot-only"
    ],
    "refuses": [
      "network-fetch",
      "search-provider-query",
      "javascript-or-wasm-execution",
      "site-css-cascade-or-site-rendering-claim",
      "live-browser-window-navigation-or-click-claim",
      "implicit-output-overwrite",
      "symbolic-link-output-write",
      "provider-key-access",
      "workshop-state-access",
      "local-machine-authority",
      "foundation-registry-hub-or-server-mutation",
      "installation",
      "promotion",
      "canon-change"
    ]
  },
  "lifecycle": {
    "state_owner": "none",
    "reload": "exact-reparse-from-caller-input",
    "disconnect": "not-applicable",
    "cleanup": "process-owned; caller owns explicit artifact outputs"
  }
}
