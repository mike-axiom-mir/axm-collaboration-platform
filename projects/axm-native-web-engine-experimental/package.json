{
  "name": "@axm/native-web-engine-experimental",
  "version": "0.2.0-experimental.1",
  "private": true,
  "description": "Detached AXM-native offline semantic core with shared headless and inert Structure Browser outputs.",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <25"
  },
  "bin": {
    "axm-web-headless": "cli.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "goldens:update": "node scripts/update-goldens.js --write",
    "examples:update": "node scripts/build-examples.js --write",
    "examples:verify": "node scripts/build-examples.js --verify",
    "manifest:update": "node scripts/build-source-manifest.js --write",
    "manifest:verify": "node scripts/build-source-manifest.js --verify",
    "schemas:verify": "node scripts/verify-schemas.js",
    "verify": "npm test && npm run schemas:verify && npm run examples:verify && npm run manifest:verify"
  },
  "dependencies": {}
}
