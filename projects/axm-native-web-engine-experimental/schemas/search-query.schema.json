{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.web.search-query/v1",
  "title": "AXM Normalized Search Query",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","version","query","count","page","language","country","freshness","safeSearch","categories","engines","mode","provider","providers"],
  "properties": {
    "schema": {"const": "axm.web.search-query/v1"},
    "version": {"const": 1},
    "query": {"type": "string", "minLength": 1, "maxLength": 400},
    "count": {"type": "integer", "minimum": 1, "maximum": 20},
    "page": {"type": "integer", "minimum": 1, "maximum": 10},
    "language": {"type": "string", "minLength": 2, "maxLength": 6},
    "country": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
    "freshness": {"enum": [null, "day", "week", "month", "year"]},
    "safeSearch": {"enum": ["off", "moderate", "strict"]},
    "categories": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "engines": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "mode": {"enum": ["single", "federated"]},
    "provider": {"enum": ["auto", "searxng", "brave", "kagi"]},
    "providers": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["searxng", "brave", "kagi"]}}
  }
}
