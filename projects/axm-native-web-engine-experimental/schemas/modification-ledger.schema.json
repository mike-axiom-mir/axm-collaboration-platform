{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.web.modification-ledger/v1",
  "title": "AXM Reversible Structure-view Modification Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","version","ledgerKind","requestedBy","createdAt","input","output","sourceMutation","pageCodeExecuted","networkUsed","reversible","reversal","entries","ledgerDigest"],
  "properties": {
    "schema":{"const":"axm.web.modification-ledger/v1"},
    "version":{"const":1},
    "ledgerKind":{"const":"DERIVED_VIEW_ONLY"},
    "requestedBy":{"type":"string","minLength":1},
    "createdAt":{"type":["string","null"]},
    "input":{"type":"object","required":["sourceDigest","documentDigest","pageModelDigest"]},
    "output":{"type":"object","required":["mode","structureIndexDigest","layoutDigest","displayListDigest"]},
    "sourceMutation":{"type":"object","required":["performed","beforeDigest","afterDigest"],"properties":{"performed":{"const":false},"beforeDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"afterDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false},
    "pageCodeExecuted":{"const":false},
    "networkUsed":{"const":false},
    "reversible":{"const":true},
    "reversal":{"const":"discard-derived-view-and-reload-bound-source"},
    "entries":{"type":"array","minItems":3,"items":{"type":"object","required":["sequence","operation","classification","inputDigest","outputDigest","sourceMutated"]}},
    "ledgerDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
