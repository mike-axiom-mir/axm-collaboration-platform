{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.web.ai-execution/v1",
  "title": "AXM AI Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","version","status","planDigest","mode","providerIdsRequested","providerIdsSucceeded","providerIdsFailed","outputs","authority","executionDigest"],
  "properties": {
    "schema": {"const": "axm.web.ai-execution/v1"},
    "version": {"const": 1},
    "status": {"enum": ["PASS","PARTIAL"]},
    "planDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mode": {"enum": ["single","panel"]},
    "providerIdsRequested": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}},
    "providerIdsSucceeded": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
    "providerIdsFailed": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
    "outputs": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["providerId","adapter","status","visualStateUsed","searchEvidenceUsed"],
        "properties": {
          "providerId": {"type": "string"},
          "adapter": {"enum": ["openai-responses","anthropic-messages","openai-compatible-chat"]},
          "status": {"enum": ["PASS","FAIL"]},
          "httpStatus": {"type": "integer", "minimum": 100, "maximum": 599},
          "responseBytes": {"type": "integer", "minimum": 0},
          "responseBodyDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "visualStateUsed": {"type": "boolean"},
          "searchEvidenceUsed": {"type": "boolean"},
          "output": {"type": "string", "maxLength": 200000},
          "code": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["networkExecutionUsed","browserMutationAllowed","searchExecutionGranted","toolExecutionUsed","resultContentTrusted","installAllowed","promotionAllowed","canonAllowed"],
      "properties": {
        "networkExecutionUsed": {"const": true},
        "browserMutationAllowed": {"const": false},
        "searchExecutionGranted": {"const": false},
        "toolExecutionUsed": {"const": false},
        "resultContentTrusted": {"const": false},
        "installAllowed": {"const": false},
        "promotionAllowed": {"const": false},
        "canonAllowed": {"const": false}
      }
    },
    "executionDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
