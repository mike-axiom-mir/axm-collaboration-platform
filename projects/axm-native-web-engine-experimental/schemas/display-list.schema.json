{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.web.display-list/v1",
  "title": "AXM Renderer-neutral Display List",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","version","rendererProfile","sourceDigest","pageModelDigest","structureIndexDigest","layoutDigest","width","height","colors","commands","commandCount","activeContent","externalResources","displayListDigest"],
  "properties": {
    "schema":{"const":"axm.web.display-list/v1"},
    "version":{"const":1},
    "rendererProfile":{"const":"axm.structure-display-list/v1"},
    "sourceDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "pageModelDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "structureIndexDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "layoutDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "width":{"type":"integer","minimum":1},
    "height":{"type":"integer","minimum":1},
    "colors":{"type":"object","additionalProperties":{"type":"string","pattern":"^#[a-f0-9]{6}$"}},
    "commands":{"type":"array","items":{"$ref":"#/$defs/command"}},
    "commandCount":{"type":"integer","minimum":1},
    "activeContent":{"const":false},
    "externalResources":{"const":false},
    "displayListDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "$defs": {
    "command":{"type":"object","required":["commandId","kind"],"properties":{"commandId":{"type":"string","pattern":"^cmd-[0-9]{5}$"},"kind":{"enum":["rect","line","text"]},"x":{"type":"number"},"y":{"type":"number"},"x1":{"type":"number"},"y1":{"type":"number"},"x2":{"type":"number"},"y2":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"fill":{"type":"string"},"stroke":{"type":["string","null"]},"strokeWidth":{"type":"number"},"radius":{"type":"number"},"text":{"type":"string"},"fontFamily":{"type":"string"},"fontSize":{"type":"number"},"fontWeight":{"type":"number"},"letterSpacing":{"type":"number"}}}
  }
}
