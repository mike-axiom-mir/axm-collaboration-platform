{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.resource-observation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "observationId", "subjectKind", "subjectDigest", "workloadRef",
    "environmentRef", "observedAt", "evidenceAuthority", "measurements",
    "evidenceRef", "observationDigest"
  ],
  "properties": {
    "schema": {"const": "axm.resource-observation/v1"},
    "observationId": {"$ref": "#/$defs/id"},
    "subjectKind": {"enum": ["BASELINE", "CANDIDATE"]},
    "subjectDigest": {"$ref": "#/$defs/digest"},
    "workloadRef": {"$ref": "#/$defs/reference"},
    "environmentRef": {"$ref": "#/$defs/reference"},
    "observedAt": {"type": "string", "format": "date-time"},
    "evidenceAuthority": {"enum": ["DIRECT_MACHINE_METER", "IMPORTED_ATTESTATION", "MANUAL_DECLARATION"]},
    "measurements": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"$ref": "#/$defs/measurement"}
    },
    "evidenceRef": {"$ref": "#/$defs/reference"},
    "observationDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$", "maxLength": 180},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "unit", "coverage", "value", "measurementDefinitionRef"],
      "properties": {
        "id": {"enum": [
          "CPU_CORE_MILLISECONDS", "WALL_MILLISECONDS", "ACCELERATOR_MILLISECONDS",
          "PEAK_MEMORY_BYTES", "STORAGE_WRITE_BYTES", "NETWORK_INGRESS_BYTES",
          "NETWORK_EGRESS_BYTES", "ENERGY_MILLIWATT_HOURS", "CARBON_MILLIGRAMS"
        ]},
        "unit": {"enum": ["ms", "byte", "mWh", "mgCO2e"]},
        "coverage": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
        "value": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "measurementDefinitionRef": {"$ref": "#/$defs/reference"}
      }
    }
  }
}
