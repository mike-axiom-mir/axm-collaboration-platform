{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.simulation-lab-extension-assessment/v1",
  "title": "AXM simulation lab extension assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "assessmentId", "generatedAt", "status", "bindings",
    "staticVerification", "coverage", "issues", "evaluationRequirements",
    "disposition", "nextGate", "authority", "assessmentDigest"
  ],
  "properties": {
    "schema": {"const": "axm.simulation-lab-extension-assessment/v1"},
    "version": {"const": "0.1.0"},
    "assessmentId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,99}$"},
    "generatedAt": {"type": "string", "minLength": 1, "maxLength": 80},
    "status": {"const": "TEST"},
    "bindings": {"type": "object"},
    "staticVerification": {"type": "object"},
    "coverage": {"type": ["object", "null"]},
    "issues": {"type": "array", "items": {"type": "object"}},
    "evaluationRequirements": {"type": "array", "items": {"type": "object"}},
    "disposition": {
      "enum": [
        "HOLD_INVALID_HOST_PROFILE", "HOLD_INVALID_PACKAGE",
        "HOLD_ROOT_IDENTITY_COLLISION", "HOLD_BOUNDARY_EXPANSION",
        "HOLD_CONTRACT_MAPPING", "READY_FOR_EXPERIMENTAL_EVALUATION_PLANNING"
      ]
    },
    "nextGate": {"type": "string"},
    "authority": {"type": "object"},
    "assessmentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
