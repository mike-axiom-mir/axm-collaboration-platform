{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.verification-snapshot-continuity-receipt/v1",
  "title": "AXM Verification Snapshot Continuity Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "continuityId", "checkedAt", "status", "scope",
    "historicalReceipt", "currentEvidence", "comparison", "decision", "truth",
    "continuityDigest"
  ],
  "properties": {
    "schema": { "const": "axm.verification-snapshot-continuity-receipt/v1" },
    "version": { "const": "0.1.0" },
    "continuityId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "checkedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "TEST" },
    "scope": { "const": "HISTORICAL_RECEIPT_AND_CURRENT_SOURCE_CONTINUITY" },
    "historicalReceipt": { "type": "object" },
    "currentEvidence": { "type": "object" },
    "comparison": { "type": "object" },
    "decision": { "type": "object" },
    "truth": { "type": "object" },
    "continuityDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

