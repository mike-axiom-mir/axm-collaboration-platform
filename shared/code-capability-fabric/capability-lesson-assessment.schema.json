{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"axm.capability-lesson-assessment/v1",
  "type":"object","additionalProperties":false,
  "required":["schema","version","status","id","requestRef","lessonRef","currentLibraryRef","fixedRegressionRef","heldOutGoalsRef","evaluatedAt","technicalHolds","nextGate","truth","authority","assessmentDigest"],
  "properties":{
    "schema":{"const":"axm.capability-lesson-assessment/v1"},"version":{"const":"1.0.0"},
    "status":{"enum":["TECHNICAL_HOLD","TECHNICAL_PASS_TIER_3_DECISION_REQUIRED"]},"id":{"$ref":"capability-lesson-common.schema.json#/$defs/id"},
    "requestRef":{"$ref":"capability-lesson-common.schema.json#/$defs/byteReference"},"lessonRef":{"$ref":"capability-lesson-common.schema.json#/$defs/byteReference"},"currentLibraryRef":{"$ref":"capability-lesson-common.schema.json#/$defs/byteReference"},"fixedRegressionRef":{"$ref":"capability-lesson-common.schema.json#/$defs/byteReference"},"heldOutGoalsRef":{"$ref":"capability-lesson-common.schema.json#/$defs/byteReference"},
    "evaluatedAt":{"$ref":"capability-lesson-common.schema.json#/$defs/timestamp"},
    "technicalHolds":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"$ref":"capability-lesson-common.schema.json#/$defs/code"}},
    "nextGate":{"enum":["REPAIR_EVIDENCE_OR_LESSON_AND_REASSESS","VERIFY_RIGHTS_AUTHORITY_THEN_AUTHENTICATED_TIER_3_HUMAN_DECISION_AND_SEPARATE_HOST_ADMISSION"]},
    "truth":{
      "type":"object","additionalProperties":false,
      "required":["exactLessonRebuilt","exactLibraryRebuilt","fixedRegressionBound","heldOutGoalsBound","contradictionsPreserved","failuresPreserved","unknownsPreserved","rightsAuthorityIndependentlyVerified","scoreCalculated","winnerSelected","authenticatedTier3DecisionVerified","runningAttemptMutated","persistentLearningAdmitted","installed","integrated","promoted","canonChanged","mikeFinalMergeGatePreserved"],
      "properties":{"exactLessonRebuilt":{"const":true},"exactLibraryRebuilt":{"const":true},"fixedRegressionBound":{"const":true},"heldOutGoalsBound":{"const":true},"contradictionsPreserved":{"const":true},"failuresPreserved":{"const":true},"unknownsPreserved":{"const":true},"rightsAuthorityIndependentlyVerified":{"const":false},"scoreCalculated":{"const":false},"winnerSelected":{"const":false},"authenticatedTier3DecisionVerified":{"const":false},"runningAttemptMutated":{"const":false},"persistentLearningAdmitted":{"const":false},"installed":{"const":false},"integrated":{"const":false},"promoted":{"const":false},"canonChanged":{"const":false},"mikeFinalMergeGatePreserved":{"const":true}}
    },
    "authority":{"const":"NONE"},"assessmentDigest":{"$ref":"capability-lesson-common.schema.json#/$defs/digest"}
  },
  "oneOf":[
    {"properties":{"status":{"const":"TECHNICAL_HOLD"},"technicalHolds":{"minItems":1},"nextGate":{"const":"REPAIR_EVIDENCE_OR_LESSON_AND_REASSESS"}}},
    {"properties":{"status":{"const":"TECHNICAL_PASS_TIER_3_DECISION_REQUIRED"},"technicalHolds":{"maxItems":0},"nextGate":{"const":"VERIFY_RIGHTS_AUTHORITY_THEN_AUTHENTICATED_TIER_3_HUMAN_DECISION_AND_SEPARATE_HOST_ADMISSION"}}}
  ]
}
