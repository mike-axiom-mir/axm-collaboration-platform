{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.semantic-common/v1",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "candidateId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
    "contract": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,219}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "hexDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "schema": {"$ref": "#/$defs/contract"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256", "byteLength"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "schema": {"$ref": "#/$defs/contract"},
        "sha256": {"$ref": "#/$defs/digest"},
        "byteLength": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byteLength"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 240},
        "sha256": {"$ref": "#/$defs/digest"},
        "byteLength": {"type": "integer", "minimum": 0, "maximum": 262144}
      }
    },
    "bundleFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "encoding", "content", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 240},
        "encoding": {"const": "base64"},
        "content": {"type": "string", "maxLength": 349528},
        "sha256": {"$ref": "#/$defs/hexDigest"}
      }
    },
    "moduleBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requiredSeats", "files"],
      "properties": {
        "schema": {"const": "axm.module-bundle/v1"},
        "requiredSeats": {"type": "integer", "minimum": 1, "maximum": 10},
        "files": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/bundleFile"}}
      }
    },
    "rootDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "verdict", "evidenceRefs"],
      "properties": {
        "root": {"enum": ["truth", "agency-non-domination", "continuity", "wisdom-over-speed"]},
        "verdict": {"enum": ["PASS", "HOLD", "FAIL"]},
        "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/reference"}}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/candidateId"},
        "version": {"const": "v0.1"},
        "status": {"const": "EXPERIMENTAL"}
      }
    }
  }
}
