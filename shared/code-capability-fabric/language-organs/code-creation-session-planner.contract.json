{
  "schema": "axm.code-creation-session-planner-contract.v1",
  "id": "code-creation-session-planner",
  "version": "1.0.0",
  "status": "TEST",
  "purpose": "Compose the 102-language Creation Fabric into one deterministic, four-root-gated, non-executing session plan.",
  "consumes": [
    "axm.code.creation-session-request.v1",
    "axm.code.four-root-technical-gate.v1",
    "caller-explicit primary language and role bindings",
    "caller-supplied build observation",
    "caller-supplied production ceilings"
  ],
  "provides": [
    "axm.code.creation-session-request.v1",
    "axm.code.four-root-technical-gate.v1",
    "axm.code.creation-session-plan.v1",
    "axm.code.creation-session-plan-verification.v1",
    "axm.code.creation-session-planner-snapshot.v1"
  ],
  "composition": [
    "four-root technical gate",
    "102-language organ registry",
    "grammar profile and specialist eye",
    "human discipline and template direction",
    "machine cheatcode guidance",
    "route knowledge and prebuild twin",
    "machine keyboard layout",
    "candidate admission policy",
    "bounded production draft slots and budget",
    "artifact build-window state",
    "production work-context card"
  ],
  "writes": [],
  "permissions": [],
  "refuses": [
    "implicit language selection",
    "case-normalized identifier alias collision",
    "rehash of malformed or internally contradictory request or root gate",
    "root HOLD or FAIL override",
    "workspace reads or mutation",
    "source generation",
    "candidate execution",
    "provider calls",
    "network use",
    "dependency installation",
    "automatic draft selection",
    "automatic admission",
    "automatic sandbox execution",
    "automatic integration, merge, promotion or CANON"
  ],
  "authority": {
    "workspaceRead": false,
    "workspaceMutation": false,
    "sourceGeneration": false,
    "candidateExecution": false,
    "toolExecution": false,
    "providerCall": false,
    "network": false,
    "install": false,
    "deployment": false,
    "merge": false,
    "promotion": false,
    "canon": false
  },
  "mergeGate": "Mike Tobi"
}
