  "grammar": {
    "paradigm": "dynamic multi-paradigm",
    "compilationOrDocumentUnit": "module",
    "dialectsOrVariants": [
      "CPython",
      "PyPy"
    ],
    "constructs": [
      "function",
      "class",
      "assignment",
      "import",
      "decorator",
      "comprehension",
      "context manager",
      "async",
      "match"
    ],
    "dependencyForms": [
      "import",
      "from-import"
    ],
    "scopeModel": "lexical/module/runtime",
    "typeModel": "dynamic or inferred",
    "mutationModel": "runtime object/state",
    "controlModel": "branch, loop, call, exception/result",
    "effectModel": "runtime plus dynamic dispatch/reflection where supported"
  },
  "analysis": {
    "symbolInventory": [
      "function",
      "class",
      "assignment",
      "import",
      "decorator",
      "comprehension",
      "context manager",
      "async",
      "match"
    ],
    "dependencyAnchors": [
      "import",
      "from-import"
    ],
    "semanticHazards": [
      "indentation",
      "descriptor/metaclass",
      "dynamic import",
      "monkey patch",
      "eval/exec"
    ],
    "requiredQuestionsBeforeRewrite": [
      "Which grammar/dialect/version is active?",
      "Which syntax nodes and dependency edges are affected?",
      "Does the change cross a scope, type, state, effect, ABI/schema, query, timing or host-language boundary?",
      "Which native or structural verifier can falsify the proposed rewrite?"
    ]
  },
  "rewritePolicy": {
    "blindTextRewrite": "FORBIDDEN",
    "unknownGrammarNode": "HOLD",
    "parseErrors": "HOLD",
    "preserveCommentsAndTriviaWhenAdapterSupportsIt": true,
    "requireDependencyImpactReview": true,
    "highRiskTransforms": [
      "indentation",
      "descriptor/metaclass",
      "dynamic import",
      "monkey patch",
      "eval/exec"
    ],
    "capabilityIsNotAuthority": true
  },
  "verification": {
    "focus": [
      "AST parse",
      "py_compile",
      "tests"
    ],
    "syntaxPassIsNotSemanticCorrectness": true,
    "fixturePassIsNotArbitraryProgramProof": true,
    "runtimeCorrectnessClaimed": false,
    "authority": "NONE"
  },
