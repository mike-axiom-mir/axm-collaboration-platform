    {"id":"browser-style-host","source":"html","destination":"css","class":"HOSTED_DSL","direction":"DOCUMENT_REFERENCES_STYLE","artifact":"stylesheet rules/selectors applied to document tree","purpose":["browser layout","visual styling","responsive UI"],"requires":["browser stylesheet support"],"failureBoundaries":["selector/specificity mismatch","layout/browser differences","asset loading"],"verify":["browser render test","visual/layout checks"]}
