    {"id":"cpp-embeds-python","source":"cpp","destination":"python","class":"EMBED_RUNTIME","direction":"HOST_TO_EMBEDDED_RUNTIME","artifact":"embedded Python runtime through C/C++ binding layer","purpose":["scriptable engine/tool","native application scripting"],"requires":["CPython embedding API or binding library"],"failureBoundaries":["ownership/lifetime mismatch","exception translation","runtime lifecycle"],"verify":["native build","embedded Python integration test"]},
