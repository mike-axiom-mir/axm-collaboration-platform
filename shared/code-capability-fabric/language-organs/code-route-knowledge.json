    {"id":"build-orchestrates-code","sourceFamilies":["build"],"destinationFamilies":["web","native","jvm","dotnet","scripting","mobile-app","beam","functional","lisp","logic","gpu-shader","wasm","scientific","blockchain","enterprise","hardware"],"class":"BUILD_ORCHESTRATION","artifact":"build graph/targets/artifacts","purpose":["compile","generate","link","test","package"],"warning":"Build-language knowledge does not imply the compiler/toolchain is installed."},
    {"id":"infra-deploys-artifacts","sourceFamilies":["infrastructure"],"destinationFamilies":["web","native","jvm","dotnet","scripting","mobile-app","beam","functional","wasm","blockchain","enterprise"],"class":"INFRA_DEPLOYMENT","artifact":"deployment/resource/runtime configuration","purpose":["deployment","service wiring","environment configuration"],"warning":"Infrastructure code deploys/configures artifacts; it does not become the application runtime."},
    {"id":"data-config-hosted","sourceFamilies":["web","native","jvm","dotnet","scripting","mobile-app","beam","functional","lisp","logic","scientific","enterprise"],"destinationFamilies":["data-config"],"class":"HOSTED_DSL","artifact":"configuration/document data","purpose":["configuration","content/data exchange","runtime settings"],"warning":"The host must parse/validate the document; a config file is not executable application code by default."},
    {"id":"pattern-drives-code","sourceFamilies":["pattern"],"destinationFamilies":["web","native","jvm","dotnet","scripting","mobile-app","beam","functional","lisp","logic","scientific","enterprise"],"class":"TEST_HARNESS","artifact":"pattern/query plus captures/matches","purpose":["search","validation","structural matching","rewrite selection"],"warning":"Pattern match is evidence/candidate selection, not semantic correctness."},
    {"id":"software-to-hardware","sourceFamilies":["native","scripting"],"destinationFamilies":["hardware"],"class":"HARDWARE_INTERFACE","artifact":"driver/register/bus/protocol/interface contract","purpose":["firmware/device control","hardware/software co-design"],"warning":"Software cannot directly assume HDL signal semantics without a concrete hardware interface and timing contract."},
    {"id":"cross-runtime-network","sourceFamilies":["web","native","jvm","dotnet","scripting","mobile-app","beam","functional","lisp","scientific","enterprise"],"destinationFamilies":["web","native","jvm","dotnet","scripting","mobile-app","beam","functional","lisp","scientific","enterprise"],"class":"NETWORK_PROTOCOL","artifact":"HTTP/RPC/message/protocol contract","purpose":["polyglot services","remote clients","distributed systems"],"warning":"Network protocols provide language neutrality at the cost of serialization, latency, partial failure and versioned contracts."}
  ],
  "buildRecipes": [
    {"id":"browser-game","goalTags":["browser game","web game","2d browser game","3d browser game"],"roles":[{"role":"document-shell","families":["web"],"preferredLanguages":["html"]},{"role":"style-layout","families":["web"],"preferredLanguages":["css"]},{"role":"game-runtime","families":["web"],"preferredLanguages":["javascript","typescript"]},{"role":"gpu-stage","families":["gpu-shader"],"optional":true},{"role":"high-performance-module","families":["wasm","native"],"optional":true},{"role":"config-assets","families":["data-config"],"optional":true}],"routeClasses":["HOSTED_DSL","SAME_RUNTIME_IMPORT","SHADER_PIPELINE","COMPILE_TARGET","FILE_DATA_CONTRACT"],"why":"Browser owns the document/runtime boundary; JS/TS coordinates interaction and game state; shaders/Wasm are specialized optional acceleration bodies."},
    {"id":"native-game","goalTags":["native game","desktop game","game engine"],"roles":[{"role":"engine-runtime","families":["native","dotnet","jvm"]},{"role":"gameplay-scripting","families":["scripting","native","dotnet"],"optional":true},{"role":"gpu-stage","families":["gpu-shader"]},{"role":"build","families":["build"]},{"role":"config-assets","families":["data-config"],"optional":true}],"routeClasses":["COMPILE_LINK","EMBED_RUNTIME","SHADER_PIPELINE","BUILD_ORCHESTRATION","FILE_DATA_CONTRACT"],"why":"Native games separate CPU engine/gameplay, GPU shader stages, build graph and data/assets; scripting is optional and requires an explicit host boundary."},
    {"id":"web-application","goalTags":["web app","website app","full stack web"],"roles":[{"role":"document-ui","families":["web"]},{"role":"browser-runtime","families":["web"]},{"role":"service-runtime","families":["scripting","jvm","dotnet","native","beam","functional"],"optional":true},{"role":"api-contract","families":["api-schema"],"optional":true},{"role":"data-store","families":["sql-query"],"optional":true},{"role":"deployment","families":["infrastructure"],"optional":true}],"routeClasses":["HOSTED_DSL","NETWORK_PROTOCOL","SCHEMA_CODEGEN","DATA_QUERY_BOUNDARY","INFRA_DEPLOYMENT"],"why":"Browser UI and service/data tiers are separate runtime boundaries; protocols and schemas connect them rather than direct cross-language calls."},
    {"id":"api-service","goalTags":["api","backend service","microservice"],"roles":[{"role":"service-runtime","families":["scripting","jvm","dotnet","native","beam","functional"]},{"role":"api-contract","families":["api-schema"],"optional":true},{"role":"data-store","families":["sql-query"],"optional":true},{"role":"build","families":["build"],"optional":true},{"role":"deployment","families":["infrastructure"],"optional":true}],"routeClasses":["SCHEMA_CODEGEN","DATA_QUERY_BOUNDARY","BUILD_ORCHESTRATION","INFRA_DEPLOYMENT","NETWORK_PROTOCOL"],"why":"A service runtime owns behavior; schemas, databases, build and deployment code live behind explicit boundaries."},
    {"id":"embedded-device","goalTags":["firmware","embedded","device software","microcontroller"],"roles":[{"role":"firmware-runtime","families":["native"]},{"role":"hardware-contract","families":["hardware"],"optional":true},{"role":"build-toolchain","families":["build"]},{"role":"configuration","families":["data-config"],"optional":true},{"role":"protocol","families":["api-schema","data-config"],"optional":true}],"routeClasses":["COMPILE_LINK","HARDWARE_INTERFACE","BUILD_ORCHESTRATION","FILE_DATA_CONTRACT"],"why":"Firmware correctness depends on the compiled native artifact plus concrete device/hardware and build contracts; HDL/config are different bodies, not interchangeable source."},
    {"id":"mobile-application","goalTags":["mobile app","android app","ios app"],"roles":[{"role":"app-runtime","families":["mobile-app","jvm","native"]},{"role":"service-contract","families":["api-schema"],"optional":true},{"role":"local-config","families":["data-config"],"optional":true},{"role":"backend","families":["scripting","jvm","dotnet","native","beam"],"optional":true}],"routeClasses":["SAME_RUNTIME_IMPORT","NETWORK_PROTOCOL","SCHEMA_CODEGEN","FILE_DATA_CONTRACT"],"why":"Mobile UI/runtime code is local; remote backends connect through protocols/contracts rather than direct language compatibility."},
    {"id":"data-pipeline","goalTags":["data pipeline","etl","analytics pipeline"],"roles":[{"role":"orchestration-transform","families":["scripting","scientific","jvm"]},{"role":"query","families":["sql-query"]},{"role":"schema-config","families":["data-config","api-schema"],"optional":true},{"role":"build-deploy","families":["build","infrastructure"],"optional":true}],"routeClasses":["DATA_QUERY_BOUNDARY","FILE_DATA_CONTRACT","BUILD_ORCHESTRATION","INFRA_DEPLOYMENT"],"why":"Data systems combine transform/orchestration code with query engines and explicit data/schema contracts."},
    {"id":"compiler-tool","goalTags":["compiler","transpiler","code generator","static analyzer"],"roles":[{"role":"compiler-runtime","families":["native","functional","jvm","dotnet","scripting"]},{"role":"grammar-pattern","families":["pattern"]},{"role":"build","families":["build"]},{"role":"schema-config","families":["data-config"],"optional":true}],"routeClasses":["HOSTED_DSL","TRANSPILE_GENERATE","BUILD_ORCHESTRATION","TEST_HARNESS"],"why":"Compiler/tooling systems combine implementation code with grammar/pattern bodies and generated artifacts."},
