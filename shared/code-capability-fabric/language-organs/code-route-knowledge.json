  "familyRules": [
    {"id":"application-to-sql","sourceFamilies":["web","native","jvm","dotnet","scripting","mobile-app","beam","functional","lisp","scientific","enterprise"],"destinationFamilies":["sql-query"],"class":"DATA_QUERY_BOUNDARY","artifact":"query text/AST + parameters + tabular/record results","purpose":["persistent data","transactions","analytics/query execution"],"warning":"SQL runs in a database/query engine; application-language compatibility depends on a driver/protocol/connector."},
    {"id":"application-to-shader","sourceFamilies":["web","native","jvm","dotnet","scripting","mobile-app"],"destinationFamilies":["gpu-shader"],"class":"SHADER_PIPELINE","artifact":"compiled shader modules + resource/binding layout + draw/dispatch commands","purpose":["real-time graphics","GPU compute/rendering"],"warning":"The host language does not directly call arbitrary shader functions; a graphics/compute API mediates the pipeline."},
