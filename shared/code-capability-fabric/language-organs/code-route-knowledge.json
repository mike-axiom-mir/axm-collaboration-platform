{
  "schema": "axm.code.route-knowledge-atlas.v1",
  "version": "1.0.0",
  "status": "TEST",
  "authority": "NONE",
  "meaning": "Directional knowledge of how code bodies, runtimes, artifacts and DSLs can combine to produce larger software systems.",
  "routeClasses": {
    "SAME_RUNTIME_IMPORT": {"boundary":"module/runtime","direct":true,"meaning":"Modules share a runtime or module system and can import/call through that system."},
    "COMPILE_LINK": {"boundary":"compiler/linker/ABI","direct":false,"meaning":"Multiple source bodies become one native artifact through compilation/linking."},
    "FFI_ABI": {"boundary":"foreign-function/ABI","direct":false,"meaning":"One language/runtime calls another through an explicitly bound ABI or foreign-function interface."},
    "EMBED_RUNTIME": {"boundary":"embedded interpreter/runtime","direct":false,"meaning":"A host application owns and invokes another language runtime."},
    "EXTEND_RUNTIME": {"boundary":"runtime extension API","direct":false,"meaning":"Foreign/native code is loaded as an extension of a host runtime."},
    "TRANSPILE_GENERATE": {"boundary":"generated source/bindings","direct":false,"meaning":"One language/tool emits another source representation or glue."},
    "COMPILE_TARGET": {"boundary":"portable/intermediate target","direct":false,"meaning":"Source compiles to a target such as WebAssembly or bytecode that another host executes."},
    "HOSTED_DSL": {"boundary":"hosted language/DSL","direct":false,"meaning":"A host program consumes a query/config/schema/template/pattern language."},
    "SHADER_PIPELINE": {"boundary":"graphics API pipeline","direct":false,"meaning":"CPU-side host code binds shader stages, resources and entrypoints through a graphics API."},
    "SCHEMA_CODEGEN": {"boundary":"schema/generated contract","direct":false,"meaning":"A schema/API definition generates or constrains code on one or more sides."},
    "PROCESS_IPC": {"boundary":"process","direct":false,"meaning":"Independent processes communicate through IPC rather than language-level calls."},
    "NETWORK_PROTOCOL": {"boundary":"network/protocol","direct":false,"meaning":"Separately deployed components communicate through an explicit protocol/API contract."},
    "DATA_QUERY_BOUNDARY": {"boundary":"database/query engine","direct":false,"meaning":"Application code sends query/data-language operations to a database or query engine."},
    "BUILD_ORCHESTRATION": {"boundary":"build graph/toolchain","direct":false,"meaning":"Build/config languages select, compile, link, generate or package other code bodies."},
    "INFRA_DEPLOYMENT": {"boundary":"deployment/runtime environment","direct":false,"meaning":"Infrastructure/configuration code deploys or configures executable artifacts."},
    "TEST_HARNESS": {"boundary":"test/observation","direct":false,"meaning":"Tests/specs/patterns drive or observe another code body without becoming its runtime language."},
    "HARDWARE_INTERFACE": {"boundary":"driver/bus/register/interface","direct":false,"meaning":"Software or firmware interacts with HDL/device behavior through explicit hardware interfaces."},
    "FILE_DATA_CONTRACT": {"boundary":"serialized file/data","direct":false,"meaning":"Components exchange structured data/files without direct code invocation."}
  },
