{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.game-generation-brief/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "seed", "recipeId", "difficulty", "world", "theme", "accessibility", "session", "authority", "briefDigest"],
  "properties": {
    "schema": {"const": "axm.game-generation-brief/v1"},
    "id": {"$ref": "semantic-common.schema.json#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "recipeId": {"enum": ["four-roots-grid-game", "twin-reactor-action-coop"]},
    "difficulty": {"enum": ["CALM", "STANDARD", "BRISK"]},
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {"width": {"enum": [16, 30]}, "height": {"enum": [10, 17]}}
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "panel", "wall", "path", "player", "accent", "text"],
      "properties": {
        "background": {"$ref": "#/$defs/color"}, "panel": {"$ref": "#/$defs/color"},
        "wall": {"$ref": "#/$defs/color"}, "path": {"$ref": "#/$defs/color"},
        "player": {"$ref": "#/$defs/color"}, "accent": {"$ref": "#/$defs/color"},
        "text": {"$ref": "#/$defs/color"}
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["touchTargetPx", "reducedMotionDefault", "highContrast"],
      "properties": {
        "touchTargetPx": {"type": "integer", "minimum": 44, "maximum": 72},
        "reducedMotionDefault": {"type": "boolean"},
        "highContrast": {"const": true}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistence", "network", "players"],
      "properties": {"persistence": {"const": "SESSION_ONLY"}, "network": {"const": "DISABLED"}, "players": {"enum": [1, 2]}}
    },
    "authority": {"const": "NONE"},
    "briefDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"recipeId": {"const": "four-roots-grid-game"}}, "required": ["recipeId"]},
      "then": {"properties": {"world": {"properties": {"width": {"const": 16}, "height": {"const": 10}}}, "session": {"properties": {"players": {"const": 1}}}}}
    },
    {
      "if": {"properties": {"recipeId": {"const": "twin-reactor-action-coop"}}, "required": ["recipeId"]},
      "then": {"properties": {"world": {"properties": {"width": {"const": 30}, "height": {"const": 17}}}, "session": {"properties": {"players": {"const": 2}}}}}
    }
  ],
  "$defs": {"color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}
}
