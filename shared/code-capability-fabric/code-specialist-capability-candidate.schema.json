{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-specialist-capability-candidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "requestRef", "specialistContext", "consentRef", "catalogRef", "buildProfileCatalogRef", "recipeRef", "buildRequestRef", "buildPlan", "buildReceiptRef", "detachedCandidate", "evidence", "holds", "capabilityGapReport", "resourceObservation", "reuseRights", "limitations", "nextGate", "truth", "authority", "resultDigest"],
  "properties": {
    "schema": {"const": "axm.code-specialist-capability-candidate/v1"},
    "version": {"const": "2.5.0"},
    "status": {"enum": ["ROOTS_HOLD", "INTENT_LINEAGE_HOLD", "SPECIALIST_HOLD", "RECIPE_HOLD", "BUILD_REQUEST_HOLD", "CONSENT_HOLD", "BUILD_PLAN_HOLD", "CANDIDATE_HOLD", "COMPLETE_DETACHED_CANDIDATE"]},
    "requestRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
    "specialistContext": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/specialistContext"}]},
    "consentRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/consentRef"}]},
    "catalogRef": {"oneOf": [{"type": "null"}, {"$ref": "semantic-common.schema.json#/$defs/reference"}]},
    "buildProfileCatalogRef": {"oneOf": [{"type": "null"}, {"$ref": "semantic-common.schema.json#/$defs/reference"}]},
    "recipeRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/recipeRef"}]},
    "buildRequestRef": {"oneOf": [{"type": "null"}, {"$ref": "semantic-common.schema.json#/$defs/reference"}]},
    "buildPlan": {"oneOf": [{"type": "null"}, {"$ref": "../capability-fabric/schemas/build-plan.schema.json"}]},
    "buildReceiptRef": {"oneOf": [{"type": "null"}, {"$ref": "semantic-common.schema.json#/$defs/reference"}]},
    "detachedCandidate": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidate"}]},
    "evidence": {"$ref": "#/$defs/evidence"},
    "holds": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {"code": {"type": "string"}, "detail": {"type": "string"}}}},
    "capabilityGapReport": {"$ref": "code-specialization-plan.schema.json#/$defs/gapReport"},
    "resourceObservation": {"$ref": "#/$defs/resources"},
    "reuseRights": {"type": "object", "additionalProperties": false, "required": ["mode", "externalSourceBytesIncluded", "publicCopyAuthorized", "directReuseAuthorized"], "properties": {"mode": {"const": "RESEARCH_ONLY_DIRECT_REUSE_HOLD"}, "externalSourceBytesIncluded": {"const": false}, "publicCopyAuthorized": {"const": false}, "directReuseAuthorized": {"const": false}}},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "nextGate": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$"},
    "truth": {"$ref": "#/$defs/truth"},
    "authority": {"const": "NONE"},
    "resultDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "versionedRef": {"type": "object", "additionalProperties": false, "required": ["id", "schema", "version", "sha256"], "properties": {"id": {"type": "string"}, "schema": {"type": "string"}, "version": {"type": "string"}, "sha256": {"$ref": "semantic-common.schema.json#/$defs/digest"}}},
    "specialistContext": {"type": "object", "additionalProperties": false, "required": ["intentPlanRef", "artifactRef", "specialistOrganRef", "buildProfileRef", "languageId", "organIntentRef"], "properties": {"intentPlanRef": {"$ref": "semantic-common.schema.json#/$defs/reference"}, "artifactRef": {"$ref": "semantic-common.schema.json#/$defs/reference"}, "specialistOrganRef": {"$ref": "#/$defs/versionedRef"}, "buildProfileRef": {"$ref": "#/$defs/versionedRef"}, "languageId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "organIntentRef": {"$ref": "semantic-common.schema.json#/$defs/reference"}}},
    "consentRef": {"type": "object", "additionalProperties": false, "required": ["decisionRef", "tier", "subject", "evaluatedAt", "expiresAt", "nonce", "replayState"], "properties": {"decisionRef": {"$ref": "semantic-common.schema.json#/$defs/reference"}, "tier": {"const": "TIER_1_DETACHED_CANDIDATE"}, "subject": {"type": "object", "additionalProperties": false, "required": ["intentPlanDigest", "capabilityRequestDigest", "catalogDigest", "recipeDigest", "buildProfileCatalogDigest", "buildProfileDigest"], "properties": {"intentPlanDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}, "capabilityRequestDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}, "catalogDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}, "recipeDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}, "buildProfileCatalogDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}, "buildProfileDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}}}, "evaluatedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}, "nonce": {"type": "string"}, "replayState": {"const": "UNVERIFIED_SINGLE_USE_CLAIM"}}},
    "recipeRef": {"type": "object", "additionalProperties": false, "required": ["id", "version", "digest", "builderId", "builderDigest", "capabilityKind"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"}, "version": {"type": "string", "minLength": 1, "maxLength": 80}, "digest": {"$ref": "semantic-common.schema.json#/$defs/digest"}, "builderId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"}, "builderDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}, "capabilityKind": {"enum": ["HAND", "SKILL"]}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["package", "files", "compilation"], "properties": {"package": {"$ref": "../capability-fabric/schemas/candidate-package.schema.json"}, "files": {"type": "object", "minProperties": 1, "maxProperties": 32, "additionalProperties": {"type": "string"}}, "compilation": {"type": "object"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["intentRebuild", "candidateStructure", "candidateByteLineage", "candidatePaths", "emittedSelftest", "runtimeBehavior", "visualBehavior"], "properties": {"intentRebuild": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "candidateStructure": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "candidateByteLineage": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "candidatePaths": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "emittedSelftest": {"enum": ["EMITTED_NOT_RUN", "NOT_EMITTED"]}, "runtimeBehavior": {"const": "UNKNOWN"}, "visualBehavior": {"enum": ["NOT_APPLICABLE", "UNKNOWN"]}}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["inputBytes", "outputBytes", "buildPasses", "attemptsEnforced", "candidateFileCeilingEnforced", "candidateByteCeilingEnforced", "durationEnforced", "memoryEnforced", "processesSpawned", "providerCalled", "networkUsed", "workspaceRead", "workspaceWritten", "candidateExecuted", "generatedSelftestExecuted"], "properties": {"inputBytes": {"type": "integer", "minimum": 1}, "outputBytes": {"type": "integer", "minimum": 1}, "buildPasses": {"enum": [0, 2]}, "attemptsEnforced": {"const": true}, "candidateFileCeilingEnforced": {"const": true}, "candidateByteCeilingEnforced": {"const": true}, "durationEnforced": {"const": false}, "memoryEnforced": {"const": false}, "processesSpawned": {"const": 0}, "providerCalled": {"const": false}, "networkUsed": {"const": false}, "workspaceRead": {"const": false}, "workspaceWritten": {"const": false}, "candidateExecuted": {"const": false}, "generatedSelftestExecuted": {"const": false}}},
    "truth": {"type": "object", "additionalProperties": false, "required": ["deterministicNativeRecipeBuild", "nativeBuilderInvoked", "candidateBytesGeneratedTransiently", "rootsEvaluatedBeforeIntentAndBuild", "exactIntentPlanRebuilt", "specialistProfileProvesCapability", "organIntentProvesImplementationSemantics", "buildRequestCarriesExplicitImplementationSemantics", "sourceReviewedRecipeExact", "authenticatedHumanIdentityProven", "consentReplayPreventionProven", "candidateGenerated", "candidateDetached", "generatedCodeExecuted", "generatedSelftestExecuted", "candidateRuntimeProven", "workspaceRead", "workspaceWritten", "permissionGranted", "networkUsed", "installed", "integrated", "published", "promoted", "canonChanged", "mikeFinalMergeGatePreserved"], "properties": {"deterministicNativeRecipeBuild": {"type": "boolean"}, "nativeBuilderInvoked": {"type": "boolean"}, "candidateBytesGeneratedTransiently": {"type": "boolean"}, "rootsEvaluatedBeforeIntentAndBuild": {"const": true}, "exactIntentPlanRebuilt": {"type": "boolean"}, "specialistProfileProvesCapability": {"const": false}, "organIntentProvesImplementationSemantics": {"const": false}, "buildRequestCarriesExplicitImplementationSemantics": {"type": "boolean"}, "sourceReviewedRecipeExact": {"type": "boolean"}, "authenticatedHumanIdentityProven": {"const": false}, "consentReplayPreventionProven": {"const": false}, "candidateGenerated": {"type": "boolean"}, "candidateDetached": {"type": "boolean"}, "generatedCodeExecuted": {"const": false}, "generatedSelftestExecuted": {"const": false}, "candidateRuntimeProven": {"const": false}, "workspaceRead": {"const": false}, "workspaceWritten": {"const": false}, "permissionGranted": {"const": false}, "networkUsed": {"const": false}, "installed": {"const": false}, "integrated": {"const": false}, "published": {"const": false}, "promoted": {"const": false}, "canonChanged": {"const": false}, "mikeFinalMergeGatePreserved": {"const": true}}}
  }
}
