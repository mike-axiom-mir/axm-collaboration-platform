{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.grounded-consent-instance/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "policyRef", "domain", "subjectRef", "domainProfileRef", "predecisionEvidenceRefs", "inputArtifacts", "actions", "permissions", "networkDomains", "dataClasses", "sourceUses", "lifecycle", "resources", "requiredEvidenceSchemas", "reconsentTriggers", "stopConditions", "createdAt", "expiresAt", "authority", "instanceDigest"],
  "properties": {
    "schema": {"const": "axm.grounded-consent-instance/v1"},
    "id": {"$ref": "#/$defs/id"},
    "policyRef": {"$ref": "#/$defs/reference"},
    "domain": {"$ref": "#/$defs/id"},
    "subjectRef": {"$ref": "#/$defs/reference"},
    "domainProfileRef": {"$ref": "#/$defs/reference"},
    "predecisionEvidenceRefs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "inputArtifacts": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactReference"}},
    "actions": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "permissions": {"$ref": "#/$defs/ids"},
    "networkDomains": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "dataClasses": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "sourceUses": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "resources": {"$ref": "#/$defs/resources"},
    "requiredEvidenceSchemas": {"$ref": "#/$defs/contracts"},
    "reconsentTriggers": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "stopConditions": {"type": "array", "minItems": 8, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "authority": {"const": "NONE"},
    "instanceDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "contract": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,179}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "contracts": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/contract"}},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "schema": {"$ref": "#/$defs/contract"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256", "byteLength"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "schema": {"$ref": "#/$defs/contract"},
        "sha256": {"$ref": "#/$defs/digest"},
        "byteLength": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publish", "install", "deploy", "persistentLearning", "hardwareActuation", "canon"],
      "properties": {
        "publish": {"type": "boolean"},
        "install": {"type": "boolean"},
        "deploy": {"type": "boolean"},
        "persistentLearning": {"type": "boolean"},
        "hardwareActuation": {"type": "boolean"},
        "canon": {"type": "boolean"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputBytes", "maxOutputBytes", "maxMemoryBytes", "maxDurationMs", "maxProcesses", "maxAttempts", "maxCostMinorUnits"],
      "properties": {
        "maxInputBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxOutputBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxMemoryBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxDurationMs": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxProcesses": {"type": "integer", "minimum": 1, "maximum": 1024},
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maxCostMinorUnits": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    }
  }
}
