{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-artifact-observation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","version","id","observedAt","workspaceRef","artifacts","sourceBytesIncluded","sourceBytesRead","attestationRef","authority","observationDigest"],
  "properties": {
    "schema":{"const":"axm.code-artifact-observation/v1"},"version":{"const":"1.5.0"},
    "id":{"$ref":"semantic-common.schema.json#/$defs/id"},"observedAt":{"type":"string","format":"date-time"},
    "workspaceRef":{"$ref":"semantic-common.schema.json#/$defs/reference"},
    "artifacts":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/artifact"}},
    "sourceBytesIncluded":{"const":false},"sourceBytesRead":{"const":false},
    "attestationRef":{"oneOf":[{"type":"null"},{"$ref":"semantic-common.schema.json#/$defs/reference"}]},
    "authority":{"const":"NONE"},"observationDigest":{"$ref":"semantic-common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "ids":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,127}$"}},
    "tokens":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":220}},
    "artifact": {
      "type":"object","additionalProperties":false,
      "required":["id","path","sha256","byteLength","declaredLanguageId","artifactFamilies","responsibilities","runtimes","frameworks","requiredPermissions","networkDomains","interfaceContracts","dependsOnArtifactIds","sharedSeam"],
      "properties": {
        "id":{"$ref":"semantic-common.schema.json#/$defs/id"},"path":{"type":"string","minLength":1,"maxLength":240},
        "sha256":{"$ref":"semantic-common.schema.json#/$defs/digest"},"byteLength":{"type":"integer","minimum":0},
        "declaredLanguageId":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,127}$"}]},
        "artifactFamilies":{"allOf":[{"$ref":"#/$defs/ids"},{"minItems":1}]},
        "responsibilities":{"allOf":[{"$ref":"#/$defs/ids"},{"minItems":1}]},
        "runtimes":{"allOf":[{"$ref":"#/$defs/ids"},{"minItems":1}]},
        "frameworks":{"$ref":"#/$defs/ids"},"requiredPermissions":{"$ref":"#/$defs/ids"},"networkDomains":{"$ref":"#/$defs/ids"},
        "interfaceContracts":{"$ref":"#/$defs/tokens"},"dependsOnArtifactIds":{"$ref":"#/$defs/ids"},"sharedSeam":{"type":"boolean"}
      }
    }
  }
}

