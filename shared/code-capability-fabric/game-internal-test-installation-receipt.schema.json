{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.game-internal-test-installation-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "gameId", "gameVersion", "status", "decisionRef", "ancestorRef", "bundleRef", "installedFiles", "hostFiles", "application", "verification", "authority", "receiptDigest"],
  "properties": {
    "schema": {"const": "axm.game-internal-test-installation-receipt/v1"},
    "version": {"const": "1.0.0"},
    "gameId": {"type": "string", "pattern": "^[0-9]{3}-[a-z0-9-]+$"},
    "gameVersion": {"type": "string", "minLength": 1, "maxLength": 32},
    "status": {"const": "TEST"},
    "decisionRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
    "ancestorRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
    "bundleRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
    "installedFiles": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "semantic-common.schema.json#/$defs/sourceFile"}},
    "hostFiles": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "semantic-common.schema.json#/$defs/sourceFile"}},
    "application": {"type": "object", "additionalProperties": false, "required": ["appliedBy", "sourceCommit", "targetBranch", "targetRelativePath", "generatedCodePerformedInstall", "installedInReviewBranch", "installedInCanonicalCheckout", "overwroteExistingGame", "gameHubAutoDiscovery"], "properties": {"appliedBy": {"const": "CODEX_HOST_STEWARD_UNDER_RECORDED_MIKE_DIRECTION"}, "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "targetBranch": {"type": "string", "pattern": "^codex/[a-z0-9._/-]+$"}, "targetRelativePath": {"type": "string", "pattern": "^tools/game-hub/game-library/[0-9]{3}-[a-z0-9-]+$"}, "generatedCodePerformedInstall": {"const": false}, "installedInReviewBranch": {"const": true}, "installedInCanonicalCheckout": {"const": false}, "overwroteExistingGame": {"const": false}, "gameHubAutoDiscovery": {"const": true}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["exactCandidateBytes", "staticBoundary", "packageSelftest", "gameHubPackageVerifier", "detachedBrowserJourney", "installedHttpJourney", "installedBrowserJourney", "humanTasteDecision"], "properties": {"exactCandidateBytes": {"const": "PASS"}, "staticBoundary": {"const": "PASS"}, "packageSelftest": {"const": "PASS"}, "gameHubPackageVerifier": {"const": "PASS"}, "detachedBrowserJourney": {"const": "PASS"}, "installedHttpJourney": {"const": "PASS"}, "installedBrowserJourney": {"const": "PASS"}, "humanTasteDecision": {"const": "PROMOTE_TO_INTERNAL_TEST"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["internalTestInstalled", "publicRelease", "promotedBeyondTest", "canonChanged", "foundationChanged", "finalMergeGate"], "properties": {"internalTestInstalled": {"const": true}, "publicRelease": {"const": false}, "promotedBeyondTest": {"const": false}, "canonChanged": {"const": false}, "foundationChanged": {"const": false}, "finalMergeGate": {"const": "MIKE_TOBI"}}},
    "receiptDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}
  }
}
