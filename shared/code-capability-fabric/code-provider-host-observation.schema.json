{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-provider-host-observation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "observedAt", "availability", "grantedPermissions", "allowedNetworkDomains", "executorRef", "verificationRefs"],
  "properties": {
    "schema": {"const": "axm.code-provider-host-observation/v1"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "descriptorSha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"},
        "descriptorSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "observedAt": {"type": "string", "format": "date-time"},
    "availability": {"enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN"]},
    "grantedPermissions": {"$ref": "#/$defs/ids"},
    "allowedNetworkDomains": {"$ref": "#/$defs/ids"},
    "executorRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
    "verificationRefs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/reference"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,179}$"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
