{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.fabric-declarative-capability-blueprint/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "id", "name", "purpose", "status", "kind", "provides", "consumes", "interface", "composition", "desiredOutcomes", "resourceBudget", "permissions", "rootsGate", "acceptancePlan", "boundaries", "provenance", "authority", "blueprintDigest"],
  "properties": {
    "schema": {"const": "axm.fabric-declarative-capability-blueprint/v1"},
    "version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 600},
    "status": {"const": "EXPERIMENTAL"},
    "kind": {"const": "PURE_DATA_TRANSFORM"},
    "provides": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/contractToken"}},
    "consumes": {"const": []},
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "fabric-declarative-blueprint-intent.schema.json#/$defs/inputField"}},
        "outputs": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "fabric-declarative-blueprint-intent.schema.json#/$defs/outputField"}}
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {"steps": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "fabric-declarative-blueprint-intent.schema.json#/$defs/step"}}}
    },
    "desiredOutcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "status"],
        "properties": {"claim": {"type": "string", "minLength": 1, "maxLength": 360}, "status": {"const": "UNPROVEN"}}
      }
    },
    "resourceBudget": {"$ref": "fabric-declarative-blueprint-intent.schema.json#/$defs/resourceBudget"},
    "permissions": {"const": []},
    "rootsGate": {"const": ["truth", "agency-non-domination", "continuity", "wisdom-over-speed"]},
    "acceptancePlan": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/acceptanceCase"}},
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permits", "refuses"],
      "properties": {
        "permits": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
        "refuses": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intentRef", "composerProfileRef"],
      "properties": {"intentRef": {"$ref": "#/$defs/reference"}, "composerProfileRef": {"$ref": "#/$defs/reference"}}
    },
    "authority": {"const": "NONE"},
    "blueprintDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "contractToken": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,179}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/contractToken"}, "schema": {"$ref": "#/$defs/contractToken"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "acceptanceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "evidenceRequired", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "claim": {"type": "string", "minLength": 1, "maxLength": 500},
        "evidenceRequired": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,99}$"},
        "status": {"enum": ["COMPOSER_VALIDATED", "PLANNED"]}
      }
    }
  }
}
