{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-recipe-evidence-packet/v1",
  "title": "AXM Code Recipe Evidence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "generatedAt", "query", "sourcePackRef", "summary", "candidates", "heldMatches", "boundaries", "querySha256", "packetSha256"],
  "properties": {
    "schema": {"const": "axm.code-recipe-evidence-packet/v1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "EVIDENCE_ONLY"},
    "generatedAt": {"type": ["string", "null"]},
    "query": {"type": "object"},
    "sourcePackRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "objectSha256", "recipeSetSha256", "sourceClaimsVerified", "canon"],
      "properties": {
        "schema": {"const": "axm.code-recipe-pack/v1"},
        "objectSha256": {"$ref": "#/$defs/digest"},
        "recipeSetSha256": {"type": ["string", "null"]},
        "sourceClaimsVerified": {"type": "boolean"},
        "canon": {"type": "boolean"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipesScanned", "eligibleMatches", "heldMatches", "returned", "truncated"],
      "properties": {
        "recipesScanned": {"type": "integer", "minimum": 0, "maximum": 5000},
        "eligibleMatches": {"type": "integer", "minimum": 0, "maximum": 5000},
        "heldMatches": {"type": "integer", "minimum": 0, "maximum": 5000},
        "returned": {"type": "integer", "minimum": 0, "maximum": 32},
        "truncated": {"type": "boolean"}
      }
    },
    "candidates": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/match"}},
    "heldMatches": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/match"}},
    "boundaries": {"type": "object"},
    "querySha256": {"$ref": "#/$defs/digest"},
    "packetSha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "recipe"],
      "properties": {
        "match": {"type": "object"},
        "recipe": {"type": "object"}
      }
    }
  }
}
