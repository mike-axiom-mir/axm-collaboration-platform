{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-capability-readiness-subject/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requestScopeDigest", "provider", "observerRef", "availability", "observationWindow", "executorRef", "workspaceBoundaryRef", "authorityEnvelopeDigest", "resourceEnvelopeDigest", "plannedAuthorityDigest", "plannedResourceDigest", "plannedWorkspaceBoundaryRef"],
  "properties": {
    "schema": {"const": "axm.code-capability-readiness-subject/v1"},
    "requestScopeDigest": {"$ref": "#/$defs/digest"},
    "provider": {"$ref": "#/$defs/providerSelector"},
    "observerRef": {"$ref": "#/$defs/reference"},
    "availability": {"const": "AVAILABLE"},
    "observationWindow": {"$ref": "#/$defs/observationWindow"},
    "executorRef": {"$ref": "#/$defs/reference"},
    "workspaceBoundaryRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
    "authorityEnvelopeDigest": {"$ref": "#/$defs/digest"},
    "resourceEnvelopeDigest": {"$ref": "#/$defs/digest"},
    "plannedAuthorityDigest": {"$ref": "#/$defs/digest"},
    "plannedResourceDigest": {"$ref": "#/$defs/digest"},
    "plannedWorkspaceBoundaryRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"},
    "contract": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,179}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "schema": {"$ref": "#/$defs/contract"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "providerSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "descriptorSha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "descriptorSha256": {"$ref": "#/$defs/digest"}}
    },
    "observationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "expiresAt"],
      "properties": {"observedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}}
    }
  }
}
