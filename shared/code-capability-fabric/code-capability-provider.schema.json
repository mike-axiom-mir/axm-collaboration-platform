{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-capability-provider/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "status", "capabilities", "accepts", "produces", "permissions", "network", "mutability", "executionBoundary", "evidenceCeiling"],
  "properties": {
    "schema": {"const": "axm.code-capability-provider/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["EXPERIMENTAL", "TEST", "WORKING"]},
    "capabilities": {"$ref": "#/$defs/requiredIds"},
    "accepts": {"$ref": "#/$defs/contracts"},
    "produces": {"$ref": "#/$defs/contracts"},
    "permissions": {"$ref": "#/$defs/ids"},
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "domains"],
      "properties": {
        "mode": {"enum": ["disabled", "allowlist"]},
        "domains": {"$ref": "#/$defs/ids"}
      }
    },
    "mutability": {"enum": ["read-only", "candidate-only", "process-observation"]},
    "executionBoundary": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "evidenceCeiling": {"type": "string", "minLength": 1, "maxLength": 600}
  },
  "$defs": {
    "ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"}},
    "requiredIds": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"}},
    "contracts": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,179}$"}}
  }
}
