{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-provider-host-observation/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "observerRef", "observedAt", "expiresAt", "availability", "workspaceBoundaryRef", "executorRef", "authorityEnvelope", "resourceEnvelope", "assuranceRefs", "recordDigest"],
  "properties": {
    "schema": {"const": "axm.code-provider-host-observation/v2"},
    "provider": {"$ref": "#/$defs/providerSelector"},
    "observerRef": {"$ref": "#/$defs/reference"},
    "observedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "availability": {"enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN"]},
    "workspaceBoundaryRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
    "executorRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
    "authorityEnvelope": {"$ref": "#/$defs/authority"},
    "resourceEnvelope": {"$ref": "#/$defs/resources"},
    "assuranceRefs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "recordDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "contract": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,179}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "schema": {"$ref": "#/$defs/contract"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "providerSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "descriptorSha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "descriptorSha256": {"$ref": "#/$defs/digest"}}
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "domains"],
      "properties": {"mode": {"enum": ["disabled", "allowlist"]}, "domains": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissions", "network", "mutability", "sourceUse"],
      "properties": {
        "permissions": {"$ref": "#/$defs/ids"},
        "network": {"$ref": "#/$defs/network"},
        "mutability": {"enum": ["read-only", "candidate-only", "process-observation"]},
        "sourceUse": {"enum": ["inspect-only", "derive-concepts", "transform-bytes", "copy-bytes"]}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputBytes", "maxOutputBytes", "maxMemoryBytes", "maxDurationMs", "maxProcesses"],
      "properties": {
        "maxInputBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxOutputBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxMemoryBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxDurationMs": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxProcesses": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    }
  }
}
