      "arbitrary-workspace-content-reading",
      "network-use",
      "child-process-execution",
      "generated-code-emission",
      "generated-code-execution",
      "acceptance-case-pass-claims",
      "existing-root-overwrite",
      "permission-grant",
      "automatic-install",
      "automatic-registration",
      "automatic-staging",
      "automatic-promotion",
      "automatic-canon",
      "machine-wide-default-activation",
      "persistent-learning-admission"
    ]
  },
  "lifecycle": {
    "state_owner": "host-selected disposable output root",
    "reload": "exact source digests and a new instruction are required",
    "disconnect": "no background work",
    "cleanup": "failed attempts remove only their newly owned root; successful schema packets are retained for review"
  }
}
