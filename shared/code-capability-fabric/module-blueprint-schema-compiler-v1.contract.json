  "version": "v0.1",
  "status": "TEST",
  "provides": [
    "axm.fabric-blueprint-schema-compilation-subject/v1",
    "axm.fabric-blueprint-acceptance-matrix/v1",
    "axm.fabric-blueprint-schema-compilation-receipt/v1",
    "code.compile-blueprint-schemas"
  ],
  "consumes": [
