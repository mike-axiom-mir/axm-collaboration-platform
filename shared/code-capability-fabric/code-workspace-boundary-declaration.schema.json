{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-workspace-boundary-declaration/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "sourceRoots", "outputRoot", "evidenceRoot"],
  "properties": {
    "schema": {"const": "axm.code-workspace-boundary-declaration/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "sourceRoots": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "outputRoot": {"$ref": "#/$defs/path"},
    "evidenceRoot": {"$ref": "#/$defs/path"}
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+/-]*$"
    }
  }
}
