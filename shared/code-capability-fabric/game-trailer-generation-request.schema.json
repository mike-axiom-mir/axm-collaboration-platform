{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.game-trailer-generation-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "goal", "gameContentRef", "gameManifestRef", "outputProfile", "rootsGate", "marketingPolicy", "resources", "rights", "hostDecision", "authority", "requestDigest"],
  "properties": {
    "schema": {"const": "axm.game-trailer-generation-request/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 600},
    "gameContentRef": {"$ref": "#/$defs/artifactRef"},
    "gameManifestRef": {"$ref": "#/$defs/artifactRef"},
    "outputProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "frameRate", "durationSeconds", "samples", "uniqueFrames", "formats", "audio", "captions"],
      "properties": {
        "width": {"const": 640}, "height": {"const": 360}, "frameRate": {"const": 12}, "durationSeconds": {"const": 30},
        "samples": {"const": 360}, "uniqueFrames": {"const": 48},
        "formats": {"const": ["video/mp4", "video/webm"]}, "audio": {"const": false}, "captions": {"const": true}
      }
    },
    "rootsGate": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/rootVerdict"}},
    "marketingPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["claimsOnlyFromEvidence", "fakeReviewQuotes", "universalBest", "publicAvailability", "canon"],
      "properties": {"claimsOnlyFromEvidence": {"const": true}, "fakeReviewQuotes": {"const": false}, "universalBest": {"const": false}, "publicAvailability": {"const": false}, "canon": {"const": false}}
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["maxInputBytes", "maxPlanBytes", "maxUniqueFrameBytes", "maxEncodedOutputBytes", "maxFiles", "maxChildProcesses", "maxNetworkRequests"],
      "properties": {
        "maxInputBytes": {"type": "integer", "minimum": 1, "maximum": 131072},
        "maxPlanBytes": {"type": "integer", "minimum": 1, "maximum": 131072},
        "maxUniqueFrameBytes": {"const": 44236800},
        "maxEncodedOutputBytes": {"type": "integer", "minimum": 1, "maximum": 52428800},
        "maxFiles": {"const": 9}, "maxChildProcesses": {"const": 0}, "maxNetworkRequests": {"const": 0}
      }
    },
    "rights": {"type": "object", "additionalProperties": false, "required": ["internalWorkshopReview", "publicDistribution"], "properties": {"internalWorkshopReview": {"const": "MIKE_AUTHORIZED_TEST"}, "publicDistribution": {"const": "HOLD"}}},
    "hostDecision": {"type": "object", "additionalProperties": false, "required": ["source", "authenticatedIdentityProven", "planAuthorized", "renderAuthorized", "publishAuthorized"], "properties": {"source": {"const": "EXPLICIT_IN_THREAD_DIRECTION"}, "authenticatedIdentityProven": {"const": false}, "planAuthorized": {"const": true}, "renderAuthorized": {"const": true}, "publishAuthorized": {"const": false}}},
    "authority": {"const": "NONE"},
    "requestDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["id", "schema", "path", "sha256", "byteLength"], "properties": {"id": {"type": "string"}, "schema": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}, "byteLength": {"type": "integer", "minimum": 1}}},
    "rootVerdict": {"type": "object", "additionalProperties": false, "required": ["root", "verdict", "evidenceRefs"], "properties": {"root": {"enum": ["truth", "agency-non-domination", "continuity", "wisdom-over-speed"]}, "verdict": {"const": "PASS"}, "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/evidenceRef"}}}},
    "evidenceRef": {"type": "object", "additionalProperties": false, "required": ["id", "schema", "sha256"], "properties": {"id": {"type": "string"}, "schema": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}}}
  }
}
