{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.semantic-candidate-materialization-subject/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "id", "status", "generationRequestRef", "candidateRef", "moduleBundleRef", "reviewCardRef", "recipeLibraryRef", "trustPolicyRef", "nurseryRef", "candidateRootName", "scope", "tier", "rootsGate", "declaredAuthority", "resources", "reuseRights", "truth", "authority", "subjectDigest"],
  "properties": {
    "schema": {"const": "axm.semantic-candidate-materialization-subject/v1"},
    "version": {"const": "0.1.0"},
    "id": {"$ref": "semantic-common.schema.json#/$defs/id"},
    "status": {"const": "PREPARED_FOR_HUMAN_DECISION"},
    "generationRequestRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
    "candidateRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
    "moduleBundleRef": {"$ref": "semantic-common.schema.json#/$defs/artifactReference"},
    "reviewCardRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
    "recipeLibraryRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
    "trustPolicyRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
    "nurseryRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
    "candidateRootName": {"type": "string", "pattern": "^axm-semantic-candidate-[a-z0-9][a-z0-9-]{1,79}-[a-f0-9]{12}$"},
    "scope": {"const": "TIER_1_CREATE_ONE_DETACHED_CANDIDATE"},
    "tier": {"const": 1},
    "rootsGate": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "semantic-common.schema.json#/$defs/rootDecision"}},
    "declaredAuthority": {"$ref": "#/$defs/emptyAuthority"},
    "resources": {"$ref": "#/$defs/resources"},
    "reuseRights": {"$ref": "#/$defs/reuseRights"},
    "truth": {"$ref": "#/$defs/truth"},
    "authority": {"const": "NONE"},
    "subjectDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "emptyAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissions", "networkDomains", "lifecycleEffects"],
      "properties": {"permissions": {"const": []}, "networkDomains": {"const": []}, "lifecycleEffects": {"const": []}}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateFileCount", "candidateBytes", "evidenceByteCeiling", "totalByteCeiling", "maxAttempts", "maxProcesses", "maxCostMinorUnits"],
      "properties": {
        "candidateFileCount": {"type": "integer", "minimum": 7, "maximum": 17},
        "candidateBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "evidenceByteCeiling": {"type": "integer", "minimum": 1024, "maximum": 131072},
        "totalByteCeiling": {"type": "integer", "minimum": 2048, "maximum": 1179648},
        "maxAttempts": {"const": 1}, "maxProcesses": {"const": 1}, "maxCostMinorUnits": {"const": 0}
      }
    },
    "reuseRights": {
      "type": "object", "additionalProperties": false, "required": ["state", "directReuseAllowed"],
      "properties": {"state": {"const": "RESEARCH_ONLY_HOLD"}, "directReuseAllowed": {"const": false}}
    },
    "truth": {
      "type": "object", "additionalProperties": false,
      "required": ["semanticGenerationRebuilt", "exactCandidateBytesBound", "candidateCodeExecuted", "hostWriteAuthorityGranted", "authenticatedHumanDecisionVerified", "installed", "integrated", "promoted", "canonChanged"],
      "properties": {
        "semanticGenerationRebuilt": {"const": true}, "exactCandidateBytesBound": {"const": true},
        "candidateCodeExecuted": {"const": false}, "hostWriteAuthorityGranted": {"const": false},
        "authenticatedHumanDecisionVerified": {"const": false}, "installed": {"const": false},
        "integrated": {"const": false}, "promoted": {"const": false}, "canonChanged": {"const": false}
      }
    }
  }
}
