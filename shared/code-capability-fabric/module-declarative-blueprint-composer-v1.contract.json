      "generated-code-emission",
      "generated-code-execution",
      "existing-root-overwrite",
      "permission-grant",
      "automatic-install",
      "automatic-registration",
      "automatic-staging",
      "automatic-promotion",
      "automatic-canon",
      "machine-wide-default-activation",
      "persistent-learning-admission"
    ]
  },
  "lifecycle": {
    "state_owner": "host-selected disposable output root",
    "reload": "explicit new instruction required",
    "disconnect": "no background work",
    "cleanup": "failed attempts remove only their newly owned root; successful blueprint is retained for review"
  }
}
