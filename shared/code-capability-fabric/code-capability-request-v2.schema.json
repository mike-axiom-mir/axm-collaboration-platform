{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-capability-request/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "capability", "inputSchema", "outputSchema", "selection", "inputArtifacts", "workspaceBoundaryRef", "reuseRights", "policy"],
  "properties": {
    "schema": {"const": "axm.code-capability-request/v2"},
    "id": {"$ref": "#/$defs/id"},
    "capability": {"$ref": "#/$defs/id"},
    "inputSchema": {"$ref": "#/$defs/contract"},
    "outputSchema": {"$ref": "#/$defs/contract"},
    "selection": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/providerSelector"}]},
    "inputArtifacts": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactReference"}},
    "workspaceBoundaryRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
    "reuseRights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "authorityRef"],
      "properties": {
        "mode": {"enum": ["RESEARCH_ONLY", "DECLARED_REUSE_ALLOWED"]},
        "authorityRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "allowedPermissions", "allowedNetworkDomains", "allowedMutability", "allowedSourceUse", "resourceCeilings", "observation", "requiredAssuranceSchemas"],
      "properties": {
        "authority": {"const": "PLAN_ONLY"},
        "allowedPermissions": {"$ref": "#/$defs/ids"},
        "allowedNetworkDomains": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "allowedMutability": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["read-only", "candidate-only", "process-observation"]}},
        "allowedSourceUse": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"enum": ["inspect-only", "derive-concepts", "transform-bytes", "copy-bytes"]}},
        "resourceCeilings": {"$ref": "#/$defs/resources"},
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluatedAt", "maximumAgeMs", "trustedObserverRefs", "selectedRecordDigest"],
          "properties": {
            "evaluatedAt": {"type": "string", "format": "date-time"},
            "maximumAgeMs": {"type": "integer", "minimum": 1, "maximum": 2678400000},
            "trustedObserverRefs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
            "selectedRecordDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}
          }
        },
        "requiredAssuranceSchemas": {"$ref": "#/$defs/contracts"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "contract": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,179}$"},
    "contracts": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/contract"}},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "schema": {"$ref": "#/$defs/contract"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256", "byteLength"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "schema": {"$ref": "#/$defs/contract"},
        "sha256": {"$ref": "#/$defs/digest"},
        "byteLength": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "providerSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "descriptorSha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "descriptorSha256": {"$ref": "#/$defs/digest"}}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputBytes", "maxOutputBytes", "maxMemoryBytes", "maxDurationMs", "maxProcesses"],
      "properties": {
        "maxInputBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxOutputBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxMemoryBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxDurationMs": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxProcesses": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    }
  }
}
