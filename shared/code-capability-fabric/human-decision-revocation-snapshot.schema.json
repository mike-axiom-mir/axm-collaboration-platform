{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.human-decision-revocation-snapshot/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "id", "trustPolicyRef", "observedAt", "expiresAt", "revokedSeatIds", "revokedDecisionKeyDigests", "revokedNonces", "revokedDecisionDigests", "authority", "snapshotDigest", "signatureBase64"],
  "properties": {
    "schema": {"const": "axm.human-decision-revocation-snapshot/v1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "SIGNED_HOST_SNAPSHOT"},
    "id": {"$ref": "semantic-common.schema.json#/$defs/id"},
    "trustPolicyRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
    "observedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "revokedSeatIds": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "semantic-common.schema.json#/$defs/id"}},
    "revokedDecisionKeyDigests": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "semantic-common.schema.json#/$defs/digest"}},
    "revokedNonces": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "semantic-common.schema.json#/$defs/id"}},
    "revokedDecisionDigests": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "semantic-common.schema.json#/$defs/digest"}},
    "authority": {"const": "REVOCATION_STATUS_ONLY"},
    "snapshotDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"},
    "signatureBase64": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
  }
}
