{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-host-observation-attestation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observationRecordDigest", "keyRef", "signedAt", "signatureBase64"],
  "properties": {
    "schema": {"const": "axm.code-host-observation-attestation/v1"},
    "observationRecordDigest": {"$ref": "#/$defs/digest"},
    "keyRef": {"$ref": "#/$defs/reference"},
    "signedAt": {"type": "string", "format": "date-time"},
    "signatureBase64": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "contract": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,179}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "schema": {"$ref": "#/$defs/contract"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
