{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "axm.workshop-contract-repair-request/v1",
  "title": "AXM Workshop Contract Repair Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "sourceLabel", "evaluatedAt", "recipe", "target", "rootsGate", "authorization", "resources", "privacy", "authority", "requestDigest"],
  "properties": {
    "schema": {"const": "axm.workshop-contract-repair-request/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "sourceLabel": {"type": "string", "minLength": 1, "maxLength": 160},
    "evaluatedAt": {"type": "string", "format": "date-time"},
    "recipe": {"const": {"id": "draft-legacy-manifest-schema-kind-alternatives-v1", "repairClass": "LEGACY_MANIFEST_SCHEMA_AND_KIND"}},
    "target": {"$ref": "#/definitions/target"},
    "rootsGate": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/definitions/rootGate"}},
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["decisionRef", "snapshotRead", "sandboxDraft", "sandboxRefresh", "preview", "humanSelectionRequired", "machineSelection", "candidateExecution", "sourceWriteBack", "install", "integrate", "publish", "promote", "canon", "authenticatedIdentityProven", "authority"],
      "properties": {
        "decisionRef": {"$ref": "#/definitions/reference"},
        "snapshotRead": {"const": true}, "sandboxDraft": {"const": true}, "sandboxRefresh": {"const": true}, "preview": {"const": true}, "humanSelectionRequired": {"const": true},
        "machineSelection": {"const": false}, "candidateExecution": {"const": false}, "sourceWriteBack": {"const": false}, "install": {"const": false}, "integrate": {"const": false}, "publish": {"const": false}, "promote": {"const": false}, "canon": {"const": false}, "authenticatedIdentityProven": {"const": false}, "authority": {"const": "NONE"}
      }
    },
    "resources": {"$ref": "#/definitions/resourcePolicy"},
    "privacy": {"$ref": "#/definitions/privacy"},
    "authority": {"const": "NONE"},
    "requestDigest": {"$ref": "#/definitions/digest"}
  },
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {"type": "object", "additionalProperties": false, "required": ["id", "schema", "sha256"], "properties": {"id": {"type": "string"}, "schema": {"type": "string"}, "sha256": {"$ref": "#/definitions/digest"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["toolId", "manifestPath", "contractPath", "selftestPath"], "properties": {"toolId": {"type": "string"}, "manifestPath": {"type": "string"}, "contractPath": {"type": "string"}, "selftestPath": {"type": "string"}}},
    "rootGate": {"type": "object", "additionalProperties": false, "required": ["root", "verdict", "evidenceRefs"], "properties": {"root": {"enum": ["TRUTH", "AGENCY_NON_DOMINATION", "CONTINUITY", "WISDOM_OVER_SPEED"]}, "verdict": {"const": "PASS"}, "evidenceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/reference"}}}},
    "resourcePolicy": {"type": "object", "additionalProperties": false, "required": ["maxInputFiles", "maxInputBytes", "maxOutputFiles", "maxOutputBytes", "maxEvidenceFiles", "maxEvidenceBytes", "maxIterations", "maxNetworkRequests", "maxChildProcesses"], "properties": {"maxInputFiles": {"const": 8}, "maxInputBytes": {"const": 2097152}, "maxOutputFiles": {"const": 6}, "maxOutputBytes": {"const": 8388608}, "maxEvidenceFiles": {"const": 16}, "maxEvidenceBytes": {"const": 8388608}, "maxIterations": {"const": 8}, "maxNetworkRequests": {"const": 0}, "maxChildProcesses": {"const": 0}}},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["scopeId", "sourceBytesInEvidence", "candidateBytesInOutput", "stdoutRetention", "stderrRetention", "machinePathRetention", "secretsRead"], "properties": {"scopeId": {"const": "target-legacy-manifest-contract-selftest-v1"}, "sourceBytesInEvidence": {"const": false}, "candidateBytesInOutput": {"const": true}, "stdoutRetention": {"const": false}, "stderrRetention": {"const": false}, "machinePathRetention": {"const": false}, "secretsRead": {"const": false}}}
  }
}
