{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-specialist-organ-profile/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "selectors", "methodMaskIds", "knowledgeLane", "evidenceKinds", "refuses"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{1,127}$"},
    "version": {"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "status": {"const":"TEST"},
    "selectors": {
      "type":"object","additionalProperties":false,
      "required":["languageFamilies","languageIds","artifactFamilies","responsibilities","runtimes"],
      "properties": {
        "languageFamilies":{"$ref":"#/$defs/ids"},"languageIds":{"$ref":"#/$defs/ids"},
        "artifactFamilies":{"$ref":"#/$defs/ids"},"responsibilities":{"$ref":"#/$defs/ids"},"runtimes":{"$ref":"#/$defs/ids"}
      }
    },
    "methodMaskIds":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128}},
    "knowledgeLane": {
      "type":"object","additionalProperties":false,
      "required":["id","state","allowedLessonKinds","admissionGate"],
      "properties": {
        "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{1,127}$"},
        "state":{"const":"REFERENCE_ONLY_EMPTY"},
        "allowedLessonKinds":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"enum":["ACCEPTED_RECIPE","COUNTERTEST","PRIVACY_SAFE_FAILURE_RULE","TEST"]}},
        "admissionGate":{"const":"SEPARATE_TIER_3_DECISION_AND_HELD_OUT_REGRESSION"}
      }
    },
    "evidenceKinds":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z0-9_]+$"}},
    "refuses":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":220}}
  },
  "$defs": {
    "ids":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,127}$"}}
  }
}

