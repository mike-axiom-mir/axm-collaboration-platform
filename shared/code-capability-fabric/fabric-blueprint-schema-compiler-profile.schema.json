{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.fabric-blueprint-schema-compiler-profile/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "kind", "maximumCompilerInputBytes", "maximumWrittenFiles", "maximumWrittenBytes", "sourceReads", "network", "childProcesses", "generatedCode", "generatedCodeExecution", "outputScope", "authority"],
  "properties": {
    "schema": {"const": "axm.fabric-blueprint-schema-compiler-profile/v1"},
    "id": {"const": "deterministic-inert-blueprint-schema-compiler"},
    "version": {"const": "0.1.0"},
    "kind": {"const": "PURE_DATA_TRANSFORM"},
    "maximumCompilerInputBytes": {"const": 65536},
    "maximumWrittenFiles": {"const": 4},
    "maximumWrittenBytes": {"const": 65536},
    "sourceReads": {"const": "BOUND_EXACT_INPUT_ARTIFACTS_ONLY"},
    "network": {"const": "DISABLED"},
    "childProcesses": {"const": "DISABLED"},
    "generatedCode": {"const": "DISABLED"},
    "generatedCodeExecution": {"const": "DISABLED"},
    "outputScope": {"const": "ONE_NEW_OWNED_ROOT"},
    "authority": {"const": "DISPOSABLE_SCHEMA_PACKET_WRITE_ONLY"}
  }
}
