{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.four-roots-adventure-content/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "status", "title", "tagline", "introMessage", "ancestor", "roots", "items", "quests", "zones", "ending", "authority", "limitations"],
  "properties": {
    "schema": {"const": "axm.four-roots-adventure-content/v1"},
    "id": {"const": "four-roots-adventure-content-v0.2"},
    "version": {"const": "0.2.0"},
    "status": {"const": "TEST"},
    "title": {"type": "string", "minLength": 1, "maxLength": 100},
    "tagline": {"type": "string", "minLength": 1, "maxLength": 240},
    "introMessage": {"type": "string", "minLength": 1, "maxLength": 600},
    "ancestor": {"type": "object", "additionalProperties": false, "required": ["candidateId", "candidateVersion", "sourceCommit", "requestDigest", "packetDigest", "bundleDigest", "liveIterationDigest"], "properties": {"candidateId": {"const": "four-roots-run-native"}, "candidateVersion": {"const": "v0.1"}, "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "requestDigest": {"$ref": "#/$defs/digest"}, "packetDigest": {"$ref": "#/$defs/digest"}, "bundleDigest": {"$ref": "#/$defs/digest"}, "liveIterationDigest": {"$ref": "#/$defs/digest"}}},
    "roots": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "color", "description"], "properties": {"id": {"enum": ["truth", "agency-non-domination", "continuity", "wisdom-over-speed"]}, "name": {"type": "string", "minLength": 1, "maxLength": 80}, "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "description": {"type": "string", "minLength": 1, "maxLength": 240}}}},
    "items": {"type": "array", "minItems": 4, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "description"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 80}, "description": {"type": "string", "minLength": 1, "maxLength": 240}}}},
    "quests": {"type": "array", "minItems": 6, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "description", "conditions"], "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1, "maxLength": 100}, "description": {"type": "string", "minLength": 1, "maxLength": 300}, "conditions": {"$ref": "#/$defs/questConditions"}}}},
    "zones": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "subtitle", "accent", "map", "spawn", "actors"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 100}, "subtitle": {"type": "string", "minLength": 1, "maxLength": 240}, "accent": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "map": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"type": "string", "pattern": "^[.#~]{15}$"}}, "spawn": {"$ref": "#/$defs/point"}, "actors": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/actor"}}}}},
    "ending": {"type": "object", "additionalProperties": false, "required": ["title", "message", "next"], "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 100}, "message": {"type": "string", "minLength": 1, "maxLength": 700}, "next": {"type": "string", "minLength": 1, "maxLength": 300}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["generatedCodeCanInstall", "generatedCodeCanPromote", "generatedCodeCanCanonize", "runtimeCanModifyFoundation", "runtimeCanUseOutboundNetwork", "finalMergeGate"], "properties": {"generatedCodeCanInstall": {"const": false}, "generatedCodeCanPromote": {"const": false}, "generatedCodeCanCanonize": {"const": false}, "runtimeCanModifyFoundation": {"const": false}, "runtimeCanUseOutboundNetwork": {"const": false}, "finalMergeGate": {"const": "MIKE_TOBI"}}},
    "limitations": {"type": "array", "minItems": 5, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "point": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "integer", "minimum": 0, "maximum": 14}, "y": {"type": "integer", "minimum": 0, "maximum": 10}}},
    "conditions": {"type": "object", "additionalProperties": false, "required": ["allFlags", "notFlags", "allRoots", "allItems"], "properties": {"allFlags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "notFlags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "allRoots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "allItems": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "questConditions": {"type": "object", "additionalProperties": false, "required": ["allFlags", "allRoots", "allItems", "completed"], "properties": {"allFlags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "allRoots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "allItems": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "completed": {"type": "boolean"}}},
    "grants": {"type": "object", "additionalProperties": false, "required": ["flags", "roots", "items"], "properties": {"flags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "roots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "items": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "travel": {"type": ["object", "null"], "additionalProperties": false, "required": ["zoneId", "x", "y"], "properties": {"zoneId": {"$ref": "#/$defs/id"}, "x": {"type": "integer", "minimum": 0, "maximum": 14}, "y": {"type": "integer", "minimum": 0, "maximum": 10}}},
    "actor": {"type": "object", "additionalProperties": false, "required": ["id", "label", "glyph", "kind", "x", "y", "requires", "grants", "travel", "complete", "message", "repeatMessage", "blockedMessage"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 100}, "glyph": {"type": "string", "minLength": 1, "maxLength": 4}, "kind": {"type": "string", "minLength": 1, "maxLength": 30}, "x": {"type": "integer", "minimum": 0, "maximum": 14}, "y": {"type": "integer", "minimum": 0, "maximum": 10}, "requires": {"$ref": "#/$defs/conditions"}, "grants": {"$ref": "#/$defs/grants"}, "travel": {"$ref": "#/$defs/travel"}, "complete": {"type": "boolean"}, "message": {"type": "string", "minLength": 1, "maxLength": 700}, "repeatMessage": {"type": "string", "minLength": 1, "maxLength": 400}, "blockedMessage": {"type": "string", "minLength": 1, "maxLength": 400}}}
  }
}
