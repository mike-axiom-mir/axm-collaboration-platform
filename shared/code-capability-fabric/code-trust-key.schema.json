{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-trust-key/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "algorithm", "publicKeySpkiDerBase64"],
  "properties": {
    "schema": {"const": "axm.code-trust-key/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "algorithm": {"const": "Ed25519"},
    "publicKeySpkiDerBase64": {"type": "string", "minLength": 60, "maxLength": 60, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
  }
}
