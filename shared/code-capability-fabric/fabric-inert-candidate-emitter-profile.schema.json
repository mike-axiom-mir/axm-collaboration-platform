{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.fabric-inert-candidate-emitter-profile/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "template", "maximumCandidateFiles", "maximumCandidateBytes", "sourceReads", "network", "childProcesses", "generatedCodeExecution", "outputScope", "authority"],
  "properties": {
    "schema": {"const": "axm.fabric-inert-candidate-emitter-profile/v1"},
    "id": {"const": "fixed-static-module-shell"},
    "version": {"const": "0.1.0"},
    "template": {"const": "STATIC_HTML_MODULE_SHELL"},
    "maximumCandidateFiles": {"const": 6},
    "maximumCandidateBytes": {"const": 65536},
    "sourceReads": {"const": "DISABLED"},
    "network": {"const": "DISABLED"},
    "childProcesses": {"const": "DISABLED"},
    "generatedCodeExecution": {"const": "DISABLED"},
    "outputScope": {"const": "ONE_NEW_OWNED_ROOT"},
    "authority": {"const": "DISPOSABLE_CANDIDATE_WRITE_ONLY"}
  }
}
