{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-specialist-capability-build-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "id", "intentAdapterRequest", "intentAdapterPlan", "selection", "capabilityBuildRequest", "consent", "resourceEnvelope", "reuseRights", "rootsGate", "authority", "requestDigest"],
  "properties": {
    "schema": {"const": "axm.code-specialist-capability-build-request/v1"},
    "version": {"const": "2.5.0"},
    "id": {"$ref": "semantic-common.schema.json#/$defs/id"},
    "intentAdapterRequest": {"$ref": "code-specialist-organ-intent-request.schema.json"},
    "intentAdapterPlan": {"$ref": "code-specialist-organ-intent-plan.schema.json"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "specialistOrganRef", "buildProfileRef", "mode"],
      "properties": {
        "artifactId": {"$ref": "semantic-common.schema.json#/$defs/id"},
        "specialistOrganRef": {"$ref": "#/$defs/versionedRef"},
        "buildProfileRef": {"$ref": "#/$defs/versionedRef"},
        "mode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}
      }
    },
    "capabilityBuildRequest": {"$ref": "../capability-fabric/schemas/build-request.schema.json"},
    "consent": {"$ref": "#/$defs/consent"},
    "resourceEnvelope": {"$ref": "#/$defs/resources"},
    "reuseRights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "externalSourceBytesIncluded", "publicCopyAuthorized", "directReuseAuthorized"],
      "properties": {
        "mode": {"const": "RESEARCH_ONLY_DIRECT_REUSE_HOLD"},
        "externalSourceBytesIncluded": {"const": false},
        "publicCopyAuthorized": {"const": false},
        "directReuseAuthorized": {"const": false}
      }
    },
    "rootsGate": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "semantic-common.schema.json#/$defs/rootDecision"}},
    "authority": {"const": "NONE"},
    "requestDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "sha256": {"$ref": "semantic-common.schema.json#/$defs/digest"}
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "decisionRef", "subject", "evaluatedAt", "expiresAt", "nonce", "revoked", "replayState", "scope"],
      "properties": {
        "tier": {"const": "TIER_1_DETACHED_CANDIDATE"},
        "decisionRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intentPlanDigest", "capabilityRequestDigest", "catalogDigest", "recipeDigest", "buildProfileCatalogDigest", "buildProfileDigest"],
          "properties": {
            "intentPlanDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"},
            "capabilityRequestDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"},
            "catalogDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"},
            "recipeDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"},
            "buildProfileCatalogDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"},
            "buildProfileDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}
          }
        },
        "evaluatedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "nonce": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{15,127}$"},
        "revoked": {"const": false},
        "replayState": {"const": "UNVERIFIED_SINGLE_USE_CLAIM"},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidateCount", "candidateExecution", "workspaceWrite", "permissions", "networkDomains", "install", "integrate", "publish", "promote", "canon"],
          "properties": {
            "candidateCount": {"const": 1},
            "candidateExecution": {"const": false},
            "workspaceWrite": {"const": false},
            "permissions": {"const": []},
            "networkDomains": {"const": []},
            "install": {"const": false},
            "integrate": {"const": false},
            "publish": {"const": false},
            "promote": {"const": false},
            "canon": {"const": false}
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputBytes", "maxOutputBytes", "maxCandidateFiles", "maxCandidateBytes", "maxBuildPasses", "maxAttempts", "maxProcesses", "maxMemoryBytes", "maxDurationMs", "maxCostMinorUnits"],
      "properties": {
        "maxInputBytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "maxOutputBytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "maxCandidateFiles": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxCandidateBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maxBuildPasses": {"const": 2},
        "maxAttempts": {"const": 1},
        "maxProcesses": {"const": 0},
        "maxMemoryBytes": {"type": "integer", "minimum": 1},
        "maxDurationMs": {"type": "integer", "minimum": 1},
        "maxCostMinorUnits": {"const": 0}
      }
    }
  }
}
