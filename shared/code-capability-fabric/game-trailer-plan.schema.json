{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.game-trailer-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "id", "requestRef", "sourceRefs", "profile", "claims", "scenes", "captions", "outputPaths", "resources", "rights", "limitations", "truth", "authority", "planDigest"],
  "properties": {
    "schema": {"const": "axm.game-trailer-plan/v1"},
    "version": {"const": "1.0.0"},
    "status": {"const": "TEST_PLAN"},
    "id": {"const": "four-roots-adventure-trailer-v0.1"},
    "requestRef": {"$ref": "#/$defs/ref"},
    "sourceRefs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/artifactRef"}},
    "profile": {"$ref": "#/$defs/profile"},
    "claims": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/claim"}},
    "scenes": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/scene"}},
    "captions": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/caption"}},
    "outputPaths": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "string", "minLength": 1, "maxLength": 240}, "uniqueItems": true},
    "resources": {"$ref": "#/$defs/resources"},
    "rights": {"$ref": "#/$defs/rights"},
    "limitations": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "truth": {"$ref": "#/$defs/truth"},
    "authority": {"const": "NONE"},
    "planDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "schema", "sha256"], "properties": {"id": {"$ref": "#/$defs/id"}, "schema": {"type": "string", "minLength": 1, "maxLength": 180}, "sha256": {"$ref": "#/$defs/digest"}}},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["id", "schema", "path", "sha256", "byteLength"], "properties": {"id": {"$ref": "#/$defs/id"}, "schema": {"type": "string", "minLength": 1, "maxLength": 180}, "path": {"type": "string", "minLength": 1, "maxLength": 240}, "sha256": {"$ref": "#/$defs/digest"}, "byteLength": {"type": "integer", "minimum": 1, "maximum": 262144}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["width", "height", "frameRate", "durationSeconds", "samples", "uniqueFrames", "formats", "audio", "captions"], "properties": {"width": {"const": 640}, "height": {"const": 360}, "frameRate": {"const": 12}, "durationSeconds": {"const": 30}, "samples": {"const": 360}, "uniqueFrames": {"const": 48}, "formats": {"const": ["video/mp4", "video/webm"]}, "audio": {"const": false}, "captions": {"const": true}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["id", "text", "status", "evidenceRefs"], "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1, "maxLength": 180}, "status": {"const": "PROVEN_FROM_EXACT_SOURCE"}, "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/artifactRef"}}}},
    "visual": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["gate-awakens", "control-path", "zone-orbit", "root-constellation", "quest-journal", "review-door"]}, "zoneId": {"type": "string"}, "zoneIds": {"type": "array", "items": {"type": "string"}}, "rootIds": {"type": "array", "items": {"type": "string"}}, "quests": {"type": "integer"}, "items": {"type": "integer"}, "actors": {"type": "integer"}, "endingTitle": {"type": "string"}}},
    "scene": {"type": "object", "additionalProperties": false, "required": ["id", "index", "startFrame", "endFrame", "kind", "headline", "subline", "accent", "claimIds", "visual"], "properties": {"id": {"$ref": "#/$defs/id"}, "index": {"type": "integer", "minimum": 0, "maximum": 5}, "startFrame": {"type": "integer", "minimum": 0, "maximum": 300}, "endFrame": {"type": "integer", "minimum": 60, "maximum": 360}, "kind": {"enum": ["title", "tutorial", "world", "progression", "features", "call-to-review"]}, "headline": {"type": "string", "minLength": 1, "maxLength": 100}, "subline": {"type": "string", "minLength": 1, "maxLength": 120}, "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}, "claimIds": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/id"}}, "visual": {"$ref": "#/$defs/visual"}}},
    "caption": {"type": "object", "additionalProperties": false, "required": ["index", "startFrame", "endFrame", "start", "end", "text"], "properties": {"index": {"type": "integer", "minimum": 0, "maximum": 5}, "startFrame": {"type": "integer", "minimum": 0, "maximum": 300}, "endFrame": {"type": "integer", "minimum": 60, "maximum": 360}, "start": {"type": "string", "pattern": "^00:00:[0-3][0-9]\\.000$"}, "end": {"type": "string", "pattern": "^00:00:[0-3][0-9]\\.000$"}, "text": {"type": "string", "minLength": 1, "maxLength": 180}}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["inputBytes", "planBytes", "uniqueFrameBytes", "samples", "files", "childProcesses", "networkRequests", "enforced"], "properties": {"inputBytes": {"type": "integer", "minimum": 1, "maximum": 131072}, "planBytes": {"type": "integer", "minimum": 1, "maximum": 131072}, "uniqueFrameBytes": {"const": 44236800}, "samples": {"const": 360}, "files": {"const": 9}, "childProcesses": {"const": 0}, "networkRequests": {"const": 0}, "enforced": {"const": true}}},
    "rights": {"type": "object", "additionalProperties": false, "required": ["internalWorkshopReview", "publicDistribution"], "properties": {"internalWorkshopReview": {"const": "MIKE_AUTHORIZED_TEST"}, "publicDistribution": {"const": "HOLD"}}},
    "truth": {"type": "object", "additionalProperties": false, "required": ["deterministicPlan", "claimsEvidenceBound", "providerCalled", "aiUsed", "gameRuntimeExecuted", "videoRendered", "playabilityProvenByTrailer", "published", "canonChanged"], "properties": {"deterministicPlan": {"const": true}, "claimsEvidenceBound": {"const": true}, "providerCalled": {"const": false}, "aiUsed": {"const": false}, "gameRuntimeExecuted": {"const": false}, "videoRendered": {"const": false}, "playabilityProvenByTrailer": {"const": false}, "published": {"const": false}, "canonChanged": {"const": false}}}
  }
}
