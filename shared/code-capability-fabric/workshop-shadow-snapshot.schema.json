{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.workshop-shadow-snapshot/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "id", "sourceLabel", "evaluatedAt", "scopeId", "inputRefs", "currentIndex", "rebuiltIndex", "sourceStateDigest", "resources", "privacy", "truth", "authority", "snapshotDigest"],
  "properties": {
    "schema": {"const": "axm.workshop-shadow-snapshot/v1"}, "version": {"const": "1.0.0"}, "status": {"const": "TEST"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"}, "sourceLabel": {"type": "string", "minLength": 1, "maxLength": 160},
    "evaluatedAt": {"type": "string", "format": "date-time"}, "scopeId": {"const": "tools-index-declarations-and-selftests-v1"},
    "inputRefs": {"type": "array", "minItems": 1, "maxItems": 8192, "items": {"$ref": "#/$defs/fileRef"}},
    "currentIndex": {"$ref": "#/$defs/indexObservation"}, "rebuiltIndex": {"$ref": "#/$defs/indexObservation"},
    "sourceStateDigest": {"$ref": "#/$defs/digest"},
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["inputFiles", "inputBytes", "enforced"],
      "properties": {"inputFiles": {"type": "integer", "minimum": 1}, "inputBytes": {"type": "integer", "minimum": 1}, "enforced": {"const": true}}
    },
    "privacy": {
      "type": "object", "additionalProperties": false, "required": ["rawSourceRetained", "machinePathsRetained", "secretsRead"],
      "properties": {"rawSourceRetained": {"const": false}, "machinePathsRetained": {"const": false}, "secretsRead": {"const": false}}
    },
    "truth": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceRead", "sourceWritten", "candidateExecuted", "networkUsed", "childProcessSpawned", "installed", "integrated", "promoted", "canonChanged"],
      "properties": {"sourceRead": {"const": true}, "sourceWritten": {"const": false}, "candidateExecuted": {"const": false}, "networkUsed": {"const": false}, "childProcessSpawned": {"const": false}, "installed": {"const": false}, "integrated": {"const": false}, "promoted": {"const": false}, "canonChanged": {"const": false}}
    },
    "authority": {"const": "NONE"}, "snapshotDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fileRef": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "byteLength"],
      "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 300}, "sha256": {"$ref": "#/$defs/digest"}, "byteLength": {"type": "integer", "minimum": 1}}
    },
    "summary": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["tools", "contractsPresent", "contractsValid", "topLevelSelftests", "capabilities", "readyForHumanReview", "blocked", "claimsNeedingReverification"],
      "properties": {"tools": {"type": "integer", "minimum": 0}, "contractsPresent": {"type": "integer", "minimum": 0}, "contractsValid": {"type": "integer", "minimum": 0}, "topLevelSelftests": {"type": "integer", "minimum": 0}, "capabilities": {"type": "integer", "minimum": 0}, "readyForHumanReview": {"type": "integer", "minimum": 0}, "blocked": {"type": "integer", "minimum": 0}, "claimsNeedingReverification": {"type": "integer", "minimum": 0}}
    },
    "indexObservation": {
      "type": "object", "additionalProperties": false, "required": ["state", "ref", "sourceDigest", "summary", "toolIds"],
      "properties": {"state": {"enum": ["VALID", "INVALID", "MISSING"]}, "ref": {"anyOf": [{"$ref": "#/$defs/fileRef"}, {"type": "null"}]}, "sourceDigest": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}, "summary": {"$ref": "#/$defs/summary"}, "toolIds": {"type": "array", "maxItems": 4096, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    }
  }
}

