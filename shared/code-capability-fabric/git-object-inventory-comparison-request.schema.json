{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.git-object-inventory-comparison-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "status", "subjectRef", "sourceInventoryRef", "mirrorInventoryRef", "trustedObserverRefs", "rootsGate", "authority", "requestDigest"],
  "properties": {
    "schema": {"const": "axm.git-object-inventory-comparison-request/v1"},
    "id": {"$ref": "#/$defs/identifier"},
    "status": {"const": "TEST"},
    "subjectRef": {"$ref": "#/$defs/subjectReference"},
    "sourceInventoryRef": {"$ref": "#/$defs/inventoryReference"},
    "mirrorInventoryRef": {"$ref": "#/$defs/inventoryReference"},
    "trustedObserverRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/trustKeyReference"}
    },
    "rootsGate": {"const": ["truth", "agency-non-domination", "continuity", "wisdom-over-speed"]},
    "authority": {"const": "NONE"},
    "requestDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "schema": {"type": "string", "minLength": 1, "maxLength": 220},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "subjectReference": {
      "allOf": [
        {"$ref": "#/$defs/reference"},
        {"properties": {"schema": {"const": "axm.git-repository-object-set-subject/v1"}}}
      ]
    },
    "inventoryReference": {
      "allOf": [
        {"$ref": "#/$defs/reference"},
        {"properties": {"schema": {"const": "axm.git-object-inventory-observation/v1"}}}
      ]
    },
    "trustKeyReference": {
      "allOf": [
        {"$ref": "#/$defs/reference"},
        {"properties": {"schema": {"const": "axm.code-trust-key/v1"}}}
      ]
    }
  }
}
