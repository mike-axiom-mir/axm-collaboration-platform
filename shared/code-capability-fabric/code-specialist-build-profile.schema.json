{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-specialist-build-profile/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "status", "mode", "specialistOrganRef", "languageIds", "capability", "exampleArtifactId", "gates", "gaps", "evidence", "boundary", "profileDigest"],
  "properties": {
    "schema": {"const": "axm.code-specialist-build-profile/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "status": {"const": "TEST"},
    "mode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
    "specialistOrganRef": {"$ref": "#/$defs/versionedRef"},
    "languageIds": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}},
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "recipeRef"],
      "properties": {
        "family": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
        "recipeRef": {"$ref": "#/$defs/recipeRef"}
      }
    },
    "exampleArtifactId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["specialist", "recipe", "request"],
      "properties": {
        "specialist": {"$ref": "#/$defs/gate"},
        "recipe": {"$ref": "#/$defs/gate"},
        "request": {"$ref": "#/$defs/gate"}
      }
    },
    "gaps": {
      "type": "object", "additionalProperties": false,
      "required": ["specialist", "recipe", "request"],
      "properties": {
        "specialist": {"$ref": "#/$defs/capabilityId"},
        "recipe": {"$ref": "#/$defs/capabilityId"},
        "request": {"$ref": "#/$defs/capabilityId"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["visualBehavior", "requiredKinds"],
      "properties": {
        "visualBehavior": {"enum": ["NOT_APPLICABLE", "UNKNOWN"]},
        "requiredKinds": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}}
      }
    },
    "boundary": {"$ref": "#/$defs/boundary"},
    "profileDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "versionedRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "sha256": {"$ref": "semantic-common.schema.json#/$defs/digest"}
      }
    },
    "recipeRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest", "builderId", "builderDigest", "capabilityKind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "digest": {"$ref": "semantic-common.schema.json#/$defs/digest"},
        "builderId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
        "builderDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"},
        "capabilityKind": {"enum": ["HAND", "SKILL"]}
      }
    },
    "gate": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$"},
    "capabilityId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,179}$"},
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "permissions", "networkDomains", "workspaceRead", "workspaceWrite", "candidateExecution", "install", "integrate", "publish", "promote", "canon"],
      "properties": {
        "authority": {"const": "NONE"},
        "permissions": {"const": []},
        "networkDomains": {"const": []},
        "workspaceRead": {"const": false},
        "workspaceWrite": {"const": false},
        "candidateExecution": {"const": false},
        "install": {"const": false},
        "integrate": {"const": false},
        "publish": {"const": false},
        "promote": {"const": false},
        "canon": {"const": false}
      }
    }
  }
}
