{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-policy-bound-assurance-review/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "baseReviewDigest", "policyBindingRef", "boundBaseRequestRef", "boundTrustPolicyRef", "boundAssuranceSchemas", "holds", "limitations", "nextGate", "truth", "authority", "reviewDigest"],
  "properties": {
    "schema": {"const": "axm.code-policy-bound-assurance-review/v1"},
    "version": {"const": "0.1.0"},
    "status": {"enum": ["BASE_REVIEW_HOLD", "POLICY_BINDING_HOLD", "REQUEST_BINDING_HOLD", "TRUST_POLICY_BINDING_HOLD", "ASSURANCE_SCOPE_HOLD", "TIME_WINDOW_HOLD", "AUTHENTICATED_HUMAN_DECISION_REQUIRED"]},
    "baseReviewDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "policyBindingRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
    "boundBaseRequestRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
    "boundTrustPolicyRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
    "boundAssuranceSchemas": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/contract"}},
    "holds": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "limitations": {"const": ["BASE_V2_REQUEST_SCHEMA_UNCHANGED", "REQUESTER_AUTHORSHIP_NOT_PROVEN", "HUMAN_POLICY_ACCEPTANCE_NOT_PROVEN", "ORGANIZATIONAL_INDEPENDENCE_NOT_PROVEN"]},
    "nextGate": {"enum": ["REPAIR_POLICY_BINDING_THEN_REASSESS", "MIKE_AUTHENTICATED_POLICY_DECISION_OUTSIDE_FABRIC"]},
    "truth": {"$ref": "#/$defs/truth"},
    "authority": {"const": "NONE"},
    "reviewDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "contract": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,179}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "schema": {"$ref": "#/$defs/contract"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseIndependentReviewVerified", "policyBindingIntegrityVerified", "baseRequestDigestBound", "trustPolicyDigestBound", "assuranceSchemaSetBound", "rootsGateBound", "bindingTimeWindowVerified", "requesterAuthorshipVerified", "humanPolicyAcceptanceVerified", "organizationalIndependenceProven", "resourceEnforcementObserved", "executorAuthorized", "providerCodeLoaded", "providerCodeExecuted", "workspaceContentRead", "permissionGranted", "networkUsed", "outputWritten", "installed", "promoted", "canonChanged"],
      "properties": {
        "baseIndependentReviewVerified": {"type": "boolean"},
        "policyBindingIntegrityVerified": {"type": "boolean"},
        "baseRequestDigestBound": {"type": "boolean"},
        "trustPolicyDigestBound": {"type": "boolean"},
        "assuranceSchemaSetBound": {"type": "boolean"},
        "rootsGateBound": {"type": "boolean"},
        "bindingTimeWindowVerified": {"type": "boolean"},
        "requesterAuthorshipVerified": {"const": false},
        "humanPolicyAcceptanceVerified": {"const": false},
        "organizationalIndependenceProven": {"const": false},
        "resourceEnforcementObserved": {"const": false},
        "executorAuthorized": {"const": false},
        "providerCodeLoaded": {"const": false},
        "providerCodeExecuted": {"const": false},
        "workspaceContentRead": {"const": false},
        "permissionGranted": {"const": false},
        "networkUsed": {"const": false},
        "outputWritten": {"const": false},
        "installed": {"const": false},
        "promoted": {"const": false},
        "canonChanged": {"const": false}
      }
    }
  }
}
