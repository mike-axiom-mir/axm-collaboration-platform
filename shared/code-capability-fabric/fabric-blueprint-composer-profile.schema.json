    "version": {"const": "0.1.0"},
    "kind": {"const": "PURE_DATA_TRANSFORM"},
    "maximumInputFields": {"const": 16},
    "maximumOutputFields": {"const": 16},
    "maximumSteps": {"const": 16},
    "maximumQualityClaims": {"const": 16},
    "maximumComposerInputBytes": {"const": 32768},
    "maximumWrittenFiles": {"const": 2},
    "maximumWrittenBytes": {"const": 65536},
    "sourceReads": {"const": "DISABLED"},
    "network": {"const": "DISABLED"},
    "childProcesses": {"const": "DISABLED"},
    "generatedCodeExecution": {"const": "DISABLED"},
    "outputScope": {"const": "ONE_NEW_OWNED_ROOT"},
