  "required": ["schema", "id", "version", "kind", "maximumInputFields", "maximumOutputFields", "maximumSteps", "maximumQualityClaims", "maximumComposerInputBytes", "maximumWrittenFiles", "maximumWrittenBytes", "sourceReads", "network", "childProcesses", "generatedCodeExecution", "outputScope", "authority"],
  "properties": {
    "schema": {"const": "axm.fabric-blueprint-composer-profile/v1"},
