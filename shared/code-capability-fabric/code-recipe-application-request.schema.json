{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-recipe-application-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "tier", "applicationMode", "intent", "blueprint", "discoveryEvidence", "recipeSelection", "mappings", "consent", "resourceEnvelope", "rootsGate", "instructionRef", "authority", "requestDigest"],
  "properties": {
    "schema": {"const": "axm.code-recipe-application-request/v1"},
    "id": {"$ref": "semantic-common.schema.json#/$defs/id", "maxLength": 109},
    "tier": {"const": 1},
    "applicationMode": {"const": "INDEPENDENT_NATIVE_REIMPLEMENTATION_PLAN"},
    "intent": {"$ref": "fabric-declarative-blueprint-intent.schema.json"},
    "blueprint": {"$ref": "fabric-declarative-capability-blueprint.schema.json"},
    "discoveryEvidence": {"$ref": "code-recipe-discovery-evidence-packet.schema.json"},
    "recipeSelection": {"$ref": "code-recipe-selection-packet.schema.json"},
    "mappings": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/mapping"}},
    "consent": {"$ref": "#/$defs/consent"},
    "resourceEnvelope": {"$ref": "#/$defs/resources"},
    "rootsGate": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "semantic-common.schema.json#/$defs/rootDecision"}},
    "instructionRef": {"$ref": "semantic-common.schema.json#/$defs/reference"},
    "authority": {"const": "NONE"},
    "requestDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "targetStepId", "nativeOperation"],
      "properties": {
        "sourceId": {"type": "string", "pattern": "^CC-[0-9]{4}$"},
        "targetStepId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "nativeOperation": {"enum": ["FILTER_VALUES", "MAP_VALUES"]}
      }
    },
    "evaluationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "instance", "evaluatedAt"],
      "properties": {
        "policy": {"$ref": "grounded-consent-policy.schema.json"},
        "instance": {"$ref": "grounded-consent-instance.schema.json"},
        "evaluatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluationInput", "evaluation"],
      "properties": {
        "evaluationInput": {"$ref": "#/$defs/evaluationInput"},
        "evaluation": {"$ref": "grounded-consent-evaluation.schema.json"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputBytes", "maxOutputBytes", "maxMemoryBytes", "maxDurationMs", "maxProcesses", "maxAttempts", "maxCostMinorUnits"],
      "properties": {
        "maxInputBytes": {"type": "integer", "minimum": 1, "maximum": 524288},
        "maxOutputBytes": {"type": "integer", "minimum": 1, "maximum": 524288},
        "maxMemoryBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "maxDurationMs": {"type": "integer", "minimum": 1, "maximum": 60000},
        "maxProcesses": {"const": 1},
        "maxAttempts": {"const": 1},
        "maxCostMinorUnits": {"const": 0}
      }
    }
  }
}
