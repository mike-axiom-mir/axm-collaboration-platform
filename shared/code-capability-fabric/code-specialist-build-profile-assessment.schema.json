{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.code-specialist-build-profile-assessment/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "profileRef", "specialistOrganRef", "recipeRef", "languageIds", "holds", "capabilityGapReport", "evidencePlan", "authority", "registered", "executed", "installed", "integrated", "promoted", "canonChanged", "nextGate", "assessmentDigest"],
  "properties": {
    "schema": {"const": "axm.code-specialist-build-profile-assessment/v1"},
    "status": {"enum": ["CAPABILITY_GAPS", "READY_FOR_PROFILE_REGISTRY_REVIEW"]},
    "profileRef": {"$ref": "#/$defs/versionedRef"},
    "specialistOrganRef": {"$ref": "#/$defs/versionedRef"},
    "recipeRef": {"$ref": "code-specialist-build-profile.schema.json#/$defs/recipeRef"},
    "languageIds": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}},
    "holds": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}, "detail": {"type": "string", "minLength": 1, "maxLength": 500}}}},
    "capabilityGapReport": {"$ref": "#/$defs/gapReport"},
    "evidencePlan": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "verdict", "executionStatus"], "properties": {"kind": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "verdict": {"const": "UNKNOWN"}, "executionStatus": {"const": "NOT_RUN"}}}},
    "authority": {"const": "NONE"},
    "registered": {"const": false},
    "executed": {"const": false},
    "installed": {"const": false},
    "integrated": {"const": false},
    "promoted": {"const": false},
    "canonChanged": {"const": false},
    "nextGate": {"enum": ["REPAIR_EXACT_PROFILE_SPECIALIST_RECIPE_BINDING", "FOUR_ROOT_REVIEW_AND_MIKE_MERGE_DECISION_REQUIRED"]},
    "assessmentDigest": {"$ref": "semantic-common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "versionedRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "sha256": {"$ref": "semantic-common.schema.json#/$defs/digest"}
      }
    },
    "gapReport": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "overall", "missingCapabilities", "proposedContracts", "automaticInstall", "automaticPermission", "automaticQualityReduction", "truth"],
      "properties": {
        "schema": {"const": "axm.capability-gap-report/v1"},
        "overall": {"enum": ["READY", "DEGRADED"]},
        "missingCapabilities": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}},
        "proposedContracts": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
        "automaticInstall": {"const": false},
        "automaticPermission": {"const": false},
        "automaticQualityReduction": {"const": false},
        "truth": {"type": "object", "additionalProperties": false, "required": ["implementationAvailableForEveryGap", "specificationClosesGap", "unsupportedCapabilityPretendedAvailable"], "properties": {"implementationAvailableForEveryGap": {"const": false}, "specificationClosesGap": {"const": false}, "unsupportedCapabilityPretendedAvailable": {"const": false}}}
      }
    }
  }
}
