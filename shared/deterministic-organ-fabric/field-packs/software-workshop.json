  "heldOutCases": [
    {"id": "held-ui-high", "description": "High-risk UI work retains live browser evidence.", "input": {"changeType": "ui", "risk": 5, "affectedSurfaces": ["hub", "mobile"]}, "assertions": [{"path": "route", "op": "contains", "value": "browser-render-click"}, {"path": "containment", "op": "in", "value": ["isolated-worktree"]}]},
    {"id": "held-data-archive", "description": "Archive data changes include persistence reload evidence.", "input": {"changeType": "data", "risk": 1, "affectedSurfaces": ["archive"]}, "assertions": [{"path": "route", "op": "contains", "value": "round-trip-test"}]},
    {"id": "held-passive-receiver", "description": "Passive receiver changes require digest-bound sender and receiver receipts.", "input": {"changeType": "code", "risk": 2, "affectedSurfaces": ["mirror-passive-receiver"]}, "assertions": [{"path": "route", "op": "contains", "value": "sender-receiver-parity"}]}
  ],
  "humanJudgments": ["Usefulness of the selected route remains a Mike decision.", "Passing checks do not make a change wise, safe to merge, or CANON."],
  "exampleIntent": {
    "id": "verification-route-organ", "name": "Verification Route Organ", "purpose": "Choose a bounded verification route from change type, risk, and affected surfaces.",
    "inputs": [
      {"name": "changeType", "type": "string", "description": "Declared change class.", "required": true, "enum": ["config", "code", "ui", "data"]},
      {"name": "risk", "type": "integer", "description": "Human-assigned risk from one to five.", "required": true, "minimum": 1, "maximum": 5},
      {"name": "affectedSurfaces", "type": "array", "description": "Explicit bounded affected-surface tokens from this pack.", "required": true, "items": "string"}
    ],
    "outputs": [
      {"name": "route", "type": "array", "description": "Ordered verification route tokens bound to the exact registry.", "required": true, "items": "string"},
      {"name": "containment", "type": "string", "description": "Recommended containment lane.", "required": true},
      {"name": "explanation", "type": "string", "description": "Bounded explanation.", "required": true}
    ],
    "requiredCases": [
      {"id": "ui-route", "description": "UI work requires live visual evidence.", "input": {"changeType": "ui", "risk": 3, "affectedSurfaces": ["hub"]}, "assertions": [{"path": "route", "op": "contains", "value": "browser-render-click"}]},
      {"id": "code-route", "description": "Code work includes a focused selftest.", "input": {"changeType": "code", "risk": 2, "affectedSurfaces": ["runtime"]}, "assertions": [{"path": "route", "op": "contains", "value": "focused-selftest"}]}
    ],
    "desiredCases": [{"id": "high-risk-regression", "description": "High risk includes regression evidence.", "input": {"changeType": "code", "risk": 5, "affectedSurfaces": ["runtime", "archive"]}, "assertions": [{"path": "route", "op": "contains", "value": "required-regression"}, {"path": "route", "op": "contains", "value": "round-trip-test"}]}],
    "invariants": ["Never claim a browser path passed from syntax evidence alone.", "Every route token resolves through the exact registry.", "Never install, promote, or mutate the Foundation."],
    "boundaries": ["Risk and affected surfaces are explicit human inputs, not inferred.", "Unknown surface tokens are refused.", "The output is advisory and cannot authorize execution."],
    "resourceBudget": {}, "metricProfileId": "balanced-v1"
  },
