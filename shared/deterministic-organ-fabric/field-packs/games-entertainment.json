  "humanJudgments": ["This organ makes no fun, balance, pacing-quality, or player-delight claim.", "A designer must review repetition and context before implementation."],
  "exampleIntent": {
    "id": "encounter-beat-organ",
    "name": "Encounter Beat Organ",
    "purpose": "Choose a bounded, telegraphed encounter beat from an explicit seed and current state.",
    "inputs": [
      {"name": "explicitSeed", "type": "string", "description": "Caller-supplied deterministic seed.", "required": true},
      {"name": "currentState", "type": "string", "description": "Current bounded encounter state.", "required": true, "enum": ["calm", "pressure", "recovery"]},
      {"name": "intensity", "type": "integer", "description": "Explicit intensity from one to five.", "required": true, "minimum": 1, "maximum": 5},
      {"name": "recentBeats", "type": "array", "description": "Explicit recent beat names for later human review.", "required": true, "items": "string"}
    ],
    "outputs": [
      {"name": "beat", "type": "string", "description": "Selected declared beat.", "required": true, "enum": ["approach", "feint", "hazard", "breather"]},
      {"name": "nextState", "type": "string", "description": "Next bounded state.", "required": true, "enum": ["calm", "pressure", "recovery"]},
      {"name": "telegraph", "type": "string", "description": "Explicit telegraph requirement.", "required": true},
      {"name": "durationTicks", "type": "integer", "description": "Bounded abstract duration.", "required": true, "minimum": 1, "maximum": 5}
    ],
    "requiredCases": [
      {"id": "calm-advances", "description": "Calm advances to pressure.", "input": {"explicitSeed": "case-calm", "currentState": "calm", "intensity": 2, "recentBeats": []}, "assertions": [{"path": "nextState", "op": "eq", "value": "pressure"}, {"path": "beat", "op": "in", "value": ["approach", "feint", "hazard", "breather"]}]},
      {"id": "recovery-cycles", "description": "Recovery advances to calm.", "input": {"explicitSeed": "case-recovery", "currentState": "recovery", "intensity": 4, "recentBeats": ["hazard"]}, "assertions": [{"path": "nextState", "op": "eq", "value": "calm"}, {"path": "durationTicks", "op": "lte", "value": 5}]}
    ],
    "desiredCases": [{"id": "bounded-duration", "description": "Duration remains bounded.", "input": {"explicitSeed": "case-duration", "currentState": "pressure", "intensity": 3, "recentBeats": []}, "assertions": [{"path": "durationTicks", "op": "gte", "value": 1}, {"path": "durationTicks", "op": "lte", "value": 5}]}],
    "invariants": ["Selection uses only an explicit seed and declared options.", "Every beat includes a telegraph and bounded transition."],
    "boundaries": ["No fun or balance claim.", "No implicit randomness, clock, environment, or player profiling."],
