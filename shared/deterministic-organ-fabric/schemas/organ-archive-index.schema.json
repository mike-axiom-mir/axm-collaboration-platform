{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.organ-archive-index/v1",
  "title": "AXM Rebuildable Organ Archive Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "derived", "objects", "failures", "events", "indexDigest"],
  "properties": {
    "schema": {"const": "axm.organ-archive-index/v1"},
    "derived": {"const": true},
    "persistence": {"enum": ["INDEXEDDB_DURABLE", "MEMORY_EXPORT_ONLY"]},
    "reason": {"type": ["string", "null"]},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/objectSummary"}},
    "failures": {"type": "array", "items": {"$ref": "#/$defs/failureSummary"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/eventSummary"}},
    "indexDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "objectSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectDigest", "status", "id", "strategy", "score", "stashDigest", "archiveDisposition", "retentionPolicy", "admissionStatus", "startupPolicy", "implementationStatus", "selected", "primaryPurposeCategory", "useFields", "functionalRoles", "classificationState"],
      "properties": {
        "objectDigest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["CURRENT", "REVALIDATION_REQUIRED"]},
        "id": {"type": "string"},
        "strategy": {"enum": ["lean", "balanced", "guarded"]},
        "score": {"type": "integer"},
        "definitionDigest": {"$ref": "#/$defs/digest"},
        "packDigest": {"$ref": "#/$defs/digest"},
        "runtimeVersion": {"type": "string"},
        "metricProfileId": {"type": "string"},
        "metricProfileDigest": {"$ref": "#/$defs/digest"},
        "stashDigest": {"$ref": "#/$defs/digest"},
        "archiveDisposition": {"const": "VALID_DORMANT_LIBRARY"},
        "retentionPolicy": {"const": "KEEP_WHEN_NO_CURRENT_USE"},
        "admissionStatus": {"const": "ARCHIVED_NOT_ADMITTED_TO_RUNTIME"},
        "startupPolicy": {"const": "DORMANT"},
        "implementationStatus": {"enum": ["UNSELECTED", "SELECTED_FOR_IMPLEMENTATION_REVIEW"]},
        "selected": {"type": "boolean"},
        "primaryPurposeCategory": {"type": "string"},
        "useFields": {"type": "array", "items": {"type": "string"}},
        "functionalRoles": {"type": "array", "items": {"type": "string"}},
        "classificationState": {"const": "INFERRED_UNCONFIRMED"}
      }
    },
    "failureSummary": {"type": "object", "additionalProperties": false, "required": ["failureDigest", "intentDigest", "strategy", "failedGates"], "properties": {"failureDigest": {"$ref": "#/$defs/digest"}, "intentDigest": {"$ref": "#/$defs/digest"}, "strategy": {"enum": ["lean", "balanced", "guarded"]}, "failedGates": {"type": "array", "items": {"type": "string"}}}},
    "eventSummary": {"type": "object", "additionalProperties": false, "required": ["sequence", "eventType", "objectDigest", "eventDigest"], "properties": {"sequence": {"type": "integer"}, "eventType": {"type": "string"}, "objectDigest": {"$ref": "#/$defs/digest"}, "eventDigest": {"$ref": "#/$defs/digest"}}}
  }
}
