{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "axm.organ-candidate-package/v1", "title": "AXM Organ Candidate Package v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "id", "version", "status", "definitionDigest", "evaluationDigest", "files", "totalBytes", "authority", "packageDigest"],
  "properties": {"schema": {"const": "axm.organ-candidate-package/v1"}, "id": {"type": "string"}, "version": {"type": "string"}, "status": {"const": "EXPERIMENTAL"}, "definitionDigest": {"$ref": "#/$defs/digest"}, "evaluationDigest": {"$ref": "#/$defs/digest"}, "files": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "digest"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[a-zA-Z0-9._/-]+$"}, "bytes": {"type": "integer", "minimum": 0}, "digest": {"$ref": "#/$defs/digest"}}}}, "totalBytes": {"type": "integer", "maximum": 524288}, "authority": {"$ref": "#/$defs/authority"}, "packageDigest": {"$ref": "#/$defs/digest"}},
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "authority": {"type": "object", "additionalProperties": false, "required": ["installed", "registered", "staged", "promoted", "canonChanged"], "properties": {"installed": {"const": false}, "registered": {"const": false}, "staged": {"const": false}, "promoted": {"const": false}, "canonChanged": {"const": false}}}}
}
