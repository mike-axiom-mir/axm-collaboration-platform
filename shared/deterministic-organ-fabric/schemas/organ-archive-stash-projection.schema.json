{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.organ-archive-stash-projection/v1",
  "title": "AXM Dormant Organ Archive Stash Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "packageDigest", "candidateId", "validity", "archiveState", "purposeClassification", "source", "targetCompatibility", "authority", "boundary", "stashDigest"],
  "properties": {
    "schema": {"const": "axm.organ-archive-stash-projection/v1"},
    "status": {"const": "EXPERIMENTAL"},
    "packageDigest": {"$ref": "#/$defs/digest"},
    "candidateId": {"type": "string", "minLength": 1},
    "validity": {"type": "object", "additionalProperties": false, "required": ["state", "evaluationDigest", "qualityClaim", "humanJudgmentsUnresolved"], "properties": {"state": {"const": "HARD_GATES_PASSED"}, "evaluationDigest": {"$ref": "#/$defs/digest"}, "qualityClaim": {"const": false}, "humanJudgmentsUnresolved": {"type": "array", "items": {"type": "string"}}}},
    "archiveState": {"type": "object", "additionalProperties": false, "required": ["disposition", "retentionPolicy", "admissionStatus", "startupPolicy", "implementationStatus"], "properties": {"disposition": {"const": "VALID_DORMANT_LIBRARY"}, "retentionPolicy": {"const": "KEEP_WHEN_NO_CURRENT_USE"}, "admissionStatus": {"const": "ARCHIVED_NOT_ADMITTED_TO_RUNTIME"}, "startupPolicy": {"const": "DORMANT"}, "implementationStatus": {"const": "UNSELECTED"}}},
    "purposeClassification": {"type": "object", "additionalProperties": false, "required": ["state", "primaryPurposeCategory", "useFields", "functionalRoles", "basis", "semanticAuthority", "compatibilityProof", "qualityProof"], "properties": {"state": {"const": "INFERRED_UNCONFIRMED"}, "primaryPurposeCategory": {"type": "string"}, "useFields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "functionalRoles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "basis": {"type": "object", "additionalProperties": false, "required": ["fieldPackId", "intentDigest", "purpose"], "properties": {"fieldPackId": {"type": "string"}, "intentDigest": {"$ref": "#/$defs/digest"}, "purpose": {"type": "string"}}}, "semanticAuthority": {"const": false}, "compatibilityProof": {"const": false}, "qualityProof": {"const": false}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["packagePath", "suggestedTargetPath", "sourceBytes", "sourceSha256", "targetArchiveObjectIdIfImported"], "properties": {"packagePath": {"const": "organ.js"}, "suggestedTargetPath": {"type": "string", "pattern": "^organs/[a-z0-9-]+-organ\\.js$"}, "sourceBytes": {"type": "integer", "minimum": 1, "maximum": 2097152}, "sourceSha256": {"$ref": "#/$defs/bareDigest"}, "targetArchiveObjectIdIfImported": {"$ref": "#/$defs/bareDigest"}}},
    "targetCompatibility": {"type": "object", "additionalProperties": false, "required": ["moduleId", "version", "status", "contractSchema", "contractFileSha256", "contractCanonicalDigest", "catalogSchema", "portableLibrarySchema", "dormantComponentSchema", "sourceConvention"], "properties": {"moduleId": {"const": "ai-organ-archive"}, "version": {"type": "string"}, "status": {"const": "TEST"}, "contractSchema": {"const": "axm.ai-native-module-contract/v1"}, "contractFileSha256": {"$ref": "#/$defs/bareDigest"}, "contractCanonicalDigest": {"$ref": "#/$defs/digest"}, "catalogSchema": {"const": "axm.mirror.ai-organ-catalog/v3"}, "portableLibrarySchema": {"const": "axm.mirror.portable-ai-organ-library/v1"}, "dormantComponentSchema": {"const": "axm.mirror.dormant-organ-component/v1"}, "sourceConvention": {"const": "organs/*-organ.js"}}},
    "authority": {"$ref": "#/$defs/authority"},
    "boundary": {"type": "string"},
    "stashDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "bareDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority": {"type": "object", "additionalProperties": false, "required": ["loaded", "executed", "connected", "installed", "registered", "staged", "promoted", "canonChanged", "permissionsChanged", "foundationChanged"], "properties": {"loaded": {"const": false}, "executed": {"const": false}, "connected": {"const": false}, "installed": {"const": false}, "registered": {"const": false}, "staged": {"const": false}, "promoted": {"const": false}, "canonChanged": {"const": false}, "permissionsChanged": {"const": false}, "foundationChanged": {"const": false}}}
  }
}
