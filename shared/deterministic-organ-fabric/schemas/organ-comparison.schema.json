{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "axm.organ-comparison/v1", "title": "AXM Organ Comparison v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "runDigest", "metricProfile", "rows", "ties", "rankingAdvisoryOnly", "selection", "authority", "comparisonDigest"],
  "properties": {"schema": {"const": "axm.organ-comparison/v1"}, "runDigest": {"$ref": "#/$defs/digest"}, "metricProfile": {"$ref": "#/$defs/profile"}, "rows": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["candidateId", "strategy", "packageDigest", "evaluationDigest", "score", "components"], "properties": {"candidateId": {"type": "string"}, "strategy": {"enum": ["lean", "balanced", "guarded"]}, "packageDigest": {"$ref": "#/$defs/digest"}, "evaluationDigest": {"$ref": "#/$defs/digest"}, "score": {"type": "integer", "minimum": 0, "maximum": 100}, "components": {"$ref": "#/$defs/components"}}}}, "ties": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["score", "candidateIds"], "properties": {"score": {"type": "integer"}, "candidateIds": {"type": "array", "items": {"type": "string"}}}}}, "rankingAdvisoryOnly": {"const": true}, "selection": {"type": "null"}, "authority": {"$ref": "#/$defs/authority"}, "comparisonDigest": {"$ref": "#/$defs/digest"}},
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "weights": {"type": "object", "additionalProperties": false, "required": ["functionalCoverage", "evidenceStrength", "failureContainment", "simplicityExplainability", "resourceMargin", "dependencyIndependence", "integrationFit"], "properties": {"functionalCoverage": {"const": 30}, "evidenceStrength": {"const": 20}, "failureContainment": {"const": 15}, "simplicityExplainability": {"const": 15}, "resourceMargin": {"const": 10}, "dependencyIndependence": {"const": 5}, "integrationFit": {"const": 5}}}, "components": {"type": "object", "additionalProperties": false, "required": ["functionalCoverage", "evidenceStrength", "failureContainment", "simplicityExplainability", "resourceMargin", "dependencyIndependence", "integrationFit"], "properties": {"functionalCoverage": {"type": "integer"}, "evidenceStrength": {"type": "integer"}, "failureContainment": {"type": "integer"}, "simplicityExplainability": {"type": "integer"}, "resourceMargin": {"type": "integer"}, "dependencyIndependence": {"type": "integer"}, "integrationFit": {"type": "integer"}}}, "profile": {"type": "object", "additionalProperties": false, "required": ["schema", "id", "digest", "integerArithmetic", "weights"], "properties": {"schema": {"const": "axm.organ-metric-profile/v1"}, "id": {"const": "balanced-v1"}, "digest": {"$ref": "#/$defs/digest"}, "integerArithmetic": {"const": true}, "weights": {"$ref": "#/$defs/weights"}}}, "authority": {"type": "object", "additionalProperties": false, "required": ["installed", "registered", "staged", "promoted", "canonChanged"], "properties": {"installed": {"const": false}, "registered": {"const": false}, "staged": {"const": false}, "promoted": {"const": false}, "canonChanged": {"const": false}}}}
}
