{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.organ-intent/v1",
  "title": "AXM Organ Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "purpose", "fieldPackRef", "inputs", "outputs", "requiredCases", "desiredCases", "invariants", "boundaries", "resourceBudget", "metricProfileId", "status", "authority", "intentDigest"],
  "properties": {
    "schema": {"const": "axm.organ-intent/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "fieldPackRef": {"$ref": "#/$defs/digestRef"},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/port"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/port"}},
    "requiredCases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "desiredCases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resourceBudget": {"$ref": "#/$defs/limits"},
    "metricProfileId": {"const": "balanced-v1"},
    "status": {"const": "EXPERIMENTAL"},
    "authority": {"const": "NONE"},
    "intentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "digestRef": {"type": "object", "additionalProperties": false, "required": ["id", "version", "digest"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}},
    "port": {"type": "object", "additionalProperties": false, "required": ["name", "type", "description", "required"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$"}, "type": {"enum": ["string", "number", "integer", "boolean", "array", "object"]}, "description": {"type": "string"}, "required": {"type": "boolean"}, "enum": {"type": "array", "minItems": 1}, "items": {"enum": ["string", "number", "integer", "boolean", "object"]}, "minimum": {"type": "number"}, "maximum": {"type": "number"}}},
    "assertion": {"type": "object", "additionalProperties": false, "required": ["path", "op", "value"], "properties": {"path": {"type": "string"}, "op": {"enum": ["eq", "contains", "in", "gte", "lte"]}, "value": {}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["id", "description", "input", "assertions"], "properties": {"id": {"type": "string"}, "description": {"type": "string"}, "input": {"type": "object"}, "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["maxNodes", "maxDepth", "maxOperations", "maxListItems", "maxInputBytes", "maxOutputBytes", "maxPackageFiles", "maxPackageBytes"], "properties": {"maxNodes": {"type": "integer", "minimum": 1, "maximum": 64}, "maxDepth": {"type": "integer", "minimum": 1, "maximum": 16}, "maxOperations": {"type": "integer", "minimum": 1, "maximum": 1024}, "maxListItems": {"type": "integer", "minimum": 1, "maximum": 256}, "maxInputBytes": {"type": "integer", "minimum": 1, "maximum": 32768}, "maxOutputBytes": {"type": "integer", "minimum": 1, "maximum": 32768}, "maxPackageFiles": {"type": "integer", "minimum": 1, "maximum": 16}, "maxPackageBytes": {"type": "integer", "minimum": 1, "maximum": 524288}}}
  }
}
