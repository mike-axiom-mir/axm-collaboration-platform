{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "axm.organ-selection-receipt/v1", "title": "AXM Organ Selection Receipt v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "selectedBy", "comparisonDigest", "candidateId", "packageDigest", "decision", "applied", "installed", "registered", "staged", "promoted", "canonChanged", "permissionsChanged", "selectionDigest"],
  "properties": {"schema": {"const": "axm.organ-selection-receipt/v1"}, "selectedBy": {"type": "string"}, "comparisonDigest": {"$ref": "#/$defs/digest"}, "candidateId": {"type": "string"}, "packageDigest": {"$ref": "#/$defs/digest"}, "decision": {"const": "SELECT_FOR_IMPLEMENTATION_REVIEW"}, "applied": {"const": false}, "installed": {"const": false}, "registered": {"const": false}, "staged": {"const": false}, "promoted": {"const": false}, "canonChanged": {"const": false}, "permissionsChanged": {"const": false}, "selectionDigest": {"$ref": "#/$defs/digest"}},
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
