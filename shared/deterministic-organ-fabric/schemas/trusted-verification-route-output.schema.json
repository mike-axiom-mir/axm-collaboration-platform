{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.trusted-verification-route-output/v1",
  "title": "AXM Trusted Verification Route Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "implementation", "plan", "evidenceDeskPrefill", "verificationSpinePrefill", "authority", "outputDigest"],
  "properties": {
    "schema": {"const": "axm.trusted-verification-route-output/v1"},
    "status": {"const": "EXPERIMENTAL"},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["id", "version", "strategy", "packageDigest", "selectionDigest"], "properties": {"id": {"const": "selected-workshop-verification-route"}, "version": {"const": "0.1.0"}, "strategy": {"const": "balanced"}, "packageDigest": {"$ref": "#/$defs/digest"}, "selectionDigest": {"$ref": "#/$defs/digest"}}},
    "plan": {"$ref": "axm.verification-route-plan/v1"},
    "evidenceDeskPrefill": {"$ref": "axm.evidence-fields/v2"},
    "verificationSpinePrefill": {"$ref": "axm.verification-spine-prefill/v1"},
    "authority": {"type": "object", "additionalProperties": false, "required": ["trustedRuntimeEvaluated", "generatedCodeExecuted", "checksExecuted", "browserOperated", "wroteState", "installed", "registered", "staged", "promoted", "canonChanged", "foundationChanged"], "properties": {"trustedRuntimeEvaluated": {"const": true}, "generatedCodeExecuted": {"const": false}, "checksExecuted": {"const": false}, "browserOperated": {"const": false}, "wroteState": {"const": false}, "installed": {"const": false}, "registered": {"const": false}, "staged": {"const": false}, "promoted": {"const": false}, "canonChanged": {"const": false}, "foundationChanged": {"const": false}}},
    "outputDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
