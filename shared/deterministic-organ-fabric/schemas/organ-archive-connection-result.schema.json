{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.organ-archive-connection-result/v1",
  "title": "AXM Passive Organ Archive Connection Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "outcome", "packageDigest", "planDigest", "receiptDigest", "receiverAcknowledgementDigest", "sourcePath", "sourceSha256", "sourceDisposition", "archiveObjectId", "archiveObjectDisposition", "eventDisposition", "archiveAdmissionStatus", "startupPolicy", "runtimeConnected", "organLoaded", "organExecuted", "runtimeAdmitted", "installed", "registered", "staged", "promoted", "canonChanged"],
  "properties": {
    "schema": {"const": "axm.organ-archive-connection-result/v1"},
    "status": {"const": "EXPERIMENTAL"},
    "outcome": {"const": "DORMANT_ARCHIVE_CONNECTION_ACKNOWLEDGED"},
    "packageDigest": {"$ref": "#/$defs/digest"},
    "planDigest": {"$ref": "#/$defs/digest"},
    "receiptDigest": {"$ref": "#/$defs/digest"},
    "receiverAcknowledgementDigest": {"$ref": "#/$defs/digest"},
    "sourcePath": {"type": "string", "pattern": "^organs/[a-z0-9-]+-organ\\.js$"},
    "sourceSha256": {"$ref": "#/$defs/rawDigest"},
    "sourceDisposition": {"enum": ["CREATED_SOURCE_ARTIFACT", "REUSED_EXACT_SOURCE_ARTIFACT"]},
    "archiveObjectId": {"$ref": "#/$defs/rawDigest"},
    "archiveObjectDisposition": {"enum": ["CREATED_ARCHIVE_OBJECT", "REUSED_EXISTING_ARCHIVE_OBJECT", "REUSED_CONCURRENT_ARCHIVE_OBJECT"]},
    "eventDisposition": {"enum": ["CREATED", "DEDUPLICATED"]},
    "archiveAdmissionStatus": {"const": "ARCHIVED_NOT_ADMITTED_TO_RUNTIME"},
    "startupPolicy": {"const": "DORMANT"},
    "runtimeConnected": {"const": false},
    "organLoaded": {"const": false},
    "organExecuted": {"const": false},
    "runtimeAdmitted": {"const": false},
    "installed": {"const": false},
    "registered": {"const": false},
    "staged": {"const": false},
    "promoted": {"const": false},
    "canonChanged": {"const": false}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "rawDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
