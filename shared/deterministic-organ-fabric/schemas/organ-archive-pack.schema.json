{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "axm.organ-archive-pack/v1", "title": "AXM Portable Organ Archive Pack v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "objects", "failures", "events", "packDigest"],
  "properties": {"schema": {"const": "axm.organ-archive-pack/v1"}, "objects": {"type": "array", "items": {"$ref": "organ-archive-object.schema.json"}}, "stash": {"type": "array", "items": {"$ref": "organ-archive-stash-projection.schema.json"}}, "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}}, "events": {"type": "array", "items": {"$ref": "organ-archive-event.schema.json"}}, "packDigest": {"$ref": "#/$defs/digest"}},
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "failure": {"type": "object", "additionalProperties": false, "required": ["schema", "factoryVersion", "intentDigest", "pack", "strategy", "status", "failedGates", "failureDigest"], "properties": {"schema": {"const": "axm.organ-generation-failure/v1"}, "factoryVersion": {"type": "string"}, "intentDigest": {"$ref": "#/$defs/digest"}, "pack": {"type": "object", "additionalProperties": false, "required": ["id", "version", "digest"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}}, "strategy": {"enum": ["lean", "balanced", "guarded"]}, "status": {"const": "REJECTED"}, "failedGates": {"type": "array"}, "failureDigest": {"$ref": "#/$defs/digest"}}}}
}
