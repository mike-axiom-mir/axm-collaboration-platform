{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "axm.organ-evaluation-receipt/v1", "title": "AXM Organ Evaluation Receipt v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "factoryVersion", "candidateId", "definitionDigest", "intentDigest", "packDigest", "status", "gates", "fixtures", "reproducibility", "limitations", "authorityCeiling", "receiptDigest"],
  "properties": {"schema": {"const": "axm.organ-evaluation-receipt/v1"}, "factoryVersion": {"type": "string"}, "candidateId": {"type": "string"}, "definitionDigest": {"$ref": "#/$defs/digest"}, "intentDigest": {"$ref": "#/$defs/digest"}, "packDigest": {"$ref": "#/$defs/digest"}, "status": {"enum": ["VALID", "REJECTED"]}, "gates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "ok", "details"], "properties": {"id": {"type": "string"}, "ok": {"type": "boolean"}, "details": {}}}}, "fixtures": {"type": "object", "additionalProperties": false, "required": ["required", "desired", "heldOut"], "properties": {"required": {"type": "array", "items": {"$ref": "#/$defs/fixtureResult"}}, "desired": {"type": "array", "items": {"$ref": "#/$defs/fixtureResult"}}, "heldOut": {"type": "array", "items": {"$ref": "#/$defs/fixtureResult"}}}}, "reproducibility": {"type": "object", "additionalProperties": false, "required": ["canonical", "definitionRebuildParity", "packageRebuildParity"], "properties": {"canonical": {"const": true}, "definitionRebuildParity": {"type": "boolean"}, "packageRebuildParity": {"type": ["boolean", "null"]}}}, "limitations": {"type": "array", "items": {"type": "string"}}, "authorityCeiling": {"$ref": "#/$defs/authority"}, "metrics": {"$ref": "#/$defs/metrics"}, "receiptDigest": {"$ref": "#/$defs/digest"}},
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "trace": {"type": "object", "additionalProperties": false, "required": ["node", "op", "valueDigest"], "properties": {"node": {"type": "string"}, "op": {"type": "string"}, "valueDigest": {"$ref": "#/$defs/digest"}}}, "fixtureResult": {"type": "object", "additionalProperties": false, "required": ["id", "ok", "failures", "outputDigest", "trace"], "properties": {"id": {"type": "string"}, "ok": {"type": "boolean"}, "failures": {"type": "array"}, "outputDigest": {"type": ["string", "null"]}, "trace": {"type": "array", "items": {"$ref": "#/$defs/trace"}}}}, "authority": {"type": "object", "additionalProperties": false, "required": ["installed", "registered", "staged", "promoted", "canonChanged", "permissionsChanged"], "properties": {"installed": {"const": false}, "registered": {"const": false}, "staged": {"const": false}, "promoted": {"const": false}, "canonChanged": {"const": false}, "permissionsChanged": {"const": false}}}, "components": {"type": "object", "additionalProperties": false, "required": ["functionalCoverage", "evidenceStrength", "failureContainment", "simplicityExplainability", "resourceMargin", "dependencyIndependence", "integrationFit"], "properties": {"functionalCoverage": {"type": "integer"}, "evidenceStrength": {"type": "integer"}, "failureContainment": {"type": "integer"}, "simplicityExplainability": {"type": "integer"}, "resourceMargin": {"type": "integer"}, "dependencyIndependence": {"type": "integer"}, "integrationFit": {"type": "integer"}}}, "metrics": {"type": "object", "additionalProperties": false, "required": ["profileId", "weights", "components", "score", "integerArithmetic"], "properties": {"profileId": {"const": "balanced-v1"}, "weights": {"$ref": "organ-comparison.schema.json#/$defs/weights"}, "components": {"$ref": "#/$defs/components"}, "score": {"type": "integer"}, "integerArithmetic": {"const": true}}}}
}
