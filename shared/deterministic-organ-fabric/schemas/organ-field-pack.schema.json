{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.organ-field-pack/v1",
  "title": "AXM Organ Field Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "title", "description", "capability", "vocabulary", "requiredInputs", "requiredOutputs", "allowedPrimitives", "strategies", "validators", "heldOutCases", "humanJudgments", "exampleIntent", "packDigest"],
  "properties": {
    "schema": {"const": "axm.organ-field-pack/v1"}, "id": {"type": "string"}, "version": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "capability": {"type": "string"},
    "vocabulary": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "requiredInputs": {"type": "array", "items": {"type": "string"}}, "requiredOutputs": {"type": "array", "items": {"type": "string"}},
    "allowedPrimitives": {"type": "array", "minItems": 1, "items": {"enum": ["read", "literal", "lookup", "equals", "gte", "and", "or", "not", "choose", "clamp", "stable_unique", "stable_union", "stable_lookup_union", "object", "transition", "seeded_select"]}},
    "strategies": {"type": "object", "additionalProperties": false, "required": ["lean", "balanced", "guarded"], "properties": {"lean": {"$ref": "#/$defs/strategy"}, "balanced": {"$ref": "#/$defs/strategy"}, "guarded": {"$ref": "#/$defs/strategy"}}},
    "validators": {"type": "array", "items": {"type": "string"}}, "heldOutCases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}, "humanJudgments": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exampleIntent": {"type": "object"}, "routeTokenRegistryRef": {"$ref": "#/$defs/ref"}, "packDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "version", "digest"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}},
    "guard": {"type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": {"kind": {"enum": ["required", "enum", "minimum", "maximum", "minimumItems"]}, "path": {"type": "string"}, "values": {"type": "array"}, "value": {}}},
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "op"], "properties": {"id": {"type": "string"}, "op": {"type": "string"}, "path": {"type": "string"}, "value": {}, "table": {"type": "object"}, "args": {"type": "array"}, "fields": {"type": "object"}, "minimum": {"type": "number"}, "maximum": {"type": "number"}, "states": {"type": "object"}, "seedRef": {"type": "string"}, "options": {"type": "array"}, "onUnknown": {"enum": ["refuse", "default"]}}},
    "graph": {"type": "object", "additionalProperties": false, "required": ["nodes", "output"], "properties": {"nodes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/node"}}, "output": {"type": "string"}}},
    "strategy": {"type": "object", "additionalProperties": false, "required": ["guards", "graph"], "properties": {"guards": {"type": "array", "items": {"$ref": "#/$defs/guard"}}, "guardOnlyInputs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "graph": {"$ref": "#/$defs/graph"}}},
    "assertion": {"type": "object", "additionalProperties": false, "required": ["path", "op", "value"], "properties": {"path": {"type": "string"}, "op": {"enum": ["eq", "contains", "in", "gte", "lte"]}, "value": {}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["id", "description", "input", "assertions"], "properties": {"id": {"type": "string"}, "description": {"type": "string"}, "input": {"type": "object"}, "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}}}}
  }
}
