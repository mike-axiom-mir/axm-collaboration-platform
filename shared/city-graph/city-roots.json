{
  "schema": "axm.city-roots/v1",
  "roots": [
    {
      "path": "tools",
      "mode": "DIRECT_CHILDREN",
      "idMode": "DECLARED",
      "declarations": ["manifest.json", "module.contract.json"],
      "ignorePrefix": "_"
    },
    {
      "path": "shared",
      "mode": "DIRECT_CHILDREN",
      "idMode": "ROOT_QUALIFIED",
      "declarations": ["manifest.json", "module.contract.json", "service.contract.json"]
    },
    {
      "path": "worlds",
      "mode": "DIRECT_CHILDREN",
      "idMode": "ROOT_QUALIFIED",
      "declarations": ["world.manifest.json", "module.contract.json"]
    }
  ],
  "authority": {
    "install": false,
    "execute": false,
    "network": false,
    "promote": false,
    "merge": false,
    "canon": false,
    "roots": false
  }
}
