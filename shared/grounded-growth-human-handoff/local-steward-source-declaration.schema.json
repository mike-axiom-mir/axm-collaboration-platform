{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.local-steward-source-declaration/v1",
  "title": "AXM Local Steward Source Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "declarationId", "declaredAt", "fixtureMode",
    "declarationMode", "attestation", "claim", "judgeRef", "protocolRef",
    "evaluationRef", "judgmentRef", "sessionRefs", "usableAsSourceTrust",
    "truth", "sourceDeclarationDigest"
  ],
  "properties": {
    "schema": { "const": "axm.local-steward-source-declaration/v1" },
    "version": { "const": "0.1.0" },
    "declarationId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "declaredAt": { "type": "string", "format": "date-time" },
    "fixtureMode": { "enum": ["LIVE", "SYNTHETIC"] },
    "declarationMode": { "enum": ["LIVE_HUMAN_DECLARATION", "SYNTHETIC_FIXTURE"] },
    "attestation": { "type": "string", "minLength": 1, "maxLength": 220 },
    "claim": { "type": "object" },
    "judgeRef": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "protocolRef": { "$ref": "#/$defs/reference" },
    "evaluationRef": { "$ref": "#/$defs/reference" },
    "judgmentRef": { "$ref": "#/$defs/reference" },
    "sessionRefs": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/reference" } },
    "usableAsSourceTrust": { "type": "boolean" },
    "truth": { "type": "object" },
    "sourceDeclarationDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 180 },
        "schema": { "type": "string", "minLength": 1, "maxLength": 180 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
