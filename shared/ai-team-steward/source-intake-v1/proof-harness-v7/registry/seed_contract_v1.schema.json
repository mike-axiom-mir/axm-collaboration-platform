{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.team.seed-contract.v1",
  "title": "AXM AI-Team Seed Proof Contract",
  "type": "object",
  "required": [
    "contract_version",
    "seed_number",
    "module_id",
    "name",
    "family",
    "risk_tier",
    "proof_slice_id",
    "state_object",
    "critical_invariant",
    "hold_rule",
    "dependency_module_ids",
    "binding_contracts",
    "owner_seam_candidate",
    "canon_status",
    "runtime_status",
    "registry_entry_digest"
  ],
  "properties": {
    "contract_version": {
      "const": "axm.team.seed-contract.v1"
    },
    "seed_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "module_id": {
      "type": "string",
      "pattern": "^axm\\.team\\."
    },
    "family": {
      "type": "string"
    },
    "risk_tier": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "canon_status": {
      "const": "WORKING_CANDIDATE_NOT_CANON"
    },
    "runtime_status": {
      "const": "DETERMINISTIC_HARNESS_TARGET_NOT_AXM_RUNTIME"
    }
  },
  "additionalProperties": true
}
