{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/visual-grammar.schema.json",
  "title": "AXM Visual Grammar Profile",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "title",
    "graph",
    "role_bindings",
    "required_roles",
    "required_capabilities",
    "protected_instances",
    "target_outputs",
    "policy",
    "approval",
    "digest"
  ],
  "properties": {
    "schema": { "const": "axm.visual-grammar/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 60 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "graph": { "type": "object" },
    "role_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["instance_id", "role", "category", "plane", "editable"],
        "properties": {
          "instance_id": { "type": "string" },
          "role": { "type": "string" },
          "category": { "type": "string" },
          "plane": { "enum": ["semantic", "presentation", "governance"] },
          "editable": { "type": "boolean" },
          "order": { "type": "integer" }
        },
        "additionalProperties": false
      }
    },
    "required_roles": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "required_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "protected_instances": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "target_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["output_id", "mime", "role", "required"],
        "properties": {
          "output_id": { "type": "string" },
          "mime": { "type": "string" },
          "role": { "type": "string" },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "required": ["data_only", "execution_authority", "preserve_semantics", "unknown_role", "visual_change"],
      "properties": {
        "data_only": { "const": true },
        "execution_authority": { "const": "none" },
        "preserve_semantics": { "const": true },
        "unknown_role": { "enum": ["fail", "namespaced-extension"] },
        "visual_change": { "const": "invalidate-approval" }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["technical", "visual", "canon"],
      "properties": {
        "technical": { "enum": ["UNTESTED", "PASS", "FAIL", "INVALIDATED"] },
        "visual": { "enum": ["UNREVIEWED", "APPROVED", "REJECTED", "INVALIDATED"] },
        "canon": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source": { "type": "object" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
