      "one-local-root-as-globally-consistent-log",
      "independent-caller-roots-as-one-coordinated-state",
      "caller-owned-files-as-external-retention-or-protected-monotonic-state",
      "local-files-as-deletion-or-rollback-resistance",
      "stored-transition-receipt-as-upstream-signature-reverification-after-restart",
      "explicit-confirmation-as-host-authorization",
      "caller-log-id-as-authenticated-ledger-authority",
      "library-call-as-host-authorized-trusted-entry-point",
      "transition-recording-as-execution-or-adoption-authority",
      "raw-public-key-or-signature-persistence",
      "raw-model-output-or-private-context-ingestion",
      "automatic-write",
      "automatic-permission-grant",
      "automatic-training",
      "automatic-install",
      "automatic-promotion",
      "automatic-merge",
      "automatic-canon",
      "foundation-mutation"
    ]
  },
  "lifecycle": {
    "state_owner": "caller-provided local state root",
    "reload": "validate manifest, contiguous local entries, digest chain, and derived head; exact upstream rebuild additionally requires caller-presented packages",
    "disconnect": "not-applicable",
    "cleanup": "caller-owned; deletion or rollback can reopen a prior head and requires explicit steward review",
    "installed": false,
    "promoted": false
