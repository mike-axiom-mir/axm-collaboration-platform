{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/material-reality-library-v0.5.schema.json",
  "title": "AXM Material Reality Library v0.5",
  "type": "object",
  "required": [
    "schema_version",
    "library_id",
    "version",
    "status",
    "profiles",
    "governance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5"
    },
    "library_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{1,95}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "status": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "profile_id",
          "name",
          "appearance",
          "physics",
          "manufacturing",
          "effects",
          "meaning"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 2
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "appearance": {
            "type": "object",
            "required": [
              "base_color_rgba",
              "metallic",
              "roughness",
              "emissive_rgb"
            ],
            "properties": {
              "base_color_rgba": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  }
                ],
                "items": false,
                "minItems": 4,
                "maxItems": 4
              },
              "metallic": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "roughness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "emissive_rgb": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "number",
                    "minimum": 0
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "transmission": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ior": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "emissive_intensity": {
                "type": "number",
                "minimum": 0
              },
              "thickness_m": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "physics": {
            "type": "object",
            "required": [
              "density_kg_m3",
              "value_status",
              "game_surface"
            ],
            "properties": {
              "density_kg_m3": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "value_status": {
                "type": "string",
                "minLength": 5
              },
              "game_surface": {
                "type": "object",
                "required": [
                  "static_friction",
                  "dynamic_friction",
                  "restitution"
                ],
                "properties": {
                  "static_friction": {
                    "type": "number",
                    "minimum": 0
                  },
                  "dynamic_friction": {
                    "type": "number",
                    "minimum": 0
                  },
                  "restitution": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "manufacturing": {
            "type": "object",
            "required": [
              "candidate_materials",
              "candidate_processes",
              "review"
            ],
            "properties": {
              "candidate_materials": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "candidate_processes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "review": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "effects": {
            "type": "object",
            "required": [
              "impact_sound_family",
              "impact_particles",
              "damage_modes"
            ],
            "properties": {
              "impact_sound_family": {
                "type": "string"
              },
              "impact_particles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "damage_modes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "meaning": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "truth_rule",
        "physical_values",
        "production_control"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
