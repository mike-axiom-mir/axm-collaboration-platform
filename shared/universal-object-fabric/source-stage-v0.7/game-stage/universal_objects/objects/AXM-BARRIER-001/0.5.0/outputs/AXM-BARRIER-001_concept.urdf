<?xml version="1.0" encoding="utf-8"?>
<robot name="axm_barrier_001">
  <!--AXM UOF v0.5 concept only: no actuators, controllers, calibrated inertia, or physical-control authority.-->
  <link name="root">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="arm">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <joint name="arm_lift" type="revolute">
    <parent link="root" />
    <child link="arm" />
    <origin xyz="0 0.78 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="1.57079633" effort="0" velocity="0" />
  </joint>
</robot>
