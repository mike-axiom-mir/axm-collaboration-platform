<?xml version="1.0" encoding="utf-8"?>
<robot name="axm_pickup_gem_001">
  <!--AXM UOF v0.5 concept only: no actuators, controllers, calibrated inertia, or physical-control authority.-->
  <link name="root">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="gem">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="lower_orbit">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="upper_orbit">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <joint name="gem_spin" type="continuous">
    <parent link="root" />
    <child link="gem" />
    <origin xyz="0 0.32 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <joint name="lower_orbit_spin" type="continuous">
    <parent link="root" />
    <child link="lower_orbit" />
    <origin xyz="0 0.23 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <joint name="upper_orbit_spin" type="continuous">
    <parent link="root" />
    <child link="upper_orbit" />
    <origin xyz="0 0.42 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
</robot>
