<?xml version="1.0" encoding="utf-8"?>
<robot name="axm_vehicle_chassis_001">
  <!--AXM UOF v0.5 concept only: no actuators, controllers, calibrated inertia, or physical-control authority.-->
  <link name="root">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="wheel_0">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="wheel_1">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="wheel_2">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="wheel_3">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <joint name="wheel_0_spin" type="continuous">
    <parent link="root" />
    <child link="wheel_0" />
    <origin xyz="-0.97 -0.19 1.05" rpy="0 0 0" />
    <axis xyz="1 0 0" />
  </joint>
  <joint name="wheel_1_spin" type="continuous">
    <parent link="root" />
    <child link="wheel_1" />
    <origin xyz="0.97 -0.19 1.05" rpy="0 0 0" />
    <axis xyz="1 0 0" />
  </joint>
  <joint name="wheel_2_spin" type="continuous">
    <parent link="root" />
    <child link="wheel_2" />
    <origin xyz="-0.97 -0.19 -1.05" rpy="0 0 0" />
    <axis xyz="1 0 0" />
  </joint>
  <joint name="wheel_3_spin" type="continuous">
    <parent link="root" />
    <child link="wheel_3" />
    <origin xyz="0.97 -0.19 -1.05" rpy="0 0 0" />
    <axis xyz="1 0 0" />
  </joint>
</robot>
