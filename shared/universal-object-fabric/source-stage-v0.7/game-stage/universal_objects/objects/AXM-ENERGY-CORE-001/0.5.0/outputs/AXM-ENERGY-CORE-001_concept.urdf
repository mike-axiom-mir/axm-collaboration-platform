<?xml version="1.0" encoding="utf-8"?>
<robot name="axm_energy_core_001">
  <!--AXM UOF v0.5 concept only: no actuators, controllers, calibrated inertia, or physical-control authority.-->
  <link name="root">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="lower_ring">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="upper_ring">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <link name="energy_core">
    <!--Visual/collision geometry remains in the source-bound AXM runtime package; this file preserves kinematic structure only.-->
  </link>
  <joint name="lower_spin" type="continuous">
    <parent link="root" />
    <child link="lower_ring" />
    <origin xyz="0 0.44 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <joint name="upper_spin" type="continuous">
    <parent link="root" />
    <child link="upper_ring" />
    <origin xyz="0 1.32 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <joint name="core_spin" type="continuous">
    <parent link="root" />
    <child link="energy_core" />
    <origin xyz="0 0.88 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
</robot>
