{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.fabrication-output-adapter/v1",
  "title": "AXM Fabrication Output Adapter v1",
  "type": "object",
  "required": ["schema", "id", "version", "processFamily", "vendorNeutral", "acceptedInputs", "produces", "standardInterchangeFormat", "offlineCore", "vendorAiBypassable", "automaticExecution", "permissions", "constraints", "verification", "digest"],
  "properties": {
    "schema": { "const": "axm.fabrication-output-adapter/v1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "processFamily": { "enum": ["filament-3d", "resin-3d", "full-colour-3d", "uv-surface", "laser-cut-engrave", "cnc", "hybrid"] },
    "vendorNeutral": { "const": true },
    "acceptedInputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "produces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "standardInterchangeFormat": { "type": "string", "minLength": 1 },
    "offlineCore": { "type": "boolean" },
    "vendorAiBypassable": { "type": "boolean" },
    "automaticExecution": { "const": false },
    "permissions": { "type": "array", "maxItems": 16, "items": { "type": "string" } },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
