{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.model-shadow-review-challenge-anchored-witness/v1",
  "title": "Model Shadow review challenge anchored witness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "receiptId", "verifiedAt", "status",
    "expectedAnchorDigest", "anchorRef", "anchorEpoch", "witnessRef",
    "witnessPolicyRef", "checkpointRef", "ledgerRef", "entriesDigest",
    "state", "authorizationEvidence", "nextGate", "truth", "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "axm.model-shadow-review-challenge-anchored-witness/v1"},
    "version": {"const": "0.5.0"},
    "receiptId": {"type": "string", "minLength": 1, "maxLength": 180},
    "verifiedAt": {"type": "string", "format": "date-time"},
    "status": {"const": "TEST"},
    "expectedAnchorDigest": {"$ref": "#/$defs/digest"},
    "anchorRef": {"$ref": "#/$defs/reference"},
    "anchorEpoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "witnessRef": {"$ref": "#/$defs/reference"},
    "witnessPolicyRef": {"$ref": "#/$defs/reference"},
    "checkpointRef": {"$ref": "#/$defs/reference"},
    "ledgerRef": {"$ref": "#/$defs/reference"},
    "entriesDigest": {"$ref": "#/$defs/digest"},
    "state": {"const": "WITNESS_CHAIN_VERIFIED_TO_CALLER_PRESENTED_ANCHOR_PIN_AUTHORITY_NOT_AUTHENTICATED"},
    "authorizationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "requiredSignatures", "verifiedSignatures", "anchorAuthorityOrigin", "authorizations"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "requiredSignatures": {"type": "integer", "minimum": 1, "maximum": 10},
        "verifiedSignatures": {"type": "integer", "minimum": 1, "maximum": 10},
        "anchorAuthorityOrigin": {"const": "CALLER_PRESENTED_PIN_UNAUTHENTICATED"},
        "authorizations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "authorizationIdDigest", "authorizationDigest", "anchorKeyIdDigest",
              "keyFingerprint", "stewardDigest", "stewardKind", "issuedAt", "expiresAt"
            ],
            "properties": {
              "authorizationIdDigest": {"$ref": "#/$defs/digest"},
              "authorizationDigest": {"$ref": "#/$defs/digest"},
              "anchorKeyIdDigest": {"$ref": "#/$defs/digest"},
              "keyFingerprint": {"$ref": "#/$defs/digest"},
              "stewardDigest": {"$ref": "#/$defs/digest"},
              "stewardKind": {"enum": ["human", "machine", "unknown"]},
              "issuedAt": {"type": "string", "format": "date-time"},
              "expiresAt": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    },
    "nextGate": {"const": "HOST_AUTHENTICATED_ANCHOR_PIN_AND_EXTERNALLY_RETAINED_RECEIPT_OR_PROTECTED_MONOTONIC_STORE"},
    "truth": {"$ref": "#/$defs/truth"},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witnessVerifiedByExactRebuild", "witnessCheckpointSignaturesCryptographicallyValid",
        "witnessSigningKeyPossessionVerified", "exactAnchorPolicySelfDigestValid",
        "expectedAnchorDigestMatched", "anchorAuthorizationSignaturesCryptographicallyValid",
        "anchorSigningKeyPossessionVerified", "anchorKeysAllowedByExactPolicy",
        "witnessAndPolicyAuthorizedByExactAnchorSignatures", "anchorEpochSelfDeclared",
        "anchorEpochMonotonicityProven", "anchorPolicyAuthorityAuthenticated",
        "expectedAnchorDigestAuthorityAuthenticated", "witnessPolicyAuthorityAuthenticated",
        "anchorOriginAuthenticatedByHost", "anchorStewardRealWorldIdentityProven",
        "declaredHumanAnchorStewardIsAuthenticatedHuman", "actualHumanParticipationProven",
        "jointAnchorAndPinSubstitutionStillPossible", "anchoredWitnessVerificationTimeExternallyTrusted",
        "anchorExternallyRetained", "anchoredWitnessExternallyRetained",
        "checkpointExternallyRetained", "anchorStoredByThisModule",
        "anchoredWitnessStoredByThisModule", "deletionOrRollbackPrevented",
        "globalSingleUseProven", "hostAuthorizationAuthenticated",
        "rawStewardIdentityEmbedded", "rawPublicKeyEmbedded", "rawSignatureEmbedded",
        "privateKeyIngested", "rawModelOutputEmbedded", "privateContextEmbedded",
        "experimentExecuted", "evaluationPerformed", "executionAuthorized",
        "adoptionAuthorized", "humanBenefitProven", "broadLearningClaimed",
        "automaticWrite", "automaticPermissionGrant", "automaticPromotion",
        "automaticMerge", "automaticCanon", "foundationMutation"
      ],
      "properties": {
        "witnessVerifiedByExactRebuild": {"const": true},
        "witnessCheckpointSignaturesCryptographicallyValid": {"const": true},
        "witnessSigningKeyPossessionVerified": {"const": true},
        "exactAnchorPolicySelfDigestValid": {"const": true},
        "expectedAnchorDigestMatched": {"const": true},
        "anchorAuthorizationSignaturesCryptographicallyValid": {"const": true},
        "anchorSigningKeyPossessionVerified": {"const": true},
        "anchorKeysAllowedByExactPolicy": {"const": true},
        "witnessAndPolicyAuthorizedByExactAnchorSignatures": {"const": true},
        "anchorEpochSelfDeclared": {"const": true},
        "anchorEpochMonotonicityProven": {"const": false},
        "anchorPolicyAuthorityAuthenticated": {"const": false},
        "expectedAnchorDigestAuthorityAuthenticated": {"const": false},
        "witnessPolicyAuthorityAuthenticated": {"const": false},
        "anchorOriginAuthenticatedByHost": {"const": false},
        "anchorStewardRealWorldIdentityProven": {"const": false},
        "declaredHumanAnchorStewardIsAuthenticatedHuman": {"const": false},
        "actualHumanParticipationProven": {"const": false},
        "jointAnchorAndPinSubstitutionStillPossible": {"const": true},
        "anchoredWitnessVerificationTimeExternallyTrusted": {"const": false},
        "anchorExternallyRetained": {"const": false},
        "anchoredWitnessExternallyRetained": {"const": false},
        "checkpointExternallyRetained": {"const": false},
        "anchorStoredByThisModule": {"const": false},
        "anchoredWitnessStoredByThisModule": {"const": false},
        "deletionOrRollbackPrevented": {"const": false},
        "globalSingleUseProven": {"const": false},
        "hostAuthorizationAuthenticated": {"const": false},
        "rawStewardIdentityEmbedded": {"const": false},
        "rawPublicKeyEmbedded": {"const": false},
        "rawSignatureEmbedded": {"const": false},
        "privateKeyIngested": {"const": false},
        "rawModelOutputEmbedded": {"const": false},
        "privateContextEmbedded": {"const": false},
        "experimentExecuted": {"const": false},
        "evaluationPerformed": {"const": false},
        "executionAuthorized": {"const": false},
        "adoptionAuthorized": {"const": false},
        "humanBenefitProven": {"const": false},
        "broadLearningClaimed": {"const": false},
        "automaticWrite": {"const": false},
        "automaticPermissionGrant": {"const": false},
        "automaticPromotion": {"const": false},
        "automaticMerge": {"const": false},
        "automaticCanon": {"const": false},
        "foundationMutation": {"const": false}
      }
    }
  }
}
