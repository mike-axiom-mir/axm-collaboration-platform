{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.model-shadow-review-challenge-anchor-policy/v1",
  "title": "Model Shadow review challenge witness anchor policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "anchorId", "anchorEpoch", "issuedAt", "expiresAt", "status",
    "audience", "scope", "authorityOrigin", "requiredSignatures",
    "maxAuthorizationAgeSeconds", "keys", "anchorDigest"
  ],
  "properties": {
    "schema": {"const": "axm.model-shadow-review-challenge-anchor-policy/v1"},
    "anchorId": {"type": "string", "minLength": 1, "maxLength": 180},
    "anchorEpoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "status": {"const": "TEST"},
    "audience": {"const": "MODEL_SHADOW_REVIEW_CHALLENGE_WITNESS_AUTHORIZATION"},
    "scope": {"const": "AUTHORIZE_EXACT_MODEL_SHADOW_REVIEW_CHALLENGE_WITNESS"},
    "authorityOrigin": {"const": "CALLER_PRESENTED_PIN_UNAUTHENTICATED"},
    "requiredSignatures": {"type": "integer", "minimum": 1, "maximum": 10},
    "maxAuthorizationAgeSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchorKeyId", "algorithm", "publicKeyPem", "stewardDigest", "stewardKind", "scope", "enabled"],
        "properties": {
          "anchorKeyId": {"type": "string", "minLength": 1, "maxLength": 180},
          "algorithm": {"const": "Ed25519"},
          "publicKeyPem": {"type": "string", "minLength": 1, "maxLength": 8192},
          "stewardDigest": {"$ref": "#/$defs/digest"},
          "stewardKind": {"enum": ["human", "machine", "unknown"]},
          "scope": {"const": "AUTHORIZE_EXACT_MODEL_SHADOW_REVIEW_CHALLENGE_WITNESS"},
          "enabled": {"const": true}
        }
      }
    },
    "anchorDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
