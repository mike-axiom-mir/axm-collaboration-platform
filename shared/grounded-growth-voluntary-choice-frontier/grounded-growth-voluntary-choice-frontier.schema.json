{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.grounded-growth-voluntary-choice-frontier/v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "frontierId",
    "generatedAt",
    "status",
    "state",
    "sourceRefs",
    "current",
    "choices",
    "holds",
    "selectionPolicy",
    "balance",
    "decision",
    "truth",
    "frontierDigest"
  ],
  "properties": {
    "schema": { "const": "axm.grounded-growth-voluntary-choice-frontier/v1" },
    "version": { "const": "0.1.0" },
    "status": { "const": "TEST" },
    "state": {
      "enum": [
        "CURRENT_NEUTRAL_OPTION_MENU_WITH_EXPLICIT_HOLDS",
        "CURRENT_NEUTRAL_OPTION_MENU"
      ]
    },
    "choices": { "type": "array" },
    "holds": { "type": "array" },
    "frontierDigest": { "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
