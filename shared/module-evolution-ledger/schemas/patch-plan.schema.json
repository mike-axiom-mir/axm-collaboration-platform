{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.module-evolution-ledger.bounded-patch-plan/v1",
  "title": "Bounded Module Evolution Patch Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "baseDocumentDigest", "operations", "patchPlanDigest"],
  "properties": {
    "schema": {"const": "axm.module-evolution-ledger.bounded-patch-plan/v1"},
    "baseDocumentDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "patchPlanDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["op", "path", "baseWitness"],
        "properties": {
          "op": {"enum": ["set_if_missing", "replace", "remove", "append_unique", "add_unique_values"]},
          "path": {"type": "string", "pattern": "^/", "maxLength": 512},
          "baseWitness": {"type": "object"}
        }
      }
    }
  }
}
