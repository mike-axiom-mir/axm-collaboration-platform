{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.model-shadow-review-challenge-separated-witness/v1",
  "title": "Model Shadow review challenge separated witness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "receiptId", "verifiedAt", "status",
    "anchoredWitnessRef", "anchorRef", "witnessRef", "witnessPolicyRef",
    "checkpointRef", "ledgerRef", "entriesDigest", "state",
    "separationEvidence", "nextGate", "truth", "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "axm.model-shadow-review-challenge-separated-witness/v1"},
    "version": {"const": "0.6.0"},
    "receiptId": {"type": "string", "minLength": 1, "maxLength": 180},
    "verifiedAt": {"type": "string", "format": "date-time"},
    "status": {"const": "TEST"},
    "anchoredWitnessRef": {"$ref": "#/$defs/reference"},
    "anchorRef": {"$ref": "#/$defs/reference"},
    "witnessRef": {"$ref": "#/$defs/reference"},
    "witnessPolicyRef": {"$ref": "#/$defs/reference"},
    "checkpointRef": {"$ref": "#/$defs/reference"},
    "ledgerRef": {"$ref": "#/$defs/reference"},
    "entriesDigest": {"$ref": "#/$defs/digest"},
    "state": {"const": "OBSERVABLE_CROSS_LAYER_OVERLAP_ABSENT_CONTROLLER_INDEPENDENCE_NOT_PROVEN"},
    "separationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "separationScope", "witnessVerifiedSeats", "anchorVerifiedSeats",
        "combinedVerifiedSeats", "witnessKeyFingerprintSetDigest",
        "anchorKeyFingerprintSetDigest", "witnessDeclaredPrincipalSetDigest",
        "anchorDeclaredPrincipalSetDigest", "sharedKeyFingerprintCount",
        "sharedDeclaredPrincipalDigestCount"
      ],
      "properties": {
        "separationScope": {"const": "OBSERVED_CROSS_LAYER_KEY_FINGERPRINT_AND_DECLARED_PRINCIPAL_DIGEST_NONOVERLAP"},
        "witnessVerifiedSeats": {"type": "integer", "minimum": 1, "maximum": 10},
        "anchorVerifiedSeats": {"type": "integer", "minimum": 1, "maximum": 10},
        "combinedVerifiedSeats": {"type": "integer", "minimum": 2, "maximum": 20},
        "witnessKeyFingerprintSetDigest": {"$ref": "#/$defs/digest"},
        "anchorKeyFingerprintSetDigest": {"$ref": "#/$defs/digest"},
        "witnessDeclaredPrincipalSetDigest": {"$ref": "#/$defs/digest"},
        "anchorDeclaredPrincipalSetDigest": {"$ref": "#/$defs/digest"},
        "sharedKeyFingerprintCount": {"const": 0},
        "sharedDeclaredPrincipalDigestCount": {"const": 0}
      }
    },
    "nextGate": {"const": "HOST_AUTHENTICATED_ANCHOR_PIN_INDEPENDENT_IDENTITY_ATTESTATION_AND_EXTERNALLY_RETAINED_OR_PROTECTED_STATE"},
    "truth": {"$ref": "#/$defs/truth"},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchoredWitnessVerifiedByExactRebuild",
        "witnessLayerSignatureSeatsCryptographicallyVerified",
        "anchorLayerSignatureSeatsCryptographicallyVerified",
        "noSharedPublicKeyFingerprintObserved",
        "noSharedDeclaredPrincipalDigestObserved",
        "observableCrossLayerSeparationVerified", "keyCustodyIndependenceProven",
        "realWorldControllerIndependenceProven", "declaredPrincipalDigestsAuthenticated",
        "sameControllerWithDistinctKeysStillPossible",
        "sameControllerWithDistinctPrincipalDigestsStillPossible",
        "crossLayerCollusionExcluded", "anchorPolicyAuthorityAuthenticated",
        "expectedAnchorDigestAuthorityAuthenticated", "witnessPolicyAuthorityAuthenticated",
        "anchorOriginAuthenticatedByHost", "actualHumanParticipationProven",
        "separationVerificationTimeExternallyTrusted", "separationReceiptExternallyRetained",
        "protectedMonotonicStateProven", "deletionOrRollbackPrevented",
        "globalSingleUseProven", "hostAuthorizationAuthenticated",
        "rawPrincipalIdentityEmbedded", "rawPublicKeyEmbedded", "rawSignatureEmbedded",
        "privateKeyIngested", "rawModelOutputEmbedded", "privateContextEmbedded",
        "experimentExecuted", "evaluationPerformed", "executionAuthorized",
        "adoptionAuthorized", "humanBenefitProven", "broadLearningClaimed",
        "automaticWrite", "automaticPermissionGrant", "automaticPromotion",
        "automaticMerge", "automaticCanon", "foundationMutation"
      ],
      "properties": {
        "anchoredWitnessVerifiedByExactRebuild": {"const": true},
        "witnessLayerSignatureSeatsCryptographicallyVerified": {"const": true},
        "anchorLayerSignatureSeatsCryptographicallyVerified": {"const": true},
        "noSharedPublicKeyFingerprintObserved": {"const": true},
        "noSharedDeclaredPrincipalDigestObserved": {"const": true},
        "observableCrossLayerSeparationVerified": {"const": true},
        "keyCustodyIndependenceProven": {"const": false},
        "realWorldControllerIndependenceProven": {"const": false},
        "declaredPrincipalDigestsAuthenticated": {"const": false},
        "sameControllerWithDistinctKeysStillPossible": {"const": true},
        "sameControllerWithDistinctPrincipalDigestsStillPossible": {"const": true},
        "crossLayerCollusionExcluded": {"const": false},
        "anchorPolicyAuthorityAuthenticated": {"const": false},
        "expectedAnchorDigestAuthorityAuthenticated": {"const": false},
        "witnessPolicyAuthorityAuthenticated": {"const": false},
        "anchorOriginAuthenticatedByHost": {"const": false},
        "actualHumanParticipationProven": {"const": false},
        "separationVerificationTimeExternallyTrusted": {"const": false},
        "separationReceiptExternallyRetained": {"const": false},
        "protectedMonotonicStateProven": {"const": false},
        "deletionOrRollbackPrevented": {"const": false},
        "globalSingleUseProven": {"const": false},
        "hostAuthorizationAuthenticated": {"const": false},
        "rawPrincipalIdentityEmbedded": {"const": false},
        "rawPublicKeyEmbedded": {"const": false},
        "rawSignatureEmbedded": {"const": false},
        "privateKeyIngested": {"const": false},
        "rawModelOutputEmbedded": {"const": false},
        "privateContextEmbedded": {"const": false},
        "experimentExecuted": {"const": false},
        "evaluationPerformed": {"const": false},
        "executionAuthorized": {"const": false},
        "adoptionAuthorized": {"const": false},
        "humanBenefitProven": {"const": false},
        "broadLearningClaimed": {"const": false},
        "automaticWrite": {"const": false},
        "automaticPermissionGrant": {"const": false},
        "automaticPromotion": {"const": false},
        "automaticMerge": {"const": false},
        "automaticCanon": {"const": false},
        "foundationMutation": {"const": false}
      }
    }
  }
}
