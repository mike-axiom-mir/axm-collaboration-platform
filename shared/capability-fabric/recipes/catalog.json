      "verifiers": [
        "package digest and exact deterministic rebuild",
        "externally execute emitted selftest.js",
        "Detached Candidate Nursery structural scan"
      ],
      "recipeDigest": "sha256:cd800d802e4ca7e18398318c6ecc35967b8e2b8577c5f41fe7393682aec6d89e"
    },
