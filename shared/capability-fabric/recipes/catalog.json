      "family": "code-module",
      "builderId": "pure-json-transform-v1",
      "activation": "ACTIVE_SOURCE_REVIEWED",
      "reviewPolicy": {
        "activation": "source-review-and-merge",
        "sharedUseRequires": "MIKE_TOBI_MERGE",
        "canonAuthority": "NONE"
      },
      "candidatePolicy": {
        "defaultCount": 1,
        "variants": [
          {
            "id": "standard",
            "title": "Standard bounded transform",
            "parameterOverrides": {}
          }
        ]
      },
      "parameterSpec": {
        "inputField": {
          "type": "string",
          "required": true,
          "pattern": "^[a-z][a-zA-Z0-9]{0,63}$",
          "maxLength": 64,
          "description": "Exact input field to read."
        },
        "outputField": {
          "type": "string",
          "required": true,
          "pattern": "^[a-z][a-zA-Z0-9]{0,63}$",
          "maxLength": 64,
          "description": "Exact output field to emit."
        },
        "defaultValue": {
          "type": "string",
          "required": true,
          "maxLength": 256,
          "description": "Fallback string when the input field is absent."
        },
        "outputSchema": {
          "type": "string",
          "required": true,
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}/v[0-9]+$",
          "maxLength": 128,
          "description": "Schema emitted by the transform envelope."
        },
        "maxInputKeys": {
          "type": "integer",
          "required": true,
          "minimum": 1,
          "maximum": 128,
          "description": "Maximum accepted top-level input keys."
        }
      },
      "exampleRequest": {
        "id": "status-normalizer",
        "family": "code-module",
        "purpose": "Map a reviewed status field into a small stable result envelope.",
        "recipeId": "pure-json-transform",
        "variantId": null,
        "parameters": {
          "inputField": "status",
          "outputField": "normalizedStatus",
          "defaultValue": "unknown",
          "outputSchema": "axm.example.status-normalized/v1",
          "maxInputKeys": 16
        },
        "source": {
          "kind": "HUMAN",
          "ref": "capability-fabric-starter"
        }
      },
      "boundaries": [
