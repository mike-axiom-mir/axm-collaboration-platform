{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.closed-object-contract-adapter-parameters/v1",
  "title": "AXM closed object-contract adapter parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["inputContract", "outputContract", "sourceSchema", "targetSchema", "mappings", "drops", "maxProperties", "maxInputBytes", "maxOutputBytes"],
  "properties": {
    "inputContract": { "$ref": "#/$defs/contract" },
    "outputContract": { "$ref": "#/$defs/contract" },
    "sourceSchema": { "$ref": "#/$defs/flatObjectSchema" },
    "targetSchema": { "$ref": "#/$defs/flatObjectSchema" },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "onMissing", "defaultValue"],
        "properties": {
          "source": { "$ref": "#/$defs/field" },
          "target": { "$ref": "#/$defs/field" },
          "onMissing": { "enum": ["REFUSE", "OMIT", "DEFAULT"] },
          "defaultValue": { "type": ["string", "number", "boolean", "null"] }
        }
      }
    },
    "drops": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/field" } },
    "maxProperties": { "type": "integer", "minimum": 1, "maximum": 64 },
    "maxInputBytes": { "type": "integer", "minimum": 64, "maximum": 65536 },
    "maxOutputBytes": { "type": "integer", "minimum": 64, "maximum": 65536 }
  },
  "$defs": {
    "contract": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{2,179}$" },
    "field": { "type": "string", "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "flatObjectSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties", "required", "additionalProperties"],
      "properties": {
        "type": { "const": "object" },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": { "$ref": "#/$defs/field" },
          "additionalProperties": { "$ref": "#/$defs/primitiveSchema" }
        },
        "required": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/field" } },
        "additionalProperties": { "const": false },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "primitiveSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "number", "integer", "boolean"] },
        "enum": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": ["string", "number", "boolean"] } },
        "minLength": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "maxLength": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "string" } }, "required": ["type"] },
          "else": { "not": { "anyOf": [{ "required": ["minLength"] }, { "required": ["maxLength"] }] } }
        },
        {
          "if": { "properties": { "type": { "enum": ["number", "integer"] } }, "required": ["type"] },
          "else": { "not": { "anyOf": [{ "required": ["minimum"] }, { "required": ["maximum"] }] } }
        }
      ]
    }
  }
}
