{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.capability-recipe-draft/v1",
  "title": "AXM inactive capability recipe draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "title", "summary", "family", "builderId", "activation", "reviewPolicy", "candidatePolicy", "parameterSpec", "exampleRequest", "boundaries", "verifiers"],
  "properties": {
    "schema": { "const": "axm.capability-recipe-draft/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "family": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "builderId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "activation": { "const": "INACTIVE_PROPOSAL" },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation", "sharedUseRequires", "canonAuthority"],
      "properties": {
        "activation": { "const": "source-review-and-merge" },
        "sharedUseRequires": { "const": "MIKE_TOBI_MERGE" },
        "canonAuthority": { "const": "NONE" }
      }
    },
    "candidatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultCount", "defaultVariantId", "variants"],
      "properties": {
        "defaultCount": { "const": 1 },
        "defaultVariantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
        "variants": { "type": "array", "minItems": 1 }
      }
    },
    "parameterSpec": { "type": "object" },
    "exampleRequest": { "type": "object" },
    "boundaries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "verifiers": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
