{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.capability-candidate-package/v1",
  "title": "AXM detached capability candidate package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "status", "capabilityKind", "requestDigest", "catalogDigest", "recipeRef", "variantId", "compilationDigest", "files", "totalBytes", "authority", "packageDigest"],
  "properties": {
    "schema": { "const": "axm.capability-candidate-package/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "version": { "const": "v0.1" },
    "status": { "const": "EXPERIMENTAL" },
    "capabilityKind": { "enum": ["HAND", "SKILL"] },
    "requestDigest": { "$ref": "#/$defs/digest" },
    "catalogDigest": { "$ref": "#/$defs/digest" },
    "recipeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "builderId", "builderDigest", "capabilityKind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "digest": { "$ref": "#/$defs/digest" },
        "builderId": { "enum": ["bounded-review-procedure-skill-v1", "closed-json-schema-validator-v1", "pure-json-transform-v1", "svg-status-badge-v1", "workshop-direction-adapter-v1"] },
        "builderDigest": { "$ref": "#/$defs/digest" },
        "capabilityKind": { "enum": ["HAND", "SKILL"] }
      }
    },
    "variantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "compilationDigest": { "$ref": "#/$defs/digest" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "digest"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240 },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "totalBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "authority": { "$ref": "#/$defs/authority" },
    "packageDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installed", "registered", "staged", "promoted", "canonChanged", "permissionsChanged"],
      "properties": {
        "installed": { "const": false },
        "registered": { "const": false },
        "staged": { "const": false },
        "promoted": { "const": false },
        "canonChanged": { "const": false },
        "permissionsChanged": { "const": false }
      }
    }
  }
}
