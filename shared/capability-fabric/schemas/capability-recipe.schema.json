{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.capability-recipe/v1",
  "title": "AXM deterministic capability recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "title", "summary", "family", "capabilityKind", "capabilityContract", "builderId", "activation", "reviewPolicy", "candidatePolicy", "parameterSpec", "exampleRequest", "boundaries", "verifiers", "recipeDigest"],
  "properties": {
    "schema": { "const": "axm.capability-recipe/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "family": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "capabilityKind": { "enum": ["HAND", "SKILL"] },
    "capabilityContract": { "$ref": "modular-capability-recipe-contract.schema.json" },
    "builderId": { "enum": ["pure-json-transform-v1", "svg-status-badge-v1", "workshop-direction-adapter-v1"] },
    "activation": { "const": "ACTIVE_SOURCE_REVIEWED" },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation", "sharedUseRequires", "canonAuthority"],
      "properties": {
        "activation": { "const": "source-review-and-merge" },
        "sharedUseRequires": { "const": "MIKE_TOBI_MERGE" },
        "canonAuthority": { "const": "NONE" }
      }
    },
    "candidatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultCount", "defaultVariantId", "variants"],
      "properties": {
        "defaultCount": { "const": 1 },
        "defaultVariantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "parameterOverrides"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "parameterOverrides": { "type": "object" }
            }
          }
        }
      }
    },
    "parameterSpec": { "type": "object" },
    "exampleRequest": { "type": "object" },
    "boundaries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "verifiers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "recipeDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
