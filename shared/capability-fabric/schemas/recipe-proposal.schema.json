{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.capability-recipe-proposal/v1",
  "title": "AXM inactive capability recipe proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceKind", "recipe", "proposalDigest"],
  "properties": {
    "schema": { "const": "axm.capability-recipe-proposal/v1" },
    "sourceKind": { "enum": ["HUMAN", "CODEX", "MIRROR", "CODE_FABRIC", "EXTERNAL", "AI"] },
    "recipe": { "$ref": "recipe-draft.schema.json" },
    "proposalDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
