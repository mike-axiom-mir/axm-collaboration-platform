{
  "contract_version": "0.1.0",
  "module_id": "axm.verify.human-review-receipt",
  "purpose": "Record exactly what a human inspected, on which native surface, with what scope, limitations, decision, dissent, and bounded authority.",
  "inputs": {
    "review": "bounded human inspection record"
  },
  "outputs": {
    "receipt": "canonical human-review evidence and digest"
  },
  "refusals": [
    "missing artifact digest",
    "unknown decision",
    "invalid timestamp",
    "empty inspected scope or authority scope"
  ],
  "non_authority": [
    "does_not release artifacts",
    "does_not replace technical proof",
    "does_not grant new authority",
    "does_not_promote_canon"
  ],
  "dependencies": "Python standard library only"
}
