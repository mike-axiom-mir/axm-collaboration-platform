{
  "contract_version": "0.1.0",
  "module_id": "axm.verify.leakage-contamination-detector",
  "purpose": "Detect exact identifiers, byte duplicates, normalized text reuse, declared or patterned hints, and exact output/evaluation overlap on supplied benchmark materials.",
  "inputs": {
    "training_items": "known training or prior-exposure items",
    "evaluation_items": "benchmark items",
    "output_items": "optional produced outputs",
    "hint_patterns": "explicit hint strings to inspect"
  },
  "outputs": {
    "detection_report": "typed overlap and hint findings, checked surfaces, unresolved contamination boundaries"
  },
  "refusals": [
    "non-sequence item sets",
    "duplicate or empty identifiers",
    "non-text and non-byte content",
    "empty hint pattern"
  ],
  "non_authority": [
    "does_not_access hidden training corpus",
    "does_not_exclude semantic contamination",
    "does_not prove dataset completeness",
    "does_not_promote_canon"
  ],
  "dependencies": "Python standard library only"
}
