{
  "contract_version": "0.1.0",
  "module_id": "axm.verify.metric-gaming-warning",
  "purpose": "Warn when proxy gaps, metric concentration, missing guardrails, threshold cliffs, or unbounded high-pressure optimization could detach a metric from the human goal.",
  "inputs": {
    "goal": "human or system objective",
    "metrics": "proxy declarations and optimization properties",
    "guardrails": "separate protected outcomes",
    "optimization_pressure": "LOW, MEDIUM, or HIGH"
  },
  "outputs": {
    "warning_report": "typed Goodhart risks, review level, guardrails, and explicit non-observation boundary"
  },
  "refusals": [
    "empty goal",
    "missing or malformed metrics",
    "duplicate names",
    "invalid weights",
    "invalid guardrails",
    "invalid optimization pressure"
  ],
  "non_authority": [
    "does_not_observe actual gaming",
    "does_not prove goal quality",
    "does_not replace human review",
    "does_not_promote_canon"
  ],
  "dependencies": "Python standard library only"
}
