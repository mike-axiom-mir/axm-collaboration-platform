{
  "contract_version": "0.1.0",
  "module_id": "axm.verify.benchmark-contract-builder",
  "purpose": "Build a deterministic benchmark contract that limits tasks, metrics, environment, exclusions, stopping rules, and valid conclusions.",
  "inputs": {
    "goal": "evaluation question",
    "population": "target population",
    "tasks": "named tasks",
    "metrics": "directional metric contracts",
    "environment": "declared benchmark setup",
    "exclusions": "out-of-scope conditions",
    "stopping_rules": "bounded completion rules",
    "valid_conclusions": "claims the benchmark may support"
  },
  "outputs": {
    "benchmark_contract": "stable contract identity and explicit evaluation boundaries"
  },
  "refusals": [
    "empty goal or population",
    "empty or duplicate tasks",
    "missing or malformed metrics",
    "missing environment",
    "non-deterministic JSON"
  ],
  "non_authority": [
    "does_not_run_benchmark",
    "does_not_choose_claim_truth",
    "does_not_create_universal_score",
    "does_not_promote_canon"
  ],
  "dependencies": "Python standard library only"
}
