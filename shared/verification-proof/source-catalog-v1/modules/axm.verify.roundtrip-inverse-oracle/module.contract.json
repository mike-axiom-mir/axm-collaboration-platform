{
  "contract_version": "0.1.0",
  "module_id": "axm.verify.roundtrip-inverse-oracle",
  "purpose": "Compare original and restored observations under explicit exact, canonical, selected-path, or numeric equivalence profiles.",
  "inputs": {
    "case_id": "round-trip identity",
    "original": "pre-forward observation",
    "restored": "post-inverse observation",
    "profile": "declared equivalence profile"
  },
  "outputs": {
    "roundtrip_receipt": "PASS or FAIL plus compared paths"
  },
  "profiles": [
    "EXACT",
    "CANONICAL_JSON",
    "SELECTED_PATHS",
    "NUMERIC_TOLERANCE"
  ],
  "refusals": [
    "unsupported_profile",
    "missing_selected_paths",
    "invalid_tolerance",
    "invalid_json_pointer"
  ],
  "non_authority": [
    "does_not_execute_forward_or_inverse",
    "equivalence_is_profile_bounded",
    "does_not_prove_intermediate_safety",
    "does_not_promote_canon"
  ],
  "dependencies": "Python standard library only"
}
