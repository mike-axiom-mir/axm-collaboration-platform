{
  "contract_version": "0.1.0",
  "module_id": "axm.verify.long-term-proof-migrator",
  "purpose": "Bind supplied original and migrated proof bytes to a checked schema-migration lineage while preserving both byte streams.",
  "inputs": {
    "original_bytes": "exact original proof bytes",
    "migrated_bytes": "exact target bytes",
    "source_schema": "starting schema identifier",
    "target_schema": "ending schema identifier",
    "steps": "ordered declared migration receipts"
  },
  "outputs": {
    "migration_packet": "preserved bytes, hashes, checked lineage, and explicit proof limits"
  },
  "refusals": [
    "non-byte content",
    "same or empty schemas",
    "empty or malformed lineage",
    "duplicate step id",
    "broken schema or digest chain",
    "final target binding mismatch"
  ],
  "non_authority": [
    "does_not_execute_migration_tools",
    "does_not_revalidate_old_signatures",
    "does_not_delete_original_bytes",
    "does_not_promote_canon"
  ],
  "dependencies": "Python standard library only"
}
