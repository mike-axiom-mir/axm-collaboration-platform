{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/controller-profile-v1.json",
  "title": "AXM controller profile v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "profileId", "vectors", "buttons", "intent"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string" },
    "sendIntervalMs": { "type": "integer", "minimum": 20, "maximum": 1000 },
    "vectors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["xField", "yField"],
        "properties": {
          "xField": { "type": "string" },
          "yField": { "type": "string" },
          "activeField": { "type": ["string", "null"] },
          "retainOnInactive": { "type": "boolean" }
        }
      }
    },
    "buttons": { "type": "object", "additionalProperties": { "type": "string" } },
    "releaseActions": { "type": "object", "additionalProperties": { "type": "string" } },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } },
    "intent": {
      "type": "object",
      "required": ["vectorPairs", "booleanFields", "pulseFields"],
      "properties": {
        "vectorPairs": { "type": "array", "minItems": 1 },
        "booleanFields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "pulseFields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
