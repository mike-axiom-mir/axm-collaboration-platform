{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/semantic-input-packet-v1.json",
  "title": "AXM semantic input packet v1",
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": {
    "inputSourceBindingId": ["inputSourceEpoch"],
    "inputSourceEpoch": ["inputSourceBindingId"]
  },
  "required": ["roomCode", "sessionId", "seatId", "token", "seq", "input"],
  "properties": {
    "roomCode": { "type": "string", "minLength": 1, "maxLength": 160 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "seatId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "token": { "type": "string", "minLength": 1, "maxLength": 160 },
    "inputSourceBindingId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "inputSourceEpoch": { "type": "integer", "minimum": 0 },
    "seq": { "type": "integer", "minimum": 0 },
    "input": {
      "type": "object",
      "description": "Allowlisted and sanitized by the target game's selected controller profile."
    }
  }
}
