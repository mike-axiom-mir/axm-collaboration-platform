{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.grounded-growth-stewardship-frontier-receipt/v1",
  "title": "AXM Grounded Growth AI and human stewardship frontier receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "stewardshipFrontierId", "generatedAt", "status",
    "scope", "sourceRefs", "counts", "lanes", "balance", "decision", "truth",
    "stewardshipFrontierDigest"
  ],
  "properties": {
    "schema": {"const": "axm.grounded-growth-stewardship-frontier-receipt/v1"},
    "version": {"const": "0.1.0"},
    "stewardshipFrontierId": {"type": "string", "minLength": 1, "maxLength": 180},
    "generatedAt": {"type": "string", "format": "date-time"},
    "status": {"const": "TEST"},
    "scope": {"const": "CURRENT_GROUNDED_GROWTH_AI_AND_HUMAN_STEWARDSHIP_INPUTS"},
    "sourceRefs": {"type": "object"},
    "counts": {"type": "object"},
    "lanes": {"type": "array", "minItems": 5, "maxItems": 5},
    "balance": {"type": "object"},
    "decision": {"type": "object"},
    "truth": {"type": "object"},
    "stewardshipFrontierDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
