      "initial-and-reloaded-review-item-mismatch",
      "direct-review-service-import-or-review-state-write",
      "automatic-review-inbox-submission",
      "network-or-api-invocation",
      "declared-host-route-as-host-mutation-authorization-proof",
      "receiver-reload-presentation-as-independent-process-or-persistence-proof",
      "pending-item-as-vote-review-approval-or-authenticated-human",
      "review-approval-as-held-observation-resolution",
      "review-approval-as-execution-adoption-promotion-merge-or-canon-authority",
      "receiver-state-as-file-fsync-directory-entry-hardware-external-or-protected-durability",
      "configured-path-full-audit-input-vote-note-identity-model-output-or-private-context-persistence",
      "artifact-over-1-MiB-request-over-2-MiB-handoff-over-4-MiB-or-input-over-declared-bound",
      "automatic-permission-grant",
      "automatic-training",
      "automatic-install",
      "automatic-promotion",
      "automatic-merge",
      "automatic-canon",
      "foundation-mutation"
    ]
  },
  "lifecycle":{
    "state_owner":"none",
    "state_owner_detail":"request and handoff rebuild from exact caller packages; Review Inbox state remains owned by its host-authorized service",
    "reload":"not-applicable",
    "reload_detail":"the bridge owns no state; each request or handoff rebuilds from exact caller receipts and does not read Review Inbox state itself",
    "disconnect":"not-applicable",
    "disconnect_detail":"the runtime opens no socket network API or provider",
    "cleanup":"not-applicable",
    "cleanup_detail":"the runtime owns no cleanup target; synthetic ReviewService compatibility state is created and removed only by the focused test harness",
    "installed":false,
