{
  "schema": "axm.shared-service-contract/v1",
  "id": "visual-actions",
  "version": "1.0.0",
  "status": "TEST",
  "provides": [
    "host-neutral-visual-action-schema",
    "deterministic-command-search-and-ranking",
    "core-advanced-specialist-progressive-disclosure",
    "platform-aware-trigger-labels",
    "capability-and-handler-gating",
    "binding-conflict-detection",
    "named-handler-dispatch"
  ],
  "accepts": [
    "axm.visual-action/v1",
    "host:named-handler-inventory",
    "host:declared-capabilities",
    "host:active-contexts"
  ],
  "produces": [
    "validated-visual-action-catalog",
    "ranked-contextual-action-results",
    "named-handler-dispatch-result",
    "binding-conflict-report"
  ],
  "boundaries": {
    "automaticWrites": [],
    "refuses": [
      "arbitrary-code-execution",
      "implicit-native-application-control",
      "invented-handler-availability",
      "silent-destructive-action",
      "shortcut-binding-as-runtime-proof"
    ]
  }
}
