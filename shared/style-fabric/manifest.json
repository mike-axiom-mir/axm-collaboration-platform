{
  "id": "axm.style-fabric",
  "name": "AXM Style Fabric",
  "version": "0.6.0",
  "status": "WORKING_TEST",
  "canon": false,
  "integrated": false,
  "runtimeProof": "STANDALONE_ONLY",
  "description": "A modular, engine-neutral system for creating, fusing, validating, treating, previewing, layering, sharing, and explicitly applying presentation-only game and character skins.",
  "signature": "Mike - Axiom/mir",
  "entrypoints": {
    "human": "studio/index.html",
    "machine": "contracts/ai-style-intent.schema.json",
    "preskins": "preskin-catalog.json",
    "molds": "mold-kit-catalog.json",
    "skinMoldSchema": "contracts/skin-mold.schema.json",
    "treatmentMoldSchema": "contracts/treatment-mold.schema.json",
    "moldFoundry": "src/core/molds.mjs",
    "treatmentForge": "src/core/treatments.mjs",
    "admission": "src/core/validator.mjs",
    "conformance": "src/core/conformance.mjs",
    "testChamber": "studio/index.html",
    "cli": "bin/axm-skin.mjs",
    "library": "src/index.mjs"
  },
  "permissions": {
    "reads": [
      "user-selected skin packs",
      "user-selected raster assets",
      "game-declared presentation slot contracts"
    ],
    "writes": [
      "user-requested downloads",
      "local browser skin library"
    ],
    "network": false,
    "gameplayAuthority": false,
    "automaticPromotion": false
  },
  "connections": {
    "current": [],
    "futureOptional": [
      "Creative Studio Asset Mode",
      "Asset Vault",
      "AXMAssets",
      "AXMRegistry",
      "Game Hub",
      "hosted share provider"
    ]
  },
  "releaseCapabilities": [
    "strict pack admission with integrity and raster verification",
    "exact mold-scoped deterministic generation",
    "review-only mold forge and growth",
    "exactly three deterministic Treatment Forge review drafts",
    "bounded legacy, effect-stack, and semantic-lighting material output",
    "single-use runtime proposal binding with explicit approval and rollback",
    "accessible Studio selection states"
  ],
  "truthBoundary": {
    "canChange": [
      "color",
      "material appearance",
      "typography",
      "shape hints",
      "visual effects",
      "declarative patterns",
      "geometry hints",
      "bounded declarative effect stacks",
      "semantic lighting hints",
      "raster asset references",
      "character appearance",
      "environment, structure, prop, vehicle, equipment, item, projectile, effect, and interface appearance"
    ],
    "cannotChange": [
      "gameplay state",
      "damage",
      "health",
      "physics",
      "collisions",
      "score",
      "randomness",
      "input",
      "networking",
      "permissions",
      "authoritative simulation"
    ]
  }
}
