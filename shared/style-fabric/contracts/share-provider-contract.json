{
  "type": "axm.share-provider-contract",
  "version": "1.0",
  "status": "CONTRACT_ONLY_NOT_IMPLEMENTED",
  "requiredOperations": [
    "publish",
    "fetch",
    "list",
    "report",
    "withdraw"
  ],
  "requiredProperties": [
    "separate-body-manifest",
    "explicit-publish-consent",
    "server-side-revalidation",
    "immutable-content-hash",
    "quarantine-before-listing",
    "withdrawal-receipt",
    "no-remote-url-import",
    "no-silent-local-delete"
  ],
  "authority": {
    "mayPublishValidatedPresentationData": true,
    "mayModifyLocalSourcePack": false,
    "mayGrantCanon": false,
    "mayChangeGameplay": false
  }
}
