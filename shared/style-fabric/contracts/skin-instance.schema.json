{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/contracts/skin-instance.schema.json",
  "title": "AXM Skin Instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "id", "packRefs", "overrides", "accessibility", "status"],
  "properties": {
    "type": { "const": "axm.skin-instance" },
    "version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "packRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "release", "integrity"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "release": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
          },
          "integrity": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
            ]
          }
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": { "type": "object" },
        "materials": { "type": "object" },
        "characterBlueprints": { "type": "object" },
        "accessibility": {
          "$ref": "#/$defs/instanceAccessibility"
        }
      }
    },
    "accessibility": {
      "type": "object",
      "$ref": "#/$defs/instanceAccessibility"
    },
    "status": { "enum": ["LOCAL_DRAFT", "LOCAL_SAVED"] }
  },
  "$defs": {
    "instanceAccessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reducedMotion": { "type": "boolean" },
        "highContrast": { "type": "boolean" },
        "effectScale": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
