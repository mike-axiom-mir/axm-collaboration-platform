{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/contracts/game-skin-contract.schema.json",
  "title": "AXM Game Skin Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "gameId", "gameVersion", "adapterApi", "slots"],
  "properties": {
    "type": { "const": "axm.game-skin-contract" },
    "version": { "const": "1.0" },
    "gameId": { "type": "string" },
    "gameVersion": { "type": "string" },
    "adapterApi": { "const": "axm.style-adapter.v1" },
    "rendererProfile": { "type": "string" },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "required",
          "supportedProperties",
          "protectedCues",
          "constraints",
          "fallback"
        ],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "enum": ["surface", "character-region", "ui", "fx", "audio"]
          },
          "required": { "type": "boolean" },
          "supportedProperties": {
            "type": "array",
            "items": { "type": "string" }
          },
          "protectedCues": {
            "type": "array",
            "items": { "type": "string" }
          },
          "constraints": {
            "type": "object",
            "properties": {
              "minimumOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
              "minimumContrast": { "type": "number", "minimum": 1, "maximum": 21 }
            }
          },
          "fallback": { "type": "object" },
          "adapterHints": { "type": "object" }
        }
      }
    }
  }
}
