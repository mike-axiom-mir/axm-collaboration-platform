{
  "id": "axm.style-policy.hosted-example.v1",
  "status": "EXAMPLE_NOT_ACTIVE",
  "purpose": "Stricter future public-host boundary without reducing local creation freedom",
  "maxPackBytes": 5242880,
  "maxAssets": 32,
  "maxEmbeddedAssetBytes": 2097152,
  "maxTotalEmbeddedBytes": 4194304,
  "maxImageDimension": 4096,
  "maxImagePixels": 16777216,
  "allowedAssetMimes": [
    "image/png",
    "image/jpeg",
    "image/webp"
  ],
  "allowRemoteAssets": false,
  "requireLicenseDeclaration": true,
  "requireIntegrity": true,
  "requires": [
    "quarantine",
    "server-side revalidation",
    "content moderation",
    "license review state",
    "immutable version hash",
    "withdrawal and report routes"
  ]
}
