{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/contracts/skin-mold.schema.json",
  "title": "AXM Semantic Skin Mold",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "purpose", "slots", "recommendedScopes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 240 },
    "slots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "recommendedScopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}

