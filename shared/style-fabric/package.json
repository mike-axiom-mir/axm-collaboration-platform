{
  "name": "@axm/style-fabric",
  "version": "0.5.0",
  "description": "Engine-neutral full-game skin contracts, 33-surface Test Chamber, adapter conformance harness, and creator for AXM games.",
  "type": "module",
  "private": true,
  "bin": {
    "axm-skin": "./bin/axm-skin.mjs"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "preskins:build": "node scripts/build-preskins.mjs",
    "molds:build": "node scripts/build-molds.mjs",
    "example:compile": "node bin/axm-skin.mjs compile examples/intents/neon-paper-luxe.intent.json examples/packs/neon-paper-luxe.axmskin.json",
    "example:validate": "node bin/axm-skin.mjs validate examples/packs/neon-paper-luxe.axmskin.json"
  },
  "engines": {
    "node": ">=20"
  }
}
