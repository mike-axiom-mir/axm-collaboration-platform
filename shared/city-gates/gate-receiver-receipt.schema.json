{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.gate-receiver-receipt/v1",
  "type": "object",
  "required": ["schema", "state", "planDigest", "checks", "draft", "open", "merged", "receiptDigest"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "axm.gate-receiver-receipt/v1" },
    "state": { "enum": ["PASS", "FAIL"] },
    "planDigest": { "type": "string" },
    "checks": { "type": "array" },
    "draft": { "type": "boolean" },
    "open": { "type": "boolean" },
    "merged": { "type": "boolean" },
    "receiptDigest": { "type": "string" }
  }
}
