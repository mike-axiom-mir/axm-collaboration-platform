{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.decision-consumption/v1",
  "type": "object",
  "required": ["schema", "decisionDigest", "requestDigest", "consumedAt", "oneUse", "receiptDigest"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "axm.decision-consumption/v1" },
    "decisionDigest": { "type": "string" },
    "requestDigest": { "type": "string" },
    "consumedAt": { "type": "string", "format": "date-time" },
    "oneUse": { "type": "boolean" },
    "receiptDigest": { "type": "string" }
  }
}
