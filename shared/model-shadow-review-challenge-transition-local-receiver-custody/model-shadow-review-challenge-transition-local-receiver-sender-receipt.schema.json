{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.model-shadow-review-challenge-transition-local-receiver-sender-receipt/v1",
  "title": "Model Shadow local receiver sender receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "senderReceiptId", "sentAt", "status",
    "assessmentRef", "rosterRef", "receiverPolicyRef", "receiverIdDigest",
    "envelopeFileName", "envelopeDigest", "payloadDigest", "truth", "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "axm.model-shadow-review-challenge-transition-local-receiver-sender-receipt/v1"},
    "version": {"const": "1.2.0"},
    "senderReceiptId": {"type": "string", "minLength": 1, "maxLength": 180},
    "sentAt": {"type": "string", "format": "date-time", "maxLength": 64},
    "status": {"const": "TEST"},
    "assessmentRef": {"$ref": "#/$defs/reference"},
    "rosterRef": {"$ref": "#/$defs/reference"},
    "receiverPolicyRef": {"$ref": "#/$defs/reference"},
    "receiverIdDigest": {"$ref": "#/$defs/digest"},
    "envelopeFileName": {"type": "string", "pattern": "^[a-f0-9]{64}\\.json$"},
    "envelopeDigest": {"$ref": "#/$defs/digest"},
    "payloadDigest": {"$ref": "#/$defs/digest"},
    "truth": {
      "type": "object", "additionalProperties": false,
      "required": [
        "envelopeVerifiedByExactRebuild", "assessmentVerifiedByExactRebuildBeforeWrite",
        "receiverPolicyVerifiedByExactRebuildBeforeWrite", "outboundEnvelopeExclusiveCreateCompleted",
        "outboundEnvelopeFileFsyncCompleted", "receiverReadObserved", "receiverPersistenceObserved",
        "senderReceiptAuthenticated", "actualNetworkTransportProven", "otherHostDeliveryProven",
        "independentlyOperatedReceiverProven", "executionAuthorized", "adoptionAuthorized", "automaticCanon"
      ],
      "properties": {
        "envelopeVerifiedByExactRebuild": {"const": true},
        "assessmentVerifiedByExactRebuildBeforeWrite": {"const": true},
        "receiverPolicyVerifiedByExactRebuildBeforeWrite": {"const": true},
        "outboundEnvelopeExclusiveCreateCompleted": {"const": true},
        "outboundEnvelopeFileFsyncCompleted": {"const": true},
        "receiverReadObserved": {"const": false},
        "receiverPersistenceObserved": {"const": false},
        "senderReceiptAuthenticated": {"const": false},
        "actualNetworkTransportProven": {"const": false},
        "otherHostDeliveryProven": {"const": false},
        "independentlyOperatedReceiverProven": {"const": false},
        "executionAuthorized": {"const": false},
        "adoptionAuthorized": {"const": false},
        "automaticCanon": {"const": false}
      }
    },
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
