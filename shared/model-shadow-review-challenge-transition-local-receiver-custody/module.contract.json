      "local-files-as-protected-monotonic-state-or-deletion-rollback-resistance",
      "v1.1-NO_DURABLE_RETENTION_CLAIM-as-a-durable-retention-claim",
      "explicit-confirmation-as-host-authentication",
      "caller-receiver-label-or-key-as-identity-or-organizational-authority",
      "receipt-as-human-review-provider-execution-branch-adoption-or-benefit",
      "private-key-persistence",
      "full-assessment-input-persistence-in-receiver-custody",
      "raw-model-output-or-private-context-ingestion",
      "automatic-permission-grant",
      "automatic-training",
      "automatic-install",
      "automatic-promotion",
      "automatic-merge",
      "automatic-canon",
      "foundation-mutation"
    ]
  },
  "lifecycle": {
