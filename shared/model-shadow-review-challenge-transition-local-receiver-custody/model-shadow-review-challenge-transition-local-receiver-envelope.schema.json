{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.model-shadow-review-challenge-transition-local-receiver-envelope/v1",
  "title": "Model Shadow local receiver transport envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "deliveryId", "receiverId", "sentAt", "status",
    "assessmentRef", "rosterRef", "receiverPolicyRef", "assessmentInput",
    "assessmentReceipt", "receiverPolicy", "payloadDigest", "envelopeDigest"
  ],
  "properties": {
    "schema": {"const": "axm.model-shadow-review-challenge-transition-local-receiver-envelope/v1"},
    "version": {"const": "1.2.0"},
    "deliveryId": {"type": "string", "minLength": 1, "maxLength": 180},
    "receiverId": {"type": "string", "minLength": 1, "maxLength": 120},
    "sentAt": {"type": "string", "format": "date-time", "maxLength": 64},
    "status": {"const": "TEST"},
    "assessmentRef": {"$ref": "#/$defs/assessmentReference"},
    "rosterRef": {"$ref": "#/$defs/rosterReference"},
    "receiverPolicyRef": {"$ref": "#/$defs/policyReference"},
    "assessmentInput": {"type": "object"},
    "assessmentReceipt": {
      "type": "object",
      "required": ["schema", "assessmentId", "receiptDigest"],
      "properties": {"schema": {"const": "axm.model-shadow-review-challenge-transition-declared-disclosure/v1"}}
    },
    "receiverPolicy": {
      "type": "object",
      "required": ["schema", "policyId", "policyDigest"],
      "properties": {"schema": {"const": "axm.model-shadow-review-challenge-transition-receiver-policy/v1"}}
    },
    "payloadDigest": {"$ref": "#/$defs/digest"},
    "envelopeDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "assessmentReference": {"allOf": [{"$ref": "#/$defs/reference"}, {"properties": {"schema": {"const": "axm.model-shadow-review-challenge-transition-declared-disclosure/v1"}}}]},
    "rosterReference": {"allOf": [{"$ref": "#/$defs/reference"}, {"properties": {"schema": {"const": "axm.model-shadow-review-challenge-transition-disclosure-roster/v1"}}}]},
    "policyReference": {"allOf": [{"$ref": "#/$defs/reference"}, {"properties": {"schema": {"const": "axm.model-shadow-review-challenge-transition-receiver-policy/v1"}}}]}
  }
}
