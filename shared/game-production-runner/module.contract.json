{
  "schema": "axm.module-contract/v1",
  "id": "game-production-runner-core",
  "version": "v0.1",
  "status": "EXPERIMENTAL",
  "provides": [
    "immutable-game-intent-validation",
    "exact-digest-production-package-graph-compilation",
    "explicit-serial-candidate-execution",
    "isolated-job-root-enforcement",
    "append-only-step-receipts",
    "independent-verifier-binding",
    "interruption-safe-resume",
    "candidate-only-assembly-state",
    "read-only-axm-integration-adapters"
  ],
  "consumes": [
