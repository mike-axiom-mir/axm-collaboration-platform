      "filesystem-root-job",
      "undeclared-output",
      "undeclared-network",
      "package-self-verification",
      "missing-evidence-pass",
      "silent-resume-completion",
      "automatic-installation",
      "automatic-promotion",
      "automatic-canon",
      "automatic-release",
      "unreviewed-native-execution"
    ]
