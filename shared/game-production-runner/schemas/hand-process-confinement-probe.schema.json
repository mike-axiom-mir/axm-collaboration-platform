{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.hand-process-confinement-probe/v1",
  "type": "object",
  "required": ["schema", "status", "observed_at", "digest"],
  "properties": {
    "schema": { "const": "axm.hand-process-confinement-probe/v1" },
    "status": { "enum": ["NOT_PROBED", "READY_WITH_LIMITS", "DEGRADED", "UNAVAILABLE"] },
    "observed_at": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "execution_authority": { "const": false },
    "trusted_hand_activation": { "enum": ["HOLD", "ELIGIBLE_FOR_SEPARATE_EXPLICIT_GATE"] },
    "untrusted_code_sandbox": { "const": false },
    "installation_performed": { "const": false },
    "runtime": { "type": "object" },
    "checks": { "type": "array", "minItems": 1 },
    "cleanup": { "type": "object" },
    "activation": { "type": "object" },
    "proof_scope": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "minItems": 1 },
    "authority": { "type": "object" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "NOT_PROBED" } } },
      "then": {
        "required": ["reason", "execution_authority", "trusted_hand_activation", "untrusted_code_sandbox", "installation_performed"]
      },
      "else": {
        "required": ["runtime", "checks", "cleanup", "activation", "proof_scope", "limitations", "authority"]
      }
    }
  ],
  "additionalProperties": false
}
