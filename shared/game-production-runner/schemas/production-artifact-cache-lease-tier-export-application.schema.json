{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.production-artifact-cache-lease-tier-export-application/v1",
  "type": "object",
  "required": ["schema", "version", "proposal_digest", "approved_digest", "status", "explicit", "recorded_at_ms", "tier_root_fingerprint", "outcomes", "packages_written", "payload_files_written", "source_files_removed", "authority", "digest"],
  "properties": {
    "schema": { "const": "axm.production-artifact-cache-lease-tier-export-application/v1" },
    "version": { "const": "0.1.0" },
    "proposal_digest": { "type": "string" },
    "approved_digest": { "type": ["string", "null"] },
    "status": { "enum": ["NOT_REQUESTED", "NOT_APPROVED", "APPROVAL_MISMATCH", "PROPOSAL_NOT_APPLICABLE", "STALE", "TIER_REVIEW_REQUIRED", "PARTIAL", "APPLIED"] },
    "explicit": { "type": "boolean" },
    "recorded_at_ms": { "type": "integer", "minimum": 0 },
    "tier_root_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "outcomes": { "type": "array" },
    "packages_written": { "type": "integer", "minimum": 0 },
    "payload_files_written": { "type": "integer", "minimum": 0 },
    "source_files_removed": { "const": 0 },
    "authority": { "type": "object" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
