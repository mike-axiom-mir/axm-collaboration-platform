{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.production-intent-lock/v1",
  "type": "object",
  "required": ["schema", "id", "version", "status", "human_goal", "target", "required_features", "forbidden_substitutions", "constraints", "change_policy", "digest"],
  "properties": {
    "schema": { "const": "axm.production-intent-lock/v1" },
    "id": { "type": "string" },
    "version": { "type": "string" },
    "status": { "const": "LOCKED" },
    "human_goal": { "type": "string", "minLength": 1 },
    "target": { "type": "object", "required": ["domain", "profile"] },
    "required_features": { "type": "array", "minItems": 1 },
    "forbidden_substitutions": { "type": "array" },
    "constraints": { "type": "object" },
    "change_policy": { "type": "object" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
