{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.production-artifact-cache-lease-curation-application/v1",
  "type": "object",
  "required": ["schema", "version", "proposal_digest", "approved_digest", "status", "explicit", "recorded_at_ms", "before_lease_snapshot_digest", "after_lease_snapshot_digest", "outcomes", "usage_after", "authority", "digest"],
  "properties": {
    "schema": { "const": "axm.production-artifact-cache-lease-curation-application/v1" },
    "version": { "const": "0.1.0" },
    "proposal_digest": { "type": "string" },
    "approved_digest": { "type": ["string", "null"] },
    "status": { "enum": ["NOT_REQUESTED", "NOT_APPROVED", "APPROVAL_MISMATCH", "PROPOSAL_NOT_APPLICABLE", "COORDINATION_BUSY", "STALE", "PARTIAL", "APPLIED"] },
    "explicit": { "type": "boolean" },
    "recorded_at_ms": { "type": "integer", "minimum": 0 },
    "before_lease_snapshot_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "after_lease_snapshot_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "outcomes": { "type": "array" },
    "usage_after": { "type": ["object", "null"] },
    "authority": { "type": "object" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
