{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.game-production-package/v1",
  "type": "object",
  "required": ["schema", "id", "version", "title", "dependencies", "inputs", "outputs", "executor", "verifier", "claims", "sandbox", "resource_budget", "repair_policy", "authority", "digest"],
  "properties": {
    "schema": { "const": "axm.game-production-package/v1" },
    "id": { "type": "string" },
    "version": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "uniqueItems": true },
    "inputs": { "type": "array" },
    "outputs": { "type": "array", "minItems": 1 },
    "executor": { "type": "object", "required": ["id", "version"] },
    "verifier": { "type": "object", "required": ["id", "version"] },
    "claims": { "type": "array", "minItems": 1 },
    "sandbox": { "type": "object" },
    "resource_budget": { "type": "object" },
    "repair_policy": { "type": "object" },
    "authority": { "type": "object" },
    "fixture": { "type": "object", "description": "Inert test-only payload; never a native proof surface." },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
