{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.production-plan/v1",
  "type": "object",
  "required": ["schema", "version", "status", "domain", "intent_ref", "graph_ref", "source_anchor", "execution_order", "package_refs", "capability_gaps", "policy", "adapter_binding", "limitations", "digest"],
  "properties": {
    "schema": { "const": "axm.production-plan/v1" },
    "version": { "type": "string" },
    "status": { "enum": ["READY", "HELD"] },
    "domain": { "type": "string", "minLength": 1 },
    "intent_ref": { "type": "object" },
    "graph_ref": { "type": "object" },
    "source_anchor": { "type": "string" },
    "execution_order": { "type": "array", "minItems": 1 },
    "package_refs": { "type": "array", "minItems": 1 },
    "capability_gaps": { "type": "array" },
    "policy": { "type": "object" },
    "adapter_binding": { "$ref": "axm.production-profile-binding/v1" },
    "limitations": { "type": "array", "minItems": 1 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
