{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.grounded-growth-knowledge-frontier-receipt/v1",
  "title": "AXM Grounded Growth knowledge, AI, and human frontier receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "knowledgeFrontierId", "generatedAt", "status",
    "scope", "sourceRefs", "counts", "lanes", "knowledgeBinding", "balance",
    "decision", "truth", "knowledgeFrontierDigest"
  ],
  "properties": {
    "schema": {"const": "axm.grounded-growth-knowledge-frontier-receipt/v1"},
    "version": {"const": "0.1.0"},
    "knowledgeFrontierId": {"type": "string", "minLength": 1, "maxLength": 180},
    "generatedAt": {"type": "string", "format": "date-time"},
    "status": {"const": "TEST"},
    "scope": {"const": "CURRENT_GROUNDED_GROWTH_KNOWLEDGE_AI_AND_HUMAN_INPUTS"},
    "sourceRefs": {"type": "object"},
    "counts": {"type": "object"},
    "lanes": {"type": "array", "minItems": 6, "maxItems": 6},
    "knowledgeBinding": {"type": "object"},
    "balance": {"type": "object"},
    "decision": {"type": "object"},
    "truth": {"type": "object"},
    "knowledgeFrontierDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
