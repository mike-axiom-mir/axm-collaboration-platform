{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.deterministic-run-integration-policy/v1",
  "title": "AXM deterministic run integration policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "targetBranch", "allowedPaths"],
  "properties": {
    "schema": { "const": "axm.deterministic-run-integration-policy/v1" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "targetBranch": { "type": "string", "pattern": "^(codex|agent)/[A-Za-z0-9][A-Za-z0-9._/-]{0,180}$" },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "additionalForbiddenPaths": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "allowDeletes": { "type": "boolean", "default": false },
    "maxFiles": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "maxBytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 }
  }
}
