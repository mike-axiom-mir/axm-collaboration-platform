{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.identity-shell.body-descriptor/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "descriptorId", "descriptorVersion", "status", "bodyClass", "interfaces", "requestedPermissions", "resourceRequest", "observationBoundary", "actuationBoundary", "execution", "evidenceCeiling"],
  "properties": {
    "schema": {"const": "axm.identity-shell.body-descriptor/v1"},
    "version": {"const": "0.1.0"},
    "descriptorId": {"$ref": "common.schema.json#/$defs/id"},
    "descriptorVersion": {"$ref": "common.schema.json#/$defs/semver"},
    "status": {"const": "EXPERIMENTAL"},
    "bodyClass": {"enum": ["SOFTWARE", "GAME", "AVATAR", "ROBOTIC"]},
    "interfaces": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "direction", "schema"], "properties": {"id": {"$ref": "common.schema.json#/$defs/id"}, "direction": {"enum": ["OBSERVATION_IN", "OUTPUT_OUT"]}, "schema": {"$ref": "common.schema.json#/$defs/contract"}}}
    },
    "requestedPermissions": {"$ref": "common.schema.json#/$defs/ids"},
    "resourceRequest": {"$ref": "common.schema.json#/$defs/resourceRequest"},
    "observationBoundary": {"type": "object", "additionalProperties": false, "required": ["allowedInterfaceIds", "undeclaredObservationAllowed"], "properties": {"allowedInterfaceIds": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}}, "undeclaredObservationAllowed": {"const": false}}},
    "actuationBoundary": {"type": "object", "additionalProperties": false, "required": ["mode", "allowedInterfaceIds"], "properties": {"mode": {"const": "UNAVAILABLE_V0_1"}, "allowedInterfaceIds": {"type": "array", "maxItems": 0}}},
    "execution": {"$ref": "common.schema.json#/$defs/execution"},
    "evidenceCeiling": {"type": "string", "minLength": 1, "maxLength": 800}
  }
}
