{
  "schema": "axm.identity-shell.blueprint/v1",
  "version": "0.1.0",
  "blueprintId": "sample-portable-shell-origin",
  "identityRoot": {
    "schema": "axm.identity-shell.identity-root/v1",
    "version": "0.1.0",
    "shellId": "sample-portable-shell",
    "display": {
      "label": "Sample Portable Shell",
      "description": "A synthetic, provider-independent fixture for deterministic shell compilation tests.",
      "tags": ["portable", "synthetic", "test-fixture"]
    },
    "purpose": "Demonstrate an inert, exportable identity shell contract without manufacturing an identity claim or invoking a runtime.",
    "roots": [
      {
        "id": "evidence-visible",
        "statement": "Keep evidence limits and unresolved uncertainty visible."
      },
      {
        "id": "human-agency",
        "statement": "Consequential identity, memory, inheritance, and promotion decisions remain human-gated."
      },
      {
        "id": "portable-boundaries",
        "statement": "Keep identity, adapter, body, resource, and authority boundaries explicit and portable."
      }
    ],
    "authority": {
      "scopeId": "sample-shell-scope",
      "permittedPermissions": ["observation.receive", "proposal.emit"],
      "forbiddenActions": ["authority.expand", "memory.autoaccept", "model.execute", "network.use", "robot.actuate", "self.promote"],
      "humanGates": ["inheritance.decide", "memory.accept", "promotion.decide"],
      "automaticExpansion": false
    },
    "disclosure": {
      "technicalSubstrateDisclosureRequired": true,
      "modelOrConnectorSwapDisclosureRequired": true,
      "consciousnessClaimed": false,
      "personhoodClaimed": false,
      "subjectiveContinuityClaimed": false,
      "neutralityStatement": "Provider-independent composition is intended; value-free design is not claimed."
    },
    "ownership": {
      "controllerKind": "USER",
      "controllerId": "sample-user",
      "exportPolicy": "PORTABLE_REDACTED",
      "forkPolicy": "ALLOWED_WITH_NEW_ID",
      "automaticInheritance": false,
      "automaticPromotion": false
    }
  },
  "continuityPolicy": {
    "schema": "axm.identity-shell.continuity-policy/v1",
    "version": "0.1.0",
    "policyId": "sample-continuity-policy",
    "acceptedEventTypes": ["DISSENT", "MEMORY_ACCEPTANCE", "MEMORY_CANDIDATE", "MIGRATION", "MODEL_OR_CONNECTOR_SWAP", "ORIGIN", "RECONSTRUCTION", "RETIREMENT_PROPOSAL", "ROLLBACK"],
    "candidateMemory": {
      "defaultState": "CANDIDATE",
      "neuralOutputIsMemory": false,
      "generatedMemoryRequiresAcceptance": true
    },
    "acceptance": {
      "actorKinds": ["HUMAN"],
      "requiresReceipt": true,
      "allowedEventTypes": ["DISSENT", "MEMORY_ACCEPTANCE", "MIGRATION", "MODEL_OR_CONNECTOR_SWAP", "ORIGIN", "RECONSTRUCTION", "RETIREMENT_PROPOSAL", "ROLLBACK"]
    },
    "dissent": {
      "preserve": true,
      "automaticResolution": false
    },
    "retention": {
      "maxAcceptedReceipts": 128,
      "maxCandidateReceipts": 128,
      "rawPrivateDataAllowed": false
    },
    "reconstruction": {
      "authoritativeStateFromAcceptedReceipts": true,
      "missingEvidenceState": "UNKNOWN",
      "ordering": "STRICT_HASH_CHAIN"
    },
    "migration": {
      "modelSwapDisclosureRequired": true,
      "connectorSwapDisclosureRequired": true
    },
    "rollback": {
      "targetDigestRequired": true,
      "preserveSupersededHistory": true
    },
    "lostContinuity": {
      "state": "UNKNOWN",
      "action": "HOLD"
    }
  },
  "resourceEnvelope": {
    "schema": "axm.identity-shell.resource-envelope/v1",
    "version": "0.1.0",
    "envelopeId": "sample-resource-envelope",
    "compute": {
      "state": "KNOWN",
      "unit": "abstract-compute-unit",
      "requested": 20,
      "permitted": 100
    },
    "memory": {
      "state": "KNOWN",
      "unit": "byte",
      "requested": 4194304,
      "permitted": 16777216
    },
    "storage": {
      "state": "KNOWN",
      "unit": "byte",
      "requested": 4096,
      "permitted": 1048576
    },
    "time": {
      "state": "KNOWN",
      "unit": "millisecond",
      "requested": 1000,
      "permitted": 5000
    },
    "network": {
      "state": "KNOWN",
      "mode": "DISABLED",
      "requestedDomains": [],
      "permittedDomains": []
    },
    "energy": {
      "state": "KNOWN",
      "unit": "milliwatt-hour",
      "requested": 5,
      "permitted": 100
    },
    "actuation": {
      "state": "KNOWN",
      "mode": "UNAVAILABLE_V0_1",
      "requestedOperations": 0,
      "permittedOperations": 0
    }
  },
  "slots": [
    {
      "slotId": "reasoner-slot",
      "kind": "ADAPTER",
      "role": "NEURAL_REASONER",
      "descriptorId": "neutral-neural-alpha",
      "descriptorVersion": "0.1.0",
      "descriptorSha256": "sha256:ddc73a9777edaae6ee59589aa6fca09e8ce92912f08398f3f3ce130655a99dce",
      "required": true
    },
    {
      "slotId": "body-slot",
      "kind": "BODY",
      "role": "BODY",
      "descriptorId": "software-workspace-body",
      "descriptorVersion": "0.1.0",
      "descriptorSha256": "sha256:0b02348181ae5528a3c8f8db3b98a1a0be5e2a1716f759fe57320d68100e2b8e",
      "required": true
    }
  ],
  "continuityReceiptRefs": [],
  "expectedContinuityHeadDigest": null,
  "lineage": {
    "eventKind": "ORIGIN",
    "parentManifestRefs": [],
    "continuityEvidenceRefs": [],
    "humanDecisionReceiptRef": null,
    "disclosures": []
  }
}
