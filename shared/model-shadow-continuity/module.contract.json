      "private-context-ingestion",
      "hidden-reasoning-access",
      "free-text-semantic-equivalence",
      "same-model-mind-claim",
      "provider-invocation",
      "provider-transport",
      "drift-as-failure",
      "agreement-as-proof",
      "semantic-correctness-claim",
      "learning-improvement-claim",
      "human-benefit-claim",
      "automatic-review-submission",
      "automatic-execution",
      "automatic-write",
      "automatic-install",
      "automatic-permission-grant",
      "automatic-training",
      "automatic-promotion",
      "automatic-merge",
      "automatic-canon",
      "foundation-mutation",
      "undefined-or-non-json-representable-state"
