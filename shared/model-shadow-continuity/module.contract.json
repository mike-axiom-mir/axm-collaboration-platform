{
  "schema": "axm.module-contract/v1",
  "id": "model-shadow-continuity",
  "version": "v0.1",
  "status": "TEST",
  "provides": [
    "model.shadow.snapshot.exact-digest",
    "model.shadow.snapshot.strict-json",
    "model.shadow.task-context.exact-bind",
    "model.shadow.seat-identity.exact-bind",
    "model.shadow.forward-sequence.require",
    "model.shadow.commitment.drift-detect",
    "model.shadow.capability.drift-detect",
    "model.shadow.source-lineage.drift-visible",
    "model.shadow.permission-expansion.critical",
    "model.shadow.authority-request-expansion.critical",
    "model.shadow.boundary-loss.critical",
    "model.shadow.raw-output.not-embedded",
    "model.shadow.private-context.not-embedded",
    "model.shadow.baseline-planning-projection",
    "model.shadow.review-projection.note-free",
    "model.shadow.receipt.exact-rebuild",
    "model.shadow.receipt.tamper-detect",
    "model.shadow.model-invocation.none",
    "model.shadow.training.none",
