{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.model-shadow-two-phase-history-checkpoint-witness-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policyId", "issuedAt", "expiresAt", "audience", "scope", "authorityOrigin", "checkpointRef", "requiredSignatures", "maxAttestationAgeSeconds", "keys", "policyDigest"],
  "properties": {
    "schema": { "const": "axm.model-shadow-two-phase-history-checkpoint-witness-policy/v1" },
    "policyId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "audience": { "const": "MODEL_SHADOW_TWO_PHASE_HISTORY_CHECKPOINT_WITNESS" },
    "scope": { "const": "WITNESS_EXACT_MODEL_SHADOW_TWO_PHASE_HISTORY_CHECKPOINT" },
    "authorityOrigin": { "const": "CALLER_SUPPLIED_UNAUTHENTICATED" },
    "checkpointRef": { "$ref": "#/$defs/ref" },
    "requiredSignatures": { "type": "integer", "minimum": 1, "maximum": 10 },
    "maxAttestationAgeSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "keys": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/key" } },
    "policyDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ref": { "type": "object", "additionalProperties": false, "required": ["id", "schema", "sha256"], "properties": { "id": { "type": "string" }, "schema": { "type": "string" }, "sha256": { "$ref": "#/$defs/digest" } } },
    "key": { "type": "object", "additionalProperties": false, "required": ["keyId", "algorithm", "publicKeyPem", "actorDigest", "actorKind", "scope", "enabled"], "properties": { "keyId": { "type": "string" }, "algorithm": { "const": "Ed25519" }, "publicKeyPem": { "type": "string" }, "actorDigest": { "$ref": "#/$defs/digest" }, "actorKind": { "enum": ["human", "machine", "unknown"] }, "scope": { "const": "WITNESS_EXACT_MODEL_SHADOW_TWO_PHASE_HISTORY_CHECKPOINT" }, "enabled": { "const": true } } }
  }
}
