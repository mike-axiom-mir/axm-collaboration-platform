    "receiptId": { "type": "string" }, "verifiedAt": { "type": "string", "format": "date-time" }, "checkpointRef": { "type": "object" }, "witnessRef": { "type": "object" },
    "witnessPolicyRef": { "type": "object" }, "anchorPolicyRef": { "type": "object" }, "anchorRef": { "type": "object" }, "state": { "type": "string" },
    "separationEvidence": { "type": "object" }, "truth": { "type": "object" }, "receiptDigest": { "$ref": "#/$defs/digest" }
