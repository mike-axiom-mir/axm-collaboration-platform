{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.model-shadow-review-challenge-witness-policy/v1",
  "title": "Model Shadow review challenge checkpoint witness key policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "policyId", "issuedAt", "expiresAt", "audience", "scope",
    "authorityOrigin", "checkpointRef", "ledgerRef", "entriesDigest",
    "requiredSignatures", "maxAttestationAgeSeconds", "keys", "policyDigest"
  ],
  "properties": {
    "schema": {"const": "axm.model-shadow-review-challenge-witness-policy/v1"},
    "policyId": {"type": "string", "minLength": 1, "maxLength": 180},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "audience": {"const": "MODEL_SHADOW_REVIEW_CHALLENGE_CONTINUITY"},
    "scope": {"const": "WITNESS_EXACT_MODEL_SHADOW_REVIEW_CHALLENGE_CHECKPOINT"},
    "authorityOrigin": {"const": "CALLER_SUPPLIED_UNAUTHENTICATED"},
    "checkpointRef": {"$ref": "#/$defs/reference"},
    "ledgerRef": {"$ref": "#/$defs/reference"},
    "entriesDigest": {"$ref": "#/$defs/digest"},
    "requiredSignatures": {"type": "integer", "minimum": 1, "maximum": 10},
    "maxAttestationAgeSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "publicKeyPem", "actorDigest", "actorKind", "scope", "enabled"],
        "properties": {
          "keyId": {"type": "string", "minLength": 1, "maxLength": 180},
          "algorithm": {"const": "Ed25519"},
          "publicKeyPem": {"type": "string", "minLength": 1, "maxLength": 8192},
          "actorDigest": {"$ref": "#/$defs/digest"},
          "actorKind": {"enum": ["human", "machine", "unknown"]},
          "scope": {"const": "WITNESS_EXACT_MODEL_SHADOW_REVIEW_CHALLENGE_CHECKPOINT"},
          "enabled": {"const": true}
        }
      }
    },
    "policyDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
