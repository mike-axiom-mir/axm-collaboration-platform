{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"axm.model-shadow-retention-audit-review-outcome-ledger-snapshot/v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema","version","status","ledgerId","mode","manifestRef","recordCount","approvedCount","holdCount",
    "rejectedCount","latestRecordRef","latestOutcomeRef","latestClassification","aggregateStorageBytes","truth","snapshotDigest"
  ],
  "properties":{
    "schema":{"const":"axm.model-shadow-retention-audit-review-outcome-ledger-snapshot/v1"},
    "version":{"const":"3.2.0"},
    "status":{"const":"TEST"},
    "ledgerId":{"type":"string","minLength":1,"maxLength":180},
    "mode":{"const":"CALLER_OWNED_LOCAL_REVIEW_OUTCOME_CONTINUITY_UNAUTHENTICATED"},
    "manifestRef":{"$ref":"#/$defs/reference"},
    "recordCount":{"type":"integer","minimum":0,"maximum":10000},
    "approvedCount":{"type":"integer","minimum":0,"maximum":10000},
    "holdCount":{"type":"integer","minimum":0,"maximum":10000},
    "rejectedCount":{"type":"integer","minimum":0,"maximum":10000},
    "latestRecordRef":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/reference"}]},
    "latestOutcomeRef":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/reference"}]},
    "latestClassification":{"anyOf":[
      {"type":"null"},
      {"enum":[
        "APPROVED_OUTCOME_PRESERVED_RETENTION_HOLD_UNRESOLVED",
        "HOLD_OUTCOME_PRESERVED_RETENTION_HOLD_UNRESOLVED",
        "REJECTED_OUTCOME_PRESERVED_RETENTION_HOLD_UNRESOLVED"
      ]}
    ]},
    "aggregateStorageBytes":{"type":"integer","minimum":0,"maximum":268435456},
    "truth":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "manifestReloaded","completeRecordChainValidated","fullMinimizedV31OutcomesReloadedWithoutCaptureInputs",
        "upstreamPresentationRequiredForReload","actorDigestProvenanceReverifiedOnReload",
        "currentReviewInboxStateContinuouslyObserved","callerOwnedLocalLedgerRoot",
        "directoryEntryOrHardwareDurabilityProven","externalRetentionProven","protectedMonotonicStateProven",
        "deletionOrRollbackPrevented","localControllerFullRewriteExcluded","jointUpstreamAndLedgerLossExcluded",
        "hostAuthorizationAuthenticated","actorRealWorldIdentityProven","actualHumanParticipationProven",
        "holdResolved","providerInvoked","evaluationPerformed","executionAuthorized","adoptionAuthorized",
        "humanBenefitProven","broadLearningClaimed","autonomousActionCount","automaticPromotion","automaticMerge",
        "automaticCanon","foundationMutation"
      ],
      "properties":{
        "manifestReloaded":{"const":true},
        "completeRecordChainValidated":{"const":true},
        "fullMinimizedV31OutcomesReloadedWithoutCaptureInputs":{"const":true},
        "upstreamPresentationRequiredForReload":{"const":false},
        "actorDigestProvenanceReverifiedOnReload":{"const":false},
        "currentReviewInboxStateContinuouslyObserved":{"const":false},
        "callerOwnedLocalLedgerRoot":{"const":true},
        "directoryEntryOrHardwareDurabilityProven":{"const":false},
        "externalRetentionProven":{"const":false},
        "protectedMonotonicStateProven":{"const":false},
        "deletionOrRollbackPrevented":{"const":false},
        "localControllerFullRewriteExcluded":{"const":false},
        "jointUpstreamAndLedgerLossExcluded":{"const":false},
        "hostAuthorizationAuthenticated":{"const":false},
        "actorRealWorldIdentityProven":{"const":false},
        "actualHumanParticipationProven":{"const":false},
        "holdResolved":{"const":false},
        "providerInvoked":{"const":false},
        "evaluationPerformed":{"const":false},
        "executionAuthorized":{"const":false},
        "adoptionAuthorized":{"const":false},
        "humanBenefitProven":{"const":false},
        "broadLearningClaimed":{"const":false},
        "autonomousActionCount":{"const":0},
        "automaticPromotion":{"const":false},
        "automaticMerge":{"const":false},
        "automaticCanon":{"const":false},
        "foundationMutation":{"const":false}
      }
    },
    "snapshotDigest":{"$ref":"#/$defs/digest"}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "reference":{
      "type":"object",
      "additionalProperties":false,
      "required":["id","schema","sha256"],
      "properties":{
        "id":{"type":"string","minLength":1,"maxLength":180},
        "schema":{"type":"string","minLength":1,"maxLength":180},
        "sha256":{"$ref":"#/$defs/digest"}
      }
    }
  }
}
