{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.route-instance/v1",
  "type": "object",
  "required": ["schema", "id", "routeDigest", "planDigest", "profileDigest", "startedAt", "states", "attemptBudgets", "receipts", "previousStateDigest", "stateDigest", "executesSteps"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "axm.route-instance/v1" },
    "id": { "type": "string" },
    "routeDigest": { "type": "string" },
    "planDigest": { "type": "string" },
    "profileDigest": { "type": ["string", "null"] },
    "startedAt": { "type": "string" },
    "states": { "type": "object" },
    "attemptBudgets": { "type": "object" },
    "receipts": { "type": "array" },
    "previousStateDigest": { "type": ["string", "null"] },
    "stateDigest": { "type": "string" },
    "executesSteps": { "const": false }
  }
}
