{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.model-shadow-review-challenge-transition-local-possession-checkpoint-two-phase-settlement-ledger-manifest/v1",
  "title": "AXM local-possession two-phase settlement ledger manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "logId", "genesisSeparatedWitnessRef", "receiverIdDigest", "challengerIdDigest", "receiverPolicyRef", "authorityOrigin", "storageMode", "manifestDigest"],
  "properties": {
    "schema": { "const": "axm.model-shadow-review-challenge-transition-local-possession-checkpoint-two-phase-settlement-ledger-manifest/v1" },
    "version": { "const": "2.0.0" },
    "status": { "const": "TEST" },
    "logId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "genesisSeparatedWitnessRef": { "$ref": "#/$defs/reference" },
    "receiverIdDigest": { "$ref": "#/$defs/digest" },
    "challengerIdDigest": { "$ref": "#/$defs/digest" },
    "receiverPolicyRef": { "$ref": "#/$defs/reference" },
    "authorityOrigin": { "const": "CALLER_STATE_ROOT_AND_CONFIRMATIONS_UNAUTHENTICATED" },
    "storageMode": { "const": "PREWRITE_MATCHED_PROPOSAL_THEN_POSTWRITE_RECAPTURED_EXCLUSIVE_SETTLEMENT" },
    "manifestDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reference": { "type": "object", "additionalProperties": false, "required": ["id", "schema", "sha256"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 180 }, "schema": { "type": "string", "minLength": 1, "maxLength": 180 }, "sha256": { "$ref": "#/$defs/digest" } } }
  }
}
