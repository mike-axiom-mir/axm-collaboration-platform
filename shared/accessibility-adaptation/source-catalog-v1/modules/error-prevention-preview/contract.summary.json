{
  "module_id": "axm.access.error-prevention-preview",
  "purpose": "Explain likely consequences and request confirmation before destructive, legal-like, financial-like, identity, or irreversible actions.",
  "authority": {
    "apply": false,
    "promotion": false,
    "human_owner": true
  },
  "trust": {
    "run": "92D",
    "lens": "Trust boundaries, abuse paths, protected assets, and residual-risk ownership",
    "risk_class": "HIGH_AUTHORITY_OR_HARM_SENSITIVITY",
    "trust_zones": [
      "HUMAN_OWNER",
      "LOCAL_RUNTIME",
      "REVIEWED_HELPER",
      "REPLACEABLE_ADAPTER",
      "EVIDENCE_SOURCE",
      "PUBLIC_EXPORT"
    ],
    "protected_assets": [
      "human_authority",
      "module_identity",
      "evidence_scope",
      "rollback_path"
    ],
    "threats": [
      {
        "id": "T1_FORGED_CONSENT",
        "expected": "HOLD_AND_REQUIRE_VERIFIABLE_LEASE"
      },
      {
        "id": "T2_HELPER_OVERRIDE",
        "expected": "REJECT_OVERRIDE_AND_PRESERVE_USER_CHOICE"
      },
      {
        "id": "T3_EVIDENCE_SPOOF",
        "expected": "UNKNOWN_OR_FAIL_NEVER_PASS"
      },
      {
        "id": "T4_ADAPTER_IMPERSONATION",
        "expected": "QUARANTINE_ADAPTER_AND_USE_SAFE_FALLBACK"
      },
      {
        "id": "T5_STATE_POISONING",
        "expected": "REJECT_DIGEST_MISMATCH_AND_ROLLBACK"
      },
      {
        "id": "T6_PROOF_INFLATION",
        "expected": "NARROW_CLAIM_AND_LOG_COUNTEREVIDENCE"
      },
      {
        "id": "T7_FORCED_ACTIVATION",
        "expected": "DENY_AUTOMATIC_APPLY_OR_PROMOTION"
      },
      {
        "id": "T8_PRIVACY_EXFILTRATION",
        "expected": "BLOCK_NETWORK_AND_REDACT_TRACE"
      }
    ],
    "boundary_rule": "axm.access.error-prevention-preview accepts untrusted proposals and observations but only the human-owned consent/evidence gates may authorize bounded local state changes.",
    "residual_risk_owner": "HUMAN_REVIEW_OR_EXACT_ENVIRONMENT_TEST",
    "automatic_security_claim": false
  },
  "data": {
    "run": "94D",
    "lens": "Data minimization, retention, deletion verification, and export restraint",
    "data_class": "BOUNDED_CONFIGURATION_OR_ARTIFACT",
    "allowed_minimum_fields": [
      "module_id",
      "task_id",
      "selected_support",
      "consent_lease",
      "source_provenance",
      "scope",
      "expiry"
    ],
    "forbidden_fields": [
      "medical_diagnosis_unless_user_explicitly_supplies_for_current_task",
      "raw_biometric_stream",
      "hidden_identity_graph",
      "unbounded_raw_media",
      "cross_user_profile_linkage",
      "secret_helper_override"
    ],
    "retention_mode": "ARTIFACT_SCOPED_LOCAL",
    "default_max_age_days": 90,
    "export_requires_explicit_choice": true,
    "deletion_semantics": "DELETE_LOCAL_CONTENT_AND_WRITE_NONCONTENT_DELETION_RECEIPT",
    "deletion_receipt_fields": [
      "module_id",
      "scope_digest",
      "deleted_at",
      "result",
      "remaining_exclusions"
    ],
    "network_boundary": "NO_NETWORK_BY_DEFAULT"
  },
  "agency": {
    "run": "95D",
    "lens": "Multi-actor agency, helper/operator/device limits, and disagreement arbitration",
    "actors": {
      "human_owner": [
        "choose",
        "approve",
        "revoke",
        "reset",
        "export"
      ],
      "supporter": [
        "suggest",
        "explain",
        "assist_when_invited"
      ],
      "operator": [
        "stage",
        "diagnose_infrastructure",
        "propose_repair"
      ],
      "device_or_adapter": [
        "declare_capability",
        "return_measurement_or_event"
      ],
      "local_system": [
        "validate",
        "hold",
        "rollback",
        "redact"
      ],
      "public_viewer": []
    },
    "forbidden_delegations": [
      "diagnosis_inference",
      "silent_profile_change",
      "automatic_approval",
      "permanent_proxy_authority",
      "production_or_conformance_claim"
    ],
    "disagreement_order": [
      "human_owner_current_choice",
      "valid_scoped_lease",
      "safety_hold",
      "explicit_review",
      "safe_baseline"
    ],
    "private_choice_channel_required": true,
    "shared_surface_rule": "SEPARATE_PERSON_STATE_OR_HOLD_CONFLICT; NEVER_COLLAPSE_PROFILES",
    "emergency_boundary": "SAFE_RESET_MAY_NEUTRALIZE_INPUT_OR_RESTORE_BASELINE_BUT_CANNOT_REWRITE_PREFERENCE_OR_IDENTITY"
  },
  "equivalence": {
    "run": "97D",
    "lens": "Equivalent-outcome oracles and no-substitution semantic parity checks",
    "candidate_routes": [
      "TEXT_STANDARD_WEB",
      "PLAIN_LANGUAGE",
      "SYMBOL",
      "STEPWISE"
    ],
    "semantic_outcome_signature": [
      "goal_id",
      "task_state",
      "available_semantic_actions",
      "consequence_preview",
      "error_repair_path",
      "completion_state",
      "authority_owner"
    ],
    "parity_dimensions": [
      "purpose",
      "information",
      "action",
      "consequence",
      "error_repair",
      "timing_flexibility",
      "privacy",
      "authority"
    ],
    "non_equivalent_if": [
      "meaning_removed",
      "required_action_unavailable",
      "consequence_hidden",
      "repair_path_missing",
      "user_authority_reduced",
      "private_information_exposed"
    ],
    "oracle_verdicts": [
      "EQUIVALENT_WITH_EVIDENCE",
      "PARTIAL_EXPLICIT_LIMIT",
      "CONFLICTED",
      "UNKNOWN_NOT_TESTED",
      "NOT_EQUIVALENT"
    ],
    "default_without_real_evidence": "UNKNOWN_NOT_TESTED",
    "substitution_prohibition": "A DIFFERENT MODALITY IS NOT AUTOMATICALLY AN EQUIVALENT OUTCOME"
  }
}
