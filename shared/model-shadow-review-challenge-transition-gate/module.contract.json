  "boundaries": {
    "reads": [],
    "writes": [],
    "refuses": [
      "invalid-previous-or-candidate-separated-chain",
      "pairwise-comparison-as-global-fork-exclusion",
      "pairwise-comparison-as-observation-of-withheld-branches",
      "pairwise-extension-as-globally-unique-transition",
      "self-declared-anchor-epoch-as-protected-monotonic-state",
      "caller-time-as-trusted-time",
      "presented-chain-as-proven-external-retention",
      "pairwise-hold-as-deletion-or-rollback-prevention",
