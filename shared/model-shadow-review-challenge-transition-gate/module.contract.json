{
  "schema": "axm.module-contract/v1",
  "id": "model-shadow-review-challenge-transition-gate",
  "version": "v0.7",
  "status": "TEST",
  "provides": [
    "model.shadow.review.challenge-separated-witness-exact-rebuild",
    "model.shadow.review.challenge-pairwise-exact-replay-classification",
    "model.shadow.review.challenge-pairwise-forward-extension-classification",
    "model.shadow.review.challenge-pairwise-anchor-identity-drift-detection",
    "model.shadow.review.challenge-pairwise-anchor-epoch-rollback-detection",
