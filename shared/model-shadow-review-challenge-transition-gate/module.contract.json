      "observable-signer-separation-as-collusion-exclusion",
      "caller-presented-anchor-as-authenticated-host-trust-root",
      "library-call-as-host-authorized-trusted-entry-point",
      "test-leaf-as-installed-or-promoted",
      "transition-receipt-as-execution-authority",
      "transition-receipt-as-adoption-authority",
      "raw-model-output-ingestion",
      "private-context-ingestion",
      "automatic-write",
      "automatic-permission-grant",
      "automatic-training",
      "automatic-install",
      "automatic-promotion",
      "automatic-merge",
      "automatic-canon",
      "foundation-mutation"
