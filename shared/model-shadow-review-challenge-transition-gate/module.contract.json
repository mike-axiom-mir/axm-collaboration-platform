  },
  "lifecycle": {
    "state_owner": "none; caller retains both separated chains and the pairwise receipt",
    "reload": "exact-rebuild both separated chains and the pairwise receipt in a fresh process",
    "disconnect": "not-applicable",
    "cleanup": "caller-owned",
    "installed": false,
    "promoted": false
  }
