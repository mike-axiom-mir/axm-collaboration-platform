{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.human-benefit-evaluation-receipt/v1",
  "title": "AXM Human Benefit Evaluation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "evaluationId",
    "generatedAt",
    "protocol",
    "sessions",
    "fixtureMode",
    "summary",
    "signal",
    "state",
    "humanBenefitVerdict",
    "truth",
    "evaluationDigest"
  ],
  "properties": {
    "schema": { "const": "axm.human-benefit-evaluation-receipt/v1" },
    "version": { "const": "0.1.0" },
    "evaluationId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "protocol": { "$ref": "./human-benefit-protocol.schema.json" },
    "sessions": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "./human-benefit-session.schema.json" } },
    "fixtureMode": { "enum": ["LIVE", "SYNTHETIC"] },
    "summary": { "type": "object" },
    "signal": { "enum": ["POSITIVE", "NEGATIVE", "MIXED", "INCONCLUSIVE"] },
    "state": { "enum": ["INSUFFICIENT_COMPLETED_SESSIONS", "READY_FOR_HUMAN_JUDGMENT"] },
    "humanBenefitVerdict": { "const": "NOT_RUN" },
    "truth": { "type": "object" },
    "evaluationDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
