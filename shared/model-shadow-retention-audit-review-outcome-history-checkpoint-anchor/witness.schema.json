{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"axm.model-shadow-retention-audit-review-outcome-history-checkpoint-witness/v1",
  "type":"object","additionalProperties":false,
  "required":["schema","version","status","witnessId","verifiedAt","checkpointRef","witnessPolicyRef","state","signatureEvidence","truth","witnessDigest"],
  "properties":{
    "schema":{"const":"axm.model-shadow-retention-audit-review-outcome-history-checkpoint-witness/v1"},"version":{"const":"3.4.0"},"status":{"const":"TEST"},
    "witnessId":{"type":"string","minLength":1,"maxLength":180},"verifiedAt":{"$ref":"#/$defs/time"},
    "checkpointRef":{"$ref":"#/$defs/ref"},"witnessPolicyRef":{"$ref":"#/$defs/ref"},
    "state":{"const":"CHECKPOINT_SIGNATURES_VERIFIED_RELATIVE_TO_CALLER_POLICY_AUTHORITY_NOT_AUTHENTICATED"},
    "signatureEvidence":{"type":"object","additionalProperties":false,"required":["algorithm","requiredSignatures","verifiedSignatures","keyFingerprintSetDigest","declaredPrincipalSetDigest","attestationSetDigest","policyAuthorityOrigin"],"properties":{"algorithm":{"const":"Ed25519"},"requiredSignatures":{"type":"integer","minimum":1,"maximum":10},"verifiedSignatures":{"type":"integer","minimum":1,"maximum":10},"keyFingerprintSetDigest":{"$ref":"#/$defs/digest"},"declaredPrincipalSetDigest":{"$ref":"#/$defs/digest"},"attestationSetDigest":{"$ref":"#/$defs/digest"},"policyAuthorityOrigin":{"const":"CALLER_SUPPLIED_UNAUTHENTICATED"}}},
