      "properties":{
        "retentionManifestReloaded":{"const":true},"completeRetentionChainValidated":{"const":true},"latestPersistedCheckpointSelectedWithoutCallerCheckpointPresentation":{"const":true},"latestPersistedCheckpointPending":{"type":"boolean"},"latestPersistedCheckpointSettled":{"type":"boolean"},"pendingObservationGrantsSettledAuthority":{"const":false},"retainedCheckpointSelfDigestValidated":{"const":true},"retainedCheckpointOriginReauthenticatedAtAudit":{"const":false},"currentSourceValidatedByV26Audit":{"type":"boolean"},"sourceRollbackObserved":{"type":"boolean"},"sourceAbsenceObserved":{"type":"boolean"},"sourceReplacementOrForkObserved":{"type":"boolean"},"retentionRootDistinctAndNonnestedFromPresentedSourceRoot":{"const":true},"localCheckpointRetentionObserved":{"const":true},"transientRetentionOperationLockWritten":{"const":true},"transientV25OperationLockMayBeWritten":{"type":"boolean"},"durableSourceLedgerStateChangedByModule":{"const":false},"auditReceiptPersistedByModule":{"const":false},"directoryEntryOrHardwareDurabilityProven":{"const":false},"checkpointOriginAuthenticated":{"const":false},"externalRetentionProven":{"const":false},"protectedMonotonicStateProven":{"const":false},"deletionOrRollbackPrevented":{"const":false},"withheldOrJointlyReplacedRootsExcluded":{"const":false},"globalTransitionUniquenessProven":{"const":false},"globallyConsistentLogProven":{"const":false},"hostAuthorizationAuthenticated":{"const":false},"actorRealWorldIdentityProven":{"const":false},"actualHumanParticipationProven":{"const":false},"timeExternallyTrusted":{"const":false},"rawPublicKeyEmbedded":{"const":false},"rawSignatureEmbedded":{"const":false},"privateKeyIngested":{"const":false},"sourceOrLedgerPathEmbedded":{"const":false},"rawUpstreamPackageEmbedded":{"const":false},"rawModelOutputEmbedded":{"const":false},"privateContextEmbedded":{"const":false},"experimentExecuted":{"const":false},"providerInvoked":{"const":false},"evaluationPerformed":{"const":false},"executionAuthorized":{"const":false},"adoptionAuthorized":{"const":false},"humanBenefitProven":{"const":false},"broadLearningClaimed":{"const":false},"autonomousActionCount":{"const":0},"automaticPermissionGrant":{"const":false},"automaticInstall":{"const":false},"automaticPromotion":{"const":false},"automaticMerge":{"const":false},"automaticCanon":{"const":false},"foundationMutation":{"const":false}
      }
    },
    "auditDigest":{"$ref":"#/$defs/digest"}
