{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.model-shadow-review-challenge-transition-receiver-acknowledgement/v1",
  "title": "Model Shadow declared receiver acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "acknowledgementId", "policyDigest", "assessmentRef",
    "rosterRef", "receiverId", "acknowledgedAt", "scope", "retentionClaim",
    "signatureAlgorithm", "signature"
  ],
  "properties": {
    "schema": {"const": "axm.model-shadow-review-challenge-transition-receiver-acknowledgement/v1"},
    "version": {"const": "1.1.0"},
    "acknowledgementId": {"type": "string", "minLength": 1, "maxLength": 180},
    "policyDigest": {"$ref": "#/$defs/digest"},
    "assessmentRef": {"$ref": "#/$defs/assessmentReference"},
    "rosterRef": {"$ref": "#/$defs/rosterReference"},
    "receiverId": {"type": "string", "minLength": 1, "maxLength": 120},
    "acknowledgedAt": {"type": "string", "format": "date-time", "maxLength": 64},
    "scope": {"const": "ACKNOWLEDGE_EXACT_DECLARED_DISCLOSURE_ASSESSMENT_REFERENCE_PRESENTED_BY_CALLER"},
    "retentionClaim": {"const": "NO_DURABLE_RETENTION_CLAIM"},
    "signatureAlgorithm": {"const": "Ed25519"},
    "signature": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$", "maxLength": 128}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "assessmentReference": {
      "allOf": [
        {"$ref": "#/$defs/reference"},
        {"properties": {"schema": {"const": "axm.model-shadow-review-challenge-transition-declared-disclosure/v1"}}}
      ]
    },
    "rosterReference": {
      "allOf": [
        {"$ref": "#/$defs/reference"},
        {"properties": {"schema": {"const": "axm.model-shadow-review-challenge-transition-disclosure-roster/v1"}}}
      ]
    }
  }
}
