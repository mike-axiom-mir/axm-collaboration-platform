{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.grounded-growth-human-bridge-receipt/v1",
  "title": "AXM Grounded Growth Human Bridge Receipt",
  "type": "object",
  "required": ["schema", "version", "bridgeId", "generatedAt", "capabilityId", "claimId", "targetScope", "binding", "sourceRefs", "evidenceClosureReceipt", "evidenceClosure", "nativeVerification", "admission", "truth", "receiptDigest"],
  "properties": {
    "schema": { "const": "axm.grounded-growth-human-bridge-receipt/v1" },
    "version": { "const": "0.1.0" },
    "targetScope": { "enum": ["NAMED_LOCAL_STEWARD", "DECLARED_COHORT"] },
    "receiptDigest": { "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": true
}
