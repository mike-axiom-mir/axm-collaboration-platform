{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.verification-source-evolution-review/v1",
  "title": "AXM Verification Source Evolution Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "reviewId", "reviewedAt", "status", "scope",
    "historicalReceipt", "continuity", "counts", "driftReviews", "decision",
    "truth", "reviewDigest"
  ],
  "properties": {
    "schema": { "const": "axm.verification-source-evolution-review/v1" },
    "version": { "const": "0.1.0" },
    "reviewId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "TEST" },
    "scope": { "const": "CURRENT_TRACKED_SOURCE_BYTES_TO_LATER_VERIFICATION_RECEIPT_EVIDENCE" },
    "historicalReceipt": { "type": "object" },
    "continuity": { "type": "object" },
    "counts": { "type": "object" },
    "driftReviews": { "type": "array", "minItems": 1 },
    "decision": { "type": "object" },
    "truth": { "type": "object" },
    "reviewDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

