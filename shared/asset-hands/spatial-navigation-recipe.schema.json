{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/spatial-navigation-recipe-v1.schema.json",
  "title": "AXM Spatial Navigation Recipe v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "id",
    "target_canvas",
    "operation",
    "source",
    "generation",
    "collision",
    "navigation",
    "debug_delivery",
    "budgets",
    "known_limits",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "axm.spatial-navigation-recipe/v1" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string" },
    "target_canvas": { "type": "object" },
    "operation": { "enum": ["create", "edit", "validate"] },
    "source": { "type": ["object", "null"] },
    "generation": { "type": "object" },
    "collision": { "type": "object" },
    "navigation": { "type": "object" },
    "debug_delivery": { "type": "object" },
    "budgets": { "type": "object" },
    "known_limits": { "type": "array", "minItems": 1 },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
