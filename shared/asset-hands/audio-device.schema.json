{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/audio-device.schema.json",
  "title": "AXM Audio Device Surface",
  "type": "object",
  "required": [
    "schema",
    "version",
    "id",
    "name",
    "target_canvas",
    "dimensions",
    "colours",
    "contrast_ratio",
    "behaviour",
    "controls",
    "midi_mapping",
    "accessibility",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "audio-device+json" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "target_canvas": { "type": "object" },
    "dimensions": { "type": "object" },
    "colours": { "type": "object" },
    "contrast_ratio": { "type": "number" },
    "behaviour": { "type": "array" },
    "controls": { "type": "array", "minItems": 1 },
    "midi_mapping": { "type": "array", "minItems": 1 },
    "accessibility": { "type": "object" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
