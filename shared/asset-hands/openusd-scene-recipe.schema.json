{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/openusd-scene-recipe-v1.schema.json",
  "title": "AXM OpenUSD Scene Recipe v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "id",
    "target_canvas",
    "operation",
    "source",
    "composition",
    "package",
    "budgets",
    "claims",
    "known_limits",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "axm.openusd-scene-recipe/v1" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "target_canvas": { "type": "object" },
    "operation": {
      "enum": ["create", "edit", "inspect", "validate", "workflow"]
    },
    "source": { "type": ["object", "null"] },
    "composition": { "type": "object" },
    "package": { "type": "object" },
    "budgets": { "type": "object" },
    "claims": { "type": "array", "minItems": 1 },
    "known_limits": { "type": "array", "minItems": 1 },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
