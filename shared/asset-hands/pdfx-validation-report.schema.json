{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/pdfx-validation-report-v1.schema.json",
  "title": "AXM PDF/X Validation Report v1",
  "type": "object",
  "required": ["schema", "version", "status", "standard", "claim", "target_canvas", "container", "output_intent", "checks"],
  "properties": {
    "schema": {"const": "axm.pdfx-validation-report/v1"},
    "version": {"const": "1.0.0"},
    "status": {"enum": ["PASS", "HOLD"]},
    "standard": {"const": "PDF/X-4"},
    "claim": {"type": "string", "minLength": 1},
    "target_canvas": {"type": "object"},
    "container": {"type": "object", "required": ["mime", "format", "bytes", "header", "xrefObjects"]},
    "output_intent": {"type": "object", "required": ["subtype", "condition", "profile_sha256", "profile_description", "profile_bytes"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "pass"]}}
  },
  "additionalProperties": false
}
