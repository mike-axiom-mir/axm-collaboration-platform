{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.raster-composition/v1",
  "title": "AXM Raster Composition Recipe v1",
  "type": "object",
  "required": ["schema", "version", "id", "canvas", "layers", "global_filters"],
  "properties": {
    "schema": { "const": "axm.raster-composition/v1" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "colour_space", "alpha"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "height": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "colour_space": { "const": "srgb" },
        "alpha": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "name", "visible", "opacity", "blend_mode", "offset", "filters"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "name": { "type": "string", "minLength": 1, "maxLength": 140 },
          "visible": { "type": "boolean" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "blend_mode": { "enum": ["normal", "multiply", "screen", "overlay", "darken", "lighten", "color-dodge", "color-burn", "hard-light", "soft-light", "difference", "exclusion", "add", "subtract"] },
          "offset": {
            "type": "object",
            "required": ["x", "y"],
            "properties": { "x": { "type": "integer", "minimum": -2048, "maximum": 2048 }, "y": { "type": "integer", "minimum": -2048, "maximum": 2048 } },
            "additionalProperties": false
          },
          "source_artifact_id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "fill": { "type": "string", "pattern": "^#[0-9A-F]{6}(?:[0-9A-F]{2})?$" },
          "mask": {
            "type": "object",
            "required": ["source_artifact_id", "channel", "invert"],
            "properties": {
              "source_artifact_id": { "type": "string", "minLength": 1, "maxLength": 100 },
              "channel": { "enum": ["alpha", "luminance"] },
              "invert": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "filters": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/filter" } }
        },
        "oneOf": [
          { "required": ["source_artifact_id"], "not": { "required": ["fill"] } },
          { "required": ["fill"], "not": { "required": ["source_artifact_id"] } }
        ],
        "additionalProperties": false
      }
    },
    "global_filters": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/filter" } },
    "notes": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 300 } }
  },
  "$defs": {
    "filter": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["brightness", "contrast", "saturation", "hue", "grayscale", "invert", "gamma", "threshold", "posterize", "tint", "blur", "sharpen", "pixelate"] },
        "value": { "type": "number" },
        "amount": { "type": "number" },
        "levels": { "type": "integer" },
        "colour": { "type": "string", "pattern": "^#[0-9A-F]{6}(?:[0-9A-F]{2})?$" },
        "radius": { "type": "integer" },
        "size": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
