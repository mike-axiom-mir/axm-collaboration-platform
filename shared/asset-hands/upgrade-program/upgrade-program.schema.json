{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/asset-hands-upgrade-program.schema.json",
  "title": "AXM Asset Hands fifty-upgrade program",
  "type": "object",
  "required": ["schema", "version", "status", "objective", "admission_rule", "upgrades"],
  "properties": {
    "schema": { "const": "axm.asset-hands.upgrade-program/v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["active-build-material", "needs-review", "accepted-for-test", "complete"] },
    "objective": { "type": "string", "minLength": 20 },
    "admission_rule": { "type": "string", "minLength": 20 },
    "upgrades": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/upgrade" }
    }
  },
  "$defs": {
    "upgrade": {
      "type": "object",
      "required": [
        "rank", "id", "title", "wave", "class", "state", "gap_types",
        "capabilities", "depends_on", "acceptance"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 50 },
        "id": { "type": "string", "pattern": "^asset\\.[a-z0-9.-]+$" },
        "title": { "type": "string", "minLength": 5, "maxLength": 120 },
        "wave": { "type": "integer", "minimum": 1, "maximum": 4 },
        "class": { "enum": ["CORE", "EVIDENCE", "IMPROVE", "NEW_HAND", "ADAPTER"] },
        "state": { "enum": ["MISSING", "PARTIAL", "READY", "BLOCKED", "UNKNOWN"] },
        "gap_types": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["HAND", "SKILL", "AUTHORITY", "SUBSTRATE", "EVIDENCE", "CONTRACT"] }
        },
        "capabilities": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
        },
        "depends_on": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^asset\\.[a-z0-9.-]+$" }
        },
        "acceptance": {
          "type": "object",
          "required": ["claim_kind", "risk", "pass_condition", "primary_surface", "counterevidence"],
          "properties": {
            "claim_kind": {
              "enum": ["existence", "static-structure", "deterministic-behavior", "visual-appearance", "interaction-journey", "persistence", "transport", "authorization", "performance", "resource-safety", "quality"]
            },
            "risk": { "enum": ["low", "medium", "high"] },
            "pass_condition": { "type": "string", "minLength": 20 },
            "primary_surface": { "type": "string", "minLength": 5 },
            "counterevidence": { "type": "string", "minLength": 10 },
            "secondary_surface": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
