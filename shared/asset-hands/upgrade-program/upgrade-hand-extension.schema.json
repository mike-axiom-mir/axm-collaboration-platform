{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/asset-hand-extension-v1.schema.json",
  "title": "AXM Asset Hand capability extension v1",
  "type": "object",
  "required": [
    "schema", "id", "title", "version", "rank", "wave", "class",
    "capabilities", "depends_on", "module", "functions", "output_types",
    "canvas_types", "constraints_honoured", "editable_recipe_formats", "operations",
    "implementation_status", "acceptance_state", "required_substrates"
  ],
  "properties": {
    "schema": { "const": "axm.asset-hand-extension/v1" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "rank": { "type": "integer", "minimum": 1, "maximum": 50 },
    "wave": { "type": "integer", "minimum": 1, "maximum": 4 },
    "class": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "module": { "type": "string", "minLength": 1 },
    "functions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "output_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "canvas_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["*", "screen", "ui", "game-world", "print", "paper", "fabric", "wood", "metal", "physical-object", "3d-surface", "audio-device"] } },
    "constraints_honoured": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "editable_recipe_formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "operations": {
      "type": "object",
      "required": ["preview", "validate", "edit"],
      "properties": {
        "preview": { "type": "boolean" },
        "validate": { "type": "boolean" },
        "edit": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "implementation_status": { "const": "executable-contract" },
    "acceptance_state": { "enum": ["MISSING", "PARTIAL", "READY"] },
    "required_substrates": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
