{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/animated-web-validation-v1.schema.json",
  "title": "AXM Animated Web Validation v1",
  "type": "object",
  "required": ["schema", "version", "status", "target_canvas", "operation", "engine", "containers", "losses", "checks"],
  "properties": {
    "schema": {"const": "axm.animated-web-validation/v1"}, "version": {"const": "1.0.0"}, "status": {"enum": ["PASS", "HOLD"]},
    "target_canvas": {"type": "object"}, "operation": {"enum": ["create", "edit", "finish", "validate"]}, "engine": {"type": "object"},
    "containers": {"type": "array", "minItems": 1}, "losses": {"type": "array"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "pass"]}}
  },
  "additionalProperties": false
}
