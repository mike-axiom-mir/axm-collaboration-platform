{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/game-visual-contract-v1.schema.json",
  "title": "AXM Game Visual Boundary Contract v1",
  "type": "object",
  "required": ["schema", "version", "status", "id", "title", "simulation_contract", "gameplay_proxy_contract", "save_contract", "required_visual_slots", "baseline_policy", "invariants", "provenance", "authority"],
  "properties": {
    "schema": { "const": "axm.game-visual-contract/v1" },
    "version": { "const": "1.0.0" },
    "status": { "const": "EXPERIMENTAL" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "simulation_contract": { "$ref": "#/$defs/boundary" },
    "gameplay_proxy_contract": { "$ref": "#/$defs/boundary" },
    "save_contract": { "$ref": "#/$defs/boundary" },
    "required_visual_slots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "baseline_policy": {
      "type": "object",
      "required": ["pack_id", "must_be_bundled", "must_be_installed", "minimum_hardware_profile_id", "silent_fallback_forbidden"],
      "properties": {
        "pack_id": { "type": "string" },
        "must_be_bundled": { "const": true },
        "must_be_installed": { "const": true },
        "minimum_hardware_profile_id": { "type": "string" },
        "silent_fallback_forbidden": { "const": true }
      },
      "additionalProperties": false
    },
    "invariants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "provenance": { "type": "object" },
    "authority": { "$ref": "asset-identity.schema.json#/$defs/authority" }
  },
  "additionalProperties": false,
  "$defs": {
    "boundary": {
      "type": "object",
      "required": ["schema", "digest"],
      "properties": { "schema": { "type": "string" }, "digest": { "type": "string", "minLength": 16 } },
      "additionalProperties": false
    }
  }
}
