{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/material-parity-recipe-v1.schema.json",
  "title": "AXM Material Parity Recipe v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "id",
    "target_canvas",
    "operation",
    "source",
    "reference_scene",
    "backends",
    "bindings",
    "thresholds",
    "performance_model",
    "known_limits",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "axm.material-parity-recipe/v1" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "target_canvas": { "type": "object" },
    "operation": { "enum": ["inspect", "validate", "workflow"] },
    "source": { "type": "object" },
    "reference_scene": { "type": "object" },
    "backends": { "type": "array", "minItems": 2, "maxItems": 2 },
    "bindings": { "type": "array" },
    "thresholds": { "type": "object" },
    "performance_model": { "type": "object" },
    "known_limits": { "type": "array", "minItems": 1 },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
