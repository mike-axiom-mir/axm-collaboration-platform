{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/animated-raster-recipe-v1.schema.json",
  "title": "AXM Animated Raster Recipe v1",
  "description": "Editable, deterministic source recipe for an APNG frame sequence created against a target canvas.",
  "type": "object",
  "required": ["schema", "version", "id", "target_canvas", "frame_count", "fps", "loop_count", "algorithm", "palette", "transparent", "frames", "provenance"],
  "properties": {
    "schema": { "const": "axm.animated-raster-recipe/v1" },
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "target_canvas": { "$ref": "target-canvas.schema.json" },
    "frame_count": { "type": "integer", "minimum": 2, "maximum": 12 },
    "fps": { "type": "number", "minimum": 1, "maximum": 60 },
    "loop_count": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "algorithm": { "type": "string", "minLength": 1, "maxLength": 80 },
    "palette": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } },
    "transparent": { "type": "boolean" },
    "frames": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["index", "phase", "delay"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "phase": { "type": "number", "minimum": 0, "maximum": 1 },
          "delay": {
            "type": "object",
            "required": ["numerator", "denominator"],
            "properties": {
              "numerator": { "type": "integer", "minimum": 1 },
              "denominator": { "type": "number", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["engine"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "source_id": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
