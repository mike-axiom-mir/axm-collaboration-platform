{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/accessible-document-recipe-v1.schema.json",
  "title": "AXM Accessible Document Recipe v1",
  "type": "object",
  "required": ["schema", "version", "id", "target_canvas", "operation", "source", "language", "direction", "reading_order", "deliveries", "claims", "known_limits", "provenance"],
  "properties": {
    "schema": {"const": "axm.accessible-document-recipe/v1"}, "version": {"const": "1.0.0"}, "id": {"type": "string", "minLength": 1},
    "target_canvas": {"type": "object"}, "operation": {"enum": ["create", "edit", "inspect", "validate"]}, "source": {"type": ["object", "null"]},
    "language": {"type": "string"}, "direction": {"enum": ["ltr", "rtl", "auto"]}, "reading_order": {"type": "array"}, "deliveries": {"type": "array", "minItems": 1},
    "claims": {"type": "array"}, "known_limits": {"type": "array"}, "provenance": {"type": "object", "required": ["hand", "hand_version", "seed", "source_artifact_digests"]}
  },
  "additionalProperties": false
}
