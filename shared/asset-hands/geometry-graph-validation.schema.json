{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/geometry-graph-validation-v1.schema.json",
  "title": "AXM Geometry Graph Validation v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "status",
    "claim",
    "target_canvas",
    "operation",
    "graph",
    "evaluation",
    "cache",
    "bake_integrity",
    "bounds",
    "budgets",
    "checks"
  ],
  "properties": {
    "schema": { "const": "axm.geometry-graph-validation/v1" },
    "version": { "const": "1.0.0" },
    "status": { "enum": ["PASS", "HOLD"] },
    "claim": { "type": "string" },
    "target_canvas": { "type": "object" },
    "operation": { "enum": ["create", "edit", "validate", "workflow"] },
    "graph": { "type": "object" },
    "evaluation": { "type": "object" },
    "cache": { "type": "object" },
    "bake_integrity": { "type": "object" },
    "bounds": { "type": "object" },
    "budgets": { "type": "object" },
    "checks": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": false
}
