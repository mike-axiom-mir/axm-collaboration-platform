{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/asset-hand-v2.schema.json",
  "title": "AXM Asset Hand Contract v2",
  "description": "A permission-bounded executable capability descriptor. Target environment remains declared separately through axm.target-canvas/v1.",
  "type": "object",
  "required": [
    "schema",
    "contract_version",
    "source_contract",
    "id",
    "title",
    "version",
    "lifecycle_status",
    "operation_modes",
    "canvas_models",
    "entry_surfaces",
    "mutability",
    "kinds",
    "wildcard_kind_policy",
    "input_types",
    "output_types",
    "canvas_types",
    "constraints_honoured",
    "editable_recipe_formats",
    "operations",
    "emits_editable_source",
    "supports_edit_operation",
    "required_permissions",
    "network_policy",
    "engine",
    "safety_tier",
    "portability",
    "implementation_status"
  ],
  "properties": {
    "schema": { "const": "axm.asset-hand/v2" },
    "legacy_schema": { "type": ["string", "null"] },
    "contract_version": { "const": "2.0" },
    "source_contract": { "enum": ["native-v2", "legacy-normalized"] },
    "id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "minLength": 1, "maxLength": 30 },
    "category": { "type": "string", "maxLength": 50 },
    "summary": { "type": "string", "maxLength": 300 },
    "purpose": { "type": "string", "maxLength": 300 },
    "lifecycle_status": {
      "enum": ["experimental", "beta", "stable", "deprecated"]
    },
    "operation_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["create", "edit", "inspect", "validate", "finish", "workflow"]
      }
    },
    "canvas_models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dom-component",
          "node-tree-design",
          "raster-frame",
          "vector-document",
          "page-document",
          "timeline",
          "viewport-2d",
          "viewport-3d",
          "cad-parametric",
          "audio-device",
          "procedural-graph",
          "host-neutral"
        ]
      }
    },
    "entry_surfaces": {
      "type": "array",
      "items": { "type": "string", "maxLength": 80 }
    },
    "mutability": {
      "enum": ["read-only", "annotate", "transform", "generate", "export"]
    },
    "kinds": {
      "type": "array",
      "items": { "type": "string", "maxLength": 80 }
    },
    "wildcard_kind_policy": { "enum": ["native", "fallback"] },
    "accepts": {
      "type": "array",
      "items": { "type": "string", "maxLength": 100 }
    },
    "produces": {
      "type": "array",
      "items": { "type": "string", "maxLength": 100 }
    },
    "input_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mime",
          "format",
          "schema",
          "roles",
          "required_for",
          "mutable",
          "max_bytes"
        ],
        "properties": {
          "mime": { "type": "string", "maxLength": 100 },
          "format": { "type": "string", "maxLength": 40 },
          "schema": { "type": "string", "maxLength": 120 },
          "roles": {
            "type": "array",
            "items": { "type": "string", "maxLength": 80 }
          },
          "required_for": {
            "type": "array",
            "items": {
              "enum": [
                "create",
                "edit",
                "inspect",
                "validate",
                "finish",
                "workflow"
              ]
            }
          },
          "mutable": { "type": "boolean" },
          "max_bytes": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "output_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "mime",
          "format",
          "schema",
          "role",
          "editable",
          "deterministic",
          "lossy",
          "known_losses"
        ],
        "properties": {
          "mime": { "type": "string", "maxLength": 100 },
          "format": { "type": "string", "maxLength": 100 },
          "schema": { "type": "string", "maxLength": 120 },
          "role": { "type": "string", "maxLength": 80 },
          "editable": { "type": "boolean" },
          "deterministic": { "type": "boolean" },
          "lossy": { "type": "boolean" },
          "known_losses": {
            "type": "array",
            "items": { "type": "string", "maxLength": 80 }
          }
        },
        "additionalProperties": false
      }
    },
    "canvas_types": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/canvasProfile" }
    },
    "canvas_limits": {
      "type": "object",
      "properties": {
        "min_width": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "min_height": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "max_width": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "max_height": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "max_pixels": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "texture_bytes_per_pixel": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "max_bleed": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "min_stroke": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "max_stroke": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "max_tool_width": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "max_depth": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "min_animation_frames": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "max_animation_frames": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "min_fps": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "max_fps": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "min_polygon_count": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "min_vertices": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "constraints_honoured": {
      "type": "array",
      "items": { "type": "string", "maxLength": 80 }
    },
    "editable_recipe_formats": {
      "type": "array",
      "items": { "type": "string", "maxLength": 100 }
    },
    "operations": {
      "type": "object",
      "required": ["preview", "validate", "edit"],
      "properties": {
        "preview": { "type": "boolean" },
        "validate": { "type": "boolean" },
        "edit": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "emits_editable_source": { "type": "boolean" },
    "supports_edit_operation": { "type": "boolean" },
    "requires": {
      "type": "array",
      "items": { "type": "string", "maxLength": 80 }
    },
    "required_permissions": { "type": "object" },
    "network_policy": { "type": "object" },
    "host_compatibility": { "type": "object" },
    "engine": { "type": "object" },
    "editable": { "type": "boolean" },
    "deterministic": { "type": "boolean" },
    "authority": { "type": "string", "maxLength": 100 },
    "implementation_status": { "type": "string", "maxLength": 40 },
    "safety_tier": {
      "enum": ["safe-local", "local-write", "networked", "native-bridge"]
    },
    "portability": { "type": "object" },
    "validation": { "type": "object" },
    "rollback": { "type": "object" },
    "observability": { "type": "object" },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "tests": {
      "type": "array",
      "items": { "type": "string", "maxLength": 80 }
    },
    "implementation_priority": { "type": "string", "maxLength": 30 },
    "limits": { "type": "object" }
  },
  "$defs": {
    "canvasProfile": {
      "type": "object",
      "required": [
        "medium",
        "units",
        "colour_spaces",
        "transparency_modes",
        "material_behaviours",
        "behaviours",
        "intended_uses"
      ],
      "properties": {
        "medium": {
          "enum": [
            "*",
            "screen",
            "ui",
            "game-world",
            "print",
            "paper",
            "fabric",
            "wood",
            "metal",
            "physical-object",
            "3d-surface",
            "audio-device"
          ]
        },
        "units": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["px", "mm", "m", "game-world-unit"] }
        },
        "colour_spaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "srgb",
              "display-p3",
              "linear-srgb",
              "cmyk",
              "grayscale",
              "material-channel"
            ]
          }
        },
        "transparency_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["required", "allowed", "opaque"] }
        },
        "material_behaviours": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 80 }
        },
        "behaviours": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "static",
              "animated",
              "interactive",
              "responsive",
              "tileable"
            ]
          }
        },
        "intended_uses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 100 }
        },
        "locale_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          }
        },
        "up_axes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["x", "y", "z"] }
        },
        "handedness": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["left", "right"] }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
