{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/cut-layout-spec-v1.schema.json",
  "title": "AXM Cut Layout Spec v1",
  "type": "object",
  "required": ["schema", "medium", "dimensions", "bleed", "safeMargin", "minimumStroke", "cuttingToolWidth", "tolerance", "materialThickness", "kerf", "materialBehaviour", "materialCompensation", "layers", "toolpathSimulation", "operatorMaterialTestRequired", "automaticCutting"],
  "properties": {
    "schema": { "const": "axm.cut-layout-spec/v1" },
    "medium": { "enum": ["paper", "fabric"] },
    "dimensions": { "type": "object" },
    "bleed": { "$ref": "#/$defs/measure" },
    "safeMargin": { "$ref": "#/$defs/measure" },
    "minimumStroke": { "$ref": "#/$defs/measure" },
    "cuttingToolWidth": { "$ref": "#/$defs/measure" },
    "tolerance": { "$ref": "#/$defs/measure" },
    "materialThickness": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/measure" }] },
    "kerf": { "type": "object", "required": ["side", "offset"], "properties": { "side": { "enum": ["centerline", "inside", "outside"] }, "offset": { "$ref": "#/$defs/measure" } }, "additionalProperties": false },
    "materialBehaviour": { "type": "array", "items": { "type": "string" } },
    "materialCompensation": { "type": "object" },
    "layers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "toolpathSimulation": { "enum": ["NOT_RUN", "PASS", "FAIL"] },
    "operatorMaterialTestRequired": { "type": "boolean" },
    "automaticCutting": { "const": false }
  },
  "$defs": { "measure": { "type": "object", "required": ["value", "unit"], "properties": { "value": { "type": "number", "minimum": 0 }, "unit": { "enum": ["mm", "m"] } }, "additionalProperties": false } },
  "additionalProperties": false
}
