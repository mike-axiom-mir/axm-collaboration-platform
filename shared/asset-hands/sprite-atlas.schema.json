{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/sprite-atlas-v1.schema.json",
  "title": "AXM Sprite Atlas v1",
  "type": "object",
  "required": ["schema", "name", "image", "frameWidth", "frameHeight", "frameCount", "fps", "loop", "tags", "pivot", "frames"],
  "properties": {
    "schema": { "const": "axm.sprite-atlas/v1" },
    "name": { "type": "string", "minLength": 1 },
    "image": { "type": "string", "minLength": 1 },
    "frameWidth": { "type": "integer", "minimum": 1 },
    "frameHeight": { "type": "integer", "minimum": 1 },
    "frameCount": { "type": "integer", "minimum": 1 },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "loop": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "object", "required": ["name", "from", "to", "direction"] } },
    "pivot": { "type": "object", "required": ["x", "y"] },
    "frames": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "x", "y", "width", "height", "durationMs", "pivot"] } }
  },
  "additionalProperties": false
}
