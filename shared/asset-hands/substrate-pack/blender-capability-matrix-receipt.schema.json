{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.blender-capability-matrix-receipt/v1",
  "title": "AXM Blender capability matrix receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "identity", "private_location_retained"],
  "properties": {
    "schema": { "const": "axm.blender-capability-matrix-receipt/v1" },
    "version": { "const": "1.0.0" },
    "status": { "enum": ["PASS", "FAIL", "MISSING_SUBSTRATE"] },
    "missing": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "identity": { "type": "object" },
    "runtime": { "type": "object" },
    "matrix_recipe": { "type": "object" },
    "matrix_recipe_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provides_substrates": { "type": "array", "uniqueItems": true, "items": { "enum": ["rig-runtime", "simulation-runtime", "texture-baker"] } },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "pass"],
        "properties": { "name": { "type": "string" }, "pass": { "type": "boolean" } }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "process", "process_pass", "metrics", "bake_digest", "project_digest", "diagnostic"],
        "properties": {
          "label": { "enum": ["a", "b"] },
          "process": { "type": "object" },
          "process_pass": { "type": "boolean" },
          "metrics": { "type": ["object", "null"] },
          "bake_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "project_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "diagnostic": { "type": ["string", "null"] }
        }
      }
    },
    "private_location_retained": { "const": false },
    "editable_source_retained": { "const": false },
    "automatic_project_retention": { "const": false },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
