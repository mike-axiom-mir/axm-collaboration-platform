{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.brep-step-capability-receipt/v1",
  "title": "AXM B-rep and STEP kernel capability receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "identity", "private_location_retained"],
  "properties": {
    "schema": { "const": "axm.brep-step-capability-receipt/v1" }, "version": { "const": "1.0.0" }, "status": { "enum": ["PASS", "FAIL", "MISSING_SUBSTRATE"] },
    "missing": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "identity": { "type": "object" }, "runtime": { "type": "object" }, "recipe": { "type": "object" }, "recipe_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expected_analytic_volume_mm3": { "type": "number" }, "checks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "pass"], "properties": { "name": { "type": "string" }, "pass": { "type": "boolean" } } } },
    "create": { "type": "object" }, "reopens": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object" } }, "counterexample": { "type": "object" },
    "step_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "editable_brep_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "provides_substrates": { "type": "array", "uniqueItems": true, "items": { "const": "brep-step-kernel" } }, "private_location_retained": { "const": false }, "generated_cad_retained": { "const": false }, "automatic_cad_retention": { "const": false }, "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
