{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.blender-live-render-receipt/v1",
  "title": "AXM Blender live render receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "identity", "private_location_retained"],
  "properties": {
    "schema": { "const": "axm.blender-live-render-receipt/v1" },
    "version": { "const": "1.0.0" },
    "status": { "enum": ["PASS", "FAIL", "MISSING_SUBSTRATE"] },
    "missing": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "identity": { "type": "object" },
    "runtime": { "type": "object" },
    "scene_recipe": { "type": "object" },
    "scene_recipe_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "frame_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "deterministic_pixel_match": { "type": "boolean" },
    "container_byte_match": { "type": "boolean" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "pass"],
        "properties": { "name": { "type": "string" }, "pass": { "type": "boolean" } }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "process", "process_pass", "metrics", "frame_digest", "frame_bytes", "editable_source_digest", "diagnostic"],
        "properties": {
          "label": { "enum": ["a", "b"] },
          "process": { "type": "object" },
          "process_pass": { "type": "boolean" },
          "metrics": { "type": ["object", "null"] },
          "frame_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "frame_bytes": { "type": "integer", "minimum": 0 },
          "editable_source_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "diagnostic": { "type": ["string", "null"] }
        }
      }
    },
    "editable_source_supported": { "type": "boolean" },
    "editable_source_retained": { "const": false },
    "private_location_retained": { "const": false },
    "automatic_project_retention": { "const": false },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
