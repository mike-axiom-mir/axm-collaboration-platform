{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/pixel-video-sequence-v1.schema.json",
  "title": "AXM Pixel Video Frame Sequence v1",
  "description": "A deterministic, codec-neutral sequence of frame artifact references and integer millisecond holds for later video rendering.",
  "type": "object",
  "required": ["schema", "version", "status", "id", "source_manifest_id", "timebase", "dimensions", "frames", "sequences", "provenance", "authority"],
  "properties": {
    "schema": { "const": "axm.pixel-video-sequence/v1" },
    "version": { "const": "1.0.0" },
    "status": { "const": "EXPERIMENTAL" },
    "id": { "type": "string", "minLength": 1, "maxLength": 180 },
    "identity_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
    "representation_profile_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
    "source_manifest_id": { "type": "string", "minLength": 1, "maxLength": 180 },
    "timebase": { "type": "object", "required": ["unit", "integer"], "properties": { "unit": { "const": "milliseconds" }, "integer": { "const": true } }, "additionalProperties": false },
    "dimensions": { "type": "object", "required": ["width", "height", "unit"], "properties": { "width": { "type": "integer", "minimum": 1, "maximum": 256 }, "height": { "type": "integer", "minimum": 1, "maximum": 256 }, "unit": { "const": "px" } }, "additionalProperties": false },
    "frames": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "required": ["frame_id", "artifact_id", "filename", "sha256"], "properties": { "frame_id": { "type": "string", "minLength": 1 }, "artifact_id": { "type": ["string", "null"] }, "filename": { "type": ["string", "null"] }, "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" } }, "additionalProperties": false } },
    "sequences": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object", "required": ["clip_id", "runtime_name", "animation", "direction", "cycles", "duration_ms", "segments"], "properties": { "clip_id": { "type": "string", "minLength": 1 }, "runtime_name": { "type": "string", "minLength": 1 }, "animation": { "type": "string", "minLength": 1 }, "direction": { "type": "string", "minLength": 1 }, "cycles": { "type": "integer", "minimum": 1, "maximum": 16 }, "duration_ms": { "type": "integer", "minimum": 1 }, "segments": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["frame_id", "cycle", "sequence_index", "start_ms", "duration_ms", "end_ms", "artifact_id", "filename", "sha256"] } } }, "additionalProperties": false } },
    "provenance": { "type": "object" },
    "authority": { "const": "candidate-only" }
  },
  "additionalProperties": false
}
