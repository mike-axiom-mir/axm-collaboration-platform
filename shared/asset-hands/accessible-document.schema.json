{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/accessible-document-v1.schema.json",
  "title": "AXM Accessible Document Source v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "id",
    "title",
    "language",
    "direction",
    "sections",
    "reading_order",
    "accessibility",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "axm.accessible-document/v1" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "language": { "type": "string", "minLength": 1 },
    "direction": { "enum": ["ltr", "rtl", "auto"] },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "text", "alt_text"]
      }
    },
    "reading_order": { "type": "array", "minItems": 1 },
    "accessibility": { "type": "object" },
    "provenance": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
