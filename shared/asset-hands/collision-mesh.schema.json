{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/collision-mesh.schema.json",
  "title": "AXM Collision Mesh",
  "type": "object",
  "required": [
    "schema",
    "version",
    "id",
    "target_canvas",
    "coordinate_unit",
    "policy",
    "world_scale",
    "vertices",
    "triangles",
    "shapes",
    "layers",
    "bounds",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "collision-mesh+json" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string" },
    "target_canvas": { "type": "object" },
    "coordinate_unit": { "const": "metre" },
    "policy": { "type": "string" },
    "world_scale": { "type": "number" },
    "vertices": { "type": "array", "minItems": 4 },
    "triangles": { "type": "array", "minItems": 2 },
    "shapes": { "type": "array", "minItems": 2 },
    "layers": { "type": "array", "minItems": 1 },
    "bounds": { "type": "object" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
