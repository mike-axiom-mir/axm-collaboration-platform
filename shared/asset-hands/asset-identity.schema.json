{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/asset-identity-v1.schema.json",
  "title": "AXM Persistent Asset Identity v1",
  "type": "object",
  "required": ["schema", "version", "status", "id", "asset_type", "components", "footprint", "pivots", "sockets", "semantic_actions", "invariants", "provenance", "authority"],
  "properties": {
    "schema": { "const": "axm.asset-identity/v1" },
    "version": { "const": "1.0.0" },
    "status": { "const": "EXPERIMENTAL" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "asset_type": { "type": "string", "minLength": 1, "maxLength": 80 },
    "components": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "role", "persistent"], "properties": { "id": { "type": "string" }, "role": { "type": "string" }, "persistent": { "type": "boolean" } }, "additionalProperties": true } },
    "footprint": { "type": "object", "required": ["width", "depth", "height", "unit", "origin"], "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "depth": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "unit": { "const": "world-unit" }, "origin": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3 } }, "additionalProperties": false },
    "pivots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/anchor" } },
    "sockets": { "type": "array", "items": { "$ref": "#/$defs/anchor" } },
    "semantic_actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "invariants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "provenance": { "type": "object" },
    "authority": { "$ref": "#/$defs/authority" }
  },
  "additionalProperties": false,
  "$defs": {
    "anchor": { "type": "object", "required": ["id", "position", "unit"], "properties": { "id": { "type": "string" }, "position": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3 }, "unit": { "const": "normalized-footprint" } }, "additionalProperties": true },
    "authority": { "type": "object", "required": ["candidate_only", "installed", "promoted", "canonical", "human_review_required"], "properties": { "candidate_only": { "const": true }, "installed": { "const": false }, "promoted": { "const": false }, "canonical": { "const": false }, "human_review_required": { "const": true } }, "additionalProperties": false }
  }
}
