{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/audio-notation-recipe-v1.schema.json",
  "title": "AXM Audio Notation Recipe v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "id",
    "target_canvas",
    "operation",
    "source",
    "sequence",
    "device",
    "deliveries",
    "timing",
    "budgets",
    "claims",
    "known_limits",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "axm.audio-notation-recipe/v1" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string" },
    "target_canvas": { "type": "object" },
    "operation": { "enum": ["create", "edit", "inspect", "validate"] },
    "source": { "type": ["object", "null"] },
    "sequence": { "type": ["object", "null"] },
    "device": { "type": ["object", "null"] },
    "deliveries": { "type": "array" },
    "timing": { "type": "object" },
    "budgets": { "type": "object" },
    "claims": { "type": "array" },
    "known_limits": { "type": "array", "minItems": 1 },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
