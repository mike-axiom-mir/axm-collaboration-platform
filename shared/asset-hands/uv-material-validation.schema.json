{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/uv-material-validation-v1.schema.json",
  "title": "AXM UV Material Validation v1",
  "type": "object",
  "required": ["schema", "version", "status", "target_canvas", "atlas", "channels", "container", "budgets", "checks"],
  "properties": {
    "schema": {"const": "axm.uv-material-validation/v1"}, "version": {"const": "1.0.0"}, "status": {"enum": ["PASS", "HOLD"]},
    "target_canvas": {"type": "object"}, "atlas": {"type": "object"}, "channels": {"type": "object"}, "container": {"type": "object"},
    "budgets": {"type": "object", "required": ["texture_memory_bytes", "total_file_bytes"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "pass"]}}
  },
  "additionalProperties": false
}
