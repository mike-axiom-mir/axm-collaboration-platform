{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/raster-operations-recipe-v1.schema.json",
  "title": "AXM Raster Operations Recipe v1",
  "type": "object",
  "required": ["schema", "version", "id", "source_artifact_id", "operations", "validation", "authority"],
  "properties": {
    "schema": { "const": "axm.raster-operations-recipe/v1" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "source_artifact_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "operations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "op", "parameters"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "op": { "enum": ["crop", "trim-alpha", "resize-nearest", "pad", "alpha-threshold", "palette-map", "grid-slice", "grid-pack"] },
          "parameters": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "max_colours": { "type": "integer", "minimum": 1, "maximum": 256 },
        "reject_duplicate_frames": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "authority": { "const": "candidate-only" }
  },
  "additionalProperties": false
}
