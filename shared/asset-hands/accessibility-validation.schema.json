{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/accessibility-validation-v1.schema.json",
  "title": "AXM Accessibility Validation v1",
  "type": "object",
  "required": ["schema", "version", "status", "claim", "target_canvas", "operation", "containers", "manual_review", "checks"],
  "properties": {
    "schema": {"const": "axm.accessibility-validation/v1"}, "version": {"const": "1.0.0"}, "status": {"enum": ["PASS", "HOLD"]}, "claim": {"type": "string"},
    "target_canvas": {"type": "object"}, "operation": {"enum": ["create", "edit", "inspect", "validate"]}, "containers": {"type": "array", "minItems": 1},
    "manual_review": {"type": "array"}, "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "pass"]}}
  },
  "additionalProperties": false
}
