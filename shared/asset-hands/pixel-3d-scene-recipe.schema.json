{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/pixel-3d-scene-recipe-v1.schema.json",
  "title": "AXM Pixel-Styled 3D Scene Recipe v1",
  "type": "object",
  "required": ["schema", "version", "status", "id", "identity_id", "representation_profile_id", "animation_state", "footprint", "pivots", "sockets", "materials", "nodes", "animations", "budgets", "game_adapter", "invariants", "provenance", "authority"],
  "properties": {
    "schema": { "const": "axm.pixel-3d-scene-recipe/v1" },
    "version": { "const": "1.0.0" },
    "status": { "const": "EXPERIMENTAL" },
    "id": { "type": "string", "minLength": 1 },
    "identity_id": { "type": "string", "minLength": 1 },
    "representation_profile_id": { "enum": ["pixel-8bit-3d", "pixel-16bit-3d"] },
    "animation_state": { "type": "string" },
    "footprint": { "type": "object" },
    "pivots": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "sockets": { "type": "array", "items": { "type": "object" } },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["id", "colour", "unlit", "roughness", "metallic"], "properties": { "id": { "type": "string" }, "colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "unlit": { "type": "boolean" }, "roughness": { "type": "number", "minimum": 0, "maximum": 1 }, "metallic": { "type": "number", "minimum": 0, "maximum": 1 }, "emissive_colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "emissive_strength": { "type": "number", "minimum": 0, "maximum": 16 }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "clearcoat": { "type": "number", "minimum": 0, "maximum": 1 }, "sheen": { "type": "number", "minimum": 0, "maximum": 1 }, "iridescence": { "type": "number", "minimum": 0, "maximum": 1 }, "translucency": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": true }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["id", "component_id", "parent_id", "translation", "rotation", "scale"], "properties": { "id": { "type": "string" }, "component_id": { "type": "string" }, "parent_id": { "type": ["string", "null"] }, "primitive": { "type": ["object", "null"] }, "material_id": { "type": ["string", "null"] }, "translation": { "$ref": "#/$defs/vec3" }, "rotation": { "$ref": "#/$defs/quat" }, "scale": { "$ref": "#/$defs/vec3" } }, "additionalProperties": true }
    },
    "animations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "duration_seconds", "loop", "channels"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "loop": { "type": "boolean" },
          "channels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["node_id", "path", "interpolation", "keys"],
              "properties": {
                "node_id": { "type": "string" },
                "path": { "enum": ["translation", "rotation", "scale"] },
                "interpolation": { "enum": ["STEP", "LINEAR"] },
                "keys": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": ["time", "value"],
                    "properties": {
                      "time": { "type": "number", "minimum": 0 },
                      "value": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "number" } }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "budgets": { "type": "object", "required": ["max_triangles", "max_nodes", "max_materials", "max_glb_bytes"], "properties": { "max_triangles": { "type": "integer", "minimum": 1 }, "max_nodes": { "type": "integer", "minimum": 1 }, "max_materials": { "type": "integer", "minimum": 1 }, "max_glb_bytes": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "game_adapter": { "type": "object", "required": ["format", "coordinate_system", "unit", "animation_clips", "identity_extras"], "properties": { "format": { "const": "glTF.2.0/GLB" }, "coordinate_system": { "const": "right-handed-y-up" }, "unit": { "const": "world-unit" }, "animation_clips": { "type": "array", "items": { "type": "string" } }, "identity_extras": { "const": true } }, "additionalProperties": true },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "provenance": { "type": "object" },
    "authority": { "$ref": "asset-identity.schema.json#/$defs/authority" }
  },
  "additionalProperties": false,
  "$defs": {
    "vec3": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3 },
    "quat": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 4, "maxItems": 4 }
  }
}
