{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/colour-validation-report-v1.schema.json",
  "title": "AXM Colour Validation Report v1",
  "type": "object",
  "required": ["schema", "version", "status", "target_canvas", "container", "targetSpace", "bitDepth", "profile", "previewGamutClippedChannels", "checks"],
  "properties": {
    "schema": {"const": "axm.colour-validation-report/v1"},
    "version": {"const": "1.0.0"},
    "status": {"enum": ["PASS", "HOLD"]},
    "target_canvas": {"type": "object"},
    "container": {"type": "object", "required": ["mime", "format", "bytes", "width", "height", "bitDepth", "chunks"]},
    "targetSpace": {"enum": ["display-p3", "linear-srgb"]},
    "sourceSpace": {"type": ["string", "null"]},
    "bitDepth": {"enum": [8, 16]},
    "profile": {"type": "object", "required": ["name", "source", "inspection"]},
    "previewGamutClippedChannels": {"type": "integer", "minimum": 0},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "pass"]}}
  },
  "additionalProperties": false
}
