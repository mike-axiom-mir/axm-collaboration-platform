{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/sprite-animation-v1.schema.json",
  "title": "AXM Engine-Neutral Sprite Animation v1",
  "type": "object",
  "required": ["schema", "version", "status", "id", "profile", "source", "sheet", "frames", "clips", "palette", "deliveries", "game_adapter", "video_adapter", "provenance", "authority"],
  "properties": {
    "schema": { "const": "axm.sprite-animation/v1" },
    "version": { "const": "1.0.0" },
    "status": { "const": "EXPERIMENTAL" },
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "identity_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
    "representation_profile_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
    "profile": { "type": "object" },
    "source": {
      "type": "object",
      "required": ["artifact_id", "sha256", "mime", "width", "height", "immutable", "parent_package_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mime": { "const": "image/png" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "immutable": { "const": true },
        "parent_package_id": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "sheet": { "type": "object" },
    "frames": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "required": ["id", "artifact_id", "filename", "sha256", "animation", "direction", "index", "duration_ms", "atlas", "bounds", "pivot", "tags", "events"] } },
    "clips": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object", "required": ["id", "runtime_name", "animation", "direction", "frame_ids", "playback", "duration_ms", "apng_artifact_id", "preview_artifact_id"] } },
    "palette": { "type": "object" },
    "deliveries": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["artifact_id", "role", "mime", "filename", "sha256"] } },
    "game_adapter": { "type": "object", "required": ["contract", "clips", "sampler"], "properties": { "contract": { "const": "axm.game-animation-graph/v1" }, "clips": { "type": "array" }, "sampler": { "const": "AXMPixelAnimationCore.sampleGameAnimationFrame" } } },
    "video_adapter": { "type": "object", "required": ["contract", "artifact_id"], "properties": { "contract": { "const": "axm.pixel-video-sequence/v1" }, "artifact_id": { "type": "string", "minLength": 1 } } },
    "provenance": { "type": "object", "required": ["recipe_id", "recipe_sha256", "engine", "author", "ai_used"] },
    "authority": { "type": "object", "required": ["candidate_only", "installed", "promoted", "canonical", "human_review_required"], "properties": { "candidate_only": { "const": true }, "installed": { "const": false }, "promoted": { "const": false }, "canonical": { "const": false }, "human_review_required": { "const": true } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
