  "additionalProperties": false,
  "properties": {
    "schema": { "const": "axm.reconciliation-request/v1" },
    "namespace": { "type": "string" },
    "reason": { "type": "string" },
    "localDigest": { "type": "string" },
    "remoteDigest": { "type": "string" },
    "ruleDigest": { "type": "string" },
    "requiresHuman": { "const": true },
    "grantsAuthority": { "const": false },
    "requestDigest": { "type": "string" }
  }
}
