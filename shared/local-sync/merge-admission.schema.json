{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.merge-admission/v1",
  "type": "object",
  "required": ["schema", "namespace", "ruleDigest", "admissionDigest"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "axm.merge-admission/v1" },
    "namespace": { "type": "string", "minLength": 1 },
    "ruleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "admissionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
