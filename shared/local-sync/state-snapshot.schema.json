{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.state-snapshot/v1",
  "type": "object",
  "required": ["schema", "id", "namespace", "valueSchema", "value", "revision", "parentDigests", "authorityDomain", "snapshotDigest"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "axm.state-snapshot/v1" },
    "id": { "type": "string", "minLength": 1 },
    "namespace": { "type": "string", "minLength": 1 },
    "valueSchema": { "type": "string", "minLength": 1 },
    "value": {},
    "revision": { "type": "integer", "minimum": 0 },
    "parentDigests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "authorityDomain": { "type": "string", "minLength": 1 },
    "snapshotDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
