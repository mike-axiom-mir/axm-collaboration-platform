{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.visual-stack-draft/v1",
  "title": "AXM Visual Stack Draft v1",
  "type": "object",
  "required": ["schema", "version", "id", "title", "canvas", "layers", "global_filters", "source_artifacts", "provenance", "authority", "visual_approval", "canonical"],
  "properties": {
    "schema": { "const": "axm.visual-stack-draft/v1" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "title": { "type": "string", "minLength": 1, "maxLength": 180 },
    "canvas": { "type": "object" },
    "layers": { "type": "array", "minItems": 1, "maxItems": 32 },
    "global_filters": { "type": "array", "maxItems": 64 },
    "source_artifacts": { "type": "array", "maxItems": 32 },
    "provenance": { "type": "array", "maxItems": 100 },
    "authority": { "const": "draft-only" },
    "visual_approval": { "const": false },
    "canonical": { "const": false }
  },
  "additionalProperties": false
}
