{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.portable-baseline-comparison/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "comparisonId", "comparedAt", "priorRef", "currentRef",
    "sameSubject", "state", "reasonCodes", "refreshRequired", "automaticAction", "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "axm.portable-baseline-comparison/v1"},
    "version": {"const": "0.1.0"},
    "comparisonId": {"type": "string", "minLength": 1, "maxLength": 180},
    "comparedAt": {"type": "string", "format": "date-time"},
    "priorRef": {"$ref": "#/$defs/reference"},
    "currentRef": {"$ref": "#/$defs/reference"},
    "sameSubject": {"type": "boolean"},
    "state": {"enum": ["NO_NEW_INFORMATION", "NEW_INFORMATION", "BASELINE_CHANGED", "INCOMPARABLE"]},
    "reasonCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "refreshRequired": {"type": "boolean"},
    "automaticAction": {"const": false},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
