{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.portable-baseline-capsule/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "capsuleId", "capturedAt", "subject", "contentRef",
    "configRef", "sourceRefs", "newInformationRefs", "generatedViews", "freshness",
    "limitations", "preservedSourceFields", "extensions", "adapter", "truth", "capsuleDigest"
  ],
  "properties": {
    "schema": {"const": "axm.portable-baseline-capsule/v1"},
    "version": {"const": "0.1.0"},
    "capsuleId": {"type": "string", "minLength": 1, "maxLength": 180},
    "capturedAt": {"type": "string", "format": "date-time"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {"enum": ["SOFTWARE_REPOSITORY", "MIRROR_STATE", "SPECIALIST_MASK"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "version": {"type": "string", "minLength": 1, "maxLength": 180}
      }
    },
    "contentRef": {"$ref": "#/$defs/reference"},
    "configRef": {"$ref": "#/$defs/reference"},
    "sourceRefs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/reference"}},
    "newInformationRefs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/reference"}},
    "generatedViews": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["viewId", "viewRef", "state", "checkedAt", "reason"],
        "properties": {
          "viewId": {"type": "string", "minLength": 1, "maxLength": 180},
          "viewRef": {"$ref": "#/$defs/reference"},
          "state": {"enum": ["CURRENT", "STALE", "UNKNOWN"]},
          "checkedAt": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 800}
        }
      }
    },
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "refreshRequired", "reasonCodes"],
      "properties": {
        "state": {"enum": ["CURRENT", "REFRESH_REQUIRED", "NOT_APPLICABLE"]},
        "refreshRequired": {"type": "boolean"},
        "reasonCodes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "preservedSourceFields": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "sourceRef", "reason"],
        "properties": {
          "field": {"type": "string", "minLength": 1, "maxLength": 180},
          "sourceRef": {"$ref": "#/$defs/reference"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "extensions": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["namespace", "extensionRef", "note"],
        "properties": {
          "namespace": {"type": "string", "minLength": 1, "maxLength": 180},
          "extensionRef": {"$ref": "#/$defs/reference"},
          "note": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "adapter": {
      "oneOf": [
        {"$ref": "#/$defs/softwareAdapter"},
        {"$ref": "#/$defs/mirrorAdapter"},
        {"$ref": "#/$defs/specialistAdapter"}
      ]
    },
    "truth": {
      "type": "object", "additionalProperties": false,
      "required": [
        "authority", "sourceBytesEmbedded", "sourceExecuted", "automaticWrite",
        "automaticInstall", "automaticPermissionGrant", "automaticPromotion",
        "automaticMerge", "automaticCanon", "foundationMutation",
        "modelWeightTrainingClaimed", "humanMergeGateRequired"
      ],
      "properties": {
        "authority": {"const": "IDENTITY_AND_EVIDENCE_LINKING_ONLY"},
        "sourceBytesEmbedded": {"const": false},
        "sourceExecuted": {"const": false},
        "automaticWrite": {"const": false},
        "automaticInstall": {"const": false},
        "automaticPermissionGrant": {"const": false},
        "automaticPromotion": {"const": false},
        "automaticMerge": {"const": false},
        "automaticCanon": {"const": false},
        "foundationMutation": {"const": false},
        "modelWeightTrainingClaimed": {"const": false},
        "humanMergeGateRequired": {"const": true}
      }
    },
    "capsuleDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "softwareAdapter": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryId", "versionOrCommit", "workingTree"],
      "properties": {
        "repositoryId": {"type": "string", "minLength": 1, "maxLength": 180},
        "versionOrCommit": {"type": "string", "minLength": 1, "maxLength": 220},
        "workingTree": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "statusRef"],
          "properties": {
            "state": {"enum": ["CLEAN", "DIRTY", "UNKNOWN"]},
            "statusRef": {"$ref": "#/$defs/reference"}
          }
        }
      }
    },
    "mirrorAdapter": {
      "type": "object", "additionalProperties": false,
      "required": ["originalBaselineRef", "privateLessons", "challenger"],
      "properties": {
        "originalBaselineRef": {"$ref": "#/$defs/reference"},
        "privateLessons": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["stateRef", "visibility"],
              "properties": {
                "stateRef": {"$ref": "#/$defs/reference"},
                "visibility": {"enum": ["PRIVATE", "RESTRICTED"]}
              }
            }
          ]
        },
        "challenger": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["stateRef", "disposable"],
              "properties": {
                "stateRef": {"$ref": "#/$defs/reference"},
                "disposable": {"const": true}
              }
            }
          ]
        }
      }
    },
    "specialistAdapter": {
      "type": "object", "additionalProperties": false,
      "required": ["hostModel", "mask", "allowedCapabilities", "evidenceCeiling", "permissionGrant", "identityEffect"],
      "properties": {
        "hostModel": {
          "type": "object", "additionalProperties": false,
          "required": ["providerFamily", "modelId", "version", "receiptRef"],
          "properties": {
            "providerFamily": {"type": "string", "minLength": 1, "maxLength": 120},
            "modelId": {"type": "string", "minLength": 1, "maxLength": 180},
            "version": {"type": "string", "minLength": 1, "maxLength": 180},
            "receiptRef": {"$ref": "#/$defs/reference"}
          }
        },
        "mask": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "schema", "version", "packageRef"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 180},
            "schema": {"type": "string", "minLength": 1, "maxLength": 180},
            "version": {"type": "string", "minLength": 1, "maxLength": 180},
            "packageRef": {"$ref": "#/$defs/reference"}
          }
        },
        "allowedCapabilities": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 180}},
        "evidenceCeiling": {"enum": ["OPERATOR_DECLARATION", "STATIC_ONLY", "SYNTHETIC_ONLY", "MIXED", "INDEPENDENT_RUNTIME"]},
        "permissionGrant": {"const": "NONE"},
        "identityEffect": {"const": "OVERLAY_ONLY"}
      }
    }
  }
}
