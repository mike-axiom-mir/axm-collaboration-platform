{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.element-composition/v1",
  "title": "AXM Element Composition v1",
  "type": "object",
  "required": ["schema", "id", "version", "title", "target", "elements", "placements", "bindings", "outputs", "policy", "digest"],
  "properties": {
    "schema": { "const": "axm.element-composition/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["context", "canvas", "allowed_categories"],
      "properties": {
        "context": { "type": "string", "minLength": 1 },
        "canvas": { "type": "string", "minLength": 1 },
        "allowed_categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "elements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/instance" } },
    "placements": { "type": "array", "items": { "$ref": "#/$defs/placement" } },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } },
    "policy": {
      "type": "object",
      "required": ["acyclic", "missing_element", "category_conflict", "execution_authority"],
      "properties": {
        "acyclic": { "const": true },
        "missing_element": { "const": "fail" },
        "category_conflict": { "const": "fail" },
        "execution_authority": { "const": "none" }
      },
      "additionalProperties": false
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "instance": {
      "type": "object",
      "required": ["instance_id", "element_id", "element_version", "element_digest"],
      "properties": {
        "instance_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
        "element_id": { "type": "string" },
        "element_version": { "type": "string" },
        "element_digest": { "$ref": "#/$defs/digest" },
        "configuration": { "type": "object" }
      },
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "required": ["instance_id", "region", "order"],
      "properties": {
        "instance_id": { "type": "string" },
        "region": { "type": "string", "minLength": 1 },
        "order": { "type": "integer" },
        "configuration": { "type": "object" }
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": ["instance_id", "port"],
      "properties": { "instance_id": { "type": "string" }, "port": { "type": "string" } },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["from", "to", "relation"],
      "properties": {
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "relation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["id", "instance_id", "port", "role"],
      "properties": {
        "id": { "type": "string" },
        "instance_id": { "type": "string" },
        "port": { "type": "string" },
        "role": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
