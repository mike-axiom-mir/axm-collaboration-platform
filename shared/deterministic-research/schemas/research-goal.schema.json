{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.research-goal/v1",
  "type": "object",
  "required": ["schema", "id", "title", "objective", "requirements", "authority", "goalDigest"],
  "properties": {
    "schema": {"const": "axm.research-goal/v1"},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "authority": {"const": "RECOMMENDATION_ONLY"},
    "goalDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requirements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "capabilities", "required", "priority", "gapType"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "required": {"type": "boolean"},
          "priority": {"type": "integer", "minimum": 0, "maximum": 100},
          "gapType": {"enum": ["HAND", "SKILL", "AUTHORITY", "SUBSTRATE", "EVIDENCE", "CONTRACT", "UNKNOWN"]}
        }
      }
    }
  }
}
