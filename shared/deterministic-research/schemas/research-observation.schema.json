{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.research-observation/v1",
  "type": "object",
  "required": ["schema", "id", "claimId", "surface", "verdict", "observedAt", "observer", "evidenceRefs"],
  "properties": {
    "schema": {"const": "axm.research-observation/v1"},
    "id": {"type": "string", "minLength": 1},
    "claimId": {"type": "string", "minLength": 1},
    "surface": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "observedAt": {"type": "string", "minLength": 1},
    "observer": {
      "type": "object", "required": ["id", "kind"],
      "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}}
    },
    "evidenceRefs": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"type": "string", "minLength": 16}}}
    }
  }
}
