{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.change-packet/v1",
  "title": "AXM Mirror Change Packet",
  "type": "object",
  "required": ["packet_id", "schema_version", "source_system", "target_system", "source_snapshot_id", "target_snapshot_id", "actor", "intent", "reason", "operations", "affected_entities", "expected_preconditions", "evidence_refs", "risk_level", "reversibility", "requested_permissions", "approval_requirements", "created_at", "status", "validation_results", "reviewer_decisions"],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^packet:[a-z0-9._-]+(?::[a-z0-9._-]+)+$"},
    "schema_version": {"const": "axm.mirror.change-packet/v1"},
    "source_system": {"type": "string"},
    "target_system": {"type": "string"},
    "source_snapshot_id": {"type": ["string", "null"]},
    "target_snapshot_id": {"type": ["string", "null"]},
    "target_revision": {"type": "integer", "minimum": 0},
    "authority_revision": {"type": "integer", "minimum": 0},
    "actor": {"type": "object"},
    "intent": {"type": "string"},
    "reason": {"type": "string"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object"}},
    "affected_entities": {"type": "array", "items": {"type": "string"}},
    "expected_preconditions": {"type": "array", "items": {"type": "object"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "reversibility": {"enum": ["reversible", "conditional", "not_reversible", "unknown"]},
    "requested_permissions": {"type": "array", "items": {"type": "string"}},
    "approval_requirements": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"type": "string"},
    "validation_results": {"type": "array", "items": {"type": "object"}},
    "reviewer_decisions": {"type": "array", "items": {"type": "object"}},
    "application_receipt": {"type": ["object", "null"]},
    "rollback_reference": {"type": ["object", "null"]},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
