{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.party.session/v1",
  "title": "AXM Party Session Compatibility Contract",
  "description": "Forward contract for incoming shared controls. It is not a Mirror Change Packet.",
  "type": "object",
  "required": ["schema_version", "session_id", "game_id", "status", "host_actor_id", "min_seats", "max_seats", "team_layout", "seat_ids", "ready_policy", "local_authority", "default_ai_fill", "created_at"],
  "properties": {
    "schema_version": {"const": "axm.party.session/v1"},
    "session_id": {"type": "string", "pattern": "^session:[a-z0-9._-]+:[a-z0-9._-]+$"},
    "game_id": {"type": "string"},
    "status": {"enum": ["draft", "lobby", "running", "paused", "ended", "failed"]},
    "host_actor_id": {"type": "string"},
    "min_seats": {"type": "integer", "minimum": 1, "maximum": 8},
    "max_seats": {"type": "integer", "minimum": 1, "maximum": 8},
    "team_layout": {
      "type": "array",
      "description": "Teams may be uneven, including 1v1, 2v3, free-for-all, or cooperative layouts.",
      "items": {
        "type": "object",
        "required": ["team_id", "seat_ids"],
        "properties": {
          "team_id": {"type": "string"},
          "label": {"type": "string"},
          "seat_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "seat_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "ready_policy": {"enum": ["all_occupied_ready", "host_selected_ready_subset", "game_contract"]},
    "local_authority": {"const": true},
    "default_ai_fill": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
