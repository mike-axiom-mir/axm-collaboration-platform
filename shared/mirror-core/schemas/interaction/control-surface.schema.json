{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.controls.surface/v1",
  "title": "AXM Shared Control Surface",
  "type": "object",
  "required": ["schema_version", "control_surface_id", "game_id", "version", "actions", "rate_limits", "actor_neutral", "hidden_machine_actions", "input_intentions_only"],
  "properties": {
    "schema_version": {"const": "axm.controls.surface/v1"},
    "control_surface_id": {"type": "string"},
    "game_id": {"type": "string"},
    "version": {"type": "string"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "input_schema"],
        "properties": {
          "action_id": {"type": "string"},
          "description": {"type": "string"},
          "input_schema": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "rate_limits": {"type": "object"},
    "actor_neutral": {"const": true},
    "hidden_machine_actions": {"const": false},
    "input_intentions_only": {"const": true}
  },
  "additionalProperties": false
}
