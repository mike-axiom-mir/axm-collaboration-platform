{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.controls.seat-binding/v1",
  "title": "AXM Visible Seat Binding",
  "type": "object",
  "required": ["schema_version", "binding_id", "session_id", "seat_id", "actor_id", "actor_type", "controller_kind", "controller_adapter_id", "control_surface_id", "observation_scope_id", "assignment_status", "assigned_by", "consent_id", "permissions", "visible_to_party", "created_at"],
  "properties": {
    "schema_version": {"const": "axm.controls.seat-binding/v1"},
    "binding_id": {"type": "string"},
    "session_id": {"type": "string"},
    "seat_id": {"type": "string"},
    "actor_id": {"type": "string"},
    "actor_type": {"enum": ["human", "ai"]},
    "controller_kind": {"enum": ["human_client", "ai_adapter"]},
    "controller_adapter_id": {"type": ["string", "null"]},
    "control_surface_id": {"type": "string"},
    "observation_scope_id": {"type": "string"},
    "assignment_status": {"enum": ["proposed", "assigned", "ready", "playing", "paused", "disconnected", "released"]},
    "assigned_by": {"type": "string"},
    "consent_id": {"type": "string"},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "visible_to_party": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
