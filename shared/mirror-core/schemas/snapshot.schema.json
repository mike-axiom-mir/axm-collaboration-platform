{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.snapshot/v1",
  "title": "AXM Mirror Snapshot",
  "type": "object",
  "required": ["snapshot_id", "schema_version", "system_id", "adapter_id", "revision", "created_at", "created_by", "state_hash", "state", "purpose"],
  "properties": {
    "snapshot_id": {"type": "string"},
    "schema_version": {"const": "axm.mirror.snapshot/v1"},
    "system_id": {"type": "string"},
    "adapter_id": {"type": "string"},
    "revision": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "object"},
    "state_hash": {"type": "string"},
    "state": {"type": "object"},
    "purpose": {"type": "string"},
    "related_packet": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
