{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.type.material/v1",
  "title": "Material type data",
  "type": "object",
  "required": ["material_id", "category", "source", "dimensions", "mass", "moisture", "density", "strength_properties", "thermal_properties", "condition", "measurement_quality", "physical_truth_status", "provenance"],
  "properties": {
    "material_id": {"type": "string"},
    "category": {"type": "string"},
    "source": {"type": "object"},
    "dimensions": {"type": ["object", "null"]},
    "mass": {"type": ["object", "null"]},
    "moisture": {"type": ["object", "null"]},
    "density": {"type": ["object", "null"]},
    "strength_properties": {"type": ["object", "null"]},
    "thermal_properties": {"type": ["object", "null"]},
    "condition": {"type": "string"},
    "measurement_quality": {"enum": ["unknown", "estimated", "measured", "independently_checked"]},
    "physical_truth_status": {"type": "string"},
    "provenance": {"type": "array"}
  },
  "additionalProperties": true
}
