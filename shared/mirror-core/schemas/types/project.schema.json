{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.mirror.type.project/v1",
  "title": "Project type data",
  "type": "object",
  "required": ["project_status", "goals", "milestones", "tasks", "workspaces", "evidence_gate", "source_document_schema"],
  "properties": {
    "project_status": {"enum": ["planning", "active", "paused", "review", "complete", "archived"]},
    "goals": {"type": "array"},
    "milestones": {"type": "array"},
    "tasks": {"type": "array"},
    "workspaces": {"type": "array"},
    "evidence_gate": {"type": "object"},
    "source_document_schema": {"type": "string"}
  },
  "additionalProperties": true
}
