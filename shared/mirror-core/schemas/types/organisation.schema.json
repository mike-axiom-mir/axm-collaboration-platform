    "privacy_class": {"enum": ["public", "internal", "restricted", "private", "mixed"]},
    "roles": {"type": "array"},
    "teams": {"type": "array"},
    "workspaces": {"type": "array"},
    "processes": {"type": "array"},
    "projects": {"type": "array"},
    "tools": {"type": "array"},
    "policies": {"type": "array"},
    "external_references": {"type": "array"},
    "mirror_scope": {"type": "object"},
    "connection_mode": {"type": "string"},
    "evidence": {"type": "array"},
    "limitations": {"type": "array"}
  },
  "additionalProperties": true
}
