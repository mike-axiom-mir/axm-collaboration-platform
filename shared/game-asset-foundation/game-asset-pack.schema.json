{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.game-asset-pack/v1",
  "title": "AXM Game Asset Pack",
  "type": "object",
  "required": ["schema", "version", "id", "profile", "status", "assets", "previews", "report", "authority"],
  "properties": {
    "schema": { "const": "axm.game-asset-pack/v1" },
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["TECHNICAL_BASELINE_PASS", "PS2_TECHNICAL_CANDIDATE_PASS", "HOLD"] },
    "profile": { "type": "object" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "lods", "collision"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "enum": ["building", "road", "prop", "vehicle", "character"] },
          "lods": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["level", "path", "triangles", "vertices", "bounds"],
              "properties": {
                "level": { "type": "integer", "minimum": 0, "maximum": 2 },
                "path": { "type": "string" },
                "triangles": { "type": "integer", "minimum": 1 },
                "vertices": { "type": "integer", "minimum": 3 }
              }
            }
          },
          "collision": { "type": "string" }
        }
      }
    },
    "previews": {
      "type": "object",
      "required": ["contactSheet", "runtime"],
      "properties": {
        "contactSheet": { "type": "string" },
        "runtime": { "type": "string" }
      }
    },
    "report": { "type": "object" },
    "authority": {
      "type": "object",
      "required": ["candidateOnly", "automaticImport", "automaticPublish", "nativeEngineWrite"],
      "properties": {
        "candidateOnly": { "const": true },
        "automaticImport": { "const": false },
        "automaticPublish": { "const": false },
        "nativeEngineWrite": { "const": false }
      }
    }
  }
}
