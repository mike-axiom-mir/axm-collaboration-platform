        "normalizedAnchorContinuityProfilesCompared":{"const":true},"normalizedWitnessContinuityProfilesCompared":{"const":true},
        "completeOrderedHistoryEntriesCompared":{"const":true},"anchorEpochOrderingChecked":{"const":true},
