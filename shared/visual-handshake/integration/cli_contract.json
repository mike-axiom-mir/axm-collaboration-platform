{
  "schema": "axm.visual-handshake.cli-contract.v1",
  "entrypoint": "python app/visual_handshake.py",
  "machine_output": "JSON",
  "skill_routes": {
    "router": "axm-visual-handshake",
    "receive_and_inspect": "axm-visual-intake",
    "publish_existing_artifact": "axm-visual-publish",
    "render_preview": "axm-visual-snapshot",
    "dashboard_lifecycle": "axm-visual-runtime"
  },
  "commands": {
    "receive_latest_from_mike": "latest-from-mike",
    "publish_file_to_mike": "send-to-mike --file PATH --title TITLE --note NOTE",
    "publish_local_preview_to_mike": "snapshot-url LOCAL_URL_OR_HTML --title TITLE --note NOTE",
    "publish_note_to_mike": "note-to-mike --text TEXT --title TITLE",
    "open_capture_button": "open-dashboard --mode capture",
    "open_latest_button": "open-dashboard --mode latest",
    "health": "status"
  }
}
