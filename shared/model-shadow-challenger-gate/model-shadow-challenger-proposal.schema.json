{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.model-shadow-challenger-proposal/v1",
  "title": "AXM Model Shadow Challenger Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "proposalId", "generatedAt", "status",
    "observationRef", "snapshotRefs", "outputRefs", "classification",
    "state", "currentBestAction", "plan", "reviewProjection", "truth",
    "proposalDigest"
  ],
  "properties": {
    "schema": {"const": "axm.model-shadow-challenger-proposal/v1"},
    "version": {"const": "0.1.0"},
    "proposalId": {"type": "string", "minLength": 1, "maxLength": 180},
    "generatedAt": {"type": "string", "format": "date-time"},
    "status": {"const": "TEST"},
    "observationRef": {"$ref": "#/$defs/reference"},
    "snapshotRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": {"$ref": "#/$defs/reference"},
        "candidate": {"$ref": "#/$defs/reference"}
      }
    },
    "outputRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": {"$ref": "#/$defs/reference"},
        "candidate": {"$ref": "#/$defs/reference"}
      }
    },
    "classification": {
      "enum": [
        "STRUCTURED_TRACE_MATCH", "DRIFT_DETECTED", "CRITICAL_DRIFT",
        "HOLD_TASK_MISMATCH", "CONTEXT_CHANGED_COMPARISON_NOT_VALID",
        "IDENTITY_CHANGED_COMPARISON_NOT_VALID", "HOLD_NON_FORWARD_SEQUENCE"
      ]
    },
    "state": {
      "enum": [
        "CHALLENGER_PLAN_READY_FOR_EXPLICIT_REVIEW",
        "HOLD_INVALID_COMPARISON",
        "HOLD_CRITICAL_AUTHORITY_DRIFT",
        "NO_STRUCTURED_DRIFT_TO_CHALLENGE",
        "HOLD_NO_DISTINCT_OUTPUT_ARTIFACTS"
      ]
    },
    "currentBestAction": {"type": "string", "minLength": 1},
    "plan": {"type": ["object", "null"]},
    "reviewProjection": {"type": ["object", "null"]},
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationVerifiedByExactRebuild", "ordinaryDriftRequiredForPlan",
        "criticalAuthorityDriftHeld", "invalidComparisonHeld",
        "distinctOutputArtifactsRequired", "sourceDirectionInvented",
        "challengerPlanVerifiedNatively", "rawModelOutputEmbedded",
        "privateContextEmbedded", "reviewSubmitted",
        "declaredHumanReviewRecorded", "experimentExecuted",
        "evaluationPerformed", "adoptionAuthorized", "humanBenefitProven",
        "sharedGrowthClaimed", "broadLearningClaimed", "automaticExecution",
        "automaticWrite", "automaticInstall", "automaticPermissionGrant",
        "automaticPromotion", "automaticMerge", "automaticCanon",
        "foundationMutation"
      ],
      "properties": {
        "observationVerifiedByExactRebuild": {"const": true},
        "ordinaryDriftRequiredForPlan": {"const": true},
        "criticalAuthorityDriftHeld": {"type": "boolean"},
        "invalidComparisonHeld": {"type": "boolean"},
        "distinctOutputArtifactsRequired": {"const": true},
        "sourceDirectionInvented": {"const": false},
        "challengerPlanVerifiedNatively": {"type": "boolean"},
        "rawModelOutputEmbedded": {"const": false},
        "privateContextEmbedded": {"const": false},
        "reviewSubmitted": {"const": false},
        "declaredHumanReviewRecorded": {"const": false},
        "experimentExecuted": {"const": false},
        "evaluationPerformed": {"const": false},
        "adoptionAuthorized": {"const": false},
        "humanBenefitProven": {"const": false},
        "sharedGrowthClaimed": {"const": false},
        "broadLearningClaimed": {"const": false},
        "automaticExecution": {"const": false},
        "automaticWrite": {"const": false},
        "automaticInstall": {"const": false},
        "automaticPermissionGrant": {"const": false},
        "automaticPromotion": {"const": false},
        "automaticMerge": {"const": false},
        "automaticCanon": {"const": false},
        "foundationMutation": {"const": false}
      }
    },
    "proposalDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 180},
        "schema": {"type": "string", "minLength": 1, "maxLength": 180},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
