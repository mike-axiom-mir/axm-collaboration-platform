{
  "schema": "axm.shared-service-contract/v1",
  "id": "ai-native-hands",
  "version": "1.0.0",
  "status": "TEST",
  "provides": [
    "evidence.route.claim/v1",
    "capability.compare.requirements/v1",
    "evidence.curate.session/v1",
    "visual.capture.ephemeral-rolling-buffer/v1",
    "visual.capture.windows-native/v1"
  ],
  "accepts": [
    "atomic claim and risk",
    "normalized capability requirements and declared inventory",
    "state-root evidence events and exact Eye-owned cleanup manifest",
    "explicit-consented browser MediaStream",
    "active human-approved native visual capture lease"
  ],
  "produces": [
    "axm.evidence-route/v1",
    "axm.capability-gap-report/v1",
    "axm.ephemeral-cleanup-receipt/v1",
    "axm.ephemeral-visual-receipt/v1",
    "axm.ephemeral-contact-sheet/v1",
    "axm.windows-native-capture/v1"
  ],
  "dependencies": [
    "shared/evidence-retention/evidence-retention-service.js",
    "browser MediaDevices and Canvas APIs for portable visual capture",
    "built-in Windows .NET C# compiler, Windows Forms and System.Drawing for native visual capture"
  ],
  "routing": {
    "preferredOnWindows": "visual.capture.windows-native/v1",
    "portableFallback": "visual.capture.ephemeral-rolling-buffer/v1",
    "requiresHumanApprovedLease": true
  },
  "boundaries": {
    "automaticWrites": ["append governed evidence", "seal explicitly selected session", "delete digest-matched Eye-owned temporary files"],
    "refuses": [
      "automatic verdict",
      "automatic dependency installation",
      "automatic permission grant or capture-lease activation",
      "raw-video memory archive",
      "user or source media deletion",
      "path-pattern cleanup",
      "automatic publishing"
    ]
  }
}
