  "additionalProperties": false,
  "properties": {
    "schema": { "const": "axm.executor-declaration/v1" },
    "id": { "type": "string" },
    "substrate": { "type": "string" },
    "effectClasses": { "type": "array", "items": { "type": "string" } },
    "budget": { "type": "object" },
    "denialProbes": { "type": "array" },
    "knownGaps": { "type": "array", "items": { "type": "string" } },
    "cancellation": { "type": "string" },
    "cleanup": { "type": "string" },
    "confinement": { "type": "object" }
  }
}
