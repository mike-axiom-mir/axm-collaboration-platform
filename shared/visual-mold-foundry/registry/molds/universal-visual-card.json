{
  "schema": "axm.visual-mold/0.2",
  "id": "axm.mold.universal-visual-card",
  "name": "Universal Visual Card",
  "version": "0.2.0",
  "category": "marketing",
  "description": "Responsive visual card for services, milestones, products, events, and public-safe explanations.",
  "lineage": {
    "parent": null,
    "derived_from": [
      "AXM_VISUAL_MOLD_RESEARCH_BUILD_LOG_2026-07-28"
    ],
    "change_policy": "explicit-approval"
  },
  "core": {
    "protected": [
      "layout.reading_order",
      "brand.safe_area",
      "accessibility.semantic_structure",
      "provenance"
    ]
  },
  "inputs": {
    "title": {
      "type": "text",
      "maximum_characters": 70,
      "default": "Build beyond the template."
    },
    "message": {
      "type": "text",
      "maximum_characters": 320,
      "default": "A local visual capability layer made from governed molds, reusable organs, and proof."
    },
    "badge": {
      "type": "text",
      "maximum_characters": 30,
      "default": "AXM VISUAL FOUNDRY"
    },
    "media": {
      "type": "slot",
      "accepts": [
        "image",
        "generated-scene"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "energy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.52
    },
    "glow": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.8,
      "default": 0.28
    },
    "metric": {
      "type": "text",
      "maximum_characters": 18,
      "default": "2050"
    },
    "cta": {
      "type": "text",
      "maximum_characters": 42,
      "default": "Inspect \u00b7 derive \u00b7 prove"
    },
    "density": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.44
    },
    "depth": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.58
    }
  },
  "variants": {
    "theme": [
      "aetherglass",
      "paper-neon",
      "rooted-machine",
      "public-calm",
      "crystal-signal",
      "nightclub-machine"
    ],
    "format": [
      "square",
      "portrait",
      "landscape",
      "phone"
    ],
    "motion": [
      "still",
      "ambient"
    ],
    "performance": [
      "low",
      "standard",
      "ultra"
    ],
    "state": [
      "idle",
      "warning",
      "success"
    ]
  },
  "organs": [
    "axm.layout.responsive-focus",
    "axm.layout.safe-area",
    "axm.layout.title-media-balance",
    "axm.layout.aspect-adapter",
    "axm.typography.title-fit",
    "axm.typography.contrast-shield",
    "axm.skin.aetherglass",
    "axm.light.rim",
    "axm.effect.edge-glow",
    "axm.state.reduced-motion"
  ],
  "checks": [
    "axm.validate.schema",
    "axm.validate.dependency",
    "axm.validate.id-uniqueness",
    "axm.validate.contrast",
    "axm.validate.overflow",
    "axm.validate.safe-area",
    "axm.validate.provenance",
    "axm.validate.performance",
    "axm.validate.reduced-motion",
    "axm.validate.protected-field",
    "axm.validate.export-readiness"
  ],
  "dependencies": [],
  "provenance": {
    "author": "Mike \u2014 Axiom/Mir + ChatGPT steward build",
    "source": "AXM visual mold continuity handoff 2026-07-28",
    "license": "AXM private workshop / user-controlled",
    "rights_scope": "private-local",
    "consent": "user supplied build request",
    "transformation_history": [
      "architecture handoff",
      "functional v0.1 implementation",
      "steward v0.2 theme contract, comparison, batch and workspace upgrade"
    ]
  },
  "outputs": [
    "json",
    "html",
    "svg",
    "png",
    "proof-html",
    "proof-png",
    "mold-package",
    "webp",
    "theme-css",
    "batch-gallery",
    "workspace"
  ],
  "approval_state": "EXPERIMENTAL",
  "performance_tier": "low-standard-ultra",
  "preview": "previews/universal-card.svg",
  "public_scope": "private",
  "renderer": "card",
  "composition_level": 4,
  "theme_contract": "registry/themes/themes.json",
  "renderer_options": {
    "layout": "editorial-split",
    "visual_role": "general",
    "media_shape": "orbital-window",
    "accent_pattern": "energy-routes"
  }
}