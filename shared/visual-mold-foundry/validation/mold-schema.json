{
  "schema": "axm.mold-schema/0.2",
  "name": "AXM Visual Mold",
  "version": "0.2.0",
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "lineage",
    "core",
    "inputs",
    "variants",
    "organs",
    "checks",
    "dependencies",
    "provenance",
    "outputs",
    "approval_state",
    "performance_tier",
    "renderer",
    "composition_level",
    "theme_contract"
  ],
  "id_pattern": "^axm\\.[a-z0-9._-]+$",
  "approval_states": [
    "EXPERIMENTAL",
    "APPROVED",
    "DEPRECATED"
  ],
  "protected_policy": "Protected paths may change only through explicit derivation with a recorded protected_change_request.",
  "input_types": [
    "text",
    "number",
    "enum",
    "boolean",
    "slot"
  ],
  "variant_axes": [
    "theme",
    "format",
    "motion",
    "performance",
    "state"
  ],
  "allowed_renderers": [
    "card",
    "living-skin",
    "portal-scene"
  ]
}