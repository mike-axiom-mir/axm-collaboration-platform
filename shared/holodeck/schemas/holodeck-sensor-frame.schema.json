{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.holodeck-sensor-frame/v1",
  "title": "AXM Holodeck structured sensory frame",
  "type": "object",
  "required": ["schema", "worldId", "stateDigest", "revision", "tick", "observer", "embodiment", "nearby", "objective", "truth", "frameDigest"],
  "properties": {
    "schema": {"const":"axm.holodeck-sensor-frame/v1"},
    "nearby": {"type":"array"},
    "truth": {"type":"object","required":["source","cameraPixelsObserved","visualOcclusionResolved"]},
    "frameDigest": {"type":"string"}
  }
}
