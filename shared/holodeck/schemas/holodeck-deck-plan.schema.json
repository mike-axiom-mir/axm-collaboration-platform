{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.holodeck-deck-plan/v1",
  "title": "AXM Holodeck renderer-neutral deck plan",
  "type": "object",
  "required": ["schema", "worldId", "worldDigest", "coordinateProjection", "environment", "nodes", "interactions", "spawnPoints", "adapterContract", "planDigest"],
  "properties": {
    "schema": {"const": "axm.holodeck-deck-plan/v1"},
    "worldId": {"type": "string"},
    "worldDigest": {"type": "string"},
    "nodes": {"type": "array"},
    "interactions": {"type": "array"},
    "adapterContract": {"const": "axm.holodeck-render-adapter/v1"},
    "planDigest": {"type": "string"}
  }
}
