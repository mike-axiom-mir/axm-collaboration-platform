{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/deterministic-animation-composition-v1.schema.json",
  "title": "AXM Deterministic Animation Composition v1",
  "description": "A candidate-only composition of embedded deterministic animation recipes with bounded rational time mapping and ordered fixed-point blends.",
  "type": "object",
  "required": ["schema", "version", "id", "seed", "loop", "timebase", "sources", "layers", "events", "presentation", "authority"],
  "properties": {
    "schema": { "const": "axm.deterministic-animation-composition/v1" },
    "version": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "seed": { "type": "string", "minLength": 1, "maxLength": 200 },
    "loop": { "type": "boolean" },
    "timebase": {
      "type": "object",
      "required": ["ticks_per_second", "frames_per_second", "duration_ticks"],
      "properties": {
        "ticks_per_second": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "frames_per_second": { "type": "integer", "minimum": 1, "maximum": 240 },
        "duration_ticks": { "type": "integer", "minimum": 1, "maximum": 600000000 }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "recipe"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "recipe": { "$ref": "https://axm.local/schemas/deterministic-animation-recipe-v1.schema.json" }
        },
        "additionalProperties": false
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["id", "source", "order", "start_tick", "end_tick", "source_in_tick", "rate", "playback", "blend", "weight", "target_prefix", "properties"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "$ref": "#/$defs/id" },
          "order": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
          "start_tick": { "type": "integer", "minimum": 0 },
          "end_tick": { "type": "integer", "minimum": 1 },
          "source_in_tick": { "type": "integer", "minimum": 0 },
          "rate": {
            "type": "object",
            "required": ["numerator", "denominator"],
            "properties": {
              "numerator": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "denominator": { "type": "integer", "minimum": 1, "maximum": 1000 }
            },
            "additionalProperties": false
          },
          "playback": { "enum": ["clamp", "loop", "ping-pong"] },
          "blend": { "enum": ["replace", "add", "multiply"] },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "target_prefix": { "type": "string", "maxLength": 120, "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
          "properties": {
            "type": "array",
            "maxItems": 512,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["id", "tick", "kind", "payload"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "tick": { "type": "integer", "minimum": 0 },
          "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
          "payload": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "presentation": { "type": "object" },
    "authority": {
      "type": "object",
      "required": ["installed", "promoted", "canonical", "human_visual_review_required"],
      "properties": {
        "installed": { "const": false },
        "promoted": { "const": false },
        "canonical": { "const": false },
        "human_visual_review_required": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" }
  }
}
