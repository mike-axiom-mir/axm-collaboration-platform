  ],
  "merge_semantics": [
    "CRDT_MERGEABLE",
    "APPEND_ONLY",
    "LAST_WRITER_NOT_ALLOWED",
    "HUMAN_RECONCILIATION_REQUIRED",
    "SINGLE_AUTHORITY",
    "IMMUTABLE"
  ],
