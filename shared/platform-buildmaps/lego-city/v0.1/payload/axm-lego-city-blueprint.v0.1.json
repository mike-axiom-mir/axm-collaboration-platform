        "typed-merge-semantics",
        "human-reconciliation"
      ],
      "refuses": [
        "automatic-root-merge",
        "automatic-authority-merge"
      ]
    },
    {
      "id": "twin-surfaces",
      "name": "Human/Machine Twin Surfaces",
      "priority": 5,
      "provides": [
        "human-city-map",
        "machine-capability-resolver",
        "shared-truth-surface"
      ]
    },
    {
      "id": "intake-harbor",
      "name": "Quarantined Intake Harbor",
      "priority": 6,
      "provides": [
        "package-inventory",
        "permission-effect-diff",
        "temporary-test-install",
        "promotion-proposal"
      ]
    },
    {
      "id": "city-gates",
      "name": "External City Gates",
      "priority": 6,
      "provides": [
        "mcp-adapter",
        "a2a-adapter",
        "github-adapter",
        "oci-export",
        "optional-public-attestation"
      ],
      "refuses": [
        "external-protocol-as-internal-canon"
      ]
