  "phases": [
    {
      "id": 0,
      "name": "Truthful map",
      "exit_gates": [
        "no live manifest or contract can be silently unindexed",
        "generated views byte-match clean regeneration",
        "semantic digest excludes timestamps and machine-local paths"
      ]
    },
    {
      "id": 1,
      "name": "Grammar without migration",
      "exit_gates": [
        "existing modules compile without rewrite",
        "duplicate IDs fail",
        "incompatible sockets are explicit"
      ]
    },
    {
      "id": 2,
      "name": "Artifact Depot and Event Streets",
      "exit_gates": [
        "interrupted writes cannot produce valid artifacts",
        "event replay reproduces derived projection",
        "no automatic deletion"
      ]
    },
    {
      "id": 3,
      "name": "Authority Grid and Hands Rail",
      "exit_gates": [
        "capability does not grant authority",
        "stale decisions fail",
        "effect target matches exact digest and scope",
        "partial failure is typed"
      ]
    },
    {
      "id": 4,
      "name": "Durable Workflow Transit",
      "exit_gates": [
        "same locked route reproduces plan digest",
        "resume cannot skip unverified work",
        "domain profile cannot expand authority"
      ]
    },
    {
      "id": 5,
      "name": "Twin Surfaces",
      "exit_gates": [
        "human labels never exceed machine truth",
        "every human effect maps to an exact packet",
        "beginner view preserves capability and risk"
      ]
    },
    {
      "id": 6,
      "name": "City Gates and distribution",
      "exit_gates": [
        "private local operation works with external gates disabled",
        "adapters cannot become internal authority",
        "public package can be independently verified"
      ]
    }
  ],
  "next_build": {
    "id": "axm-city-map-gate-v0.1",
    "goal": "Make omission of a real declared module from the machine map a CI failure.",
    "mode": "read-only deterministic compiler and verifier",
    "required_negative_tests": [
      "UNINDEXED_MODULE",
      "CITY_GRAPH_DRIFT",
      "DUPLICATE_BLOCK_ID",
      "UNRESOLVED_SCHEMA",
      "EFFECT_PERMISSION_DRIFT",
      "AUTHORITY_MAP_STALE",
      "HUMAN_VIEW_DRIFT"
    ],
    "explicit_non_authority": [
      "install",
      "execute",
      "network-write",
      "promote",
      "merge",
      "canon",
      "roots"
    ]
  },
  "non_goals": [
    "one giant AXM kernel",
    "turn every block into an AI agent",
    "replace current modules",
    "make MCP or A2A internal truth",
    "automatic promotion",
    "automatic canon",
    "public dependency for private local operation"
