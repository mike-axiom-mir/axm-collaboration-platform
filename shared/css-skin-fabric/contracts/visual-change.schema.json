{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm://schemas/visual-change.schema.json",
  "type": "object",
  "required": ["name", "purpose", "author", "source", "overrides", "rollback_pointer"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,48}$"},
    "purpose": {"type": "string", "minLength": 10, "maxLength": 240},
    "author": {"type": "string", "minLength": 2, "maxLength": 80},
    "source": {"type": "string", "minLength": 2, "maxLength": 120},
    "overrides": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 120}},
    "rollback_pointer": {"type": "string", "minLength": 3, "maxLength": 160}
  },
  "additionalProperties": false
}
