{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm://schemas/mold-request.schema.json",
  "type": "object",
  "required": [
    "name",
    "component",
    "material",
    "theme",
    "purpose"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,48}$"
    },
    "component": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    }
  },
  "additionalProperties": false
}