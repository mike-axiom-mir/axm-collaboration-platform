{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.artifact-lease/v1",
  "type": "object",
  "required": ["schema", "id", "owner", "artifacts", "expiresAt", "renewable", "grantsAuthority"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "axm.artifact-lease/v1" },
    "id": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "artifacts": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "uniqueItems": true },
    "expiresAt": { "type": ["string", "null"] },
    "renewable": { "type": "boolean" },
    "grantsAuthority": { "const": false }
  }
}
