{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.artifact-ref/v1",
  "type": "object",
  "required": ["schema", "algorithm", "digest", "size", "mediaType", "semanticDigest", "dependencies", "executable", "refDigest"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "axm.artifact-ref/v1" },
    "algorithm": { "const": "sha256" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "size": { "type": "integer", "minimum": 0 },
    "mediaType": { "type": "string" },
    "semanticDigest": { "type": ["string", "null"] },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "uniqueItems": true },
    "executable": { "const": false },
    "refDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
