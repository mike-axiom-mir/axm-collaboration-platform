{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.workshop-update-manifest/v1",
  "title": "AXM Workshop signed update manifest",
  "type": "object",
  "required": ["schema", "releaseId", "version", "repository", "commitSha", "publishedAt", "archive", "signatures"],
  "properties": {
    "schema": { "const": "axm.workshop-update-manifest/v1" },
    "releaseId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "repository": { "const": "mike-axiom-mir/axm-collaboration-platform" },
    "commitSha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "minimumUpdaterVersion": { "type": "string" },
    "archive": {
      "type": "object",
      "required": ["url", "sha256", "bytes"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 }
      },
      "additionalProperties": false
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["keyId", "algorithm", "signature"],
        "properties": {
          "keyId": { "type": "string" },
          "algorithm": { "const": "ed25519" },
          "signature": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
