{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.review-operation-lease-retirement-publication-stage-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "state", "reasonCode", "stageFile", "targetFile", "archiveFile", "stageDigest", "stageBytes", "targetState", "archiveState", "assertionRequired", "confirmationRequired", "truth"],
  "properties": {
    "schema": { "const": "axm.review-operation-lease-retirement-publication-stage-plan/v1" },
    "status": { "const": "TEST" },
    "state": { "enum": ["ARCHIVAL_REQUIRES_OPERATOR_ASSERTION", "ARCHIVE_CHECKPOINT_REQUIRES_STAGE_UNLINK", "ALREADY_ARCHIVED", "HELD"] },
    "reasonCode": { "type": "string", "minLength": 1 },
    "stageFile": { "type": ["string", "null"] },
    "targetFile": { "type": ["string", "null"] },
    "archiveFile": { "type": ["string", "null"] },
    "stageDigest": { "anyOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" }] },
    "stageBytes": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 65536 }, { "type": "null" }] },
    "targetState": { "enum": ["ABSENT", "EXACT_MATCH", "CONFLICT", "INVALID", "UNREADABLE", null] },
    "archiveState": { "enum": ["MISSING", "EXACT_MATCH", "CONFLICT", "INVALID", "UNREADABLE", null] },
    "assertionRequired": { "type": ["string", "null"] },
    "confirmationRequired": { "type": ["string", "null"] },
    "truth": { "$ref": "#/$defs/truth" }
  },
  "$defs": {
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageArtifactExact", "stageDigestVerified", "authoritativeTargetClassified", "archiveDigestVerified", "losslessArchiveBytesPreserved", "stagePathRemoved", "authoritativeTargetMutatedByArchival", "ownerLockMutatedByArchival", "explicitPublisherAbandonmentAssertionRequired", "exactStageDigestConfirmationRequired", "cooperatingSingleHostArchiveCheckpointConvergence", "archiveHardLinkNoOverwrite", "sameFilesystemHardLinkRequired", "automaticArchival", "processLivenessInference", "publisherTerminatedOrAbandonedProven", "falseAssertionCanInterruptLivePublication", "durableArchivalAuthorizationRecordProvided", "stageBytesDeletedByArchival", "storageSpaceReclaimed", "archiveRetentionBounded", "livePublisherSafetyProven", "hardLinkFreeArchiveFallbackProvided", "powerLossDurabilityProven", "crossFileAtomicityProven", "nonCooperatingExternalWritersExcluded", "protectedStorageOrRollbackPreventionProven", "realWorldIdentityProven", "actualHumanParticipationProven", "browserRoute", "apiRoute", "executionAuthorized", "adoptionAuthorized", "promotionAuthorized", "mergeAuthorized", "canonAuthorized"],
      "properties": {
        "stageArtifactExact": { "type": "boolean" },
        "stageDigestVerified": { "type": "boolean" },
        "authoritativeTargetClassified": { "type": "boolean" },
        "archiveDigestVerified": { "type": "boolean" },
        "losslessArchiveBytesPreserved": { "type": "boolean" },
        "stagePathRemoved": { "type": "boolean" },
        "authoritativeTargetMutatedByArchival": { "const": false },
        "ownerLockMutatedByArchival": { "const": false },
        "explicitPublisherAbandonmentAssertionRequired": { "const": true },
        "exactStageDigestConfirmationRequired": { "const": true },
        "cooperatingSingleHostArchiveCheckpointConvergence": { "const": true },
        "archiveHardLinkNoOverwrite": { "const": true },
        "sameFilesystemHardLinkRequired": { "const": true },
        "automaticArchival": { "const": false },
        "processLivenessInference": { "const": false },
        "publisherTerminatedOrAbandonedProven": { "const": false },
        "falseAssertionCanInterruptLivePublication": { "const": true },
        "durableArchivalAuthorizationRecordProvided": { "const": false },
        "stageBytesDeletedByArchival": { "const": false },
        "storageSpaceReclaimed": { "const": false },
        "archiveRetentionBounded": { "const": false },
        "livePublisherSafetyProven": { "const": false },
        "hardLinkFreeArchiveFallbackProvided": { "const": false },
        "powerLossDurabilityProven": { "const": false },
        "crossFileAtomicityProven": { "const": false },
        "nonCooperatingExternalWritersExcluded": { "const": false },
        "protectedStorageOrRollbackPreventionProven": { "const": false },
        "realWorldIdentityProven": { "const": false },
        "actualHumanParticipationProven": { "const": false },
        "browserRoute": { "const": false },
        "apiRoute": { "const": false },
        "executionAuthorized": { "const": false },
        "adoptionAuthorized": { "const": false },
        "promotionAuthorized": { "const": false },
        "mergeAuthorized": { "const": false },
        "canonAuthorized": { "const": false }
      }
    }
  }
}
