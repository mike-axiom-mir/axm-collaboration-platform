{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.review-authority-view/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "reviewId", "artifactDigest", "reviewState", "authorityState", "reasonCode", "projectionState", "pendingProjectionEnvelopeIds", "submissionAssurance", "requiredSeats", "authenticatedApprovalSeats", "authenticatedHoldSeats", "authenticatedRejectSeats", "authenticatedPrincipalDigests", "policy", "truth"],
  "properties": {
    "schema": { "const": "axm.review-authority-view/v2" },
    "status": { "const": "TEST" },
    "reviewId": { "type": ["string", "null"] },
    "artifactDigest": { "type": ["string", "null"] },
    "reviewState": { "type": "string" },
    "authorityState": { "enum": ["HELD", "HOST_KEY_AUTHENTICATED_APPROVED"] },
    "reasonCode": { "type": "string", "minLength": 1 },
    "projectionState": { "enum": ["NONE", "PROJECTED", "PENDING", "INVALID"] },
    "pendingProjectionEnvelopeIds": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 180 } },
    "submissionAssurance": { "enum": ["NONE", "HOST_TRUSTED_KEY_POSSESSION"] },
    "requiredSeats": { "type": "integer", "minimum": 0, "maximum": 10 },
    "authenticatedApprovalSeats": { "type": "integer", "minimum": 0, "maximum": 10 },
    "authenticatedHoldSeats": { "type": "integer", "minimum": 0, "maximum": 10 },
    "authenticatedRejectSeats": { "type": "integer", "minimum": 0, "maximum": 10 },
    "authenticatedPrincipalDigests": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
    "policy": { "type": "object" },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostConfiguredPolicyActive", "authenticationIntentPersisted", "reviewProjectionVerified", "submissionKeyPossessionVerified", "reviewKeyPossessionVerified", "distinctAuthenticatedPrincipalsVerified", "automaticRecovery", "browserRecoveryRoute", "crossFileAtomicityProven", "multiProcessSerializationProven", "rollbackPreventionProven", "externalCustodyProven", "realWorldIdentityProven", "actualHumanParticipationProven", "trustedTimeProven", "reconciliationAuthorized", "executionAuthorized", "adoptionAuthorized", "permissionGranted", "promotionAuthorized", "mergeAuthorized", "canonAuthorized", "foundationMutationAuthorized"],
      "properties": {
        "hostConfiguredPolicyActive": { "type": "boolean" },
        "authenticationIntentPersisted": { "type": "boolean" },
        "reviewProjectionVerified": { "type": "boolean" },
        "submissionKeyPossessionVerified": { "type": "boolean" },
        "reviewKeyPossessionVerified": { "type": "boolean" },
        "distinctAuthenticatedPrincipalsVerified": { "type": "boolean" },
        "automaticRecovery": { "const": false },
        "browserRecoveryRoute": { "const": false },
        "crossFileAtomicityProven": { "const": false },
        "multiProcessSerializationProven": { "const": false },
        "rollbackPreventionProven": { "const": false },
        "externalCustodyProven": { "const": false },
        "realWorldIdentityProven": { "const": false },
        "actualHumanParticipationProven": { "const": false },
        "trustedTimeProven": { "const": false },
        "reconciliationAuthorized": { "const": false },
        "executionAuthorized": { "const": false },
        "adoptionAuthorized": { "const": false },
        "permissionGranted": { "const": false },
        "promotionAuthorized": { "const": false },
        "mergeAuthorized": { "const": false },
        "canonAuthorized": { "const": false },
        "foundationMutationAuthorized": { "const": false }
      }
    }
  }
}
