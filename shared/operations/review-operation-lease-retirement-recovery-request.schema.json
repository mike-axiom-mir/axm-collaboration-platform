{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.review-operation-lease-retirement-recovery-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "retirementId", "action", "ownerDigest", "assertion", "confirmation", "reason"],
  "properties": {
    "schema": { "const": "axm.review-operation-lease-retirement-recovery-request/v1" },
    "retirementId": { "type": "string", "format": "uuid" },
    "action": { "enum": ["RESUME_RETIREMENT", "FINALIZE_RESULT"] },
    "ownerDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "assertion": { "const": "HOLDER_TERMINATED_OR_ABANDONED" },
    "confirmation": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 20, "maxLength": 500 }
  }
}
