        "authoritativeTargetClassified": { "type": "boolean" },
        "archiveDigestVerified": { "type": "boolean" },
        "losslessArchiveBytesPreserved": { "type": "boolean" },
        "stagePathRemoved": { "type": "boolean" },
        "authoritativeTargetMutatedByArchival": { "const": false },
