"const":true},"strictRollbackObserved":{"type":"boolean"},"replacementOrForkObserved":{"type":"boolean"},"absenceCauseProven":{"const":false},"ledgerSnapshotAtomic":{"const":false},"intermediateOrRevertedLedgerChangesExcluded":{"const":false},"ledgerCurrentAfterFinalReadProven":{"const":false},"checkpointExternalRetentionProven":{"const":false},"deletionOrRollbackPrevented":{"const":false},"protectedMonotonicStateProven":{"const":false},"withheldRootsExcluded":{"const":false},"globalTransitionUniquenessProven":{"const":false},"globallyConsistentLogProven":{"const":false},"hostAuthorizationAuthenticated":{"const":false},"actorRealWorldIdentityProven":{"const":false},"actualHumanParticipationProven":{"const":false},"timeExternallyTrusted":{"const":false},"rawPublicKeyEmbedded":{"const":false},"rawSignatureEmbedded":{"const":false},"privateKeyIngested":{"const":false},"sourceOrLedgerPathEmbedded":{"const":false},"rawUpstreamPackageEmbedded":{"const":false},"rawModelOutputEmbedded":{"const":false},"privateContextEmbedded":{"const":false},"experimentExecuted":{"const":false},"providerInvoked":{"const":false},"evaluationPerformed":{"const":false},"executionAuthorized":{"const":false},"adoptionAuthorized":{"const":false},"humanBenefitProven":{"const":false},"broadLearningClaimed":{"const":false},"autonomousActionCount":{"const":0},"automaticPermissionGrant":{"const":false},"automaticInstall":{"const":false},"automaticPromotion":{"const":false},"automaticMerge":{"const":false},"automaticCanon":{"const":false},"foundationMutation":{"const":false}}}
