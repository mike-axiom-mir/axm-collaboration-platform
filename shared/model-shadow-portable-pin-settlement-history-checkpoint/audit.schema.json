    "current":{"type":"object","additionalProperties":false,"required":["snapshotBinding","historyDigest","proposalCount","settlementCount","currentSettledPinRef","errorCode"],"properties":{"snapshotBinding":{"$ref":"#/$defs/nullableSnapshotBinding"},"historyDigest":{"$ref":"#/$defs/nullableDigest"},"proposalCount":{"$ref":"#/$defs/nullableCount"},"settlementCount":{"$ref":"#/$defs/nullableCount"},"currentSettledPinRef":{"$ref":"#/$defs/nullableReference"},"errorCode":{"$ref":"#/$defs/nullableText"}}},
    "comparison":{"type":"object","additionalProperties":false,"required":["checkpointProposalCount","checkpointSettlementCount","commonProposalPrefixCount","commonSettlementPrefixCount","commonSettledPinPrefixCount","exactHistoryMatch","forwardHistoryExtension","strictHistoryRollback","historyReplacementOrFork","ledgerIdentityDrift"],"properties":{"checkpointProposalCount":{"type":"integer","minimum":0,"maximum":10000},"checkpointSettlementCount":{"type":"integer","minimum":0,"maximum":10000},"commonProposalPrefixCount":{"type":"integer","minimum":0,"maximum":10000},"commonSettlementPrefixCount":{"type":"integer","minimum":0,"maximum":10000},"commonSettledPinPrefixCount":{"type":"integer","minimum":0,"maximum":10000},"exactHistoryMatch":{"type":"boolean"},"forwardHistoryExtension":{"type":"boolean"},"strictHistoryRollback":{"type":"boolean"},"historyReplacementOrFork":{"type":"boolean"},"ledgerIdentityDrift":{"type":"boolean"}}},
    "decision":{"type":"object","additionalProperties":false,"required":["reviewRequired","holdRequired","bestAction","autonomousActionCount"],"properties":{"reviewRequired":{"const":true},"holdRequired":{"type":"boolean"},"bestAction":{"enum":["RETAIN_PRESENTED_CHECKPOINT_AND_CONTINUE_READ_ONLY_REVIEW","REVIEW_EXTENSION_BEFORE_OPTIONAL_NEW_CALLER_CHECKPOINT","HOLD_AND_ESCALATE_TO_STEWARD"]},"autonomousActionCount":{"const":0}}},
